@using Newtonsoft.Json
@model PageDashboardViewModel
@{
    ViewData["Title"] = "Home Page";
    DateTime date = ViewBag.date;
    string shift = ViewBag.shift;
    string companyCode = ViewBag.CompanyCode;
    PageDashboardViewModel pageDashboardViewModel = new PageDashboardViewModel();
    if (Model != null)
    {
        pageDashboardViewModel = Model;
    }
    else
    {
        pageDashboardViewModel = null;
    }

    string GetStatus(string Percent)
    {
        string status = "bg-primary";

        if (Percent != null)
        {
            if (Percent.Contains("%"))
            {
                Percent = Percent.Replace("%", "");
            }
            if (double.TryParse(Percent, out double percentValue))
            {
                if (percentValue >= 100)
                {
                    status = "bg-primary";
                }
                else if (percentValue >= 92 && percentValue < 100)
                {
                    status = "bg-success";
                }
                else if (percentValue >= 75 && percentValue < 92)
                {
                    status = "bg-warning";
                }
                else
                {
                    status = "bg-danger";
                }
            }
        }

        return status;
    }
}
@functions {
    public string ShortenNameWithCode(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "";

        fullName = fullName.Trim();
        string staffCode = "";

        // 1. Kiểm tra xem chuỗi có chứa dấu đóng mở ngoặc đơn của mã NV không
        if (fullName.Contains("(") && fullName.EndsWith(")"))
        {
            int openBracketIndex = fullName.LastIndexOf("(");
            // Cắt lấy cụm mã nhân viên kèm ngoặc (Ví dụ: " (SVN0005)")
            staffCode = " " + fullName.Substring(openBracketIndex);
            // Cắt phần tên đầy đủ phía trước ra để xử lý rút gọn (Ví dụ: "Nguyễn Văn Hướng")
            fullName = fullName.Substring(0, openBracketIndex).Trim();
        }

        // 2. Tiến hành rút gọn phần chữ tên như cũ
        var words = fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (words.Length <= 1) return fullName + staffCode;

        string shortParts = "";
        for (int i = 0; i < words.Length - 1; i++)
        {
            shortParts += words[i].Substring(0, 1).ToUpper() + ".";
        }

        // 3. Kết quả trả về = Chữ viết tắt + Tên chính + Mã nhân viên ban đầu
        return shortParts + words[words.Length - 1] + staffCode;
    }
}
<script>
    var pageLoadedDate = '@date.ToString("yyyy-MM-dd")';
    var pageLoadedShift = '@shift';
    var urlParams = new URLSearchParams(window.location.search);
    var isManualSearch = urlParams.get('isManualLoad') === 'true';

    function parseSectionTimeToMinutes(str) {
        if (!str) return 0;
        str = str.trim().toLowerCase();
        var hour = 0, min = 0;
        if (str.indexOf(':') !== -1) {
            var p = str.split(':');
            hour = parseInt(p[0], 10) || 0;
            min = parseInt(p[1], 10) || 0;
        } else if (str.indexOf('h') !== -1) {
            var p = str.split('h');
            hour = parseInt(p[0], 10) || 0;
            min = parseInt(p[1], 10) || 0;
        } else {
            hour = parseInt(str, 10) || 0;
        }
        return hour * 60 + min;
    }

    function calculateBarColors(actualData, targetData, sections) {
        var defaultBg = 'rgba(60, 141, 188, 0.9)';
        var defaultBorder = 'rgba(60, 141, 188, 0.8)';
        var dangerBg = 'rgba(220, 53, 69, 0.9)';
        var dangerBorder = 'rgba(220, 53, 69, 1)';

        var bgColors = [];
        var borderColors = [];

        if (!sections || !Array.isArray(sections) || sections.length === 0) {
            return { backgroundColors: defaultBg, borderColors: defaultBorder };
        }

        var now = new Date();
        var currentMinutes = now.getHours() * 60 + now.getMinutes();

        // 1. Xác định ca/section hiện tại
        var currentIndex = -1;
        var todayStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');

        if (typeof pageLoadedDate !== 'undefined' && pageLoadedDate < todayStr && typeof isManualSearch !== 'undefined' && isManualSearch) {
            // Xem lại ngày trong quá khứ -> tất cả các ca đã kết thúc
            currentIndex = sections.length;
        } else if (typeof pageLoadedDate !== 'undefined' && pageLoadedDate > todayStr && typeof isManualSearch !== 'undefined' && isManualSearch) {
            // Xem ngày tương lai -> chưa ca nào chạy
            currentIndex = 0;
        } else {
            for (var i = 0; i < sections.length; i++) {
                var times = sections[i].split('-');
                if (times.length < 2) continue;

                var startM = parseSectionTimeToMinutes(times[0]);
                var endM = parseSectionTimeToMinutes(times[1]);

                // Xử lý ca qua đêm (VD: 22h - 2h)
                if (endM <= startM) {
                    endM += 24 * 60;
                }

                var curM = currentMinutes;
                if (startM >= 20 * 60 && curM < 8 * 60) {
                    curM += 24 * 60;
                }
                if (startM < 8 * 60 && typeof pageLoadedShift !== 'undefined' && pageLoadedShift === 'Night') {
                    startM += 24 * 60;
                    endM += 24 * 60;
                    if (curM < 8 * 60) curM += 24 * 60;
                }

                if (curM >= startM && curM < endM) {
                    currentIndex = i; // Đang nằm trong ca i
                    break;
                }
                if (curM < startM) {
                    currentIndex = i;
                    break;
                }
            }

            if (currentIndex === -1) {
                currentIndex = sections.length;
            }
        }

        // 2. Tính tổng actual và tổng target của tất cả các ca TRƯỚC currentIndex
        var totalActualBefore = 0;
        var totalTargetBefore = 0;
        for (var i = 0; i < currentIndex; i++) {
            totalActualBefore += (actualData && actualData[i] != null) ? Number(actualData[i]) : 0;
            totalTargetBefore += (targetData && targetData[i] != null) ? Number(targetData[i]) : 0;
        }

        // Đánh giá không đạt nếu tổng target > 0 và tổng actual < tổng target
        var isFailedBefore = (totalTargetBefore > 0 && totalActualBefore < totalTargetBefore);

        // 3. Phân bổ màu cho từng cột
        for (var i = 0; i < sections.length; i++) {
            if (i < currentIndex && isFailedBefore) {
                // Các ca trước đó chuyển sang màu đỏ nếu tổng không đạt target
                bgColors.push(dangerBg);
                borderColors.push(dangerBorder);
            } else {
                // Ca hiện tại hoặc ca tương lai hoặc ca trước đạt target -> màu xanh mặc định
                bgColors.push(defaultBg);
                borderColors.push(defaultBorder);
            }
        }

        return { backgroundColors: bgColors, borderColors: borderColors };
    }

    // Xác định ca/khung giờ hiện tại đang diễn ra và kiểm tra điều kiện áp dụng hiệu ứng
    function getActiveSectionInfo(sections, actualData, targetData) {
        if (!sections || !Array.isArray(sections) || sections.length === 0) {
            return null;
        }

        var now = new Date();
        var todayStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');

        // Nếu đang xem lịch sử ngày quá khứ hoặc ngày tương lai -> không áp dụng
        if (typeof pageLoadedDate !== 'undefined' && pageLoadedDate !== todayStr && typeof isManualSearch !== 'undefined' && isManualSearch) {
            return null;
        }

        var currentMinutes = now.getHours() * 60 + now.getMinutes();

        for (var i = 0; i < sections.length; i++) {
            var times = sections[i].split('-');
            if (times.length < 2) continue;

            var startM = parseSectionTimeToMinutes(times[0]);
            var endM = parseSectionTimeToMinutes(times[1]);

            // Xử lý ca qua đêm (VD: 22h - 2h)
            if (endM <= startM) {
                endM += 24 * 60;
            }

            var curM = currentMinutes;
            if (startM >= 20 * 60 && curM < 8 * 60) {
                curM += 24 * 60;
            }
            if (startM < 8 * 60 && typeof pageLoadedShift !== 'undefined' && pageLoadedShift === 'Night') {
                startM += 24 * 60;
                endM += 24 * 60;
                if (curM < 8 * 60) curM += 24 * 60;
            }

            // Khung giờ thực tế ĐANG DIỄN RA
            if (curM >= startM && curM < endM) {
                var actual = (actualData && actualData[i] != null) ? Number(actualData[i]) : 0;
                var target = (targetData && targetData[i] != null) ? Number(targetData[i]) : 0;

                // Cột đã đạt hoặc vượt target rồi thì thôi (không có hiệu ứng)
                if (target > 0 && actual >= target) {
                    return null;
                }

                return {
                    index: i,
                    actual: actual,
                    target: target
                };
            }
        }

        return null;
    }

    // Cập nhật vị trí hiệu ứng ánh sáng nhẹ lướt lên trên cho riêng cột ở ca hiện tại
    function updateActiveBarGlow(chart) {
        if (!chart || !chart.canvas || chart.config.type !== 'bar') return;

        var labels = chart.data.labels;
        if (!labels || !Array.isArray(labels) || labels.length === 0) return;

        var $canvas = $(chart.canvas);
        var $wrapper = $canvas.closest('.chart-progress-wrapper');
        if ($wrapper.length === 0) return;

        var $glow = $wrapper.find('.active-bar-glow');
        if ($glow.length === 0) {
            $glow = $('<div class="active-bar-glow"></div>');
            $wrapper.append($glow);
        }

        var actualData = chart.data.datasets && chart.data.datasets[0] ? chart.data.datasets[0].data : null;
        var targetData = chart.data.datasets && chart.data.datasets[1] ? chart.data.datasets[1].data : null;

        var activeInfo = getActiveSectionInfo(labels, actualData, targetData);
        if (!activeInfo) {
            $glow.hide();
            return;
        }

        var meta = chart.getDatasetMeta(0);
        if (!meta || !meta.data || !meta.data[activeInfo.index]) {
            $glow.hide();
            return;
        }

        var vm = meta.data[activeInfo.index]._view;
        if (!vm) {
            $glow.hide();
            return;
        }

        var barHeight = vm.base - vm.y;
        // Chỉ hiện hiệu ứng khi cột có chiều cao mọc lên (sản lượng > 0)
        if (barHeight <= 2) {
            $glow.hide();
            return;
        }

        var offsetLeft = chart.canvas.offsetLeft || 0;
        var offsetTop = chart.canvas.offsetTop || 0;

        $glow.css({
            display: 'block',
            left: (offsetLeft + vm.x - vm.width / 2) + 'px',
            top: (offsetTop + vm.y) + 'px',
            width: vm.width + 'px',
            height: barHeight + 'px'
        });
    }

    // Đăng ký Plugin toàn cục cho Chart.js để tự động kích hoạt hiệu ứng trên mọi biểu đồ Bar
    if (typeof Chart !== 'undefined' && Chart.plugins) {
        var existingGlowPlugin = Chart.plugins.getAll ? Chart.plugins.getAll().find(function (p) { return p && p.id === 'activeBarGlowPlugin'; }) : null;
        if (!existingGlowPlugin) {
            Chart.plugins.register({
                id: 'activeBarGlowPlugin',
                afterDraw: function (chart) {
                    if (chart.config.type === 'bar') {
                        updateActiveBarGlow(chart);
                    }
                }
            });
        }
    }
</script>
