@using Newtonsoft.Json
@model DashboardViewModel
@{
    ViewData["Title"] = "Home Page";
    DateTime date = ViewBag.date;
    string shift = ViewBag.shift;

    string GetStatus(string Percent)
    {
        string status = "bg-primary";

        if (Percent != null)
        {
            if (Percent.Contains("%"))
            {
                Percent = Percent.Replace("%", "");
            }
            if (double.TryParse(Percent, out double percentValue))
            {
                if (percentValue >= 100)
                {
                    status = "bg-primary";
                }
                else if (percentValue >= 92 && percentValue < 100)
                {
                    status = "bg-success";
                }
                else if (percentValue >= 75 && percentValue < 92)
                {
                    status = "bg-warning";
                }
                else
                {
                    status = "bg-danger";
                }
            }
        }

        return status;
    }
}
<div class="container-fluid">
    <div class="row">
        @foreach (var item in Model.BarChartData)
        {
            string sectionList = string.Empty;
            string targetData = string.Empty;
            string resultData = string.Empty;
            string defectLabel = string.Empty;
            string defectData = string.Empty;

            sectionList = JsonConvert.SerializeObject(Model.Sections);
            targetData = JsonConvert.SerializeObject(item.TargetData);
            resultData = JsonConvert.SerializeObject(item.ActualData);
            defectLabel = JsonConvert.SerializeObject(item.Defectlabel);
            defectData = JsonConvert.SerializeObject(item.Defectdata);

            string charID = item.Operation;
            charID = charID.Replace("-", "");
            if (charID.Contains("(SM)"))
            {
                charID = charID.Replace("(SM)", "");
            }
            if (charID.Contains("(ITA)"))
            {
                charID = charID.Replace("(ITA)", "");
            }

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">@item.Operation</h5>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                            <div class="btn-group">
                                <button type="button" class="btn btn-tool dropdown-toggle" data-toggle="dropdown">
                                    <i class="fas fa-wrench"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-right" role="menu">
                                    <a href="#" class="dropdown-item">Action</a>
                                    <a href="#" class="dropdown-item">Another action</a>
                                    <a href="#" class="dropdown-item">Something else here</a>
                                    <a class="dropdown-divider"></a>
                                    <a href="#" class="dropdown-item">Separated link</a>
                                </div>
                            </div>
                            <button type="button" class="btn btn-tool" data-card-widget="remove">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8 col-12">
                                <p class="text-center header-font-size">
                                    <strong>Nguyễn Văn Hướng (SVN0005) - Phạm Thị Thủy (SVN0132)</strong>
                                </p>

                                <div class="chart">
                                    <!-- Sales Chart Canvas -->
                                    <canvas id="barChart_@charID" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
                                </div>
                                <!-- /.chart-responsive -->
                            </div>
                            <!-- /.col -->
                            <div class="col-md-4 col-12">
                                <p class="text-center header-font-size">
                                    <strong>Defect by category</strong>
                                </p>
                                <div class="chart">
                                    <!-- Sales Chart Canvas -->
                                    <canvas id="pieChart_@charID" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
                                </div>
                            </div>
                            <!-- /.col -->
                        </div>
                        <!-- /.row -->
                    </div>
                    <!-- ./card-body -->
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-6 col-12">
                                <div class="progress-group">
                                    <span class="progress-text content-font-size">Hourly Plan</span>
                                    <span class="float-right content-font-size"><b>@item.HourlyPlanData</b></span>
                                    <div class="progress progress-sm">
                                        <div class="progress-bar @GetStatus(item.HourlyPlanPercent)" style="width: @item.HourlyPlanPercent">@item.HourlyPlanPercent</div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.col -->
                            <div class="col-md-6 col-12">
                                <div class="progress-group">
                                    <span class="progress-text content-font-size">UPH</span>
                                    <span class="float-right content-font-size"><b>@item.UPHData</b></span>
                                    <div class="progress progress-sm">
                                        <div class="progress-bar @GetStatus(item.UPHPercent)" style="width: @item.UPHPercent">@item.UPHPercent</div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.col -->
                            <div class="col-md-6 col-12">
                                <!-- /.progress-group -->
                                <div class="progress-group">
                                    <span class="progress-text content-font-size">UPPH</span>
                                    <span class="float-right content-font-size"><b>@item.UPPHData</b></span>
                                    <div class="progress progress-sm">
                                        <div class="progress-bar @GetStatus(item.UPPHPercent)" style="width: @item.UPPHPercent">@item.UPPHPercent</div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.col -->
                            <div class="col-md-6 col-12">
                                <!-- /.progress-group -->
                                <div class="progress-group">
                                    <span class="progress-text content-font-size">Defect</span>
                                    <span class="float-right content-font-size"><b>@item.DefectData</b></span>
                                    <div class="progress progress-sm">
                                        <div class="progress-bar @GetStatus(item.DefectPercent)" style="width: @item.DefectPercent">@item.DefectPercent</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.row -->
                    </div>
                    <!-- /.card-footer -->
                </div>
                <!-- /.card -->
            </div>
            <script>
                $(function () {
              var areaChartData = {
                labels  : @Html.Raw(sectionList),
                datasets: [
                  {
                    label               : '@item.TargetLabel',
                    backgroundColor     : 'rgba(210, 214, 222, 1)',
                    borderColor         : 'rgba(210, 214, 222, 1)',
                    pointRadius         : false,
                    pointColor          : 'rgba(210, 214, 222, 1)',
                    pointStrokeColor    : '#c1c7d1',
                    pointHighlightFill  : '#fff',
                    pointHighlightStroke: 'rgba(220,220,220,1)',
                    data                : @Html.Raw(targetData)
                  },
                  {
                    label               : '@item.ActualLabel',
                    backgroundColor     : 'rgba(60,141,188,0.9)',
                    borderColor         : 'rgba(60,141,188,0.8)',
                    pointRadius          : false,
                    pointColor          : '#3b8bba',
                    pointStrokeColor    : 'rgba(60,141,188,1)',
                    pointHighlightFill  : '#fff',
                    pointHighlightStroke: 'rgba(60,141,188,1)',
                    data                : @Html.Raw(resultData)
                  },
                ]
              }
              var donutData        = {
                labels: @Html.Raw(defectLabel),
                datasets: [
                  {
                    data: @Html.Raw(defectData),
                    backgroundColor : ['#00c0ef', '#3c8dbc', '#d2d6de'],
                  }
                ]
              }

              //-------------
              //- PIE CHART -
              //-------------
              // Get context with jQuery - using jQuery's .get() method.
              var pieChartCanvas = $('#pieChart_@charID').get(0).getContext('2d')
              var pieData        = donutData;
              var pieOptions     = {
                maintainAspectRatio : false,
                responsive : true,
              }
              //Create pie or douhnut chart
              // You can switch between pie and douhnut using the method below.
              new Chart(pieChartCanvas, {
                type: 'pie',
                data: pieData,
                options: pieOptions
              })

              //-------------
              //- BAR CHART -
              //-------------
              var barChartCanvas = $('#barChart_@charID').get(0).getContext('2d')
              var barChartData = $.extend(true, {}, areaChartData)
              var temp0 = areaChartData.datasets[0]
              var temp1 = areaChartData.datasets[1]
              barChartData.datasets[0] = temp1
              barChartData.datasets[1] = temp0

              var barChartOptions = {
                responsive              : true,
                maintainAspectRatio     : false,
                datasetFill             : false
              }

              new Chart(barChartCanvas, {
                type: 'bar',
                data: barChartData,
                options: barChartOptions
              })
            })
        </script>
        }
        <!-- /.col -->
    </div>
    
</div><!--/. container-fluid -->
