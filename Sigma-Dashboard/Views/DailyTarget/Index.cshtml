@model IEnumerable<Sigma_Dashboard.Models.DailyTargetViewModel>
<link href="~/plugins/datatables-bs4/css/datatables.bootstrap4.min.css" rel="stylesheet" />
<link href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" rel="stylesheet" />
<link href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css" rel="stylesheet" />
@{
    string stringDate = ViewBag.stringDate;
}
<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title">Daily Target</h3>

            <input type="file" id="excelFile" accept=".xlsx, .xls" style="display: none;" onchange="uploadExcel()" />

            <div class="d-flex ml-auto">
                <button type="button" class="btn btn-success mr-2" onclick="$('#excelFile').click()">
                    <i class="fas fa-file-import"></i>
                </button>
                <button type="button" class="btn btn-success" onclick="openCreateModal()">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Operation</th>
                        <th>Daily_plan</th>
                        <th>UPH</th>
                        <th>UPPH</th>
                        <th>Labor</th>
                        <th>Date_time</th>
                        <th>Defect</th>
                        <th>Workingtime</th>
                        <th>Shift</th>
                        <th style="width: 120px;">Options</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row_@item.Operation">
                                <td>@item.Operation</td>
                                <td>@item.Daily_plan</td>
                                <td>@item.UPH</td>
                                <td>@item.UPPH</td>
                                <td>@item.Labor</td>
                                <td>@item.Date_time</td>
                                <td>@item.Defect</td>
                                <td>@item.Workingtime</td>
                                <td>@item.Shift</td>
                                <td>
                                    <button class="btn btn-sm btn-primary"
                                            onclick="openEditModal(this)"
                                            data-operation="@item.Operation"
                                            data-dailyplan="@item.Daily_plan"
                                            data-uph="@item.UPH"
                                            data-upph="@item.UPPH"
                                            data-labor="@item.Labor"
                                            data-datetime="@item.Date_time"
                                            data-defect="@item.Defect"
                                            data-workingtime="@item.Workingtime"
                                            data-shift="@item.Shift">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteTarget('@item.Operation', '@item.Date_time')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center">No data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="targetModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add New Target</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="targetForm">
                <div class="modal-body">
                    <input type="hidden" id="isEditMode" value="false" />

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label>Operation <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtOperation" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Date Time (yyyyMMdd) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtDateTime" placeholder="Ví dụ: @stringDate" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label>Daily Plan</label>
                            <input type="number" class="form-control" id="txtDailyPlan">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Shift</label>
                            <select class="form-control" id="ddlShift">
                                <option value="day">day</option>
                                <option value="night">night</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label>UPH</label>
                            <input type="number" step="0.001" class="form-control" id="txtUPH">
                        </div>
                        <div class="form-group col-md-4">
                            <label>UPPH</label>
                            <input type="number" step="0.001" class="form-control" id="txtUPPH">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Labor</label>
                            <input type="number" class="form-control" id="txtLabor">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label>Defect</label>
                            <input type="text" class="form-control" id="txtDefect">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Working Time</label>
                            <input type="number" step="0.001" class="form-control" id="txtWorkingTime">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCreateModal() {
        // 1. Reset form về trống rỗng TRƯỚC
        $('#targetForm')[0].reset();

        // 2. Định nghĩa chế độ Thêm mới và tiêu đề
        $('#isEditMode').val('false');
        $('#modalTitle').text('Add New Target');

        // 3. Mở khóa ô Operation, gán giá trị mặc định cho Date_time và Khóa lại
        $('#txtOperation').prop('disabled', false);
        $('#txtDateTime').val('@stringDate').prop('disabled', true);

        // 4. Hiển thị Modal lên màn hình
        $('#targetModal').modal('show');
    }

    function openEditModal(btn) {
        $('#isEditMode').val('true');
        $('#modalTitle').text('Update Target');

        // --- KHÓA ĐỒNG THỜI CẢ OPERATION VÀ DATE_TIME KHI EDIT ---
        $('#txtOperation').val($(btn).data('operation')).prop('disabled', true);
        $('#txtDateTime').val($(btn).data('datetime')).prop('disabled', true);

        $('#txtDailyPlan').val($(btn).data('dailyplan'));
        $('#txtUPH').val($(btn).data('uph'));
        $('#txtUPPH').val($(btn).data('upph'));
        $('#txtLabor').val($(btn).data('labor'));
        $('#txtDefect').val($(btn).data('defect'));
        $('#txtWorkingTime').val($(btn).data('workingtime'));

        // Gán giá trị được chọn cho Select Box Shift
        $('#ddlShift').val($(btn).data('shift'));

        $('#targetModal').modal('show');
    }

    $('#targetForm').on('submit', function (e) {
        e.preventDefault();

        var formData = {
            Operation: $('#txtOperation').val(),
            Date_time: $('#txtDateTime').val(), // Lấy chuỗi string trực tiếp
            Daily_plan: parseInt($('#txtDailyPlan').val()) || 0,
            UPH: parseFloat($('#txtUPH').val()) || 0,
            UPPH: parseFloat($('#txtUPPH').val()) || 0,
            Labor: parseInt($('#txtLabor').val()) || 0,
            Defect: $('#txtDefect').val(),
            Workingtime: parseFloat($('#txtWorkingTime').val()) || 0,
            Shift: $('#ddlShift').val() // Lấy giá trị từ select box
        };

        var isEdit = $('#isEditMode').val() === 'true';
        var url = isEdit ? '/DailyTarget/Edit' : '/DailyTarget/Create';

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    $('#targetModal').modal('hide');
                    location.reload();
                } else {
                    alert("Lỗi: " + res.message);
                }
            },
            error: function () {
                alert("Đã xảy ra lỗi kết nối mạng.");
            }
        });
    });

    function deleteTarget(operation, datetime) {
        if (confirm("Bạn có chắc chắn muốn xóa dữ liệu của Operation " + operation + " không?")) {
            $.ajax({
                url: '/DailyTarget/Delete',
                type: 'POST',
                data: { operation: operation, datetime: datetime },
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        $('#row_' + operation).remove();
                    } else {
                        alert("Lỗi: " + res.message);
                    }
                },
                error: function () {
                    alert("Không thể thực hiện lệnh xóa.");
                }
            });
        }
    }

    function uploadExcel() {
        var fileInput = $('#excelFile')[0].files[0];
        if (!fileInput) return;

        var formData = new FormData();
        formData.append("file", fileInput);

        if (typeof showLoader === "function") showLoader();

        $.ajax({
            url: '/DailyTarget/ImportExcel',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            // Cấu hình nhận stream ký tự mã hóa thô, ngăn chặn jQuery tự ép kiểu gây lỗi
            mimeType: 'text/plain; charset=x-user-defined',
            success: function (rawData, status, xhr) {
                var contentType = xhr.getResponseHeader("content-type") || "";

                // TRƯỜNG HỢP 1: Server trả về JSON (Thành công hoặc lỗi DB)
                if (contentType.toLowerCase().indexOf("json") !== -1) {
                    try {
                        // Giải mã chuỗi thô về chuỗi Unicode tiêu chuẩn trước khi parse JSON
                        var jsonText = "";
                        for (var i = 0; i < rawData.length; i++) {
                            jsonText += String.fromCharCode(rawData.charCodeAt(i) & 0xff);
                        }

                        var res = JSON.parse(jsonText);
                        if (res.success === true || res.success === "true") {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert("Thất bại: " + res.message);
                        }
                    } catch (e) {
                        alert("Lỗi cấu trúc dữ liệu JSON từ Server.");
                    }
                }
                // TRƯỜNG HỢP 2: Server trả về File Excel lỗi (Dữ liệu không hợp lệ)
                else {
                    alert("Import dữ liệu thất bại! Hệ thống phát hiện dòng dữ liệu sai định dạng và đã xuất bản tệp tin Excel kèm ghi chú tại cột Options.");

                    // Đọc chuỗi ký tự thô mã hóa gốc và chuyển đổi thành mảng byte chuẩn OpenXML
                    var bytes = new Uint8Array(rawData.length);
                    for (var i = 0; i < rawData.length; i++) {
                        bytes[i] = rawData.charCodeAt(i) & 0xff; // Giữ nguyên bit nhị phân gốc của file Excel
                    }

                    var blob = new Blob([bytes], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = "Import_DailyTarget_Errors.xlsx";

                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(link.href);
                }
            },
            error: function (xhr, status, error) {
                alert("Đã xảy ra lỗi kết nối đường truyền mạng hoặc máy chủ phản hồi lỗi 500.");
            },
            complete: function () {
                $('#excelFile').val('');
                if (typeof hideLoader === "function") hideLoader();
            }
        });
    }
</script>

<script src="~/plugins/datatables/jquery.datatables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/datatables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables-responsive/js/datatables.responsive.min.js"></script>
<script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
<script src="~/plugins/datatables-buttons/js/datatables.buttons.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
<script src="~/plugins/jszip/jszip.min.js"></script>
<script src="~/plugins/pdfmake/pdfmake.min.js"></script>
<script src="~/plugins/pdfmake/vfs_fonts.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.colvis.min.js"></script>

<script>
    $(function () {
      $("#example1").DataTable({
        "responsive": true, "lengthChange": false, "autoWidth": false,
        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
      }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
      $('#example2').DataTable({
        "paging": true,
        "lengthChange": false,
        "searching": false,
        "ordering": true,
        "info": true,
        "autoWidth": false,
        "responsive": true,
      });
    });
</script>