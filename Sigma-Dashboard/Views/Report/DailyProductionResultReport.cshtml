@model IEnumerable<Sigma_Dashboard.Models.PDResultDailyViewModel>
<link href="~/plugins/datatables-bs4/css/datatables.bootstrap4.min.css" rel="stylesheet" />
<link href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" rel="stylesheet" />
<link href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css" rel="stylesheet" />
@{
    ViewData["Title"] = ViewBag.TitleName;
    DateTime fromDate = ViewBag.FromDate;
    DateTime toDate = ViewBag.ToDate;
    List<DailyTargetDetailsViewModel> viewModelDetails = ViewBag.DailyResultDetails;
}

@functions {
    string FormatNumber(object value)
    {
        if (value == null) return "0";
        string str = value.ToString().Trim();
        if (string.IsNullOrEmpty(str)) return "0";

        string cleanStr = str.Replace(",", "");
        if (double.TryParse(cleanStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double num))
        {
            return num.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture);
        }
        return str;
    }

    string FormatLabor(object value)
    {
        if (value == null) return "0";
        string str = value.ToString().Trim();
        if (string.IsNullOrEmpty(str)) return "0";

        string cleanStr = str.Replace(",", "");
        if (double.TryParse(cleanStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double num))
        {
            return Math.Ceiling(num).ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture);
        }
        return str;
    }

    string GetLaborPercent(PDResultDailyViewModel item)
    {
        double target = 0;
        double current = 0;
        if (double.TryParse(item.LaborTarget?.Replace(",", ""), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double t))
        {
            target = Math.Ceiling(t);
        }
        if (double.TryParse(item.LaborCurrent?.Replace(",", ""), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double c))
        {
            current = Math.Ceiling(c);
        }
        if (target > 0)
        {
            return Math.Round(current / target * 100, 2).ToString() + "%";
        }
        return "0%";
    }

    string GetCleanNumber(object value)
    {
        if (value == null) return "0";
        string str = value.ToString().Replace("%", "").Replace(",", "").Trim();
        if (double.TryParse(str, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double num))
        {
            return num.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
        return "0";
    }

    string GetBadgeClass(string percentStr, bool isDefect = false)
    {
        if (string.IsNullOrWhiteSpace(percentStr)) return "";

        string cleanStr = percentStr.Replace("%", "").Trim();
        if (double.TryParse(cleanStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double val))
        {
            if (isDefect)
            {
                if (val >= 100) return "badge-danger";
                if (val >= 92 && val < 100) return "badge-warning";
                if (val >= 75 && val < 92) return "badge-success";
                return "badge-primary";
            }
            else
            {
                if (val >= 100) return "badge-primary";
                if (val >= 92 && val < 100) return "badge-success";
                if (val >= 75 && val < 92) return "badge-warning";
                return "badge-danger";
            }
        }
        return "";
    }
}

<style>
    .report-percent-badge {
        display: inline-block;
        min-width: 65px;
        padding: 3px 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
        border-radius: 4px;
        color: #fff;
    }
    .report-percent-badge.badge-primary {
        background-color: #007bff;
        color: #fff;
    }
    .report-percent-badge.badge-success {
        background-color: #28a745;
        color: #fff;
    }
    .report-percent-badge.badge-warning {
        background-color: #ffc107;
        color: #1f2d3d !important;
    }
    .report-percent-badge.badge-danger {
        background-color: #dc3545;
        color: #fff;
    }
    #example1 th, #example2 th {
        vertical-align: middle;
        text-align: center;
    }
</style>
<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center row">
            <div class="col-12 mb-2">
                <h3 class="card-title">@ViewBag.TitleName - @fromDate.ToString("dd/MM/yyyy") - @toDate.ToString("dd/MM/yyyy")</h3>
            </div>
            <div class="col-12">
                <ul class="nav nav-tabs" id="custom-tabs-four-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="custom-tabs-four-home-tab" data-toggle="pill" href="#custom-tabs-four-home" role="tab" aria-controls="custom-tabs-four-home" aria-selected="true">Totals</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="custom-tabs-four-profile-tab" data-toggle="pill" href="#custom-tabs-four-profile" role="tab" aria-controls="custom-tabs-four-profile" aria-selected="false">Details</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="card-body">
            <div class="tab-content" id="custom-tabs-four-tabContent">
                <div class="tab-pane fade show active" id="custom-tabs-four-home" role="tabpanel" aria-labelledby="custom-tabs-four-home-tab">
                    <table id="example1" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th rowspan="2" scope="col">Operation active</th>
                                <th colspan="3" scope="col">Daily Plan Achieve</th>
                                <th colspan="3" scope="col">UPH</th>
                                <th rowspan="2" scope="col">UPPH</th>
                                <th colspan="3" scope="col">Labor</th>
                                <th colspan="3" scope="col">Defect rate</th>
                                <th rowspan="2" scope="col">Check list on system</th>
                                <th rowspan="2" scope="col">Remark</th>
                            </tr>
                            <tr>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                                <th>Target rate</th>
                                <th>Current rate</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    string rowClass = "";
                                    if (item.OperationActive == "Total Quatity")
                                    {
                                        rowClass = "font-weight: 800;";
                                    }
                                    <tr style="@rowClass">
                                        <td>@item.OperationActive</td>
                                        <td data-order="@GetCleanNumber(item.DailyPlanTarget)" class="text-right">@FormatNumber(item.DailyPlanTarget)</td>
                                        <td data-order="@GetCleanNumber(item.DailyPlanCurrent)" class="text-right">@FormatNumber(item.DailyPlanCurrent)</td>
                                        <td data-order="@GetCleanNumber(item.DailyPlanAchieve)" class="text-center"><span class="report-percent-badge @GetBadgeClass(item.DailyPlanAchieve)">@item.DailyPlanAchieve</span></td>
                                        <td data-order="@GetCleanNumber(item.UPHTarget)" class="text-right">@FormatNumber(item.UPHTarget)</td>
                                        <td data-order="@GetCleanNumber(item.UPHCurrent)" class="text-right">@FormatNumber(item.UPHCurrent)</td>
                                        <td data-order="@GetCleanNumber(item.UPH)" class="text-center"><span class="report-percent-badge @GetBadgeClass(item.UPH)">@item.UPH</span></td>
                                        <td data-order="@GetCleanNumber(item.UPPH)" class="text-center"><span class="report-percent-badge @GetBadgeClass(item.UPPH)">@item.UPPH</span></td>
                                        <td data-order="@GetCleanNumber(FormatLabor(item.LaborTarget))" class="text-right">@FormatLabor(item.LaborTarget)</td>
                                        <td data-order="@GetCleanNumber(FormatLabor(item.LaborCurrent))" class="text-right">@FormatLabor(item.LaborCurrent)</td>
                                        @{
                                            var laborPercentTotals = GetLaborPercent(item);
                                        }
                                        <td data-order="@GetCleanNumber(laborPercentTotals)" class="text-center"><span class="report-percent-badge @GetBadgeClass(laborPercentTotals)">@laborPercentTotals</span></td>
                                        <td class="text-center">@item.DefectTargetRate</td>
                                        <td class="text-center">@item.DefectCurrentRate</td>
                                        <td data-order="@GetCleanNumber(item.DefectRate)" class="text-center"><span class="report-percent-badge @GetBadgeClass(item.DefectRate, true)">@item.DefectRate</span></td>
                                        <td class="text-center">@item.CheckListOnSystem</td>
                                        <td>@item.Remark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="16" class="text-center">No data available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="tab-pane fade" id="custom-tabs-four-profile" role="tabpanel" aria-labelledby="custom-tabs-four-profile-tab">
                    <table id="example2" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th rowspan="2" scope="col">Project</th>
                                <th rowspan="2" scope="col">PartNumber</th>
                                <th rowspan="2" scope="col">DateTime</th>
                                <th colspan="3" scope="col">Daily Plan Output</th>
                                <th colspan="3" scope="col">UPH</th>
                                <th rowspan="2" scope="col">UPPH</th>
                                <th colspan="3" scope="col">Labor</th>
                                
                            </tr>
                            <tr>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (viewModelDetails != null && viewModelDetails.Any())
                            {
                                foreach (var item in viewModelDetails)
                                {
                                    string rowClass = "";
                                    
                                    <tr style="@rowClass">
                                        <td>@item.Project</td>
                                        <td>@item.PartNumber</td>
                                        <td class="text-center">@item.Date_time</td>
                                        <td data-order="@item.Daily_plan" class="text-right">@FormatNumber(item.Daily_plan)</td>
                                        <td data-order="@item.Total_Qty" class="text-right">@FormatNumber(item.Total_Qty)</td>
                                        @{
                                            var dailyPercent = item.Daily_plan == 0 ? "0%" : Math.Round(item.Total_Qty / item.Daily_plan * 100, 2).ToString() + "%";
                                        }
                                        <td data-order="@GetCleanNumber(dailyPercent)" class="text-center"><span class="report-percent-badge @GetBadgeClass(dailyPercent)">@dailyPercent</span></td>
                                        <td data-order="@item.UPH" class="text-right">@FormatNumber(item.UPH)</td>
                                        <td data-order="@item.Current_UPH" class="text-right">@FormatNumber(item.Current_UPH)</td>
                                        @{
                                            var uphPercent = item.UPH == 0 ? "0%" : Math.Round(item.Current_UPH / item.UPH * 100, 2).ToString() + "%";
                                        }
                                        <td data-order="@GetCleanNumber(uphPercent)" class="text-center"><span class="report-percent-badge @GetBadgeClass(uphPercent)">@uphPercent</span></td>
                                        @{
                                            var upphPercent = item.UPPH == 0 ? "0%" : Math.Round(item.Current_UPPH / item.UPPH * 100, 2).ToString() + "%";
                                        }
                                        <td data-order="@GetCleanNumber(upphPercent)" class="text-center"><span class="report-percent-badge @GetBadgeClass(upphPercent)">@upphPercent</span></td>
                                        <td data-order="@Math.Ceiling(item.MaxLabor)" class="text-right">@FormatLabor(item.MaxLabor)</td>
                                        <td data-order="@Math.Ceiling(item.Labor)" class="text-right">@FormatLabor(item.Labor)</td>
                                        @{
                                            var laborPercent = item.MaxLabor == 0 ? "0%" : Math.Round(item.Labor / item.MaxLabor * 100, 2).ToString() + "%";
                                        }
                                        <td data-order="@GetCleanNumber(laborPercent)" class="text-center"><span class="report-percent-badge @GetBadgeClass(laborPercent)">@laborPercent</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center">No data available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
    </div>
</div>

<script src="~/plugins/datatables/jquery.datatables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/datatables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables-responsive/js/datatables.responsive.min.js"></script>
<script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
<script src="~/plugins/datatables-buttons/js/datatables.buttons.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
<script src="~/plugins/jszip/jszip.min.js"></script>
<script src="~/plugins/pdfmake/pdfmake.min.js"></script>
<script src="~/plugins/pdfmake/vfs_fonts.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.colvis.min.js"></script>

<script>
    $(function () {
      $("#example1").DataTable({
        "responsive": true, "lengthChange": false, "autoWidth": false,
        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
      }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
      $('#example2').DataTable({
        // "paging": true,
        // "lengthChange": false,
        // "searching": false,
        // "ordering": true,
        // "info": true,
        // "autoWidth": false,
        // "responsive": true,
        "responsive": true, "lengthChange": false, "autoWidth": false,
        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
      }).buttons().container().appendTo('#example2_wrapper .col-md-6:eq(0)');
    });
</script>