@{
    Layout = "~/Views/Shared/_ToolsLayout.cshtml";
    ViewData["Title"] = "Nhập kết quả sản xuất";
}
<form method="post">
    <div class="row">
        
        @* <div class="col-12">
            <div class="form-group">
                <label class="control-label">Mã sản phẩm</label>
            </div>
        </div> *@
        <div class="row col-12">
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Lệnh sản xuất</label>
                    <input id="txtWorkOrderCode" type="text" name="workOrderCode" class="form-control" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group" style="margin-top:33px">
                    <button class="btn btn-success" type="button" onclick="GetProductByWorkOrder('#txtWorkOrderCode')"><i class="fa fa-pencil"></i> Tìm kiếm</button>
                </div>
            </div>
        </div>
        <div id="divWorkOrder" class="row col-12">
            <div class="col-12">
                <div class="form-group">
                    <h1 class="control-label">Lệnh sản xuất: NM/MO/00933-004</h1>
                    <input type="hidden" name="Name" class="form-control" value="NM/MO/00933" />
                </div>
            </div>
            <div class="col-12">
                <div class="form-group">
                    <h2 class="control-label">
                        Sản phẩm:
                        [FG-SOL-SP-0220-00-One Section] Cozy PRODUCTION 1655 Flatbush Avenue = 1335 COVER TYPE: Baseboard (with bump-out eKits)- One Section
                    </h2>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <div class="row">
                        <div class="col-2">
                            <label class="control-label">Số lượng</label>
                        </div>
                        <div class="col-5">
                            <input type="text" name="Quality" class="form-control" />
                        </div>
                        <div class="col-5">
                            /97
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <div class="row">
                        <div class="col-2">
                            <label class="control-label">Số serial</label>
                        </div>
                        <div class="col-10">
                            <input type="text" name="Serial" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Sản phẩm</th>
                            <th scope="col">Từ</th>
                            <th scope="col">Số seri</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">
                                [WCT01-60186] Linacoustic insulation panel after cutting
                            </th>
                            <td>
                                NM/Dự trữ
                            </td>
                            <td>
                                <input type="hidden" class="form-control" value="170" />
                                <input type="text" class="form-control" value="12345" />
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">
                                [RMT11-60002] Metal sheet of 72” baseboard (SPCC T=1.2MM JIS G3141)

                            </th>
                            <td>
                                NM/Dự trữ
                            </td>
                            <td>
                                <input type="hidden" class="form-control" value="165" />
                                <input type="text" class="form-control" value="123" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<script>
    function GetProductByWorkOrder(txtworkOrderCode) {
        var workOrderCode = $(txtworkOrderCode).val();
        $.ajax({
            url: '@Url.Action("GetProductByWorkOrder", "Tools")',  // Adjust the controller name if needed
            type: 'POST',
            data: {workOrderCode: workOrderCode},
            dataType: 'json',
            success: function (response) {
                if(response.result == false) {
                    alert(response.message);
                }
                else{
                    $(txtPackageID).val(response.packageID);
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
                alert("An error occurred while getting Pallet ID.");
            }
        });
    }
</script>
