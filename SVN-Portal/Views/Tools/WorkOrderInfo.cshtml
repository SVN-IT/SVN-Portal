@{
    Layout = "~/Views/Shared/_ToolsLayout.cshtml";
    ViewData["Title"] = "Nhập kết quả sản xuất";
}
<form method="post">
    <div class="row">
        
        @* <div class="col-12">
            <div class="form-group">
                <label class="control-label">Mã sản phẩm</label>
            </div>
        </div> *@
        <div class="row col-12">
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Lệnh sản xuất</label>
                    <input id="txtWorkOrderCode" type="text" name="workOrderCode" class="form-control" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group" style="margin-top:33px">
                    <button class="btn btn-success" type="button" onclick="GetProductByWorkOrder('#txtWorkOrderCode')"><i class="fa fa-pencil"></i> Tìm kiếm</button>
                </div>
            </div>
        </div>
        <div id="divWorkOrder" class="row col-12">
            
        </div>
    </div>
</form>

<script>
    function GetProductByWorkOrder(txtworkOrderCode) {
        var workOrderCode = $(txtworkOrderCode).val();
        $.ajax({
            url: '@Url.Action("GetProductByWorkOrder", "Tools")',  // Adjust the controller name if needed
            type: 'POST',
            data: {workOrderCode: workOrderCode},
            dataType: 'json',
            success: function (response) {
                if(response.result == false) {
                    alert(response.message);
                }
                else{
                    $(`#divWorkOrder`).html(response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
                alert("An error occurred while getting Pallet ID.");
            }
        });
    }
</script>
