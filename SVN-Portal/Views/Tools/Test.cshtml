<style>
    .chart-container {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        width: 200px;
        height: 300px; /* Chiều cao tối đa của cột */
        border: 1px solid #ccc;
        background: linear-gradient(45deg, #e3e3e3, #f7f7f7); /* Hiệu ứng nền 3D */
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        position: relative;
    }

    .chart-bar {
        position: relative;
        width: 80px;
        height: 100%;
        background: linear-gradient(180deg, #cccccc, #888888); /* Hiệu ứng 3D */
        border: 1px solid #aaa;
        box-shadow: inset 0px -5px 10px rgba(0, 0, 0, 0.1);
    }

    .bar-fill {
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 0;
        background: linear-gradient(180deg, #00bfff, #007bff);
        border-radius: 2px;
        box-shadow: inset 0px -3px 7px rgba(0, 0, 0, 0.3);
        transition: height 1s ease-in-out; /* Hiệu ứng chuyển động */
    }

    .bar-label {
        position: absolute;
        bottom: 5px;
        width: 100%;
        text-align: center;
        font-size: 16px;
        color: #fff;
    }


</style>
<div class="chart-container">
    <div class="chart-bar">
        <div class="bar-fill" style="height: 0;"></div>
        <div class="bar-label">40%</div>
    </div>
</div>
<script>
        $(document).ready(function () {
      // Giá trị phần trăm
      var percentage = 40; // Giá trị label (40%)

      // Tính chiều cao cột dựa trên phần trăm
      var maxHeight = $(".chart-container").height(); // Chiều cao tối đa
      var barHeight = (percentage / 100) * maxHeight;

      // Cập nhật chiều cao cột với hiệu ứng
      $(".bar-fill").css({
        height: barHeight + "px"
      });

      // Hiển thị giá trị phần trăm trên label
      $(".bar-label").text(percentage + "%");
    });
</script>