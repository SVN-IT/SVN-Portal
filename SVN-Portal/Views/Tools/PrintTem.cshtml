@model List<PrintTemViewModel>
@{
    ViewData["Title"] = "In tem";
}
@* <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script> *@

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.18/css/bootstrap-select.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.18/js/bootstrap-select.min.js"></script>

<form method="post">
    <div class="row">
        <div class="row col-12">
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Chọn số dòng cần lấy</label>
                    <input type="number" name="countRows" class="form-control" value="@ViewBag.CountRows" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Chọn sản phẩm</label>
                    <select id="selectedProductID" class="form-control" name="selectedProductID" data-live-search="true" asp-items="@ViewBag.ProductList">
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group" style="margin-top:33px">
                    <button class="btn btn-success" type="submit"><i class="fa fa-filter"></i> Tìm kiếm</button>
                </div>
            </div>
        </div>
        <div class="row col-12">
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Số lượng bản</label>
                    <input type="number" name="copies" class="form-control" value="1" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group" style="margin-top:33px">
                    <button class="btn btn-primary" type="submit" asp-action="Print"><i class="fa fa-print"></i> In</button>
                </div>
            </div>
        </div>
        <div class="col-12">
            <table class="table">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">No</th>
                        <th scope="col">Tên sản phẩm</th>
                        <th scope="col">Mã Lot</th>
                        <th scope="col">Số lượng đã sản xuất</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count() > 0)
                    {
                        for (int i = 0; i < Model.Count(); i++)
                        {
                            <tr>
                                @{
                                    int no = i + 1;
                                }
                                <th scope="row">@no</th>
                                <td>
                                    @Model[i].item_name
                                    <input type="hidden" asp-for="@Model[i].item_name" />
                                </td>
                                <td>
                                    @Model[i].lot_code
                                    <input type="hidden" asp-for="@Model[i].lot_code" />
                                </td>
                                <td>
                                    @Model[i].product_qty
                                    <input type="hidden" asp-for="@Model[i].product_qty" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">Không có dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>
<script>
    // $(document).ready(function () {
    //     $('#selectedProductID').select2({
    //         placeholder: "Select an option",
    //         allowClear: true
    //     });
    // });
    $(document).ready(function() {
        $('#selectedProductID').selectpicker();
    });
</script>