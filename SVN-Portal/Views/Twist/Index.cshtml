@{
    ViewData["Title"] = "Tem hộp hàng thường";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6" style="color:black">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Tem hộp hàng thường</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="woInput" class="form-label">Nhập WO code</label>
                        <div class="input-group">
                            <input id="woInput" type="text" class="form-control" autocomplete="off" placeholder="Nhập WO code...">
                            <button id="btnGetWO" class="btn btn-primary" type="button">Lấy thông tin WO</button>
                        </div>
                    </div>
                    <div id="woInfo" style="display:none;">
                        <div class="mb-2">
                            <span class="fw-bold">Mã sản phẩm:</span> <span id="productCode"></span>
                        </div>
                        <div class="mb-2">
                            <span class="fw-bold">Số PCS/hộp:</span> <span id="pcsPerBox"></span>
                        </div>
                        <div class="mb-2">
                            <span class="fw-bold">Tiến độ:</span> <span id="progress"></span>
                        </div>
                        <div class="mb-3">
                            <label for="pcsInput" class="form-label">Nhập mã PCS</label>
                            <div class="input-group">
                                <input id="pcsInput" type="text" class="form-control" autocomplete="off" placeholder="Nhập mã PCS...">
                                <button id="btnAddPCS" class="btn btn-success" type="button">Nhập PCS</button>
                            </div>
                        </div>
                        <ul id="pcsList" class="list-group mb-3"></ul>
                        <button id="btnPrint" class="btn btn-warning w-100" style="display:none;">In tem &amp; Nhập kết quả</button>
                    </div>
                    <div id="message" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pcsList = [];
        let pcsPerBox = 0;
        let productCode = "";
        let woCode = "";

        $('#btnGetWO').click(function() {
            woCode = $('#woInput').val().trim();
            if (!woCode) return;
            $.get('/Twist/GetWOInfo', { wo: woCode }, function(data) {
                if (data.error) {
                    showMessage(data.error, "danger");
                    return;
                }
                productCode = data.productCode;
                $('#productCode').text(productCode);
                // Lấy số PCS/hộp
                $.get('/Twist/GetPcsPerBox', { productCode: productCode }, function(res) {
                    if (res.error) {
                        showMessage(res.error, "danger");
                        return;
                    }
                    pcsPerBox = res.pcsPerBox;
                    $('#pcsPerBox').text(pcsPerBox);
                    pcsList = [];
                    updateProgress();
                    $('#pcsList').empty();
                    $('#woInfo').slideDown();
                    $('#pcsInput').focus();
                    showMessage('');
                    $('#btnPrint').hide();
                });
            });
        });

        $('#btnAddPCS').click(function() {
            let pcs = $('#pcsInput').val().trim();
            if (!pcs) return;
            // if (pcsList.includes(pcs)) {
            //     showMessage("PCS đã nhập!", "warning");
            //     $('#pcsInput').val('');
            //     return;
            // }
            pcsList.push(pcs);
            $('#pcsList').append('<li class="list-group-item">' + pcs + '</li>');
            updateProgress();
            $('#pcsInput').val('');
            showMessage('');
            if (pcsList.length === pcsPerBox) {
                $('#btnPrint').show();
            }
        });

        $('#btnPrint').click(function() {
            $.ajax({
                url: '/Twist/PrintLabel',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ wo: woCode, pcsList: pcsList }),
                success: function(res) {
                    if (res.success) {
                        // Gọi nhập kết quả sản xuất
                        $.ajax({
                            url: '/Twist/SubmitProduction',
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ wo: woCode, pcsList: pcsList }),
                            success: function(res2) {
                                if (res2.success) {
                                    showMessage("Thành công! Đã nhập kết quả sản xuất.", "success");
                                    resetAll();
                                } else {
                                    showMessage("Báo lỗi: Nhập kết quả sản xuất thất bại!", "danger");
                                }
                            }
                        });
                    } else {
                        showMessage("Báo lỗi: In tem thất bại!", "danger");
                    }
                }
            });
        });

        function updateProgress() {
            $('#progress').text(pcsList.length + '/' + pcsPerBox);
        }
        function showMessage(msg, type) {
            if (!msg) { $('#message').html(''); return; }
            let alertType = type || "info";
            $('#message').html('<div class="alert alert-' + alertType + '">' + msg + '</div>');
        }
        function resetAll() {
            $('#woInput').val('');
            $('#woInfo').hide();
            pcsList = [];
            pcsPerBox = 0;
            productCode = "";
            woCode = "";
            $('#btnPrint').hide();
            $('#pcsList').empty();
            updateProgress();
        }
    </script>
}
