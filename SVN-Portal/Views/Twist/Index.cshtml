@{
    ViewData["Title"] = "Tem hộp hàng thường";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- CSS Select2 & Theme Dark -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    body {
        background: #1a2740;
    }

    .main-card {
        background: #22335a;
        border-radius: 18px;
        box-shadow: 0 0 24px #0004;
    }

    .wo-input {
        font-size: 2.2rem;
        height: 3.5rem;
    }

    .wo-btn {
        font-size: 2rem;
    }

    .wo-info {
        color: #fff;
        font-size: 1.3rem;
    }

    .scan-input {
        font-size: 2rem;
        height: 3.5rem;
    }

    .scan-label {
        color: #fff;
        font-size: 1.3rem;
    }

    .side-card {
        background: #22335a;
        border-radius: 18px;
        color: #fff;
        min-height: 120px;
    }

        .side-card.success {
            border: 3px solid #28a745;
        }

        .side-card.error {
            border: 3px solid #dc3545;
        }

    .side-title {
        font-size: 1.2rem;
        color: #8ecfff;
    }

    .side-value {
        font-size: 2.5rem;
        font-weight: bold;
    }

    .side-value-small {
        font-size: 1.5rem;
    }

    .pcs-list {
        color: #fff;
        font-size: 1.1rem;
    }

    .animate-flash {
        animation: flash 3s linear;
    }

    @@keyframes flash {
        0% {
            box-shadow: 0 0 0 0 #28a745;
        }

        50% {
            box-shadow: 0 0 40px 10px #28a745;
        }

        100% {
            box-shadow: 0 0 0 0 #28a745;
        }
    }

    .animate-flash-error {
        animation: flash-error 3s linear;
    }

    @@keyframes flash-error {
        0% {
            box-shadow: 0 0 0 0 #dc3545;
        }

        50% {
            box-shadow: 0 0 40px 10px #dc3545;
        }

        100% {
            box-shadow: 0 0 0 0 #dc3545;
        }
    }

    /* ============================================================
       BLOCK OVERLAY — Quét sai mã sản phẩm
    ============================================================ */
    #blockOverlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        z-index: 9999;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(10, 0, 0, 0.92);
        backdrop-filter: blur(4px);
    }

    .block-center-card {
        background: #1c1c1e;
        border: 1px solid #ff4444;
        border-radius: 16px;
        padding: 2rem 2.5rem;
        max-width: 440px;
        width: 90%;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    }

    .block-icon {
        font-size: 3rem;
        display: block;
        margin-bottom: 0.75rem;
    }

    .block-header-bar {
        color: #ff4444;
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .block-msg-main {
        font-size: 1.1rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 1rem;
        line-height: 1.4;
    }

    .block-divider {
        border: none;
        border-top: 1px solid #444;
        margin: 1rem 0;
    }

    .block-msg-sub {
        font-size: 0.95rem;
        color: #aaaaaa;
        margin-bottom: 1.5rem;
        line-height: 1.4;
    }

    .block-pwd-box {
        text-align: center;
    }

    .block-pwd-label {
        font-size: 0.9rem;
        color: #cccccc;
        margin-bottom: 0.6rem;
    }

    #blockPasswordInput {
        background: #1e1e1e !important;
        color: #fff !important;
        border: 1px solid #555 !important;
        font-size: 1.2rem !important;
        text-align: center;
        letter-spacing: 0.15em;
    }

    #blockPasswordInput:focus {
        box-shadow: 0 0 0 3px #ff444466 !important;
    }

    #blockPasswordError {
        color: #ff9999;
        font-size: 1.05rem;
        margin-top: 0.5rem;
    }

    #btnBlockConfirm {
        font-size: 1.4rem;
        font-weight: bold;
        letter-spacing: 0.05em;
        padding: 0.6rem 2rem;
    }

    /* Fix giao diện Dark mode cho Select2 */
    .select2-container--bootstrap-5 .select2-selection {
        background-color: #212529 !important;
        color: #fff !important;
        border-color: #495057 !important;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        color: #fff !important;
    }

    .select2-dropdown {
        background-color: #212529 !important;
        color: #fff !important;
        border-color: #495057 !important;
    }

    .select2-search__field {
        background-color: #343a40 !important;
        color: #fff !important;
    }
    /* supervisorConfirmModal phải hiện trên blockOverlay (z-index 9999) */
    #supervisorConfirmModal { z-index: 10001 !important; }
</style>

<div class="container-fluid py-4">
    <div class="row g-4">
        <!-- Cột trái: Nhập WO, thông tin WO, scan PCS -->
        <div class="col-xxl-8 col-xl-8 col-lg-7">
            <div class="main-card p-4">
                <!-- Nhập WO -->
                <div class="mb-3 d-flex align-items-center">
                    <input id="woInput" type="text" class="form-control wo-input me-3" placeholder="Nhập WO code..." autocomplete="off" />
                    <button id="btnGetWO" class="btn btn-primary wo-btn px-4">Go</button>
                </div>
                <!-- Thông tin WO -->
                <div id="woInfo" class="wo-info mb-3" style="display:none;">
                    <div class="mb-2">
                        <div class="form-group">
                            <span class="fw-bold">WO:</span> <span id="woCode"></span>
                        </div>
                        <div class="form-group">
                            <span class="fw-bold">Mã sản phẩm:</span> <span id="productCode"></span>
                        </div>
                        <div class="form-group">
                            <span class="fw-bold">Tên sản phẩm:</span> <span id="productName"></span>
                        </div>
                        <div class="form-group d-none" id="poInfoRow">
                            <span class="fw-bold">Mã PO:</span> <span id="poInfoVal"></span>
                        </div>
                    </div>
                    <div class="mb-2 d-none">
                        <span class="fw-bold">Ngày tạo:</span> <span id="woDate"></span>
                        <span class="fw-bold">product_id</span> <span id="product_id"></span>
                        <span class="fw-bold ms-4">Khách hàng:</span> <span id="customer"></span>
                    </div>
                </div>
                <!-- Danh sách PCS đã scan -->
                <div id="pcsList" class="pcs-list mb-3"></div>
                <!-- Scan PCS -->
                <div class="mb-2">
                    <label for="pcsInput" class="scan-label mb-1">Mã sản phẩm quét</label>
                    <div class="input-group input-group-lg">
                        <input id="pcsInput" type="text" class="form-control scan-input" autocomplete="off" placeholder="Scan mã..." />
                        <button id="btnAddPCS" class="btn btn-success wo-btn" type="button">Scan</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Cột phải: Thông tin đóng gói, thông báo, tiến độ -->
        <div class="col-xxl-4 col-xl-4 col-lg-5">
            <div class="d-flex flex-column gap-4">
                <!-- Thông báo trạng thái -->
                <div id="statusCard" class="side-card p-3 text-center">
                    <div class="side-title mb-2">Trạng thái</div>
                    <div id="statusIcon" style="font-size:3rem;">🛈</div>
                    <div id="statusMsg" class="side-value-small mt-2"></div>
                </div>
                <!-- Thông tin SKU, PCS, Total -->
                <div class="side-card p-3">
                    <div class="side-title mb-2">Thông tin đóng gói</div>
                    <div>SKU: <span id="sku" class="side-value-small"></span></div>
                    <div>PCS: <span id="pcsCount" class="side-value"></span></div>
                    <div>Total: <span id="totalCount" class="side-value-small"></span></div>
                </div>
                <!-- Số lượng PCS/hộp -->
                <div class="side-card p-3">
                    <div class="side-title mb-2">Số lượng đóng gói</div>
                    <div id="pcsPerBox" class="side-value">0/0</div>
                </div>
                <!-- Số lượng hoàn thành / tổng số -->
                <div class="side-card p-3">
                    <div class="side-title mb-2">Số lượng hoàn thành / Tổng số</div>
                    <div id="progress" class="side-value">0/0</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Nhập mật khẩu (Dùng chung cho cả phím 1 và phím 3) -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Xác thực quyền thao tác</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="cfgPasswordInput" class="form-label">Nhập mật khẩu:</label>
                    <input type="password" id="cfgPasswordInput" class="form-control" placeholder="Mật khẩu..." />
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnConfirmPassword" class="btn btn-primary">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Popup In Lại Tem (Bấm phím 1 + đúng Pass) -->
<div class="modal fade" id="reprintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">In Lại Tem (Reprint)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="reprintProductSelect" class="form-label fw-bold text-info">Mã sản phẩm (Product Code):</label>
                    <select id="reprintProductSelect" class="form-select" style="width: 100%;">
                        <option value="">-- Chọn hoặc gõ tìm mã --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="reprintPrinterSelect" class="form-label fw-bold text-info">Chọn Máy in:</label>
                    <select id="reprintPrinterSelect" class="form-select">
                        <option value="">-- Chọn máy in --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="reprintLabelType" class="form-label fw-bold text-info">Loại tem:</label>
                    <select id="reprintLabelType" class="form-select">
                        <option value="Box">Box</option>
                        <option value="Carton">Carton</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="reprintQuantity" class="form-label fw-bold text-info">Số lượng bản in:</label>
                    <input type="number" id="reprintQuantity" class="form-control" value="1" min="1" />
                </div>
                <div class="mb-3 d-none" id="reprintPORow">
                    <label class="form-label fw-bold text-warning">Số PO (EMEA):</label>
                    <input type="text" id="reprintPOInput" class="form-control" placeholder="Nhập số PO..." />
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" id="btnDoReprint" class="btn btn-primary">Thực hiện In</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: Cấu hình Máy in (Bấm phím 3 + đúng Pass) -->
<div class="modal fade" id="printerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Cấu hình Máy in</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="printerSelect" class="form-label fw-bold text-info">Chọn Máy in:</label>
                    <select id="printerSelect" class="form-select">
                        <option value="">-- Chọn máy in --</option>
                    </select>
                </div>
                <hr class="border-secondary" />
                <form id="printerForm" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">ID Printer</label>
                        <input type="text" id="p_ID" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên Máy in</label>
                        <input type="text" id="p_Name" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">IP Address</label>
                        <input type="text" id="p_IP" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none">
                        <label class="form-label">MAC Address</label>
                        <input type="text" id="p_MAC" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none">
                        <label class="form-label">Port</label>
                        <input type="text" id="p_Port" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none">
                        <label class="form-label">Kích thước (Size)</label>
                        <select id="p_Size" class="form-select">
                            <option value="3x3">3x3</option>
                            <option value="4x6">4x6</option>
                            <option value="4x8">4x8</option>
                        </select>
                    </div>
                    <div class="col-md-12 d-none">
                        <label class="form-label">Loại (Type)</label>
                        <input type="text" id="p_Type" class="form-control" />
                    </div>
                    <div class="col-md-12 d-none">
                        <label class="form-label">ZPL Template</label>
                        <textarea id="p_ZPL" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-12 d-none">
                        <label class="form-label">DPL Template</label>
                        <textarea id="p_DPL" class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" id="btnSavePrinter" class="btn btn-success">Lưu cấu hình</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     BLOCK OVERLAY — Quét sai mã sản phẩm
============================================================ -->
<div id="blockOverlay">
    <div class="block-center-card">
        <span class="block-icon">⛔</span>
        <div class="block-header-bar">CẢNH BÁO SAI MÃ, VUI LÒNG DỪNG THAO TÁC VÀ MÁY QUÉT</div>
        <div id="blockErrorMsg" class="block-msg-main"></div>
        <hr class="block-divider" />
        <div class="block-msg-sub">Vui lòng báo cáo với Tổ trưởng để xác nhận trước khi tiếp tục.</div>
        <div class="block-pwd-box">
            <div class="block-pwd-label">Tổ trưởng nhập mật khẩu xác nhận</div>
            <input type="password" id="blockPasswordInput" class="form-control form-control-lg mb-2"
                   placeholder="Mật khẩu..." autocomplete="off" />
            <div id="blockPasswordError" class="text-danger small mt-1 d-none">Mật khẩu không đúng, vui lòng thử lại!</div>
            <button id="btnBlockConfirm" class="btn btn-danger w-100 mt-2">Xác nhận</button>
        </div>
    </div>
</div>

<!-- Modal xác nhận của Tổ trưởng (hiện sau khi nhập đúng mật khẩu) -->
<div class="modal fade" id="supervisorConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index:10001;">
    <div class="modal-dialog modal-dialog-centered" style="max-width:360px;">
        <div class="modal-content border-0" style="border-radius:20px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.4);">
            <!-- Header màu xanh dịu -->
            <div style="background:linear-gradient(135deg,#1e88e5,#1565c0); padding:1.5rem 1.5rem 1rem; text-align:center;">
                <div style="width:56px;height:56px;background:rgba(255,255,255,0.2);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                    <span style="font-size:1.8rem;line-height:1;">🔐</span>
                </div>
                <h5 style="color:#fff;font-weight:700;margin:0;font-size:1.1rem;letter-spacing:0.02em;">Xác nhận của Tổ trưởng</h5>
            </div>
            <!-- Body -->
            <div style="background:#fff;padding:1.5rem;text-align:center;">
                <p style="color:#555;font-size:1rem;margin:0;">Tổ trưởng có xác nhận cho phép tiếp tục không?</p>
            </div>
            <!-- Footer -->
            <div style="background:#f8f9fa;padding:1rem 1.5rem;display:flex;gap:0.75rem;justify-content:center;border-top:1px solid #eee;">
                <button id="btnSupervisorNo" class="btn" style="flex:1;border-radius:10px;font-weight:600;font-size:1rem;padding:0.6rem;background:#fff;border:2px solid #dee2e6;color:#6c757d;">
                    Không
                </button>
                <button id="btnSupervisorYes" class="btn" style="flex:1;border-radius:10px;font-weight:700;font-size:1rem;padding:0.6rem;background:linear-gradient(135deg,#28a745,#1e7e34);border:none;color:#fff;box-shadow:0 4px 12px rgba(40,167,69,0.35);">
                    Có, xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 4: Quản lý PO - Sản phẩm EU (Numlock 3 + đúng Pass) -->
<div class="modal fade" id="euPOModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">&#127466;&#127482; Quản lý PO — Sản phẩm EU</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="euSearchInput" class="form-control" placeholder="&#128269; Tìm theo mã hoặc SKU..." autocomplete="off" />
                </div>
                <div id="euPOList"></div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 5: Xác nhận sản phẩm EU khi lookup WO -->
<div class="modal fade" id="euConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content border-0" style="border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
            <div style="background:linear-gradient(135deg,#0d47a1,#1565c0);padding:1.5rem 1.5rem 1rem;text-align:center;">
                <div style="font-size:2.5rem;margin-bottom:0.4rem;">&#127466;&#127482;</div>
                <h5 style="color:#fff;font-weight:700;margin:0;font-size:1.1rem;letter-spacing:0.02em;">Sản phẩm thị trường EU</h5>
            </div>
            <div style="background:#1e2d4a;padding:1.5rem 1.5rem 0.75rem;text-align:center;">
                <div style="font-size:1.4rem;color:#8ecfff;font-weight:700;" id="euConfirmCode"></div>
                <div style="font-size:1rem;color:#ccc;margin-top:0.2rem;" id="euConfirmSku"></div>
                <hr style="border-color:#3a4f7a;margin:1rem 0;" />
                <div style="margin-bottom:0.75rem;">
                    <div style="font-size:0.85rem;color:#8ecfff;margin-bottom:0.2rem;">PO</div>
                    <div id="euConfirmPODisplayRow" class="d-flex align-items-center justify-content-center gap-2">
                        <div id="euConfirmPOVal" style="font-size:1.8rem;font-weight:bold;color:#fff;"></div>
                        <button id="btnEUEditPO" class="btn btn-sm btn-outline-info" style="border-radius:8px;">Sửa PO</button>
                    </div>
                    <div id="euConfirmPOInputBlock" class="d-none">
                        <div id="euConfirmPOEmptyWarn" style="color:#ffc107;font-size:0.85rem;margin-bottom:0.4rem;">&#9888; Chưa có PO — vui lòng nhập để tiếp tục</div>
                        <input type="text" id="euConfirmPOInput" class="form-control text-center fw-bold"
                               placeholder="Nhập số PO..."
                               style="font-size:1.3rem;background:#2a3f6a;color:#fff;border-color:#3a5a9a;border-radius:8px;" />
                    </div>
                </div>
            </div>
            <div style="background:#1e2d4a;padding:1rem 1.5rem 1.25rem;display:flex;gap:0.75rem;justify-content:center;border-top:1px solid #2a3f6a;">
                <button id="btnEUConfirmCancel" class="btn btn-secondary" style="flex:1;max-width:160px;border-radius:10px;font-weight:600;">Hủy</button>
                <button id="btnEUConfirmOK" class="btn btn-success fw-bold" style="flex:1;max-width:200px;border-radius:10px;font-size:1rem;">Xác nhận bắt đầu quét</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // State — restore từ sessionStorage (tồn tại trong tab, xoá khi đóng tab)
        const _st = JSON.parse(sessionStorage.getItem('twist_wo_state') || '{}');
        let pcsList = [];
        let pcsPerBox = _st.pcsPerBox || 0;
        let productCode = _st.productCode || "";
        let productName = _st.productName || "";
        let woCode = _st.woCode || "";
        let totalCount = _st.totalCount || 0;
        let completedCount = _st.completedCount || 0;
        let sku = _st.sku || "";
        let currentEUPoNumber = _st.euPoNumber || "";
        let isEUProduct = _st.isEUProduct || false;
        let euSkuName = _st.euSkuName || "";
        let euConfirmed = false; // reset mỗi lần load tab mới

        function saveState() {
            sessionStorage.setItem('twist_wo_state', JSON.stringify({
                woCode, productCode, productName, totalCount, completedCount, pcsPerBox, sku,
                productId: $('#product_id').text().trim(),
                woDate: $('#woDate').text().trim(),
                customer: $('#customer').text().trim(),
                isBlocked: $('#blockOverlay').css('display') !== 'none',
                blockMsg: $('#blockErrorMsg').text(),
                euPoNumber: currentEUPoNumber,
                isEUProduct: isEUProduct,
                euSkuName: euSkuName
            }));
        }

        // Restore UI nếu có state
        if (woCode) {
            $('#woInput').val(woCode);
            $('#woCode').text(woCode);
            $('#productCode').text(productCode);
            $('#productName').text(productName);
            $('#woDate').text(_st.woDate || '');
            $('#customer').text(_st.customer || '');
            $('#sku').text(sku);
            $('#totalCount').text(totalCount);
            $('#product_id').text(_st.productId || '');
            updatePcsList();
            updatePcsPerBox();
            updateProgress();
            $('#woInfo').show();
            if (isEUProduct && currentEUPoNumber) {
                euConfirmed = true;
                showPOInfoRow(currentEUPoNumber);
            }
            if (_st.isBlocked) {
                showBlockScreen(_st.blockMsg || 'Máy đang bị khoá, vui lòng liên hệ Tổ trưởng.');
            } else {
                showStatus('Đã khôi phục WO: ' + woCode, true);
            }
        }

        // Nhập WO
        $('#btnGetWO').click(function() {
            woCode = $('#woInput').val().trim();
            if (!woCode) return;
            if (!woCode.includes('NM/MO/')) woCode = 'NM/MO/' + woCode;
            $('#woInput').val(woCode);
            // Lấy thông tin WO
            $.get('/Twist/GetWOInfo', { wo: woCode }, function(data) {
                if (data.error) {
                    showStatus(data.error, false);
                    return;
                }
                productCode = data.productCode;
                productName = data.productName || '';
                totalCount = data.quantity || 0;
                sku = productCode;
                completedCount = 0;
                $('#woCode').text(data.woCode);
                $('#productCode').text(productCode);
                $('#productName').text(productName);
                $('#woDate').text(data.date || '');
                $('#customer').text(data.customer || '');
                $('#sku').text(sku);
                $('#totalCount').text(totalCount);

                $('#product_id').text(data.product_id);

                $('#woInfo').show();
                // Lấy số PCS/hộp
                $.get('/Twist/GetPcsPerBox', { productCode: productCode }, function(res) {
                    if (res.error) {
                        showStatus(res.error, false);
                        return;
                    }
                    pcsPerBox = res.pcsPerBox;
                    isEUProduct = res.isEU || false;
                    euSkuName = res.skuName || "";
                    currentEUPoNumber = res.poNumber || "";
                    pcsList = [];
                    updatePcsList();
                    updatePcsPerBox();
                    updateProgress();
                    saveState();
                    if (isEUProduct) {
                        euConfirmed = false;
                        showEUConfirmModal(productCode, euSkuName, currentEUPoNumber);
                    } else {
                        $('#pcsInput').focus();
                        showStatus('Sẵn sàng scan PCS', true);
                    }
                });
            });
        });

        // Scan PCS
        $('#btnAddPCS').click(function() {
            if (isEUProduct && !euConfirmed) {
                showStatus('Vui lòng xác nhận PO EU trước khi quét!', false);
                $('#pcsInput').val('');
                return;
            }
            if (completedCount >= totalCount) {
                showStatus('Đã hoàn thành WO', false);
                $('#pcsInput').val('');
                return;
            }

            let pcs = $('#pcsInput').val().trim();
            if (!pcs) return;

            if (!productCode) {
                showStatus('Vui lòng chọn WO trước khi scan PCS!', false);
                return;
            }

            $.get('/Twist/ValidatePcs', { productCode: productCode, pcs: pcs }, function(res) {
                if (res.isValid) {
                    pcsList.push(pcs);
                    updatePcsList();
                    updatePcsPerBox();
                    $('#pcsInput').val('');
                    showStatus('Scan thành công', true);

                    if (pcsList.length === pcsPerBox) {
                        printLabel();
                    }
                } else {
                    $('#pcsInput').val('');
                    if (res.isMismatch) {
                        showBlockScreen(res.error);
                    } else {
                        showStatus(res.error, false);
                    }
                }
            }).fail(function() {
                showStatus('Lỗi kết nối máy chủ!', false);
            });
        });

        // Enter để trigger nút
        $('#woInput').keypress(function(e) { if (e.which === 13) $('#btnGetWO').click(); });
        $('#pcsInput').keypress(function(e) { if (e.which === 13) $('#btnAddPCS').click(); });

        function updatePcsList() {
            let html = '';
            pcsList.forEach((pcs, idx) => {
                html += `<span class="badge bg-info me-2 mb-2" style="font-size:1.3rem;">${pcs}</span>`;
            });
            $('#pcsList').html(html);
        }
        function updatePcsPerBox() {
            $('#pcsPerBox').text(`${pcsList.length}/${pcsPerBox}`);
            $('#pcsCount').text(`${pcsList.length}/${pcsPerBox}`);
        }
        function updateProgress() {
            $('#progress').text(`${completedCount}/${totalCount}`);
        }
        function showStatus(msg, isSuccess) {
            let card = $('#statusCard');
            let icon = isSuccess ? '✔️' : '❌';
            let flashClass = isSuccess ? 'animate-flash' : 'animate-flash-error';
            card.removeClass('success error animate-flash animate-flash-error');
            card.addClass(isSuccess ? 'success' : 'error');
            card.addClass(flashClass);
            $('#statusIcon').text(icon);
            $('#statusMsg').text(msg);
            setTimeout(() => {
                card.removeClass(flashClass);
            }, 3000);
        }
        const supervisorModal = new bootstrap.Modal(document.getElementById('supervisorConfirmModal'), { backdrop: false });

        function showBlockScreen(errorMsg) {
            $('#blockErrorMsg').text(errorMsg);
            $('#blockPasswordInput').val('');
            $('#blockPasswordError').addClass('d-none');
            $('#blockOverlay').css('display', 'flex');
            setTimeout(() => $('#blockPasswordInput').focus(), 150);
            saveState();
        }

        function hideBlockScreen() {
            $('#blockOverlay').css('display', 'none');
            saveState();
        }

        // Bước 1: Kiểm tra mật khẩu
        $('#btnBlockConfirm').click(function() {
            let pwd = $('#blockPasswordInput').val();
            if (pwd === CONFIG_PASSWORD) {
                $('#blockPasswordError').addClass('d-none');
                // Mở modal xác nhận Có/Không
                supervisorModal.show();
            } else {
                $('#blockPasswordError').removeClass('d-none');
                $('#blockPasswordInput').val('').focus();
            }
        });

        $('#blockPasswordInput').keypress(function(e) {
            if (e.which === 13) $('#btnBlockConfirm').click();
        });

        // Bước 2a: Tổ trưởng chọn "Có" → ẩn overlay, clear ô scan, cho quét tiếp
        $('#btnSupervisorYes').click(function() {
            supervisorModal.hide();
            hideBlockScreen();
            $('#pcsInput').val('').focus();
        });

        // Bước 2b: Tổ trưởng chọn "Không" → đóng modal, giữ nguyên overlay, xoá pass
        $('#btnSupervisorNo').click(function() {
            supervisorModal.hide();
            $('#blockPasswordInput').val('');
            setTimeout(() => $('#blockPasswordInput').focus(), 300);
        });

        function printLabel() {
            // Copy batch hiện tại và reset pcsList ngay — scan mới sẽ vào batch tiếp theo
            const batch = [...pcsList];
            pcsList = [];
            updatePcsList();
            updatePcsPerBox();

            let savedPrinter = localStorage.getItem('selected_printer_config');
            let printerConfig = savedPrinter ? JSON.parse(savedPrinter) : null;
            let productId = $('#product_id').text().trim();

            $.ajax({
                url: '/Twist/PrintLabel',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ productCode: productCode, woCode: woCode, productId: parseInt(productId), printQty: batch.length, printerConfig: printerConfig, poNumber: currentEUPoNumber }),
                success: function(res) {
                    if (res.success) {
                        $.ajax({
                            url: '/Twist/SubmitProduction',
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ wo: woCode, productQty: batch.length, productId: productId }),
                            success: function(res2) {
                                if (res2.success) {
                                    completedCount += batch.length;
                                    updateProgress();
                                    saveState();
                                    showStatus("Thành công! Đã nhập kết quả sản xuất.", true);
                                } else {
                                    showStatus(res2.error, false);
                                }
                            }
                        });
                    } else {
                        showStatus(res.error, false);
                    }
                },
                error: function() {
                    showStatus('Lỗi kết nối máy chủ!', false);
                }
            });
        }

        // =============================================================
        // PHÂN QUYỀN VÀ CẤU HÌNH POPUPS (PHÍM 1 VÀ PHÍM 3)
        // =============================================================
        const CONFIG_PASSWORD = "123";
        let printerList = [];
        let currentAuthAction = null; // Đánh dấu 'reprint' hoặc 'config'

        // Khởi tạo Bootstrap Modals
        const pwdModal = new bootstrap.Modal(document.getElementById('passwordModal'));
        const prtModal = new bootstrap.Modal(document.getElementById('printerModal'));
        const rprModal = new bootstrap.Modal(document.getElementById('reprintModal'));
        const euPOMod = new bootstrap.Modal(document.getElementById('euPOModal'));
        const euConfirmMod = new bootstrap.Modal(document.getElementById('euConfirmModal'), { backdrop: 'static', keyboard: false });

        // Lắng nghe phím bấm 1 và 3
        $(document).keydown(function(e) {
            if ($(e.target).is('input, textarea, select')) return;
            if ($('.modal.show').length > 0) return; // Không trigger khi modal đang mở

            // Phím "1" -> Mở Modal Mật khẩu để In Lại
            if (e.key === '1' || e.keyCode === 49 || e.keyCode === 97) {
                e.preventDefault();
                currentAuthAction = 'reprint';
                openPasswordModal();
            }

            // Phím "3" (regular) -> Cấu hình Máy in
            if (e.keyCode === 51) {
                e.preventDefault();
                currentAuthAction = 'config';
                openPasswordModal();
            }

            // Numpad "3" (Numlock 3) -> Quản lý PO EU (cần password)
            if (e.keyCode === 99) {
                e.preventDefault();
                currentAuthAction = 'eu_po';
                openPasswordModal();
            }
        });

        function openPasswordModal() {
            $('#cfgPasswordInput').val('');
            pwdModal.show();
        }

        document.getElementById('passwordModal').addEventListener('shown.bs.modal', function () {
            document.getElementById('cfgPasswordInput').focus();
        });

        // Xác thực Mật khẩu dùng chung
        $('#btnConfirmPassword').click(function() {
            let pwd = $('#cfgPasswordInput').val();
            if (pwd === CONFIG_PASSWORD) {
                let action = currentAuthAction;
                pwdModal.hide();
                setTimeout(function() {
                    if (action === 'reprint') {
                        openReprintModal();
                    } else if (action === 'config') {
                        loadAndOpenPrinterConfig();
                    } else if (action === 'eu_po') {
                        loadAndOpenEUPOModal();
                    }
                }, 350);
            } else {
                alert('Mật khẩu không chính xác!');
                $('#cfgPasswordInput').select();
            }
        });

        $('#cfgPasswordInput').keypress(function(e) {
            if (e.which === 13) $('#btnConfirmPassword').click();
        });

        // -------------------------------------------------------------
        // CÁC THAO TÁC POPUP IN LẠI TEM (REPRINT)
        // -------------------------------------------------------------
        function openReprintModal() {
            // Lấy danh sách Mã sản phẩm cho Select2
            $.get('/Twist/GetProductCodes', function(codes) {
                let pSelect = $('#reprintProductSelect');
                pSelect.empty().append('<option value="">-- Chọn hoặc gõ tìm mã --</option>');
                if (codes && codes.length > 0) {
                    codes.forEach(c => {
                        pSelect.append(`<option value="${c}">${c}</option>`);
                    });
                }
                pSelect.select2({
                    theme: 'bootstrap-5',
                    dropdownParent: $('#reprintModal')
                });
            });

            // Lấy danh sách Máy in
            $.get('/Twist/GetPrinters', function(data) {
                if (data && data.error) {
                    showStatus('Lỗi: ' + data.error, false);
                    return;
                }
                printerList = data || [];
                let prtSelect = $('#reprintPrinterSelect');
                prtSelect.empty().append('<option value="">-- Chọn máy in --</option>');

                printerList.forEach(p => {
                    prtSelect.append(`<option value="${p.iD_Printer}">${p.name_Printer} (${p.iP_Printer})</option>`);
                });

                // Khôi phục máy in đã chọn cho In lại từ LocalStorage riêng
                let savedReprintPrinter = localStorage.getItem('reprint_selected_printer_config');
                if (savedReprintPrinter) {
                    let localObj = JSON.parse(savedReprintPrinter);
                    prtSelect.val(localObj.iD_Printer);
                }
            });

            rprModal.show();
        }

        // Khi chọn mã sản phẩm trong reprint modal, kiểm tra EMEA để hiện ô PO
        $('#reprintProductSelect').on('change', function() {
            let pCode = $(this).val();
            $('#reprintPORow').addClass('d-none');
            $('#reprintPOInput').val('');
            if (!pCode) return;
            $.get('/Twist/GetPcsPerBox', { productCode: pCode }, function(res) {
                if (res && res.isEU) {
                    $('#reprintPOInput').val(res.poNumber || '');
                    $('#reprintPORow').removeClass('d-none');
                }
            });
        });

        // Lưu thông tin máy in cho Reprint khi Select box thay đổi
        $('#reprintPrinterSelect').change(function() {
            let selectedId = $(this).val();
            if (!selectedId) {
                localStorage.removeItem('reprint_selected_printer_config');
                return;
            }
            let p = printerList.find(x => x.iD_Printer === selectedId);
            if (p) {
                let reprintConfig = {
                    iD_Printer: p.iD_Printer,
                    name_Printer: p.name_Printer,
                    iP_Printer: p.iP_Printer,
                    maC_Printer: p.maC_Printer,
                    port_Printer: p.port_Printer,
                    size: p.size,
                    type: p.type,
                    zpL_Temp: p.zpL_Temp,
                    dpL_Temp: p.dpL_Temp
                };
                localStorage.setItem('reprint_selected_printer_config', JSON.stringify(reprintConfig));
            }
        });

        // Thực hiện In lại
        $('#btnDoReprint').click(function() {
            let pCode = $('#reprintProductSelect').val();
            let printerId = $('#reprintPrinterSelect').val();
            let lType = $('#reprintLabelType').val();
            let qty = parseInt($('#reprintQuantity').val()) || 1;

            if (!pCode) {
                alert('Vui lòng chọn Mã sản phẩm!');
                return;
            }
            if (!printerId) {
                alert('Vui lòng chọn Máy in!');
                return;
            }

            let savedReprintPrinter = localStorage.getItem('reprint_selected_printer_config');
            let printerConfig = savedReprintPrinter ? JSON.parse(savedReprintPrinter) : null;

            let isEmeaRow = !$('#reprintPORow').hasClass('d-none');
            let requestData = {
                productCode: pCode,
                labelType: lType,
                printQty: qty,
                poNumber: isEmeaRow ? ($('#reprintPOInput').val() || '') : '',
                printerConfig: printerConfig
            };

            $.ajax({
                url: '/Twist/PrintLabelReprint',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                success: function(res) {
                    if (res.success) {
                        showStatus(`In lại thành công tem ${lType} cho ${pCode}!`, true);
                        rprModal.hide();
                    } else {
                        alert('Lỗi in tem: ' + res.error);
                    }
                },
                error: function(xhr, status, error) {
                    alert('Lỗi kết nối máy chủ: ' + error);
                }
            });
        });

        // -------------------------------------------------------------
        // CÁC THAO TÁC POPUP CẤU HÌNH MÁY IN
        // -------------------------------------------------------------
        function loadAndOpenPrinterConfig() {
            $.get('/Twist/GetPrinters', function(data) {
                if (data && data.error) {
                    showStatus('Báo lỗi: ' + data.error, false);
                    return;
                }

                printerList = data || [];
                let select = $('#printerSelect');
                select.empty().append('<option value="">-- Chọn máy in --</option>');

                printerList.forEach(p => {
                    select.append(`<option value="${p.iD_Printer}">${p.name_Printer} (${p.iP_Printer})</option>`);
                });

                let savedConfig = localStorage.getItem('selected_printer_config');
                if (savedConfig) {
                    let localObj = JSON.parse(savedConfig);
                    let selectedId = localObj.iD_Printer;
                    select.val(selectedId);

                    let currentPrinter = printerList.find(x => x.iD_Printer === selectedId);
                    if (currentPrinter) {
                        fillPrinterForm(currentPrinter);
                    } else {
                        fillPrinterForm(localObj);
                    }
                } else {
                    $('#printerForm')[0].reset();
                }

                prtModal.show();
            }).fail(function(xhr, status, error) {
                showStatus('Lỗi kết nối máy chủ khi lấy danh sách máy in!', false);
            });
        }

        $('#printerSelect').change(function() {
            let selectedId = $(this).val();

            if (!selectedId) {
                $('#printerForm')[0].reset();
                localStorage.removeItem('selected_printer_config');
                return;
            }

            let p = printerList.find(x => x.iD_Printer === selectedId);
            if (p) {
                fillPrinterForm(p);
                let selectedConfig = {
                    iD_Printer: p.iD_Printer,
                    name_Printer: p.name_Printer,
                    iP_Printer: p.iP_Printer,
                    maC_Printer: p.maC_Printer,
                    port_Printer: p.port_Printer,
                    size: p.size,
                    type: p.type,
                    zpL_Temp: p.zpL_Temp,
                    dpL_Temp: p.dpL_Temp
                };

                localStorage.setItem('selected_printer_config', JSON.stringify(selectedConfig));
                showStatus(`Đã chọn máy in: ${p.name_Printer}`, true);
            }
        });

        function fillPrinterForm(p) {
            $('#p_ID').val(p.iD_Printer || '');
            $('#p_Name').val(p.name_Printer || '');
            $('#p_IP').val(p.iP_Printer || '');
            $('#p_MAC').val(p.maC_Printer || '');
            $('#p_Port').val(p.port_Printer || '');
            $('#p_Size').val(p.size || '4x6');
            $('#p_Type').val(p.type || '');
            $('#p_ZPL').val(p.zpL_Temp || '');
            $('#p_DPL').val(p.dpL_Temp || '');
        }

        // =============================================================
        // EU PO MANAGEMENT (NUMLOCK 3)
        // =============================================================
        let euPOData = [];
        let euSearchVal = '';

        function loadAndOpenEUPOModal() {
            $.get('/Twist/GetEUCodes', function(data) {
                euPOData = data || [];
                euSearchVal = '';
                $('#euSearchInput').val('');
                renderEUPOList();
                euPOMod.show();
            }).fail(function() {
                showStatus('Lỗi khi tải danh sách mã EU!', false);
            });
        }

        function renderEUPOList() {
            let filtered = euSearchVal
                ? euPOData.filter(d => d.code.includes(euSearchVal) || d.skuName.toLowerCase().includes(euSearchVal.toLowerCase()))
                : euPOData;

            if (filtered.length === 0) {
                $('#euPOList').html('<div class="text-center text-secondary py-4">Không tìm thấy mã EU nào.</div>');
                return;
            }

            let html = '<table class="table table-dark table-hover table-sm mb-0"><thead><tr>'
                + '<th>Mã WO</th><th>SKU</th><th>PO</th><th></th></tr></thead><tbody>';
            filtered.forEach(d => {
                let poDisplay = d.poNumber ? `<span class="text-white fw-bold">${d.poNumber}</span>`
                    : '<span class="text-warning fst-italic">Chưa thiết lập</span>';
                html += `<tr data-code="${d.code}">
                    <td class="align-middle" style="color:#8ecfff;font-weight:bold;">${d.code}</td>
                    <td class="align-middle">${d.skuName}</td>
                    <td class="align-middle">
                        <span class="eu-po-display">${poDisplay}</span>
                        <input type="text" class="form-control form-control-sm eu-po-edit d-none" value="${d.poNumber || ''}" placeholder="Nhập số PO..." style="max-width:180px;" />
                    </td>
                    <td class="align-middle" style="white-space:nowrap;">
                        <button class="btn btn-sm btn-outline-info btn-eu-edit">Sửa</button>
                        <button class="btn btn-sm btn-success btn-eu-save d-none ms-1">Lưu</button>
                        <button class="btn btn-sm btn-secondary btn-eu-cancel d-none ms-1">Hủy</button>
                    </td>
                </tr>`;
            });
            html += '</tbody></table>';
            $('#euPOList').html(html);
        }

        $('#euSearchInput').on('input', function() {
            euSearchVal = $(this).val().trim();
            renderEUPOList();
        });

        $('#euPOList').on('click', '.btn-eu-edit', function() {
            let row = $(this).closest('tr');
            row.find('.eu-po-display').addClass('d-none');
            row.find('.eu-po-edit').removeClass('d-none').focus().select();
            $(this).addClass('d-none');
            row.find('.btn-eu-save, .btn-eu-cancel').removeClass('d-none');
        });

        $('#euPOList').on('keypress', '.eu-po-edit', function(e) {
            if (e.which === 13) $(this).closest('tr').find('.btn-eu-save').click();
        });

        $('#euPOList').on('click', '.btn-eu-save', function() {
            let row = $(this).closest('tr');
            let code = row.data('code');
            let po = row.find('.eu-po-edit').val().trim();

            $.ajax({
                url: '/Twist/SaveEUPO',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ code: code, poNumber: po }),
                success: function(res) {
                    if (res.success) {
                        let item = euPOData.find(x => x.code === code);
                        if (item) item.poNumber = po;
                        let poDisplay = po ? `<span class="text-white fw-bold">${po}</span>`
                            : '<span class="text-warning fst-italic">Chưa thiết lập</span>';
                        row.find('.eu-po-display').html(poDisplay).removeClass('d-none');
                        row.find('.eu-po-edit').addClass('d-none');
                        row.find('.btn-eu-save, .btn-eu-cancel').addClass('d-none');
                        row.find('.btn-eu-edit').removeClass('d-none');
                        if (code === productCode && isEUProduct) {
                            currentEUPoNumber = po;
                            saveState();
                        }
                        showStatus(`Đã lưu PO cho mã ${code}`, true);
                    } else {
                        alert('Lỗi lưu PO: ' + (res.error || 'Không xác định'));
                    }
                },
                error: function() { alert('Lỗi kết nối khi lưu PO!'); }
            });
        });

        $('#euPOList').on('click', '.btn-eu-cancel', function() {
            let row = $(this).closest('tr');
            let item = euPOData.find(x => x.code === row.data('code'));
            row.find('.eu-po-edit').val(item ? (item.poNumber || '') : '').addClass('d-none');
            row.find('.eu-po-display').removeClass('d-none');
            row.find('.btn-eu-save, .btn-eu-cancel').addClass('d-none');
            row.find('.btn-eu-edit').removeClass('d-none');
        });

        // =============================================================
        // EU CONFIRM MODAL (sau khi lookup WO mã EU)
        // =============================================================
        function showEUConfirmModal(code, sku, po) {
            $('#euConfirmCode').text('Mã: ' + code);
            $('#euConfirmSku').text(sku);
            if (po) {
                $('#euConfirmPOVal').text(po);
                $('#euConfirmPODisplayRow').removeClass('d-none');
                $('#euConfirmPOInputBlock').addClass('d-none');
                $('#btnEUConfirmOK').prop('disabled', false);
            } else {
                $('#euConfirmPODisplayRow').addClass('d-none');
                $('#euConfirmPOEmptyWarn').removeClass('d-none');
                $('#euConfirmPOInputBlock').removeClass('d-none');
                $('#euConfirmPOInput').val('');
                $('#btnEUConfirmOK').prop('disabled', true);
            }
            euConfirmMod.show();
            if (!po) setTimeout(() => $('#euConfirmPOInput').focus(), 350);
        }

        $('#btnEUEditPO').click(function() {
            $('#euConfirmPODisplayRow').addClass('d-none');
            $('#euConfirmPOEmptyWarn').addClass('d-none');
            $('#euConfirmPOInputBlock').removeClass('d-none');
            $('#euConfirmPOInput').val(currentEUPoNumber).focus().select();
            $('#btnEUConfirmOK').prop('disabled', $('#euConfirmPOInput').val().trim() === '');
        });

        $('#euConfirmPOInput').on('input', function() {
            $('#btnEUConfirmOK').prop('disabled', $(this).val().trim() === '');
        });

        $('#euConfirmPOInput').keypress(function(e) {
            if (e.which === 13 && !$('#btnEUConfirmOK').prop('disabled')) $('#btnEUConfirmOK').click();
        });

        $('#btnEUConfirmOK').click(function() {
            let newPO = $('#euConfirmPOInputBlock').is(':visible') ? $('#euConfirmPOInput').val().trim() : null;
            if (newPO) {
                $.ajax({
                    url: '/Twist/SaveEUPO',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ code: productCode, poNumber: newPO }),
                    success: function(res) {
                        if (res.success) {
                            currentEUPoNumber = newPO;
                            euConfirmed = true;
                            saveState();
                            showPOInfoRow(newPO);
                            euConfirmMod.hide();
                            $('#pcsInput').focus();
                            showStatus('Sẵn sàng scan PCS (EU)', true);
                        } else {
                            alert('Lỗi lưu PO: ' + (res.error || 'Không xác định'));
                        }
                    },
                    error: function() { alert('Lỗi kết nối khi lưu PO!'); }
                });
            } else {
                euConfirmed = true;
                showPOInfoRow(currentEUPoNumber);
                euConfirmMod.hide();
                $('#pcsInput').focus();
                showStatus('Sẵn sàng scan PCS (EU)', true);
            }
        });

        $('#btnEUConfirmCancel').click(function() {
            euConfirmMod.hide();
            isEUProduct = false;
            euSkuName = '';
            currentEUPoNumber = '';
            euConfirmed = false;
            woCode = ''; productCode = ''; productName = '';
            totalCount = 0; completedCount = 0; pcsPerBox = 0; sku = '';
            pcsList = [];
            $('#woInput').val('');
            $('#woInfo').hide();
            $('#poInfoRow').addClass('d-none');
            updatePcsList(); updatePcsPerBox(); updateProgress();
            saveState();
            showStatus('Đã hủy — vui lòng nhập lại WO.', false);
        });

        function showPOInfoRow(po) {
            if (po) {
                $('#poInfoVal').text(po);
                $('#poInfoRow').removeClass('d-none');
            } else {
                $('#poInfoRow').addClass('d-none');
            }
        }

        $('#btnSavePrinter').click(function () {
            let selectedId = $('#printerSelect').val();
            if (!selectedId) {
                alert('Vui lòng chọn máy in!');
                return;
            }

            let configData = {
                ID_Printer: $('#p_ID').val(),
                Name_Printer: $('#p_Name').val(),
                IP_Printer: $('#p_IP').val(),
                MAC_Printer: $('#p_MAC').val(),
                Port_Printer: $('#p_Port').val(),
                Size: $('#p_Size').val(),
                Type: $('#p_Type').val(),
                ZPL_Temp: $('#p_ZPL').val(),
                DPL_Temp: $('#p_DPL').val()
            };

            localStorage.setItem('selected_printer_config', JSON.stringify(configData));

            $.ajax({
                url: '/Twist/SavePrinterConfig',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(configData),
                success: function (res) {
                    if (res.success) {
                        showStatus(res.message || 'Lưu cấu hình máy in thành công!', true);
                        prtModal.hide();
                    } else {
                        alert('Lỗi lưu vào DB: ' + res.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert('Lỗi kết nối máy chủ: ' + error);
                }
            });
        });
    </script>
}