@using Newtonsoft.Json
@using SVNShareLib.DTO
@model IEnumerable<PDResultDailyViewModel>
@{

    DateTime date = ViewBag.Date;
    ViewData["Title"] = "Production Result Daily";
    string jsonData = string.Empty;
    jsonData = JsonConvert.SerializeObject(Model);
    string jsonUPHData = ViewBag.strUPHData;
    string jsonUPPHData = ViewBag.strUPPHData;
    string jsonLaborData = ViewBag.strLaborData;
    string jsonDefectRateData = ViewBag.strDefectRateData;
}

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-3">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <button type="submit" asp-action="ProductionResultNew" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <button type="submit" asp-action="ExportPDResultDaily" class="btn btn-success">
                                Export excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="card svn-card">
            <div class="card-title">
                <h4>Production Result Daily</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <table class="table">
                        <thead>
                            <tr>
                                <th rowspan="2" scope="col">Operation active</th>
                                <th colspan="3" scope="col">Daily Plan Achieve</th>
                                <th rowspan="2" scope="col">UPH</th>
                                <th rowspan="2" scope="col">UPPH</th>
                                <th rowspan="2" scope="col">Labor</th>
                                <th colspan="3" scope="col">Defect rate</th>
                                @* <th rowspan="2" scope="col">Check list on system</th> *@
                                <th rowspan="2" scope="col">Remark</th>
                            </tr>
                            <tr>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                                <th>Target rate</th>
                                <th>Current rate</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count() > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <th scope="row">@item.OperationActive</th>
                                        <td>@item.DailyPlanTarget</td>
                                        <td>@item.DailyPlanCurrent</td>
                                        <td>@item.DailyPlanAchieve</td>
                                        <td>@item.UPH</td>
                                        <td>@item.UPPH</td>
                                        <td>@item.Labor</td>
                                        <td>@item.DefectTargetRate</td>
                                        <td>@item.DefectCurrentRate</td>
                                        <td>@item.DefectRate</td>
                                        @* <td>@item.CheckListOnSystem</td> *@
                                        <td>@item.Remark</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
    <div class="col-12">
        <h2>Daily Plan Achieve</h2>
        <div id="dailyPlanChart" style="width:100%;height:400px;"></div>
    </div>
    <div class="col-12 col-md-6">
        <h2>UPH (%)</h2>
        <div id="uphChart" style="width:100%;height:400px;"></div>
    </div>
    <div class="col-12 col-md-6">
        <h2>UPPH (%)</h2>
        <div id="upphChart" style="width:100%;height:400px;"></div>
    </div>
    <div class="col-12 col-md-6">
        <h2>Labor (%)</h2>
        <div id="laborChart" style="width:100%;height:400px;"></div>
    </div>
    <div class="col-12 col-md-6">
        <h2>Defect (%)</h2>
        <div id="defectChart" style="width:100%;height:400px;"></div>
    </div>
    <script>
        var chartData = @Html.Raw(jsonData)

        function safeParse(val) {
            if (!val) return 0;
            val = val.toString().replace("%", "").trim();
            var num = parseFloat(val);
            return isNaN(num) ? 0 : num;
        }

        chartData = chartData.map(function(item) {
            return {
                OperationActive: item.OperationActive,
                DailyPlanTarget: safeParse(item.DailyPlanTarget),
                DailyPlanCurrent: safeParse(item.DailyPlanCurrent),
                DailyPlanAchieve: safeParse(item.DailyPlanAchieve),
                UPH: safeParse(item.UPH),
                UPPH: safeParse(item.UPPH),
                Labor: safeParse(item.Labor),
                DefectTargetRate: safeParse(item.DefectTargetRate),
                DefectCurrentRate: safeParse(item.DefectCurrentRate),
                DefectRate: safeParse(item.DefectRate),
                CheckListOnSystem: item.CheckListOnSystem,
                Remark: item.Remark
            };
        });

        // 1. Daily Plan Achieve
        AmCharts.makeChart("dailyPlanChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 16,
            "marginLeft": 0,

            "valueAxes": [{
                "id": "v1",
                "position": "left"
                // "title": "Qty"
            }, {
                "id": "v2",
                "position": "right",
                "title": "% Achieve",
                "axisAlpha": 0,
                "gridAlpha": 0
            }],
            "graphs": [{
                "balloonText": "[[value]]",
                "legendValueText": "Target: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Target",
                "valueField": "DailyPlanTarget",
                "valueAxis": "v1",
                "fillColors": "#FFCE56"
            }, {
                "balloonText": "[[value]]",
                "legendValueText": "Actual: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Current",
                "valueField": "DailyPlanCurrent",
                "valueAxis": "v1",
                "fillColors": "#36A2EB"
            }, {
                "id": "g2",
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 1,
                "type": "line",
                "title": "%Achieve",
                "valueField": "DailyPlanAchieve",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "[[value]] %",
                "legendValueText": "Achieve: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "[[value]] %",
                "labelPosition": "top",
                "lineColor": "#FF0000"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });

        
    </script>
</div>
