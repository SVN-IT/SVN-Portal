@using Newtonsoft.Json
@using SVNShareLib.DTO
@model IEnumerable<PDResultDailyViewModel>
@{
    // Layout = "~/Views/Shared/_NewLayout.cshtml";
    DateTime date = ViewBag.Date;
    ViewData["Title"] = "Production Result Daily";
    string jsonData = string.Empty;
    jsonData = JsonConvert.SerializeObject(Model);
    string jsonUPHData = string.Empty;
    string jsonUPPHData = string.Empty;
    string jsonLaborData = string.Empty;
    string jsonDefectRateData = string.Empty;
    List<string> listStatus = ViewBag.StatusList;
    List<CostDailyViewModel> costDailyViewModels = ViewBag.CostDaily;
    string jsonCostData = JsonConvert.SerializeObject(costDailyViewModels);
}
<link href="~/css/responsivescreen.css" rel="stylesheet" />
<script>
    function BuildDefectPieChart(dataParam, chartID) {
    var chart = AmCharts.makeChart(chartID, {
    "type": "pie",
    "addClassNames": true,
    "startDuration": 0,
    // "classNameField": "class",
    "dataProvider": dataParam,
    "valueField": "value",
    "categoryField": "category",
    "labelRadius": 10,  // Adjust label radius
    "radius": "42%",
    "innerRadius": "60%",
    "labelText": "", //[[category]]
    "labelColorField": "color",
    "labelFontSize": 14,
    "labelColor": "#FFFFFF",
    // "export": {
    //     "enabled": true
    // },
    "labelPosition": "outside",
    "fontSize": 14,
    "fontColor": "#FFFFFF",
    "animationPlayed": false,
    "color": "#FFFFFF",
    "colors": ["#4680ff", "#0ca6dc", "#6845fb"],
    // Configure legend
    "legend": {
    "enabled": false,                        // Bật legend
    "position": "bottom",                   // Đặt legend ở dưới biểu đồ
    "marginTop": 10,                        // Khoảng cách trên cùng của legend
    "marginBottom": 10,                     // Khoảng cách dưới cùng của legend
    "labelWidth": 150,                      // Độ rộng của nhãn trong legend
    "markerType": "circle",                 // Loại marker trong legend (có thể là "square", "circle", v.v.)
    "fontSize": 14,                         // Kích thước font chữ của legend
    "color": "#FFFFFF",                     // Màu chữ của legend
    "valueText": "[[category]]: [[value]]", // Định dạng giá trị hiển thị trong legend
    "valueWidth": 100,                      // Độ rộng của phần hiển thị giá trị trong legend
    "markerLabelGap": 10,
    "valueAlign": "left"
    }
    });
    }

</script>
<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-3">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <button type="submit" asp-action="ProductionResultNew" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                    @* <h2 style="float:right"><strong>@ViewBag.CostAndRevenueYearlyInfo</strong></h2> *@
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="card svn-card">
            <div class="card-title">
                <h2>Project Summary</h2>
            </div>
            <div class="card-body">
                <div class="row donut-chart-card">
                    @foreach (var item in Model)
                    {
                        List<DefectByCategoryViewModel> viewModels = new List<DefectByCategoryViewModel>();
                        viewModels.Add(new DefectByCategoryViewModel { category = item.OperationActive, value = item.DailyPlanAchieve.Replace("%","") });
                        if (!string.IsNullOrWhiteSpace(item.DailyPlanAchieve) && double.Parse(item.DailyPlanAchieve.Replace("%", "")) < 100)
                        {
                            var remain = 100 - double.Parse(item.DailyPlanAchieve.Replace("%", ""));
                            viewModels.Add(new DefectByCategoryViewModel { category = item.OperationActive + "1", value = Math.Round(remain, 2).ToString() });
                        }
                        int colIndex = 4;
                        string status = string.Empty;
                        if (Model.Count() >= 6)
                        {
                            colIndex = 2;
                        }
                        else if (Model.Count() == 4 || Model.Count() == 5)
                        {
                            colIndex = 3;
                        }
                        else if (Model.Count() == 3)
                        {
                            colIndex = 4;
                        }
                        else if (Model.Count() == 2)
                        {
                            colIndex = 6;
                        }
                        else
                        {
                            colIndex = 12;
                        }
                        var chartPideData = JsonConvert.SerializeObject(viewModels);
                        <div class="col-12 col-md-@colIndex border-right">
                            <div class="row">
                                <div class="col-12 col-md-6">
                                    <h1><strong>@item.OperationActive</strong></h1>
                                    <h2><strong>Plan Achieve: </strong> <strong>@item.DailyPlanAchieve</strong></h2>
                                    @if(double.Parse(item.DefectRate.Replace("%", "")) > 100)
                                    {
                                        status = "bg-danger";
                                    }
                                    else if (double.Parse(item.DefectRate.Replace("%", "")) > 75 && double.Parse(item.DefectRate.Replace("%", "")) <= 100)
                                    {
                                        status = "bg-warning";
                                    }
                                    else
                                    {
                                        status = "bg-primary";
                                    }
                                    <h5><strong>Defect Rate: </strong> <strong class="rate-box @status">@item.DefectRate</strong></h5>
                                    <br/>
                                    <h4><strong>💰PMC WO: </strong> <strong>@item.TargetRevenue @ViewBag.LocalCurrency</strong> | <strong>💰PD Output: </strong> <strong>@item.ActualRevenue @ViewBag.LocalCurrency</strong> | <strong>💰Rate: </strong> <strong>@item.RevenueRate</strong></h4>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div id="pieChart_@item.OperationActive" class="donut-chart-contain"></div>
                                    <div class="donut-chart-sum-text">
                                        @item.DailyPlanAchieve
                                    </div>
                                </div>

                            </div>
                        </div>
                        <script>
                            var chartPieData = @Html.Raw(chartPideData)
                            BuildDefectPieChart(chartPieData, "pieChart_@item.OperationActive")
                        </script>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
