@using Newtonsoft.Json
@using SVNShareLib.DTO
@model IEnumerable<PDResultDailyViewModel>
@{

    DateTime date = ViewBag.Date;
    ViewData["Title"] = "Production Result Daily";
    string jsonData = string.Empty;
    jsonData = JsonConvert.SerializeObject(Model);
    string jsonUPHData = ViewBag.strUPHData;
    string jsonUPPHData = ViewBag.strUPPHData;
    string jsonLaborData = ViewBag.strLaborData;
    string jsonDefectRateData = ViewBag.strDefectRateData;
}

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-3">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <button type="submit" asp-action="ProductionResultNew" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <button type="submit" asp-action="ExportPDResultDaily" class="btn btn-success">
                                Export excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="card svn-card">
            <div class="card-title">
                <h2>Project Summary</h2>
            </div>
            <div class="card-body">
                <div class="row" style="width:100%;height:200px;">
                    @foreach (var item in Model)
                    {
                        <div class="col-12 col-md-4">
                            <h1><strong>@item.OperationActive</strong></h1>
                            <br />
                            <h2><strong>Daily Plan Achieve: </strong> <strong>@item.DailyPlanAchieve</strong></h2>
                            <h5><strong>Defect Rate: </strong> <strong>@item.DefectRate</strong></h5>
                        </div>
                        
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card svn-card">
            <div class="card-title">
                <h2>UPH</h2>
            </div>
            <div class="card-body">
                <div id="uphChart" style="width:100%;height:400px;"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card svn-card">
            <div class="card-title">
                <h2>UPPH</h2>
            </div>
            <div class="card-body">
                <div id="upphChart" style="width:100%;height:400px;"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card svn-card">
            <div class="card-title">
                <h2>Daily Plan</h2>
            </div>
            <div class="card-body">
                <div id="dailyPlanChart" style="width:100%;height:400px;"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card svn-card">
            <div class="card-title">
                <h2>Labor</h2>
            </div>
            <div class="card-body">
                <div id="laborChart" style="width:100%;height:400px;"></div>
            </div>
        </div>
    </div>
    <script>
        var chartData = @Html.Raw(jsonData)

        function safeParse(val) {
            if (!val) return 0;
            val = val.toString().replace("%", "").trim();
            var num = parseFloat(val);
            return isNaN(num) ? 0 : num;
        }

        chartData = chartData.map(function(item) {
            return {
                OperationActive: item.OperationActive,
                OperationLine: `${item.OperationActive}\nLine: ${item.DailyPlanCurrent}`,
                DailyPlanTarget: safeParse(item.DailyPlanTarget),
                DailyPlanCurrent: safeParse(item.DailyPlanCurrent),
                DailyPlanAchieve: safeParse(item.DailyPlanAchieve),
                UPH: safeParse(item.UPH),
                UPPH: safeParse(item.UPPH),
                Labor: safeParse(item.Labor),
                DefectTargetRate: safeParse(item.DefectTargetRate),
                DefectCurrentRate: safeParse(item.DefectCurrentRate),
                DefectRate: safeParse(item.DefectRate),
                CheckListOnSystem: item.CheckListOnSystem,
                UPHTarget:safeParse(item.UPHTarget),
                UPPHTarget:safeParse(item.UPPHTarget),
                LaborTarget:safeParse(item.LaborTarget),
                UPHCurrent:safeParse(item.UPHCurrent),
                UPPHCurrent:safeParse(item.UPPHCurrent),
                LaborCurrent:safeParse(item.LaborCurrent),
                Remark: item.Remark
            };
        });

        // 1. Daily Plan Achieve
        AmCharts.makeChart("dailyPlanChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 16,
            "marginLeft": 0,

            "valueAxes": [{
                "id": "v1",
                "position": "left"
                // "title": "Qty"
            }],
            "graphs": [{
                "balloonText": "[[value]]",
                "legendValueText": "Actual: [[value]]",
                // "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Current",
                "valueField": "DailyPlanCurrent",
                "valueAxis": "v1",
                "fillColors": "#36A2EB"
            }, {
                "id": "g2",
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 2,
                "type": "line",
                "title": "%Achieve",
                "valueField": "DailyPlanTarget",
                "valueAxis": "v1",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "[[value]]",
                "legendValueText": "Achieve: [[value]]",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "[[value]]",
                "labelPosition": "top",
                "lineColor": "#FF0000"
            }],
            "categoryField": "OperationLine",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });

        AmCharts.makeChart("uphChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 16,
            "marginLeft": 0,

            "valueAxes": [{
                "id": "v1",
                "position": "left"
                // "title": "Qty"
            }, {
                "id": "v2",
                "position": "right",
                "title": "Rate %",
                "axisAlpha": 0,
                "gridAlpha": 0
            }],
            "graphs": [{
                "balloonText": "[[value]]",
                "legendValueText": "Target: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Target",
                "valueField": "UPHTarget",
                "valueAxis": "v1",
                "fillColors": "#FFCE56"
            }, {
                "balloonText": "[[value]]",
                "legendValueText": "Actual: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Current",
                "valueField": "UPHCurrent",
                "valueAxis": "v1",
                "fillColors": "#36A2EB"
            }, {
                "id": "g2",
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 1,
                "type": "line",
                "title": "%Achieve",
                "valueField": "UPH",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "[[value]] %",
                "legendValueText": "Achieve: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "[[value]] %",
                "labelPosition": "top",
                "lineColor": "#FF0000"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });

        AmCharts.makeChart("upphChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 16,
            "marginLeft": 0,

            "valueAxes": [{
                "id": "v1",
                "position": "left"
                // "title": "Qty"
            }, {
                "id": "v2",
                "position": "right",
                "title": "Rate %",
                "axisAlpha": 0,
                "gridAlpha": 0
            }],
            "graphs": [{
                "balloonText": "[[value]]",
                "legendValueText": "Target: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Target",
                "valueField": "UPPHTarget",
                "valueAxis": "v1",
                "fillColors": "#FFCE56"
            }, {
                "balloonText": "[[value]]",
                "legendValueText": "Actual: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Current",
                "valueField": "UPPHCurrent",
                "valueAxis": "v1",
                "fillColors": "#36A2EB"
            }, {
                "id": "g2",
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 1,
                "type": "line",
                "title": "%Achieve",
                "valueField": "UPPH",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "[[value]] %",
                "legendValueText": "Achieve: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "[[value]] %",
                "labelPosition": "top",
                "lineColor": "#FF0000"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });
        AmCharts.makeChart("laborChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 16,
            "marginLeft": 0,

            "valueAxes": [{
                "id": "v1",
                "position": "left"
                // "title": "Qty"
            }, {
                "id": "v2",
                "position": "right",
                "title": "Rate %",
                "axisAlpha": 0,
                "gridAlpha": 0
            }],
            "graphs": [{
                "balloonText": "[[value]]",
                "legendValueText": "Target: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Target",
                "valueField": "LaborTarget",
                "valueAxis": "v1",
                "fillColors": "#FFCE56"
            }, {
                "balloonText": "[[value]]",
                "legendValueText": "Actual: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Current",
                "valueField": "LaborCurrent",
                "valueAxis": "v1",
                "fillColors": "#36A2EB"
            }, {
                "id": "g2",
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 1,
                "type": "line",
                "title": "%Achieve",
                "valueField": "Labor",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "[[value]] %",
                "legendValueText": "Achieve: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "[[value]] %",
                "labelPosition": "top",
                "lineColor": "#FF0000"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });
    </script>
</div>
