    <script>
        var jsonYestardayData = @Html.Raw(jsonYestardayData);
        var jsonTodayData = @Html.Raw(jsonTodayData);
        var jsonYearlyData = @Html.Raw(jsonYearlyData);

        AmCharts.makeChart("costRevenueYesterdayChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": jsonYestardayData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            // "fontSize": 20,
            "marginLeft": 0,

            "valueAxes": [{
                "id": "v1",
                "position": "left",
                "labelsEnabled": false,
                "axisColor": "#FFFFFF",     // đường trục
                "lineColor": "#FFFFFF",
                "gridColor": "#FFFFFF",     // đường grid
                "gridAlpha": 0.2,           // giảm đậm grid
                "minimum": 0
                // "title": "Qty"
            }],
            "graphs": [{
                "balloonText": "[[value]]",
                "legendValueText": "Target: [[value]]",
                "labelText": "[[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Money",
                "valueField": "Value",
                "valueAxis": "v1",
                "fillColors": "#36A2EB"
            }],
            "categoryField": "Key",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 0,
                "useGraphSettings": true,
                "color": "#FFFFFF",
                "horizontalGap": 0,  // khoảng cách giữa các item
                "maxColumns": 3,      // số lượng cột tối đa (cho legend nằm ngang)
                "forceWidth": true    // ép giữ nguyên width, không xuống dòng
            }
        });

