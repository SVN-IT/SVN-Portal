@using Newtonsoft.Json
@using SVNShareLib.DTO
@model IEnumerable<SVN_production_summaryUI>
@{

    string jsondata = string.Empty;
    string oper = string.Empty;
    QtyProdResultByOperViewModel viewmodel = new QtyProdResultByOperViewModel();

    jsondata = JsonConvert.SerializeObject(Model, Formatting.Indented);

    DateTime date = ViewBag.date;
    ViewData["Title"] = "Production Result by Month";
}

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="row">
                        <div class="col-9">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-3">
                            <button type="submit" asp-action="PDResultByMonthReport" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="card svn-card">
            <div class="card-title">
                <h4>Production Result by Month</h4>
            </div>
            <div class="card-body">
                <div class="row">
                </div>
                <div id="chartdivSingle"></div>
            </div>
        </div>
    </div>

</div>
<script>
    $(document).ready(function () {
        var Data = @Html.Raw(jsondata);
        var chart = AmCharts.makeChart("chartdivSingle", {
            "type": "serial",
            "theme": "light",

            "dataDateFormat": "YYYY-MM-DD",
            "dataProvider": Data,

            "addClassNames": true,
            "startDuration": 1,
            "color": "#FFFFFF",
            "marginLeft": 0,

            "categoryField": "Operation",
            "categoryAxis": {
                "parseDates": false,
                // "minPeriod": "DD",
                "autoGridCount": false,
                "gridCount": 50,
                "gridAlpha": 0.1,
                "gridColor": "#FFFFFF",
                "axisColor": "#555555"
            },

            "valueAxes": [{
                "id": "a1",
                "title": "quatity",
                "gridAlpha": 0,
                "axisAlpha": 0
            }],
            "graphs": [{
                "id": "g1",
                "valueField": "Production",
                "title": "Production",
                "type": "column",
                "fillAlphas": 0.9,
                "valueAxis": "a1",
                "balloonText": "[[value]] qty",
                "legendValueText": "[[value]] qty",
                "legendPeriodValueText": "total: [[value.sum]] qty",
                "lineColor": "#428bca",
                "alphaField": "alpha"
            }, {
                "id": "g2",
                "valueField": "Rate",
                "classNameField": "bulletClass",
                "title": "Rate",
                "type": "line",
                "valueAxis": "a1",
                "lineColor": "#FF0000",
                "lineThickness": 1,
                "legendValueText": "[[value]]/[[description]]",
                "bullet": "round",
                "bulletBorderColor": "#FF0000",
                "bulletBorderAlpha": 1,
                "bulletBorderThickness": 1,
                "bulletColor": "#FF0000	",
                "labelPosition": "right",
                "balloonText": "Rate:[[value]]",
                "showBalloon": true,
                "animationPlayed": true,
                "labelText": "[[value]]",
                "labelPosition": "bottom", // Giá trị nằm trên điểm của đường
                "labelColor": "#FF0000", // Màu chữ trên đường
            }, {
                "id": "g3",
                "title": "Target",
                "valueField": "Target",
                "type": "line",
                "valueAxis": "a1",
                "lineColor": "#006600",
                "balloonText": "[[value]]",
                "lineThickness": 4,
                "legendValueText": "[[value]]",
                "bullet": "square",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "animationPlayed": true,
                "labelText": "[[value]]",
                "labelPosition": "top", // Giá trị nằm trên điểm của đường
                "labelColor": "#006600", // Màu chữ trên đường
            }],

            "chartCursor": {
                "zoomable": false,
                "categoryBalloonDateFormat": "DD",
                "cursorAlpha": 0,
                "valueBalloonsEnabled": false
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });
    });
</script>
