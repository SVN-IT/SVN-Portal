                                                int stateIndex = Array.IndexOf(machineStates, item.State);
                                                string colorClass = stateIndex >= 0 ? machineStateColor[stateIndex] : "bg-light";
                                                <div class="col-1 mt-2">
                                                    <button class="btn @colorClass" style="text-overflow: ellipsis; width:95px">@item.Name</button>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
