                                                                <div class="col-2 border table-cell text-center">@Math.Round(subitem.Current, 2)</div>
                                                                <div class="col-3 border table-cell text-center">@Math.Round(subitem.Percent, 2) %</div>
                                                            }

                                                            string status = string.Empty;
                                                            if (subitem.Item == "Defect")
