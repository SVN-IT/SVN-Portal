                                                                /*
                                                                if (subitem.Percent > 0 && subitem.Percent <= 75)
                                                                {

                                                                    status = "bg-warning";
                                                                    }
                                                                else if (subitem.Percent > 75 && subitem.Percent <= 92)
                                                                {
                                                                    status = "bg-danger";
                                                                    }
                                                                */
                                                                if (subitem.Percent > 100)
