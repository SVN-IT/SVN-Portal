                                            string[] machineStateColor = { "btn-info", "btn-success", "btn-warning", "btn-primary", "btn-light", "btn-secondary", "btn-danger", "btn-dark" };
                                        }
                                        @if (equipments != null)
                                        {
                                            foreach (var item in equipments)
