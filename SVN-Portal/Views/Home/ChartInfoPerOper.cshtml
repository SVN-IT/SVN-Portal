                                                            "title": "quatity",
                                                            "gridAlpha": 0,
                                                            "axisAlpha": 0
                                                        }],
                                                        "graphs": [{
                                                            "id": "g1",
                                                            "valueField": "Line",
                                                            "title": "Line",
                                                            "type": "column",
                                                            "fillAlphas": 0.9,
                                                            "valueAxis": "a1",
                                                            "balloonText": "[[value]] qty",
                                                            "legendValueText": "[[value]] qty",
                                                            "legendPeriodValueText": "total: [[value.sum]] qty",
                                                            "lineColor": "#428bca",
                                                            "alphaField": "alpha"
                                                        }, {
                                                            "id": "g2",
                                                            "valueField": "ManQuantity",
                                                            "classNameField": "bulletClass",
                                                            "title": "Labor",
                                                            "type": "line",
                                                            "valueAxis": "a1",
                                                            "lineColor": "#333300",
                                                            "lineThickness": 1,
                                                            "legendValueText": "[[value]]/[[description]]",
                                                            "bullet": "round",
                                                                "bulletBorderColor": "#333300	",
                                                            "bulletBorderAlpha": 1,
                                                            "bulletBorderThickness": 1,
                                                                "bulletColor": "#333300	",
                                                            "labelPosition": "right",
                                                            "balloonText": "Man Qty:[[value]]",
                                                            "showBalloon": true,
                                                            "animationPlayed": true
                                                        }, {
                                                            "id": "g3",
                                                            "title": "Target",
                                                            "valueField": "Target",
                                                            "type": "line",
                                                            "valueAxis": "a1",
                                                            "lineColor": "#006600",
                                                            "balloonText": "[[value]]",
                                                            "lineThickness": 4,
                                                            "legendValueText": "[[value]]",
                                                            "bullet": "square",
                                                            "bulletBorderColor": "#006600",
                                                            "bulletBorderThickness": 1,
                                                            "bulletBorderAlpha": 1,
                                                            "dashLengthField": "dashLength",
                                                            "animationPlayed": true
                                                        }],

                                                        "chartCursor": {
                                                            "zoomable": false,
                                                            "categoryBalloonDateFormat": "DD",
                                                            "cursorAlpha": 0,
                                                            "valueBalloonsEnabled": false
                                                        },
                                                        "legend": {
                                                            "bulletType": "round",
                                                            "equalWidths": false,
                                                            "valueWidth": 120,
                                                            "useGraphSettings": true
                                                            //"color": "#FFFFFF"
                                                        }
                                                    });

                                                });

                                            </script>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="col-12 col-md-5">
                <div></div>
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-3 border">
