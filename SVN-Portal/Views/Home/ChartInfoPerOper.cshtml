@using Newtonsoft.Json
@using SVNShareLib.DTO
@model IEnumerable<QtyProdResultByOperViewModel>
@{
    ViewData["Title"] = "Home Page";
    DateTime date = ViewBag.date;
    double Achieve = 0;
    double Forecast = 0;
    string WORunning = string.Empty;
    string Product = string.Empty;
    string Customer = string.Empty;
    string PDName = string.Empty;
    string QCName = string.Empty;
    string PDURL = string.Empty;
    string QCURL = string.Empty;

    QtyProdResultByOperViewModel defectModel = new QtyProdResultByOperViewModel();
    if(Model != null)
    {
        if (Model.Count() == 1)
        {
            defectModel = Model.FirstOrDefault();
            if (defectModel != null)
            {
                Achieve = defectModel.Achieve;
                Forecast = defectModel.Forecast;
                WORunning = defectModel.WORunning;
                Product = defectModel.Product;
                Customer = defectModel.Customer;
                PDName = defectModel.PDName;
                QCName = defectModel.QCName;
                PDURL = defectModel.PDURL;
                QCURL = defectModel.QCURL;
            }
        }
        else
        {
            defectModel = Model.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.WC) && x.WC.Contains("FG"));
            if (defectModel != null)
            {
                Achieve = defectModel.Achieve;
                Forecast = defectModel.Forecast;
                WORunning = defectModel.WORunning;
                Product = defectModel.Product;
                Customer = defectModel.Customer;
                PDName = defectModel.PDName;
                QCName = defectModel.QCName;
                PDURL = defectModel.PDURL;
                QCURL = defectModel.QCURL;
            }
        }
    }
    var defectJsonData = JsonConvert.SerializeObject(defectModel.ViewModels);

    int All = 0;
    int Run = 0;
    int Fault = 0;
    int Adjust = 0;
    int Item = 0;
    int Maint = 0;
    int Stop = 0;
    int Devel = 0;

    List<SVN_Equipment_InfoUI> equipments = ViewBag.Equipments;
    if(equipments != null)
    {
        All = equipments.Count();
        Run = equipments.Count(x => x.State == "Run");
        Fault = equipments.Count(x => x.State == "Fault");
        Adjust = equipments.Count(x => x.State == "Adjust");
        Item = equipments.Count(x => x.State == "Item");
        Maint = equipments.Count(x => x.State == "Maint");
        Stop = equipments.Count(x => x.State == "Stop");
        Devel = equipments.Count(x => x.State == "Devel");
    }
}
<script>
    var dataParam;
</script>

<div class="row svn-layout">
    <div class="col-12 text-center">
        <h1><b>@ViewBag.oper</b></h1>
    </div>
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row mt-1">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="row">
                        <div class="col-9">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-3">
                            <button type="submit" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="row">
            <div class="col-12 col-md-7">
                <div class="row">
                    <div class="col-12">
                        <div class="card svn-card">
                            <div class="card-title">
                                <h4>Machine</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-12 col-md-6 row">
                                        <div class="col-3 bg-info border table-cell text-center">
                                            All: @All
                                        </div>
                                        <div class="col-3 bg-success border table-cell text-center">
                                            Run: @Run
                                        </div>
                                        <div class="col-3 bg-warning border table-cell text-center">
                                            Fault: @Fault
                                        </div>
                                        <div class="col-3 bg-primary border table-cell text-center">
                                            Adjust: @Adjust
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 row">
                                        <div class="col-3 bg-light border table-cell text-center">
                                            Item: @Item
                                        </div>
                                        <div class="col-3 bg-secondary color-white border table-cell text-center">
                                            Maint: @Maint
                                        </div>
                                        <div class="col-3 bg-danger border table-cell text-center">
                                            Stop: @Stop
                                        </div>
                                        <div class="col-3 bg-dark border table-cell text-center">
                                            Devel: @Devel
                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    @{
                                        string[] machineStates = { "All", "Run", "Fault", "Adjust", "Item", "Maint", "Stop", "Devel" };
                                        string[] machineStateColor = { "bg-info", "bg-success", "bg-warning", "bg-primary", "bg-light", "bg-secondary", "bg-danger", "bg-dark" };
                                    }
                                    @if (equipments != null)
                                    {
                                        foreach (var item in equipments)
                                        {
                                            int stateIndex = Array.IndexOf(machineStates, item.State);
                                            string colorClass = stateIndex >= 0 ? machineStateColor[stateIndex] : "bg-light";
                                            <div class="col-2">
                                                <div class="card color-white @colorClass">
                                                    <div class="card-body">
                                                        @item.Name (@item.State)
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
