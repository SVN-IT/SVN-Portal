@using Newtonsoft.Json
@using SVNShareLib.DTO
@using System.Globalization
@model IEnumerable<QtyProdResultByOperViewModel>
@{
    ViewData["Title"] = "Home Page";
    DateTime date = ViewBag.date;
    double Achieve = 0;
    double Forecast = 0;
    string WORunning = string.Empty;
    string Product = string.Empty;
    string Customer = string.Empty;
    string PDName = string.Empty;
    string QCName = string.Empty;
    string PDURL = string.Empty;
    string QCURL = string.Empty;

    QtyProdResultByOperViewModel defectModel = new QtyProdResultByOperViewModel();
    if(Model != null)
    {
        if (Model.Count() == 1)
        {
            defectModel = Model.FirstOrDefault();
            if (defectModel != null)
            {
                Achieve = defectModel.Achieve;
                Forecast = defectModel.Forecast;
                WORunning = defectModel.WORunning;
                Product = defectModel.Product;
                Customer = defectModel.Customer;
                PDName = defectModel.PDName;
                QCName = defectModel.QCName;
                PDURL = defectModel.PDURL;
                QCURL = defectModel.QCURL;
            }
        }
        else
        {
            defectModel = Model.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.WC) && x.WC.Contains("FG"));
            if (defectModel != null)
            {
                Achieve = defectModel.Achieve;
                Forecast = defectModel.Forecast;
                WORunning = defectModel.WORunning;
                Product = defectModel.Product;
                Customer = defectModel.Customer;
                PDName = defectModel.PDName;
                QCName = defectModel.QCName;
                PDURL = defectModel.PDURL;
                QCURL = defectModel.QCURL;
            }
        }
    }
    var defectJsonData = JsonConvert.SerializeObject(defectModel.ViewModels);

    int All = 0;
    int Run = 0;
    int Fault = 0;
    int Adjust = 0;
    int Item = 0;
    int Maint = 0;
    int Stop = 0;
    int Devel = 0;

    List<SVN_Equipment_InfoUI> equipments = ViewBag.Equipments;
    if(equipments != null)
    {
        All = equipments.Count();
        Run = equipments.Count(x => x.State == "Run");
        Fault = equipments.Count(x => x.State == "Fault");
        Adjust = equipments.Count(x => x.State == "Adjust");
        Item = equipments.Count(x => x.State == "Item");
        Maint = equipments.Count(x => x.State == "Maint");
        Stop = equipments.Count(x => x.State == "Stop");
        Devel = equipments.Count(x => x.State == "Devel");
    }
}
<script>
    function BuildProductionChart(dataParam, chartID){
    // Modify dataParam to include Line data in the Time field for categoryField
    dataParam = dataParam.map(item => ({
    ...item,
    Time: `${item.Time} \nLine: ${item.Line}` // Concatenate Line value with Time
    }));
    var chart = AmCharts.makeChart(chartID, {
    "type": "serial",
    "theme": "light",

    "dataDateFormat": "YYYY-MM-DD",
    "dataProvider": dataParam,

    "addClassNames": true,
    "startDuration": 1,
    "color": "#FFFFFF",
    "fontSize": 20,
    "marginLeft": 0,

    "categoryField": "Time",
    "categoryAxis": {
    "parseDates": false,
    // "minPeriod": "DD",
    "autoGridCount": false,
    "gridCount": 50,
    "gridAlpha": 0.1,
    "gridColor": "#FFFFFF",
    "axisColor": "#555555"
    },

    "valueAxes": [{
    "id": "a1",
    "title": "quatity",
    "gridAlpha": 0,
    "axisAlpha": 0
    }],
    "graphs": [{
    "id": "g1",
    "valueField": "Line",
    "title": "Line",
    "type": "column",
    "fillAlphas": 0.9,
    "valueAxis": "a1",
    "balloonText": "[[value]] qty",
    "legendValueText": "[[value]] qty",
    "legendPeriodValueText": "total: [[value.sum]] qty",
    "lineColor": "#428bca",
    "alphaField": "alpha"
    }, {
    "id": "g2",
    "valueField": "ManQuantity",
    "classNameField": "bulletClass",
    "title": "Labor",
    "type": "smoothedLine",
    "valueAxis": "a1",
    "lineColor": "#FF0000",
    "lineThickness": 1,
    "legendValueText": "[[value]]/[[description]]",
    "bullet": "round",
    "bulletBorderColor": "#FF0000",
    "bulletBorderAlpha": 1,
    "bulletBorderThickness": 1,
    "bulletColor": "#FF0000	",
    "labelPosition": "right",
    "balloonText": "Man Qty:[[value]]",
    "showBalloon": true,
    "animationPlayed": true,
    "labelText": "[[value]]",
    "labelPosition": "bottom", // Giá trị nằm trên điểm của đường
    "labelColor": "#FF0000", // Màu chữ trên đường
    }, {
    "id": "g3",
    "title": "Target",
    "valueField": "Target",
    "type": "smoothedLine",
    "valueAxis": "a1",
    "lineColor": "#006600",
    "balloonText": "[[value]]",
    "lineThickness": 4,
    "legendValueText": "[[value]]",
    "bullet": "square",
    "bulletBorderColor": "#006600",
    "bulletBorderThickness": 1,
    "bulletBorderAlpha": 1,
    "dashLengthField": "dashLength",
    "animationPlayed": true,
    "labelText": "[[value]]",
    "labelPosition": "top", // Giá trị nằm trên điểm của đường
    "labelColor": "#006600", // Màu chữ trên đường
    }],

    "chartCursor": {
    "zoomable": false,
    "categoryBalloonDateFormat": "DD",
    "cursorAlpha": 0,
    "valueBalloonsEnabled": false
    },
    "legend": {
    "bulletType": "round",
    "equalWidths": false,
    "valueWidth": 120,
    "useGraphSettings": true,
    "color": "#FFFFFF"
    }
    });
    }

    function BuildDefectChart(dataParam, chartID){
    var chartDefect = AmCharts.makeChart("defectchart", {
    "type": "serial",
    "theme": "light",

    "dataDateFormat": "YYYY-MM-DD",
    "dataProvider": dataParam,

    "addClassNames": true,
    "startDuration": 1,
    "color": "#FFFFFF",
    "fontSize": 20,
    "marginLeft": 0,

    "categoryField": "Time",
    "categoryAxis": {
    "parseDates": false,
    // "minPeriod": "DD",
    "autoGridCount": false,
    "gridCount": 50,
    "gridAlpha": 0.1,
    "gridColor": "#FFFFFF",
    "axisColor": "#555555"
    },

    "valueAxes": [{
    "id": "a1",
    "title": "quatity",
    "gridAlpha": 0,
    "axisAlpha": 0
    }],
    "graphs": [{
    "id": "g3",
    "title": "Defect rate",
    "valueField": "NG",
    "type": "smoothedLine",
    "valueAxis": "a1",
    "lineColor": "#006600",
    "balloonText": "[[value]]",
    "lineThickness": 4,
    "legendValueText": "[[value]]",
    "bullet": "square",
    "bulletBorderColor": "#006600",
    "bulletBorderThickness": 1,
    "bulletBorderAlpha": 1,
    "dashLengthField": "dashLength",
    "animationPlayed": true,
    "labelText": "[[value]]",
    "labelPosition": "top", // Giá trị nằm trên điểm của đường
    "labelColor": "#006600", // Màu chữ trên đường
    }],

    "chartCursor": {
    "zoomable": false,
    "categoryBalloonDateFormat": "DD",
    "cursorAlpha": 0,
    "valueBalloonsEnabled": false
    },
    "legend": {
    "bulletType": "round",
    "equalWidths": false,
    "valueWidth": 120,
    "useGraphSettings": true,
    "color": "#FFFFFF"
    }
    });
    }

    var charIDs = [];
</script>

<div class="row svn-layout">
    <div class="col-12 text-center">
