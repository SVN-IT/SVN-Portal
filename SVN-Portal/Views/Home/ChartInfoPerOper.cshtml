                                        <h3>QC: Vũ Thị Lan Anh</h3>
                                        <h3>(SVN0334)</h3>
                                    </div>
                                    <div class="col-9 border text-center">
                                        <h3><b>Forecast</b></h3>
                                        <canvas id="forecastChart" width="400" height="200"></canvas>
                                        <h3>92 %</h3>
                                    </div>
                                    <div class="col-12 border">
                                        <h3><b>Defect rate</b></h3>
                                        <div id="defectchart"></div>
                                </div>
                                
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>

        </div>
