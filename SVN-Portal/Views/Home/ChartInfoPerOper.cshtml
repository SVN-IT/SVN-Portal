@using Newtonsoft.Json
@model IEnumerable<QtyProdResultByOperViewModel>
@{
    ViewData["Title"] = "Home Page";
    DateTime date = ViewBag.date;
}
<script>
    var dataParam;
</script>

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="row">
                        <div class="col-9">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-3">
                            <button type="submit" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="row">
            <div class="col-12 col-md-7">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-title">
                                <h4>Machine</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-12 col-md-6 row">
                                        <div class="col-3 bg-info border table-cell text-center">
                                            All: 5
                                        </div>
                                        <div class="col-3 bg-success border table-cell text-center">
                                            Run: 5
                                        </div>
                                        <div class="col-3 bg-warning border table-cell text-center">
                                            Fault: 0
                                        </div>
                                        <div class="col-3 bg-primary border table-cell text-center">
                                            Adjust: 0
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 row">
                                        <div class="col-3 border table-cell text-center">
                                            Item: 0
                                        </div>
                                        <div class="col-3 bg-secondary color-white border table-cell text-center">
                                            Maint: 1
                                        </div>
                                        <div class="col-3 bg-danger border table-cell text-center">
                                            Stop: 0
                                        </div>
                                        <div class="col-3 bg-dark border table-cell text-center">
                                            Devel: 0
                                        </div>
                                    </div>
                                    
                                </div>
                                <div class="row">
                                    <div class="col-2">
                                        <div class="card color-white bg-success">
                                            <div class="card-body">
                                                M-1 (Run)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <div class="card color-white bg-success">
                                            <div class="card-body">
                                                M-2 (Run)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <div class="card color-white bg-success">
                                            <div class="card-body">
                                                M-3 (Run)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <div class="card color-white bg-warning">
                                            <div class="card-body">
                                                M-4 (Develop)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <div class="card color-white bg-success">
                                            <div class="card-body">
                                                M-5 (Run)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <div class="card color-white bg-success">
                                            <div class="card-body">
                                                M-6 (Run)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card">
                            <div class="card-title">
                                <h4>Production result</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-4">
                                        <strong>WO running: NM/MO/00226-384</strong>
                                    </div>
                                    <div class="col-4">
                                        <strong>Product: F8W973btBLU AP1</strong>
                                    </div>
                                    <div class="col-4">
                                        <strong>Customer: Sigma Worldwide Asia Limited</strong>
                                    </div>
                                    @foreach (var item in Model)
                                    {
                                        string charID = "chartdiv" + item.Operation;
                                        if (!string.IsNullOrWhiteSpace(item.WC))
                                        {
                                            charID = "chartdiv" + item.Operation + item.WC;
                                            charID = charID.Replace("-", "");
                                        }
                                        string jsonData = string.Empty;
                                        jsonData = JsonConvert.SerializeObject(item.ViewModels);
                                        <style>
                                            #@charID {
                                                height: 450px;
                                                width: 100%;
                                            }
                                        </style>
                                        <div class="col-lg-@item.ColWidth border mt-2">
                                            <h4>
                                                @item.Operation - @item.WC
                                            </h4>
                                            <div class="row">
                                                <div class="col-6 row">
                                                    <div class="col-12 border table-cell text-center">
                                                        <strong>Production result: @item.Operation</strong>
                                                    </div>
                                                    <div class="col-2">
                                                        <div class="row">
                                                            <div class="col-12 border table-cell text-center">
                                                                <strong>Time</strong>
                                                            </div>
                                                            <div class="col-12 border table-cell text-center">
                                                                <strong>Target</strong>
                                                            </div>
                                                            <div class="col-12 border table-cell text-center">
                                                                <strong>Line</strong>
                                                            </div>
                                                            <div class="col-12 border table-cell text-center">
                                                                <strong>Labor</strong>
                                                            </div>
                                                            <div class="col-12 border table-cell text-center">
                                                                <strong>Defect</strong>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @foreach (var subitem in item.ViewModels)
                                                    {
                                                        <div class="col-2">
                                                            <div class="row">
                                                                <div class="col-12 border table-cell text-center">
                                                                    @subitem.Time
                                                                </div>
                                                                <div class="col-12 border table-cell text-center">
                                                                    @Math.Round(subitem.Target, 2)
                                                                </div>
                                                                <div class="col-12 border table-cell text-center">
                                                                    @Math.Round(subitem.Line, 2)
                                                                </div>
                                                                <div class="col-12 border table-cell text-center">
                                                                    @Math.Round(subitem.ManQuantity, 2)
                                                                </div>
                                                                <div class="col-12 border table-cell text-center">
                                                                    @Math.Round(subitem.NG, 2)
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                @if ((!string.IsNullOrWhiteSpace(item.WC) && item.WC.Contains("FG")) || appConfig.ShowSingleChart.Contains(item.Operation))
                                                {
                                                    <div class="col-6 row" style="padding-left:20px">
                                                        <div class="col-3 border table-cell text-center"><strong>Item</strong></div>
                                                        <div class="col-2 border table-cell text-center"><strong>Target</strong></div>
                                                        <div class="col-2 border table-cell text-center"><strong>Current</strong></div>
                                                        <div class="col-3 border table-cell text-center"><strong>Rate</strong></div>
                                                        <div class="col-2 border table-cell text-center"><strong>Status</strong></div>
                                                        @* <div class="col-3 border table-cell">Expert</div> *@
                                                        @foreach (var subitem in item.TargetViewModels)
                                                        {
                                                            <div class="col-3 border table-cell text-center"><strong>@subitem.Item</strong></div>
                                                            if (subitem.Item == "Defect")
                                                            {
                                                                <div class="col-2 border table-cell text-center">@Math.Round(subitem.Target, 2) %</div>
                                                                <div class="col-2 border table-cell text-center">@Math.Round(subitem.Current, 2) %</div>
                                                                <div class="col-3 border table-cell text-center">@Math.Round(subitem.Percent, 2) %</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="col-2 border table-cell text-center">@Math.Round(subitem.Target, 2)</div>
                                                                <div class="col-2 border table-cell text-center">@Math.Round(subitem.Current, 2)</div>
                                                                <div class="col-3 border table-cell text-center">@Math.Round(subitem.Percent, 2) %</div>
                                                            }

                                                            string status = string.Empty;
                                                            if (subitem.Item == "Defect")
                                                            {
                                                                /*
                                                                if (subitem.Percent > 0 && subitem.Percent <= 75)
                                                                {

                                                                    status = "bg-warning";
                                                                    }
                                                                else if (subitem.Percent > 75 && subitem.Percent <= 92)
                                                                {
                                                                    status = "bg-danger";
                                                                    }
                                                                */
                                                                if (subitem.Percent > 100)
                                                                {

                                                                    status = "bg-danger";
                                                                }
                                                                else if (subitem.Percent > 75 && subitem.Percent <= 100)
                                                                {
                                                                    status = "bg-warning";
                                                                }
                                                                else
                                                                {
                                                                    status = "bg-primary";
                                                                }
                                                            }
                                                            else
                                                            {

                                                                if (subitem.Percent > 0 && subitem.Percent <= 75)
                                                                {
                                                                    status = "bg-danger";
                                                                }
                                                                else if (subitem.Percent > 75 && subitem.Percent <= 92)
                                                                {
                                                                    status = "bg-warning";
                                                                }
                                                                else
                                                                {
                                                                    status = "bg-primary";
                                                                }
                                                            }
                                                            <div class="col-2 border table-cell text-center @status"></div>
                                                            @* <div class="col-3 border table-cell">@Math.Round(item.Est, 2) %</div> *@
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="col-6 row" style="padding-left:20px">
                                                        <div class="col-4 border table-cell text-center">
                                                            <strong>WO Name</strong>
                                                        </div>
                                                        <div class="col-4 border table-cell text-center">
                                                            <strong>State</strong>
                                                        </div>
                                                        <div class="col-4 border table-cell text-center">
                                                            <strong>Product Qty</strong>
                                                        </div>
                                                        @foreach (var subitem in item.ProductionUIs)
                                                        {
                                                            <div class="col-4 border table-cell text-center">
                                                                @subitem.name
                                                            </div>
                                                            <div class="col-4 border table-cell text-center">
                                                                @subitem.state
                                                            </div>
                                                            <div class="col-4 border table-cell text-center">
                                                                @subitem.product_uom_qty
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <div id=@charID></div>
                                            <script>
                                                $(document).ready(function () {
                                                    var dataParam = @Html.Raw(jsonData);
                                                    var chart = AmCharts.makeChart(@charID, {
                                                        "type": "serial",
                                                        "theme": "light",

                                                        "dataDateFormat": "YYYY-MM-DD",
                                                        "dataProvider": dataParam,

                                                        "addClassNames": true,
                                                        "startDuration": 1,
                                                        //"color": "#FFFFFF",
                                                        "marginLeft": 0,

                                                        "categoryField": "Time",
                                                        "categoryAxis": {
                                                            "parseDates": false,
                                                            // "minPeriod": "DD",
                                                            "autoGridCount": false,
                                                            "gridCount": 50,
                                                            "gridAlpha": 0.1,
                                                            "gridColor": "#FFFFFF",
                                                            "axisColor": "#555555"
                                                        },

                                                        "valueAxes": [{
                                                            "id": "a1",
                                                            "title": "quatity",
                                                            "gridAlpha": 0,
                                                            "axisAlpha": 0
                                                        }],
                                                        "graphs": [{
                                                            "id": "g1",
                                                            "valueField": "Line",
                                                            "title": "Line",
                                                            "type": "column",
                                                            "fillAlphas": 0.9,
                                                            "valueAxis": "a1",
                                                            "balloonText": "[[value]] qty",
                                                            "legendValueText": "[[value]] qty",
                                                            "legendPeriodValueText": "total: [[value.sum]] qty",
                                                            "lineColor": "#428bca",
                                                            "alphaField": "alpha"
                                                        }, {
                                                            "id": "g2",
                                                            "valueField": "ManQuantity",
                                                            "classNameField": "bulletClass",
                                                            "title": "Labor",
                                                            "type": "line",
                                                            "valueAxis": "a1",
                                                            "lineColor": "#333300",
                                                            "lineThickness": 1,
                                                            "legendValueText": "[[value]]/[[description]]",
                                                            "bullet": "round",
                                                                "bulletBorderColor": "#333300	",
                                                            "bulletBorderAlpha": 1,
                                                            "bulletBorderThickness": 1,
                                                                "bulletColor": "#333300	",
                                                            "labelPosition": "right",
                                                            "balloonText": "Man Qty:[[value]]",
                                                            "showBalloon": true,
                                                            "animationPlayed": true
                                                        }, {
                                                            "id": "g3",
                                                            "title": "Target",
                                                            "valueField": "Target",
                                                            "type": "line",
                                                            "valueAxis": "a1",
                                                            "lineColor": "#006600",
                                                            "balloonText": "[[value]]",
                                                            "lineThickness": 4,
                                                            "legendValueText": "[[value]]",
                                                            "bullet": "square",
                                                            "bulletBorderColor": "#006600",
                                                            "bulletBorderThickness": 1,
                                                            "bulletBorderAlpha": 1,
                                                            "dashLengthField": "dashLength",
                                                            "animationPlayed": true
                                                        }],

                                                        "chartCursor": {
                                                            "zoomable": false,
                                                            "categoryBalloonDateFormat": "DD",
                                                            "cursorAlpha": 0,
                                                            "valueBalloonsEnabled": false
                                                        },
                                                        "legend": {
                                                            "bulletType": "round",
                                                            "equalWidths": false,
                                                            "valueWidth": 120,
                                                            "useGraphSettings": true
                                                            //"color": "#FFFFFF"
                                                        }
                                                    });

                                                });

                                            </script>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="col-12 col-md-5">
                <div class="row">
                    <div class="col-3">
                        <div class="card">
                            <img class="card-img-top" src="~/images/user.jpg" alt="Card image cap">
                            <div class="card-body">
                                <h3>PD: Vũ Văn Công</h3>
                                <h3>(SVN0003)</h3>
                            </div>
                        </div>
                        
                    </div>
                    <div class="col-3">
                        <div class="card">
                            <img class="card-img-top" src="~/images/user.jpg" alt="Card image cap">
                            <div class="card-body">
                                <h3>QC: Vũ Thị Lan Anh</h3>
                                <h3>(SVN0334)</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card">
                            <div class="card-body" style="text-align:center">
                                <h3>Achieve</h3>
                                <canvas id="foo" width="400" height="200"></canvas>
                                <h3>92 %</h3>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
