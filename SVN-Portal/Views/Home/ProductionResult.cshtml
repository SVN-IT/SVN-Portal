@using Newtonsoft.Json
@using System.Globalization
@model IEnumerable<QtyProdResultByOperViewModel>
@{
    ViewData["Title"] = "Home Page";
    DateTime date = ViewBag.date;
}
<script>
    var dataParam;
    function BuildProductionChart(dataParam, chartID){
    dataParam = dataParam.map(item => ({
    ...item,
    Time: `${item.Time}\nLine: ${item.Line}` // Concatenate Line value with Time
    }));
    var chart = AmCharts.makeChart(chartID, {
    "type": "serial",
    "theme": "light",

    "dataDateFormat": "YYYY-MM-DD",
    "dataProvider": dataParam,

    "addClassNames": true,
    "startDuration": 0,
    "color": "#FFFFFF",
    "fontSize": 20,
    "marginLeft": 0,

    "categoryField": "Time",
    "categoryAxis": {
    "parseDates": false,
    // "minPeriod": "DD",
    "autoGridCount": false,
    "gridCount": 50,
    "gridAlpha": 0.1,
    "gridColor": "#FFFFFF",
    "axisColor": "#555555"
    },

    "valueAxes": [{
    "id": "a1",
    "title": "Qty",
    "gridAlpha": 0,
    "axisAlpha": 0
    }],
    "graphs": [{
    "id": "g1",
    "valueField": "Line",
    "title": "Line",
    "type": "column",
    "fillAlphas": 0.9,
    "valueAxis": "a1",
    "balloonText": "[[value]] qty",
    "legendValueText": "[[value]] qty",
    "legendPeriodValueText": "total: [[value.sum]]",
    "lineColor": "#428bca",
    "alphaField": "alpha"
    }, {
    "id": "g2",
    "valueField": "ManQuantity",
    "classNameField": "bulletClass",
    "title": "Labor",
    "type": "line",
    "valueAxis": "a1",
    "lineColor": "#FF0000",
    "lineThickness": 1,
    "legendValueText": "[[value]]",
    "legendPeriodValueText": "[[value]]",
    "bullet": "round",
    "bulletBorderColor": "#FF0000",
    "bulletBorderAlpha": 1,
    "bulletBorderThickness": 1,
    "bulletColor": "#FF0000",
    "labelPosition": "right",
    "balloonText": "Man Qty:[[value]]",
    "showBalloon": true,
    "animationPlayed": false,
    "labelText": "[[value]]",
    "labelPosition": "bottom", // Giá trị nằm trên điểm của đường
    "labelColor": "#FF0000", // Màu chữ trên đường
    }, {
    "id": "g3",
    "title": "Target",
    "valueField": "Target",
    "type": "line",
    "valueAxis": "a1",
    "lineColor": "#006600",
    "balloonText": "[[value]]",
    "lineThickness": 4,
    "legendValueText": "[[value]]",
    "legendPeriodValueText": "total: [[value.sum]]",
    "bullet": "square",
    "bulletBorderColor": "#006600",
    "bulletBorderThickness": 1,
    "bulletBorderAlpha": 1,
    "dashLengthField": "dashLength",
    "animationPlayed": false,
    "labelText": "[[value]]",
    "labelPosition": "top", // Giá trị nằm trên điểm của đường
    "labelColor": "#006600", // Màu chữ trên đường
    }],

    "chartCursor": {
    "zoomable": false,
    "categoryBalloonDateFormat": "DD",
    "cursorAlpha": 0,
    "valueBalloonsEnabled": false
    },
    "legend": {
    "bulletType": "round",
    "equalWidths": false,
    "valueWidth": 120,
    "useGraphSettings": true,
    "color": "#FFFFFF"
    }
    });
    }

    function BuildDefectPieChart(dataParam, chartID) {
    var chart = AmCharts.makeChart(chartID, {
    "type": "pie",
    "addClassNames": true,
    "startDuration": 0,
    // "classNameField": "class",
    "dataProvider": dataParam,
    "valueField": "value",
    "categoryField": "category",
    "labelRadius": 10,  // Adjust label radius
    "radius": "42%",
    "innerRadius": "60%",
    "labelText": "", //[[category]]
    "labelColorField": "color",
    "labelFontSize": 14,
    "labelColor": "#FFFFFF",
    // "export": {
    //     "enabled": true
    // },
    "labelPosition": "outside",
    "fontSize": 14,
    "fontColor": "#FFFFFF",
    "animationPlayed": false,
    "color": "#FFFFFF",
    "colors": ["#4680ff", "#0ca6dc", "#6845fb"],
    // Configure legend
    "legend": {
    "enabled": true,                        // Bật legend
    "position": "bottom",                   // Đặt legend ở dưới biểu đồ
    "marginTop": 10,                        // Khoảng cách trên cùng của legend
    "marginBottom": 10,                     // Khoảng cách dưới cùng của legend
    "labelWidth": 150,                      // Độ rộng của nhãn trong legend
    "markerType": "circle",                 // Loại marker trong legend (có thể là "square", "circle", v.v.)
    "fontSize": 14,                         // Kích thước font chữ của legend
    "color": "#FFFFFF",                     // Màu chữ của legend
    "valueText": "[[category]]: [[value]]", // Định dạng giá trị hiển thị trong legend
    "valueWidth": 100,                      // Độ rộng của phần hiển thị giá trị trong legend
    "markerLabelGap": 10,
    "valueAlign": "left"
    }
    });
    }

    var charIDs = [];
</script>

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="row">
                        <div class="col-9">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-3">
                            <button type="submit" asp-route-companyCode="@ViewBag.CompanyCode" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-8 col-lg-9">
                    <h1 class="float-right">@ViewBag.ComparePeople</h1>
                </div>
            </div>
        </form>
    </div>
    @if(Model != null)
    {
        foreach (var item in Model)
        {
            string currentTime = string.Empty;
            foreach (var subitem in item.ViewModels)
            {
                if (!string.IsNullOrWhiteSpace(subitem.Time))
                {
                    var times = subitem.Time.Split('-');
                    DateTime today = date;

                    // Chuyển đổi thành định dạng HH:mm
                    string startTime = times[0].Replace("h", ":");
                    if (startTime.Last() == ':')
                    {
                        startTime = startTime + "00";
                    }
                    if (startTime.Length == 4)
                    {
                        startTime = "0" + startTime;
                    }

                    string endTime = times[1].Replace("h", ":");
                    if (endTime.Last() == ':')
                    {
                        endTime = endTime + "00";
                    }
                    if (endTime.Length == 4)
                    {
                        endTime = "0" + endTime;
                    }

                    // Tạo đối tượng DateTime với ngày hôm nay và giờ từ chuỗi
                    DateTime startDatetime = DateTime.ParseExact(today.ToString("yyyy-MM-dd") + " " + startTime, "yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
                    DateTime endDatetime = DateTime.ParseExact(today.ToString("yyyy-MM-dd") + " " + endTime, "yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
                    if (startDatetime <= DateTime.Now && endDatetime >= DateTime.Now)
                    {
                        currentTime = subitem.Time;
                    }
                }
            }
            string charID = "chartdiv" + item.Operation;
            charID = charID.Replace("-", "");
            if (charID.Contains("(SM)"))
            {
                charID = charID.Replace("(SM)", "");
            }
            string jsonData = string.Empty;
            string defectData = string.Empty;
            string disableStatus = string.Empty;
            string hideStatus = string.Empty;
            jsonData = JsonConvert.SerializeObject(item.ViewModels);
            defectData = JsonConvert.SerializeObject(item.DefectByCategoryViewModels);
            if (item.IsProduction == false)
            {
                disableStatus = "card-disable";
            }
            @* else
            {
                hideStatus = "d-none";
            } *@
            <style>
                #@charID {
                height: 500px;
                width: 100%;
                }

                #chartPie_@charID{
                height:290px;
                width: 100%;
                }
            </style>
            <div class="col-lg-@appConfig.ChartCol">
                <div id="disableCard_@charID" class="no-production d-none">Chưa làm Checklist</div>@* Chưa làm Checklist *@
                <div id="disableCardDowntime_@charID" class="no-production-by-downtime d-none"></div>
                <div id="bigCard_@charID" class="card svn-card @disableStatus">

                    <div class="card-title">
                        @{
                            string productName = string.Empty;
                            if (!string.IsNullOrWhiteSpace(item.Name))
                            {
                                productName = "(" + item.Name + ")";
                            }
                        }
                        <div class="row">
                            <div class="col-12">
                                <h4>
                                    @item.Operation @productName
                                    <br />
                                    <br />
                                    @{
                                        string techName = !string.IsNullOrWhiteSpace(item.TechName) ? " - " + item.TechName : "";

                                    }
                                    <p style="font-size:20px" class=" text-light"> @item.PDName - @item.QCName  @techName</p>
                                </h4>
                            </div>
                            <div id="checklistStatus-@charID" class="col-12">
                                @* <p style="font-size:20px" class=" text-light"> <strong>Checklist status</strong>: 🔴 PD - 🔴 MT - 🔴 QC Checked | 🔴 PD - 🔴 QC Confirmed </p> *@
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div id="achieveCard_@charID" class="target-container">
