                                                <span> | Cur: @Math.Round(subitem.Current, 2) %</span> <br />
                                                <span>
                                                    <strong class="f-s-23">Rate:</strong> <strong class="rate-box @status f-s-23">@Math.Round(subitem.Percent, 2) %</strong>
                                                </span>
                                            }
                                            else
                                            {
                                                <span>Tar: @Math.Round(subitem.Target, 2)</span>
                                                <span> | Cur: @Math.Round(subitem.Current, 2)</span> <br />
                                                <span>
                                                    <strong class="f-s-23">Rate:</strong> <strong class="rate-box @status f-s-23">@Math.Round(subitem.Percent, 2) %</strong>
                                                </span>
                                            }
                                        </div>
                                        @* @if (subitem.Item == "Defect")
                                        {
