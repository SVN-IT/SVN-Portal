                                    }
                                    else if (item.Forecast > 75 && item.Forecast <= 100)
                                    {
                                        <span style="font-size:60px;">🌥️</span>
                                    }
                                    else if (item.Forecast > 50 && item.Forecast <= 75)
                                    {
                                        <span style="font-size:60px;">☁️</span>
                                    }
                                    else if (item.Forecast > 30 && item.Forecast <= 50)
                                    {
                                        <span style="font-size:60px;">🌦️</span>
                                    }
                                    else if (item.Forecast > 10 && item.Forecast <= 30)
                                    {
                                        <span style="font-size:60px;">🌧️</span>
                                    }
                                    else
                                    {
                                        <span style="font-size:60px;">⚡</span>
                                    }
                                
                                    <h4 class="mt-3 text-center">@item.Forecast %</h4>
                                    <h3 class="mt-3 text-center">Forecast Achievement</h3>
                                </div>
                                <div class="col-12">
                                    <div id="chartPie_@charID"></div>
                                    <h3 class="mt-3 text-center">Defect by category</h3>
                                </div>
                            
                            </div>
                        </div>
                    
                        <script>
                            $(document).ready(function () {
                                var dataParam = @Html.Raw(jsonData);

                                var defectParam = @Html.Raw(defectData);

                                BuildProductionChart(dataParam, @charID)
                                BuildDefectPieChart(defectParam, "chartPie_@charID")

                                charIDs.push({
                                    charID: "@charID",
                                    date: "@date.ToString("yyyyMMdd")",
                                    oper: "@item.Operation",
                                    wc: "@item.WC"
                                })
                            });

                        </script>
                    </div>
                </div>
            </div>
        }
    }
</div>
<script>
    function fetchChartData(charID, date, oper, wc) {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/Home/GetDataByOperAndWCMainDashBoard',
                type: 'POST',
                data: {
                    date: date,
                    oper: oper,
                    wc: wc
                },
                success: function (response) {
                    if (response.result) {
                        // Clear content first
                        $(`#achieveCard_${charID}`).empty();
                        $(`#divForecast_${charID}`).empty();

                        // Populate content after clearing
                        $(`#achieveCard_${charID}`).html(response.targetTable);
                        $(`#divForecast_${charID}`).html(response.forecase);

                        var pdData = JSON.parse(response.pdmodel);

                        $('#checklistStatus-' + charID).html(response.checklistStatus);

                        if(response.canProduction)
                        {
                            $(`#disableCard_${charID}`).addClass("d-none");
                        }
                        else
                        {
                            $(`#disableCard_${charID}`).removeClass("d-none");
                        }

                        if(response.canProductionByDowntime)
                        {
                            $(`#disableCardDowntime_${charID}`).addClass("d-none");
                        }
                        else
                        {
                            $(`#disableCardDowntime_${charID}`).removeClass("d-none");
                            $(`#disableCardDowntime_${charID}`).html(response.downTimeStatus);
                        }

                        if(response.isProduction)
                        {
                            $(`#bigCard_${charID}`).removeClass("card-disable");
                            // $(`#disableCard_${charID}`).addClass("d-none");
                        }
                        else
                        {
                            $(`#bigCard_${charID}`).addClass("card-disable");
                            // $(`#disableCard_${charID}`).removeClass("d-none");
                        }

                        // Build charts for this charID
                        BuildProductionChart(pdData, charID);

                        var defectParam = JSON.parse(response.defectcalmodel);

                        BuildDefectPieChart(defectParam, "chartPie_" + charID)

                        resolve(); // Mark AJAX call as complete
                    } else {
                        // console.error("Error: " + response.message);
                        reject(response.message); // Handle failure
                    }
                },
                error: function (xhr, status, error) {
                    // console.error("AJAX Error: " + status + ", " + error);
                    reject(error); // Reject promise on AJAX error
                }
            });
        });
    }

    $(document).ready(function () {
        async function executeSequentialCalls(charIDs) {
            for (const charID of charIDs) {
                try{
                    await fetchChartData(charID.charID, charID.date, charID.oper, charID.wc);
                } catch (error) {
                    // console.error("Error fetching data for " + charID.charID + ": " + error);
                }
            }
            setTimeout(async () => {await executeSequentialCalls(charIDs)}, 10000);
        }
        executeSequentialCalls(charIDs);
    });
