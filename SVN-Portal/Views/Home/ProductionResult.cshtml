                                                    {
                                                        if (item.IsProduction)
                                                        {
                                                            alert = "blinking-warning";
                                                        }
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                if (subitem.Percent > 0 && subitem.Percent <= 75)
                                                {
                                                    status = "bg-danger";
                                                    if (item.IsProduction)
                                                    {
                                                        alert = "blinking";
                                                    }
                                                }
                                                else if (subitem.Percent > 100)
                                                {
                                                    status = "bg-primary";
                                                    if (subitem.Item == "H.Plan")
                                                    {
                                                        if (item.IsProduction)
                                                        {
                                                            alert = "blinking-warning";
                                                        }
                                                    }
                                                }
                                                else if (subitem.Percent > 75 && subitem.Percent <= 92)
                                                {
                                                    status = "bg-warning";
                                                }
                                                else
                                                {
                                                    status = "bg-primary";
                                                }
                                            }
                                        }
                                        else
                                        {
                                            if (subitem.Percent > 0 && subitem.Percent <= 75)
                                            {
                                                status = "bg-danger";
                                                if (item.IsProduction)
                                                {
                                                    alert = "blinking";
                                                }
                                            }
                                            else if (subitem.Percent > 100)
                                            {
                                                status = "bg-primary";
                                                if (subitem.Item == "H.Plan")
                                                {
                                                    if (item.IsProduction)
                                                    {
                                                        alert = "blinking-warning";
                                                    }
                                                }
                                            }
                                            else if (subitem.Percent > 75 && subitem.Percent <= 92)
                                            {
                                                status = "bg-warning";
                                            }
                                            else
