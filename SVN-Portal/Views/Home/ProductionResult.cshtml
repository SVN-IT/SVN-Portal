<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="row">
                        <div class="col-9">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-3">
                            <button type="submit" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    @foreach (var item in Model)
    {
        string charID = "chartdiv" + item.Operation;
        string jsonData = string.Empty;
        jsonData = JsonConvert.SerializeObject(item.ViewModels);
        <style>
            #@charID {
            height: 450px;
            width: 100%;
            }
        </style>
        <div class="col-lg-@appConfig.ChartCol">
            <div class="card svn-card">
                <div class="card-title">
                    <h4>
                        @item.Operation
                        <br />
                        <br />
                        <p style="font-size:20px" class=" text-light"> @item.PDName - @item.QCName </p>

                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="target-container">
                            @foreach (var subitem in item.TargetViewModels)
                            {
                                string cardColor = string.Empty;
                                if (subitem.Item == "Daily Plan")
                                {
                                    cardColor = "bg-dailyPlan";
                                }
                                else if (subitem.Item == "UPH")
                                {
                                    cardColor = "bg-uph";
                                }
                                else if (subitem.Item == "UPPH")
                                {
                                    cardColor = "bg-upph";
                                }
                                else if (subitem.Item == "Labor")
                                {
                                    cardColor = "bg-labor";
                                }
                                else if (subitem.Item == "Defect")
                                {
                                    cardColor = "bg-defect";
                                }
                                <div class="target-item @cardColor">
                                    @{
                                        string status = string.Empty;
                                    }
                                    @if (subitem.Item == "Defect")
                                    {
                                        if (subitem.Percent > 100)
                                        {

                                            status = "bg-danger";
                                        }
                                        else if (subitem.Percent > 75 && subitem.Percent <= 100)
                                        {
                                            status = "bg-warning";
                                        }
                                        else
                                        {
                                            status = "bg-primary";
                                        }
                                    }
                                    else
                                    {

                                        if (subitem.Percent > 0 && subitem.Percent <= 75)
                                        {
                                            status = "bg-danger";
                                        }
                                        else if (subitem.Percent > 75 && subitem.Percent <= 92)
                                        {
                                            status = "bg-warning";
                                        }
                                        else
                                        {
                                            status = "bg-primary";
                                        }
                                    }

                                    <div>
                                        @if (subitem.Item == "Daily Plan")
                                        {
                                            <strong>📅 @subitem.Item</strong>

                                            <br>
                                        }
                                        else if (subitem.Item == "UPH")
                                        {
                                            <strong>⚙️ @subitem.Item</strong>

                                            <br>
                                        }
                                        else if (subitem.Item == "UPPH")
                                        {
                                            <strong>📈 @subitem.Item</strong>

                                            <br>
                                        }
                                        else if (subitem.Item == "Labor")
                                        {
                                            <strong>👷 @subitem.Item</strong>

                                            <br>
                                        }
                                        else if (subitem.Item == "Defect")
                                        {
                                            <strong><span style="filter: brightness(0) invert(1);">❌</span> @subitem.Item</strong>

                                            <br>
                                        }
                                        
                                        @if (subitem.Item == "Defect")
                                        {
                                            <span>Tar: @Math.Round(subitem.Target, 2) %</span>
                                            <span> | Cur: @Math.Round(subitem.Current, 2) %</span> <br />
                                            <span>
                                                <strong class="f-s-26">Rate:</strong> <strong class="rate-box @status f-s-26">@Math.Round(subitem.Percent, 2) %</strong>
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Tar: @Math.Round(subitem.Target, 2)</span>
                                            <span> | Cur: @Math.Round(subitem.Current, 2)</span> <br />
                                            <span>
                                                <strong class="f-s-26">Rate:</strong> <strong class="rate-box @status f-s-26">@Math.Round(subitem.Percent, 2) %</strong>
                                            </span>
                                        }
                                    </div>
                                    @* @if (subitem.Item == "Defect")
                                    {
                                        <span>
                                            <strong class="f-s-26">Rate:</strong> <br />
                                            <strong class="@status f-s-26">@Math.Round(subitem.Percent, 2) %</strong>
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            <strong class="f-s-26">Rate:</strong> <br />
                                            <strong class="@status f-s-26">@Math.Round(subitem.Percent, 2) %</strong>
                                        </span>
                                    } *@
                                </div>

                                
                            }
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-9 border-right">
                            <div id=@charID></div>
                        </div>
                        <div class="col-12 col-md-3">
                            <canvas id="pieChart_@charID" width="250" height="250"></canvas>
                            <h3 class="mt-3 text-center">Defect by category</h3>
                        </div>
                    </div>
                    
                    <script>
                        $(document).ready(function () {
                            var dataParam = @Html.Raw(jsonData);
                            dataParam = dataParam.map(item => ({
                                ...item,
                                Time: `${item.Time} (Line: ${item.Line})` // Concatenate Line value with Time
                            }));
                            var chart = AmCharts.makeChart(@charID, {
                                "type": "serial",
                                "theme": "light",

                                "dataDateFormat": "YYYY-MM-DD",
                                "dataProvider": dataParam,

                                "addClassNames": true,
                                "startDuration": 1,
                                "color": "#FFFFFF",
                                "marginLeft": 0,

                                "categoryField": "Time",
                                "categoryAxis": {
                                    "parseDates": false,
                                    // "minPeriod": "DD",
                                    "autoGridCount": false,
                                    "gridCount": 50,
                                    "gridAlpha": 0.1,
                                    "gridColor": "#FFFFFF",
                                    "axisColor": "#555555"
                                },

                                "valueAxes": [{
                                    "id": "a1",
                                    "title": "quatity",
                                    "gridAlpha": 0,
                                    "axisAlpha": 0
                                }],
                                "graphs": [{
                                    "id": "g1",
                                    "valueField": "Line",
                                    "title": "Line",
                                    "type": "column",
                                    "fillAlphas": 0.9,
                                    "valueAxis": "a1",
                                    "balloonText": "[[value]] qty",
                                    "legendValueText": "[[value]] qty",
                                    "legendPeriodValueText": "total: [[value.sum]] qty",
                                    "lineColor": "#428bca",
                                    "alphaField": "alpha"
                                }, {
                                    "id": "g2",
                                    "valueField": "ManQuantity",
                                    "classNameField": "bulletClass",
                                    "title": "Labor",
                                    "type": "smoothedLine",
                                    "valueAxis": "a1",
                                    "lineColor": "#FF0000",
                                    "lineThickness": 1,
                                    "legendValueText": "[[value]]/[[description]]",
                                    "bullet": "round",
                                        "bulletBorderColor": "#FF0000",
                                    "bulletBorderAlpha": 1,
                                    "bulletBorderThickness": 1,
                                        "bulletColor": "#FF0000",
                                    "labelPosition": "right",
                                    "balloonText": "Man Qty:[[value]]",
                                    "showBalloon": true,
                                    "animationPlayed": true,
                                    "labelText": "[[value]]",
                                    "labelPosition": "bottom", // Giá trị nằm trên điểm của đường
                                    "labelColor": "#FF0000", // Màu chữ trên đường
                                }, {
                                    "id": "g3",
                                    "title": "Target",
                                    "valueField": "Target",
                                    "type": "smoothedLine",
                                    "valueAxis": "a1",
                                    "lineColor": "#006600",
                                    "balloonText": "[[value]]",
                                    "lineThickness": 4,
                                    "legendValueText": "[[value]]",
                                    "bullet": "square",
                                    "bulletBorderColor": "#006600",
                                    "bulletBorderThickness": 1,
                                    "bulletBorderAlpha": 1,
                                    "dashLengthField": "dashLength",
                                    "animationPlayed": true,
                                    "labelText": "[[value]]",
                                    "labelPosition": "top", // Giá trị nằm trên điểm của đường
                                    "labelColor": "#006600", // Màu chữ trên đường
                                }],

                                "chartCursor": {
                                    "zoomable": false,
                                    "categoryBalloonDateFormat": "DD",
                                    "cursorAlpha": 0,
                                    "valueBalloonsEnabled": false
                                },
                                "legend": {
                                    "bulletType": "round",
                                    "equalWidths": false,
                                    "valueWidth": 120,
                                    "useGraphSettings": true,
                                    "color": "#FFFFFF"
                                }
                            });

                            new Chart(document.getElementById("pieChart_@charID"), {
                              type: 'pie',
                              data: {
                                labels: ["Surface", "Alignment", "Electrical"],
                                datasets: [{
                                  label: "Defects",
                                  data: [50, 30, 20]
                                }]
                              },
                              options: {
                                plugins: { legend: { labels: { color: "#fff" } } },
                                responsive: false
                              }
                            });
                        });

                    </script>
                </div>
            </div>
        </div>
    }


