                                            // Chuyển đổi thành định dạng HH:mm
                                            string startTime = times[0].Replace("h", ":");
                                            if (startTime.Last() == ':')
                                            {
                                                startTime = startTime + "00";
                                            }
                                            if (startTime.Length == 4)
                                            {
                                                startTime = "0" + startTime;
                                            }

                                            string endTime = times[1].Replace("h", ":");
                                            if (endTime.Last() == ':')
                                            {
                                                endTime = endTime + "00";
                                            }
                                            if (endTime.Length == 4)
                                            {
