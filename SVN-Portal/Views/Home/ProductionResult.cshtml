                                                <br>
                                            }
                                            else if (subitem.Item == "Defect")
                                            {
                                                <strong class="f-s-26">❌ <span class="@textColor">@subitem.Item</span></strong>

                                                <br>
                                            }
                                        
                                            @if (subitem.Item == "Defect")
                                            {
