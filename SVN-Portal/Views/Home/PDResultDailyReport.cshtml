@using Newtonsoft.Json
@using SVNShareLib.DTO
@model IEnumerable<PDResultDailyViewModel>
@{

    DateTime date = ViewBag.date;
    ViewData["Title"] = "Production Result Daily";
}

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="row">
                        <div class="col-9">
                            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-3">
                            <button type="submit" asp-action="PDResultDailyReport" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="card svn-card">
            <div class="card-title">
                <h4>Production Result Daily</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Operation active</th>
                                <th scope="col">Daily Plan Achieve</th>
                                <th scope="col">UPH</th>
                                <th scope="col">UPPH</th>
                                <th scope="col">Labor</th>
                                <th scope="col">Defect rate</th>
                                <th scope="col">Check list on system</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model)
                            {
                                <tr>
                                    <th scope="row">@item.OperationActive</th>
                                    <td>@item.DailyPlanAchieve</td>
                                    <td>@item.UPH</td>
                                    <td>@item.UPPH</td>
                                    <td>@item.Labor</td>
                                    <td>@item.DefectRate</td>
                                    <td>@item.CheckListOnSystem</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
            </div>
        </div>
    </div>

</div>
