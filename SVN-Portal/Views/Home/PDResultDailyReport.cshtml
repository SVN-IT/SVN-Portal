@using Newtonsoft.Json
@using SVNShareLib.DTO
@model IEnumerable<PDResultDailyViewModel>
@{

    DateTime fromdate = ViewBag.FromDate;
    DateTime todate = ViewBag.ToDate;
    ViewData["Title"] = "Production Result Daily";
    string jsonData = string.Empty;
    jsonData = JsonConvert.SerializeObject(Model);
    string abc = "abc";
}

<div class="row">
    <div class="col-lg-12">
        <form method="post">
            <div class="form-group row">
                <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-3">
                            <input type="date" name="fromdate" value="@fromdate.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <input type="date" name="todate" value="@todate.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <button type="submit" asp-action="PDResultDailyReport" class="btn btn-primary">
                                Search
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <button type="submit" asp-action="ExportPDResultDaily" class="btn btn-success">
                                Export excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-12">
        <div class="card svn-card">
            <div class="card-title">
                <h4>Production Result Daily</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <table class="table">
                        <thead>
                            <tr>
                                <th rowspan="2" scope="col">Operation active</th>
                                <th colspan="3" scope="col">Daily Plan Achieve</th>
                                <th rowspan="2" scope="col">UPH</th>
                                <th rowspan="2" scope="col">UPPH</th>
                                <th rowspan="2" scope="col">Labor</th>
                                <th colspan="3" scope="col">Defect rate</th>
                                <th rowspan="2" scope="col">Check list on system</th>
                                <th rowspan="2" scope="col">Remark</th>
                            </tr>
                            <tr>
                                <th>Target</th>
                                <th>Current</th>
                                <th>%</th>
                                <th>Target rate</th>
                                <th>Current rate</th>
                                <th>%</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count() > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <th scope="row">@item.OperationActive</th>
                                        <td>@item.DailyPlanTarget</td>
                                        <td>@item.DailyPlanCurrent</td>
                                        <td>@item.DailyPlanAchieve</td>
                                        <td>@item.UPH</td>
                                        <td>@item.UPPH</td>
                                        <td>@item.Labor</td>
                                        <td>@item.DefectTargetRate</td>
                                        <td>@item.DefectCurrentRate</td>
                                        <td>@item.DefectRate</td>
                                        <td>@item.CheckListOnSystem</td>
                                        <td>@item.Remark</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                
            </div>
        </div>
    </div>
    <h2>Daily Plan Achieve</h2>
    <div id="dailyPlanChart" style="width:100%;height:400px;"></div>

    <h2>UPH & UPPH (%)</h2>
    <div id="uphChart" style="width:100%;height:400px;"></div>

    <h2>Labor (%)</h2>
    <div id="laborChart" style="width:100%;height:400px;"></div>

    <h2>Defect Rate</h2>
    <div id="defectChart" style="width:100%;height:400px;"></div>

    <script>
        // Data chung
        var chartData = @Html.Raw(jsonData);

        chartData = chartData.map(function(item) {
            return {
                OperationActive: item.OperationActive,
                DailyPlanTarget: parseFloat(item.DailyPlanTarget),
                DailyPlanCurrent: parseFloat(item.DailyPlanCurrent),
                DailyPlanAchieve: parseFloat((item.DailyPlanAchieve || "0").replace("%","")),
                UPH: parseFloat((item.UPH || "0").replace("%","")),
                UPPH: parseFloat((item.UPPH || "0").replace("%","")),
                Labor: parseFloat((item.Labor || "0").replace("%","")),
                DefectTargetRate: parseFloat((item.DefectTargetRate || "0").replace("%","")),
                DefectCurrentRate: parseFloat((item.DefectCurrentRate || "0").replace("%","")),
                DefectRate: parseFloat((item.DefectRate || "0").replace("%","")),
                CheckListOnSystem: item.CheckListOnSystem,
                Remark: item.Remark
            };
        });

        // 1. Daily Plan Achieve
        AmCharts.makeChart("dailyPlanChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 20,
            "marginLeft": 0,

            "valueAxes": [{
                "id": "v1",
                "position": "left",
                "title": "Qty"
            }, {
                "id": "v2",
                "position": "right",
                "title": "% Achieve",
                "axisAlpha": 0,
                "gridAlpha": 0
            }],
            "graphs": [{
                "balloonText": "Target: [[value]]",
                "legendValueText": "Target: [[value]]",
                "labelText": "Target: [[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Target",
                "valueField": "DailyPlanTarget",
                "valueAxis": "v1",
                "fillColors": "#FFCE56"
            }, {
                "balloonText": "Actual: [[value]]",
                "legendValueText": "Actual: [[value]]",
                "labelText": "Actual: [[value]]",
                "fillAlphas": 0.7,
                "lineAlpha": 0.2,
                "type": "column",
                "title": "Current",
                "valueField": "DailyPlanCurrent",
                "valueAxis": "v1",
                "fillColors": "#36A2EB"
            }, {
                "id": "g2",
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 1,
                "type": "line",
                "title": "%Achieve",
                "valueField": "DailyPlanAchieve",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "Achieve: [[value]] %",
                "legendValueText": "Achieve: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "Achieve: [[value]] %",
                "labelPosition": "top",
                "lineColor": "#FF0000"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });

        // 2. UPH & UPPH
        AmCharts.makeChart("uphChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 20,
            "marginLeft": 0,

            "valueAxes": [{
                "title": "%"
            }],
            "graphs": [{
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 2,
                "type": "line",
                "title": "UPH %",
                "valueField": "UPH",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "UPH: [[value]] %",
                "legendValueText": "UPH: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "UPH: [[value]] %",
                "labelPosition": "top",
                "fillColors": "#4BC0C0"
            }, {
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 2,
                "type": "line",
                "title": "UPPH %",
                "valueField": "UPPH",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "UPPH: [[value]] %",
                "legendValueText": "UPPH: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "UPPH: [[value]] %",
                "labelPosition": "bottom",
                "fillColors": "#9966FF"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });

        // 3. Labor %
        AmCharts.makeChart("laborChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 20,
            "marginLeft": 0,

            "valueAxes": [{
                "title": "Labor %"
            }],
            "graphs": [{
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 2,
                "type": "line",
                "title": "Labor %",
                "valueField": "Labor",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "Labor: [[value]] %",
                "legendValueText": "Labor: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "Labor: [[value]] %",
                "labelPosition": "top",
                "fillColors": "#FF9F40"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });

        // 4. Defect Rate
        AmCharts.makeChart("defectChart", {
            "type": "serial",
            "theme": "light",
            "dataProvider": chartData,

            "addClassNames": true,
            "startDuration": 0,
            "color": "#FFFFFF",
            "fontSize": 20,
            "marginLeft": 0,

            "valueAxes": [{
                "title": "Defect %"
            }],
            "graphs": [{
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 2,
                "type": "line",
                "title": "Defect Target",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "Target: [[value]] %",
                "legendValueText": "Target: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "Target: [[value]] %",
                "labelPosition": "top",
                "valueField": "DefectTargetRate",
                "fillColors": "#FF6384"
            }, {
                "classNameField": "bulletClass",
                "bullet": "line",
                "lineThickness": 2,
                "type": "line",
                "valueAxis": "v2",
                "showBalloon": true,
                "animationPlayed": false,
                "balloonText": "Current: [[value]] %",
                "legendValueText": "Current: [[value]] %",
                "bullet": "round",
                "bulletBorderColor": "#006600",
                "bulletBorderThickness": 1,
                "bulletBorderAlpha": 1,
                "dashLengthField": "dashLength",
                "labelText": "Current: [[value]] %",
                "labelPosition": "bottom",
                "title": "Defect Current",
                "valueField": "DefectCurrentRate",
                "fillColors": "#36A2EB"
            }],
            "categoryField": "OperationActive",
            "categoryAxis": {
                "gridPosition": "start"
            },
            "legend": {
                "bulletType": "round",
                "equalWidths": false,
                "valueWidth": 120,
                "useGraphSettings": true,
                "color": "#FFFFFF"
            }
        });
    </script>
</div>
