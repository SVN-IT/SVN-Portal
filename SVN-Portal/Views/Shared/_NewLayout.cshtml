<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon.png">
    <title>@ViewData["Title"] - SVN_Portal</title>
    <link href="~/lib/amchart/export.css" rel="stylesheet" />
    <!-- Bootstrap Core CSS -->
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/SVN_Portal.styles.css" asp-append-version="true" /> *@
    <!-- Custom CSS -->
    <link href="~/css/helper.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
    <!-- All Jquery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <!-- slimscrollbar scrollbar JavaScript -->
    <script src="~/js/jquery.slimscroll.js"></script>
    <!--Menu sidebar -->
    <script src="~/js/sidebarmenu.js"></script>
    <!--stickey kit -->
    <script src="https://bernii.github.io/gauge.js/dist/gauge.min.js"></script>
    <script src="~/lib/sticky-kit-master/dist/sticky-kit.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Amchart -->
    <script src="~/lib/chart-amchart/amcharts.js"></script>
    <script src="~/lib/chart-amchart/serial.js"></script>
    <script src="~/lib/chart-amchart/export.min.js"></script>
    <script src="~/lib/chart-amchart/light.js"></script>
    <script src="~/lib/chart-amchart/ammap.js"></script>
    <script src="~/lib/chart-amchart/worldlow.js"></script>
    <script src="~/lib/chart-amchart/pie.js"></script>
    <script src="~/lib/chart-amchart/amstock.js"></script>
    <script src="~/lib/chart-amchart/amchart-init.js"></script>
    <script>
        var timeBeforeReload = @appConfig.TimeBeforeReload;
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!--Custom JavaScript -->
    <script src="~/js/scripts.js"></script>
</head>
<body class="mini-sidebar">
    <!-- Preloader - style you can find in spinners.css -->
    <div class="preloader">
        <svg class="circular" viewBox="25 25 50 50">
            <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="2" stroke-miterlimit="10" />
        </svg>
    </div>
    <!-- Main wrapper  -->
    <div id="main-wrapper d-flex flex-column h-100">
        <div class="header">
            <nav class="navbar top-navbar navbar-expand-md navbar-light">
                <!-- Logo -->
                <div class="navbar-header">
                    <a class="navbar-brand" asp-controller="Home" asp-action="ProductionResult">
                        <!-- Logo icon -->
                        <b><img src="~/images/logo.png" alt="homepage" class="dark-logo" /></b>
                        <!--End Logo icon -->
                        <!-- Logo text -->
                        <span><img src="~/images/logo-text.png" alt="homepage" class="dark-logo" /></span>
                    </a>
                </div>
                <!-- End Logo -->
                <div class="navbar-collapse">
                    <!-- toggle and nav items -->
                    <ul class="navbar-nav mr-auto mt-md-0">
                        <!-- This is  -->
                        <li class="nav-item"> <a class="nav-link nav-toggler hidden-md-up text-muted  " href="javascript:void(0)"><i class="mdi mdi-menu"></i></a> </li>
                        <li class="nav-item m-l-10"> <a class="nav-link sidebartoggler hidden-sm-down text-muted  " href="javascript:void(0)"><i class="ti-menu"></i></a> </li>
                    </ul>
                    <!-- User profile and search -->
                    <ul class="navbar-nav my-lg-0">
                        <!-- Comment -->
                        
                    </ul>
                </div>
                <span id="datetime" style="font-size: 72px; color: #007bff; font-weight: 700;"></span>
            </nav>
        </div>
        <!-- End header header -->
        <!-- Left Sidebar  -->
        @{
            List<string> operList = appConfig.MasterOperList.Split(",").ToList();
        }
        <div class="left-sidebar">
            <!-- Sidebar scroll-->
            <div class="scroll-sidebar">
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav mt-5">
                    <ul id="sidebarnav">
                        <li class="nav-devider"></li>
                        <li class="nav-label"></li>
                        <li class="d-none">

                            <a class="has-arrow  " href="#" aria-expanded="false"><i class="fa fa-tachometer"></i><span class="hide-menu">Dashboard <span class="label label-rouded label-primary pull-right">@operList.Count</span></span></a>
                            <ul aria-expanded="false" class="collapse">
                                @foreach (var item in operList)
                                {
                                    <li><a asp-controller="Home" asp-action="ChartPerOper" asp-route-oper="@item">@item Dashboard</a></li>
                                }
                            </ul>
                        </li>
                        <li class="d-none"><a asp-controller="Home" asp-action="ProductionResult"><i class="fa fa-bar-chart" aria-hidden="true"></i><span class="hide-menu">Viindoo Production Result</span></a></li>
                        <li>
                            <a class="has-arrow  " href="#" aria-expanded="false"><i class="fa fa-tachometer"></i><span class="hide-menu">Viindoo Dashboard <span class="label label-rouded label-primary pull-right">@operList.Count</span></span></a>
                            <ul aria-expanded="false" class="collapse">
                                @foreach (var item in operList)
                                {
                                    <li><a asp-controller="Home" asp-action="ChartInfoPerOper" asp-route-oper="@item">@item Dashboard</a></li>
                                }
                            </ul>
                        </li>
                        <li>
                            <a class="has-arrow  " href="#" aria-expanded="false"><i class="fa fa-book" aria-hidden="true"></i><span class="hide-menu">Report <span class="label label-rouded label-primary pull-right">2</span></span></a>
                            <ul aria-expanded="false" class="collapse">
                                <li><a asp-controller="Home" asp-action="PDResultByMonthReport">Production Result by Month</a></li>
                                <li><a href="http://10.10.99.10:8011/Home/PDResultDailyReport">Production Result Daily</a></li>
                                <li><a asp-controller="Home" asp-action="PDResultDailyReport">Production Result Daily New</a></li>
                            </ul>
                        </li>
                        <li class="d-none"><a asp-controller="Home" asp-action="AutomationTrackingPerOper"><i class="fa fa-bar-chart" aria-hidden="true"></i><span class="hide-menu">AutomationTrackingPerOper</span></a></li>
                        
                    </ul>
                </nav>
                <!-- End Sidebar navigation -->
            </div>
            <!-- End Sidebar scroll-->
        </div>
        <!-- End Left Sidebar  -->
        <!-- Page wrapper  -->
        <div class="page-wrapper svn-layout d-flex flex-column flex-grow-1">
            <!-- Bread crumb -->
            <div class="row page-titles">
                <div class="col-md-5 align-self-center">
                    <h5 class="text-primary">

                        <a class="p-3 mb-2 bg-danger text-white">&lt;=75%</a>
                        <a class="p-3 mb-2 bg-warning text-dark">Between 75% and 92%</a>
                        <a class="p-3 mb-2 bg-primary text-white">&gt;92%</a>
                    </h5>

                </div>
                <div class="col-md-7 align-self-center">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">home</a></li>
                        <li class="breadcrumb-item active">Production results</li>
                        @{
                            string destinationlink = ViewBag.oper;
                        }
                        @if (!string.IsNullOrWhiteSpace(destinationlink))
                        {
                            <li class="breadcrumb-item active">@destinationlink Dashboard</li>
                        }
                    </ol>
                </div>
            </div>
            <!-- End Bread crumb -->
            <!-- Container fluid  -->
            <div class="container-fluid d-flex flex-column flex-grow-1">
                @RenderBody()
            </div>
            <!-- End Container fluid  -->
            <!-- footer -->
            <footer class="footer"> © 2024 All rights reserved. SVN</footer>
            <!-- End footer -->
        </div>
        <!-- End Page wrapper  -->
    </div>
    <!-- End Wrapper -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
