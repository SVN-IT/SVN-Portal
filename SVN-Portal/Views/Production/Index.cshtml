@{
    Layout = "~/Views/Shared/_ToolsLayout.cshtml";
    ViewData["Title"] = "Nhập kết quả sản xuất";
    string masterWorkOrder = ViewBag.MasterWorkOrder as string ?? "";
}
<style>
    .box-square {
        width: 100%; /* chiếm hết chiều ngang phần tử cha */
        aspect-ratio: 1 / 1; /* đảm bảo luôn vuông (width : height = 1:1) */
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
</style>
<form method="post">
    <div class="row">
        <div class="col-12 col-md-12">
            <div class="row">
                <div class="col-12">
                    <div class="form-group form-check">
                        <input type="checkbox" class="form-check-input" id="checkScanCode">
                        <label class="form-check-label" for="checkScanCode">MPQ/ 最低生产数量</label>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" class="form-check-input" id="checkCreateLot">
                        <label class="form-check-label" for="checkCreateLot">Auto Create lot/ 自动创建批次</label>
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" class="form-check-input" id="checkPrintLabel">
                        <label class="form-check-label" for="checkPrintLabel">Auto Print Label/ 自动打印标签</label>
                    </div>
                    <div id="modalInputQuantityCode" class="modal" tabindex="-1" role="dialog">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" style="color:#455a64!important">Scan the serial number to enter the quantity/ 扫描序列号以输入数量。</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <input id="txtInputQuantityCode" type="text" name="txtInputQuantityCode" class="form-control" />
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary">Confirm/ 确认</button>
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close/ 关闭</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-group">
                        <label class="control-label">Work Order/ 工作单</label>
                        <input id="txtWorkOrderCode" type="text" name="workOrderCode" class="form-control" value="@masterWorkOrder" />
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="form-group" style="margin-top:33px">
                        <button id="btnSearch" class="btn btn-success" type="button" onclick="GetProductByWorkOrder('#txtWorkOrderCode')"><i class="fa fa-pencil"></i> Search/ 搜索</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4 d-none">
            <h4>Key 1 (Numeric keypad) - ✅ Scan serial number to enter quantity</h4>
            <h4>Key 2 (Numeric keypad) - Enter new production order</h4>
            <h4>Key 3 (Numeric keypad) - Open label printing page</h4>
            <h4>Key 4 (Numeric keypad) - Open scan page</h4>
            <h4>Key F5 - Reset web page</h4>
        </div>
        <div class="col-12 col-md-3">
            <div id="divResultLight" class="box-square bg-light"></div>
        </div>
        <div id="divWorkOrder" class="row col-12 col-md-9">
        </div>
    </div>
</form>

<script>
    var product_tracking = "none"

    // Hiện loader
    function showLoader() {
        $("#app-loader").css("display", "flex");
    }

    // Ẩn loader
    function hideLoader() {
        $("#app-loader").css("display", "none");
    }

    //Hàm generate code
    function generateUniqueCode(prefix = 'CODE') {
        // Lấy thời gian hiện tại dưới dạng Timestamp (mili giây)
        const timestamp = Date.now();

        // Tạo chuỗi ngẫu nhiên 4 ký tự (chữ + số) để đảm bảo tính duy nhất
        const randomStr = Math.random().toString(36).substring(2, 6).toUpperCase();

        // Ghép lại thành mã: [Tiền tố]-[Timestamp]-[Chuỗi ngẫu nhiên]
        return `${prefix}-${timestamp}-${randomStr}`;
    }

    function printProductLabel(){
        var serialInput = $('input[name="Serial"]').val().trim();

            if (!serialInput) {
                alert('Please input Serial!');
                return;
            }
            

            // Gọi AJAX về C# Backend
            $.ajax({
                url: '@Url.Action("PrintSerial", "Production")', // Đường dẫn tới Action trong C# Controller
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ serial: serialInput }),
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        
                    } else {
                        alert(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert(response.message);
                },
                complete: function () {
                    
                }
            });
    }

    async function checkAutoFillComponent(productId, componentProductId) {
        try {
            const res = await $.ajax({
                url: '/Production/CheckAutoFillComponentByFGLotSerial',
                type: 'POST',
                data: {
                    product_id: productId,
                    component_product_id: componentProductId
                }
            });

            // Trả về giá trị res.result (true/false)
            return res.result; 

        } catch (error) {
            console.error("Lỗi API:", error);
            return false;
        }
    }

    function GetProductByWorkOrder(txtworkOrderCode) {
        var workOrderCode = $(txtworkOrderCode).val();
        showLoader();
        $.ajax({
            url: '@Url.Action("GetProductByWorkOrder", "Production")',  // Adjust the controller name if needed
            type: 'POST',
            data: {workOrderCode: workOrderCode},
            dataType: 'json',
            success: function (response) {
                if(response.result == false) {
                    $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                    setTimeout(function() {
                        $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                    }, 3000);
                    alert(response.message);
                }
                else{
                    $(`#divWorkOrder`).html(response.message);

                    product_tracking = response.product_tracking;

                    // Focus ban đầu
                    if (product_tracking === "serial") {
                        //trong trường hợp là số serial mà checkbox tạo mã tự động đươc bật thì chạy trình tạo mã

                        $('input[name="Serial"]').focus();

                        if ($('#checkCreateLot').is(':checked')) {
                            let generatedCode = generateUniqueCode('SERI');
                            $('input[name="Serial"]').val(generatedCode);

                            if ($('input[name="Serial"]')) {
                                let enterEvent = new KeyboardEvent('keydown', {
                                    key: 'Enter',
                                    code: 'Enter',
                                    keyCode: 13,
                                    which: 13,
                                    bubbles: true,     // BẮT BUỘC: Để sự kiện nổi bọt lên $(document)
                                    cancelable: true   // BẮT BUỘC: Để hàm e.preventDefault() trong code của bạn không bị lỗi
                                });

                                $('input[name="Serial"]')[0].dispatchEvent(enterEvent);
                            }
                        }
                    } else {
                        if ($('#checkScanCode').is(':checked')) {
                            $('#modalInputQuantityCode').modal('show');
                            $('input[name="txtInputQuantityCode"]').val('');
                            $('input[name="txtInputQuantityCode"]').focus();
                        } else {
                            $('input[name="Quantity"]').focus();
                        }
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
                $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                setTimeout(function() {
                    $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                }, 3000);
                alert("Network error. Please try again");
            },
            complete: function () {
                hideLoader();
            }
        });
    }

    let isRunning = false;
    function InputProductionResult(){
        if (isRunning) {
            console.warn("Đang chạy rồi, bỏ qua...");
            return;
        }
        isRunning = true;

        let formData = {
            name: $('input[name="Name"]').val(),
            subName: $('input[name="SubName"]').val(),
            quantity: $('input[name="Quantity"]').val(),
            productTracking: $('input[name="ProductTracking"]').val(),
            serial: $('input[name="Serial"]').val(),
            productID: $('input[name="ProductID"]').val(),
            totalQuantity: $('input[name="TotalQuantity"]').val(),
            products: []
        };
        showLoader();
        $(".table tbody tr").each(function () {
            let inputs = $(this).find("input");

            let productItem = {
                product_id: $(inputs[0]).val(),    // hidden
                has_tracking: $(inputs[1]).val(), // text
                serial_code: $(inputs[2]).val()
            };

            formData.products.push(productItem);
        });

        $.ajax({
            url: '/Production/InputProductionResult',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            success: function (res) {
                if(res.result) {
                    console.log("Gửi thành công:", res);
                    $('#divResultLight').removeClass('bg-light').addClass('bg-success');

                    setTimeout(function() {
                        $('#divResultLight').removeClass('bg-success').addClass('bg-light');
                    }, 3000);

                    //Nếu checkbox in label dc check thì mới gọi hàm in
                    if ($('#checkPrintLabel').is(':checked'))
                    {
                        printProductLabel();
                    }

                    GetProductByWorkOrder('#txtWorkOrderCode');

                    
                    
                }
                else{
                    $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                    setTimeout(function() {
                        $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                    }, 3000);
                    alert(res.message);
                }

            },
            error: function (err) {
                console.error("Lỗi:", err);
                $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                setTimeout(function() {
                    $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                }, 3000);
                alert("Network error. Please try again");
            },
            complete: function () {
                // isRunning = false;
                // hideLoader();

                setTimeout(function() {
                    isRunning = false;
                    hideLoader();
                }, 5000);
            }
        });
    }



    function InputProductionResultWithSearialList() {
        if (isRunning) {
            console.warn("Đang chạy rồi, bỏ qua...");
            return;
        }
        isRunning = true;

        // 1. Khởi tạo đối tượng FormData (thay vì Object thường)
        let formData = new FormData();

        // 2. Thêm các trường text thông thường
        formData.append("name", $('input[name="Name"]').val());
        formData.append("subName", $('input[name="SubName"]').val());
        formData.append("quantity", $('input[name="Quantity"]').val());
        formData.append("productTracking", $('input[name="ProductTracking"]').val());
        formData.append("serial", $('input[name="Serial"]').val());
        formData.append("productID", $('input[name="ProductID"]').val());
        formData.append("totalQuantity", $('input[name="TotalQuantity"]').val());

        // 3. Thêm File từ input (quan trọng)
        let fileInput = $('#serialFile')[0].files[0];
        if (fileInput) {
            formData.append("serialFile", fileInput);
        }

        // 4. Thêm danh sách products (Dạng mảng phải append từng item hoặc gửi string JSON)
        $(".table tbody tr").each(function (index) {
            let inputs = $(this).find("input");
            // Gửi theo định dạng mảng để Controller dễ nhận (Syntax: Products[0].Property)
            formData.append(`products[${index}].product_id`, $(inputs[0]).val());
            formData.append(`products[${index}].has_tracking`, $(inputs[1]).val());
            formData.append(`products[${index}].serial_code`, $(inputs[2]).val());
        });

        showLoader();

        $.ajax({
            url: '/Production/InputProductionResultWithSerialList',
            type: 'POST',
            data: formData, // Không dùng JSON.stringify nữa
            contentType: false, // Bắt buộc: Để trình duyệt tự xử lý Content-Type
            processData: false, // Bắt buộc: Không để jQuery biến formData thành query string
            success: function (res) {
                if (res.result) {
                    console.log("Gửi thành công:", res);
                    alert(res.message);

                    $('#divResultLight').removeClass('bg-light').addClass('bg-success');

                    setTimeout(function() {
                        $('#divResultLight').removeClass('bg-success').addClass('bg-light');
                    }, 3000);

                    GetProductByWorkOrder('#txtWorkOrderCode');
                } else {
                    $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                    setTimeout(function() {
                        $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                    }, 3000);
                    GetProductByWorkOrder('#txtWorkOrderCode');

                    alert(res.message);
                }
            },
            error: function (err) {
                console.error("Lỗi:", err);
                $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                setTimeout(function() {
                    $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                }, 3000);
                alert("Network error. Please try again");
            },
            complete: function () {
                isRunning = false;
                hideLoader();
            }
        });
    }

    $(document).ready(function () {
        $('input[name="workOrderCode"]').focus();

        // ==================== ĐOẠN CODE THÊM MỚI Ở ĐÂY ====================
        // Lắng nghe sự kiện khi bất kỳ ô input nào được focus vào
        $(document).on('focus', 'input', function () {
            // Chỉ áp dụng cho các ô nhập liệu được, bỏ qua nút bấm hoặc ô ẩn (hidden)
            if ($(this).attr('type') !== 'hidden' && $(this).attr('type') !== 'button' && $(this).attr('type') !== 'submit') {
                $(this).css({
                    'border-color': '#28a745',          // Viền xanh lá
                    'background-color': '#e8f5e9',      // Nền xanh lá cực nhạt
                    'box-shadow': '0 0 0 0.2rem rgba(40, 167, 69, 0.25)', // Hiệu ứng đổ bóng sáng
                    'outline': 'none',
                    'transition': 'all 0.2s ease-in-out' // Hiệu ứng mượt mà
                });
            }
        });

        // Lắng nghe sự kiện khi con trỏ rời khỏi ô input (blur) -> Trả về trạng thái cũ
        $(document).on('blur', 'input', function () {
            $(this).css({
                'border-color': '',
                'background-color': '',
                'box-shadow': ''
            });
        });
        // ===================================================================

        // Bắt phím Enter
        $(document).on('keydown', 'input', async function (e) {
            if (e.key === "Enter") {
                e.preventDefault(); // chặn submit form khi bấm Enter

                // Nếu ô hiện tại rỗng => không cho đi tiếp
                if (!$(this).val().trim()) {
                    return;
                }

                let inputs = $('.serial-input'); // tất cả ô seri

                if ($(this).attr("name") === "workOrderCode") {
                    $('#btnSearch').trigger('click');
                }

                if ($(this).attr("name") === "txtInputQuantityCode") {
                    let serialScanQuantityCode = $(this).val().trim();
                    // Gọi AJAX để kiểm tra
                    $.ajax({
                        url: '/Production/CheckScanQuantitySerial', // API check
                        type: 'POST',
                        data: { serial: serialScanQuantityCode },
                        success: function (res) {
                            if (res.result) {
                                $('#modalInputQuantityCode').modal('hide');
                                $('input[name="Quantity"]').val(res.quantity);
                                $('input[name="Quantity"]').focus().trigger({
                                    type: 'keydown',
                                    key: 'Enter'
                                });
                            } else {
                                $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                                setTimeout(function() {
                                    $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                                }, 3000);
                                alert(res.message);
                                $('input[name="txtInputQuantityCode"]').val('');
                                $('input[name="txtInputQuantityCode"]').focus();
                            }
                        },
                        error: function () {
                            $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                            setTimeout(function() {
                                $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                            }, 3000);
                            alert("Network error. Please try again");
                            $('input[name="txtInputQuantityCode"]').val('');
                            $('input[name="txtInputQuantityCode"]').focus();
                        }
                    });
                    return;
                }

                // Nếu đang ở ô Quality thì nhảy sang ô seri đầu tiên
                if ($(this).attr("name") === "Quantity") {
                    if(inputs.length > 0 && $('input[name="ProductTracking"]').val() === "none"){
                        inputs.first().focus();
                        // Lấy productId của dòng serial-input đầu tiên
                        let $firstInput = inputs.first();
                        let firstProductId = $firstInput.closest('td').find('.product-id').val();
                        let trackingType = $firstInput.closest('td').find('.has-tracking').val();
                        let masterProductID = $('input[name="ProductID"]').val();
                        let masterProductTracking = $('input[name="ProductTracking"]').val();

                        if((masterProductTracking == "serial" || masterProductTracking == "lot") && masterProductTracking == trackingType){
                            let isAutoFillValid = await checkAutoFillComponent(masterProductID, firstProductId);
                            if(isAutoFillValid){
                                var masterSerial = $('input[name="Serial"]').val().trim();
                                inputs.first().val(masterSerial);

                                let enterEvent = new KeyboardEvent('keydown', {
                                    key: 'Enter',
                                    code: 'Enter',
                                    keyCode: 13,
                                    which: 13,
                                    bubbles: true,     // BẮT BUỘC: Để sự kiện nổi bọt lên $(document)
                                    cancelable: true   // BẮT BUỘC: Để hàm e.preventDefault() trong code của bạn không bị lỗi
                                });

                                inputs.first()[0].dispatchEvent(enterEvent);
                            }
                        }
                    }
                    else{
                        if($('input[name="ProductTracking"]').val() === "lot"){
                            $('input[name="Serial"]').focus();

                            //trường hợp là mã HTMLSlotElement thì cx tương tự
                            if ($('#checkCreateLot').is(':checked')) {
                                let generatedCode = generateUniqueCode('LOT');
                                $('input[name="Serial"]').val(generatedCode);

                                if ($('input[name="Serial"]')) {
                                let enterEvent = new KeyboardEvent('keydown', {
                                        key: 'Enter',
                                        code: 'Enter',
                                        keyCode: 13,
                                        which: 13,
                                        bubbles: true,     // BẮT BUỘC: Để sự kiện nổi bọt lên $(document)
                                        cancelable: true   // BẮT BUỘC: Để hàm e.preventDefault() trong code của bạn không bị lỗi
                                    });

                                    $('input[name="Serial"]')[0].dispatchEvent(enterEvent);
                                }
                            }
                        }
                        else{
                            InputProductionResult();
                        }
                    }
                    return;
                }

                var masterMOName = $('input[name="Name"]').val();
                var productID = $('input[name="ProductID"]').val();

                // Nếu đang ở ô Serial (form trên đầu)
                if ($(this).attr("name") === "Serial") {
                    let serialValue = $(this).val().trim();

                    // Gọi AJAX để kiểm tra
                    $.ajax({
                        url: '/Production/CheckLotSerialFG', // API check
                        type: 'POST',
                        data: { serial: serialValue, masterMOName: masterMOName, productID: productID },
                        success: async function (res) {
                            if (res.result) {
                                // Nếu pass -> set Quality = 1 rồi đi tiếp
                                if($('input[name="ProductTracking"]').val() === "serial"){
                                    $('input[name="Quantity"]').val(1);
                                }
                                if(inputs.length > 0){
                                    inputs.first().focus();
                                    let $firstInput = inputs.first();
                                    let firstProductId = $firstInput.closest('td').find('.product-id').val();
                                    let trackingType = $firstInput.closest('td').find('.has-tracking').val();
                                    let masterProductID = $('input[name="ProductID"]').val();
                                    let masterProductTracking = $('input[name="ProductTracking"]').val();

                                    if((masterProductTracking == "serial" || masterProductTracking == "lot") && masterProductTracking == trackingType){
                                        let isAutoFillValid = await checkAutoFillComponent(masterProductID, firstProductId);
                                        if(isAutoFillValid){
                                            var masterSerial = $('input[name="Serial"]').val().trim();
                                            inputs.first().val(masterSerial);

                                            let enterEvent = new KeyboardEvent('keydown', {
                                                key: 'Enter',
                                                code: 'Enter',
                                                keyCode: 13,
                                                which: 13,
                                                bubbles: true,     // BẮT BUỘC: Để sự kiện nổi bọt lên $(document)
                                                cancelable: true   // BẮT BUỘC: Để hàm e.preventDefault() trong code của bạn không bị lỗi
                                            });

                                            inputs.first()[0].dispatchEvent(enterEvent);
                                        }
                                    }
                                }
                                else{
                                    InputProductionResult();
                                }
                            } else {
                                $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                                setTimeout(function() {
                                    $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                                }, 3000);
                                alert(res.message);
                                $('input[name="Serial"]').val('');
                                $('input[name="Serial"]').focus();
                            }
                        },
                        error: function () {
                            $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                            setTimeout(function() {
                                $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                            }, 3000);
                            alert("Network error. Please try again");
                            $('input[name="Serial"]').val('');
                            $('input[name="Serial"]').focus();
                        }
                    });
                    return;
                }

                // Nếu đang ở trong list serial-input
                if ($(this).hasClass('serial-input')) {
                    let $this = $(this);
                    let idx = inputs.index(this);
                    let serialCValue = $this.val().trim();

                    // lấy product-id đi kèm (ở cùng <td>)
                    let productId = $this.closest('td').find('.product-id').val();
                    let hasTracking = $this.closest('td').find('.has-tracking').val();
                    let productName = $this.closest('td').find('.product_name').val();

                    $.ajax({
                        url: '/Production/CheckLotSerialComponemt', // API riêng cho serial-input
                        type: 'POST',
                        data: {
                            serial: serialCValue,
                            productId: productId,
                            masterMOName: masterMOName,
                            hasTracking: hasTracking,
                            productName: productName
                        },
                        success: function (res) {
                            if (res.result) {
                                if (idx >= 0 && idx < inputs.length - 1) {
                                    // Nhảy xuống serial-input tiếp theo
                                    inputs.eq(idx + 1).focus();
                                } else {
                                    // // Nếu là serial cuối cùng thì quay lại ô ban đầu
                                    // if (product_tracking === "serial") {
                                    //     $('input[name="Serial"]').focus();
                                    // } else {
                                    //     $('input[name="Quantity"]').focus();
                                    // }
                                    InputProductionResult();
                                }
                            } else {
                                $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                                setTimeout(function() {
                                    $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                                }, 3000);
                                alert(res.message);
                                $this.val('').focus();
                            }
                        },
                        error: function () {
                            $('#divResultLight').removeClass('bg-light').addClass('bg-danger');

                            setTimeout(function() {
                                $('#divResultLight').removeClass('bg-danger').addClass('bg-light');
                            }, 3000);
                            alert("Network error. Please try again");
                            $this.val('').focus();
                        }
                    });
                }

            }
        });

        $('#serialFile').on('change', function() {
            InputProductionResultWithSearialList();
        });

