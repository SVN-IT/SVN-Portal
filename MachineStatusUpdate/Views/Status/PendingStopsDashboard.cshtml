@model List<MachineStatusUpdate.Models.PendingStopItem>
@{
    ViewData["Title"] = "Dashboard - Bản ghi chưa Run";
    Layout = "_Layout";
    string selectedDate = ViewBag.SelectedDate as string ?? DateTime.Now.ToString("yyyy-MM-dd");
    int totalPending = ViewBag.TotalPending ?? 0;
    int overdueCount = ViewBag.OverdueCount ?? 0;
    DateTime generatedAt = ViewBag.GeneratedAt ?? DateTime.Now;
}

<style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
        --brand:      #dc2626;
        --brand-dark: #991b1b;
        --brand-dim:  rgba(220,38,38,.06);
        --warn:       #d97706;
        --warn-dim:   rgba(217,119,6,.08);
        --ok:         #16a34a;
        --ink:        #09090b;
        --ink-2:      #3f3f46;
        --ink-3:      #71717a;
        --ink-4:      #a1a1aa;
        --surface:    #ffffff;
        --base:       #f4f4f5;
        --border:     #e4e4e7;
        --border-2:   #d4d4d8;
        --sh-sm:      0 1px 2px rgba(0,0,0,.05);
        --sh:         0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04);
        --r:          8px;
        --r-lg:       12px;
    }

    body {
        font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
        background: var(--base);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
    }

    .container { padding: 0 20px; max-width: 1400px; margin: 0 auto; }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px 0 20px;
        gap: 16px;
        flex-wrap: wrap;
    }
    .page-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -.3px;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .page-title::before {
        content: '';
        display: inline-block;
        width: 4px;
        height: 20px;
        background: var(--brand);
        border-radius: 2px;
        flex-shrink: 0;
    }
    .page-subtitle { font-size: 12.5px; color: var(--ink-3); margin-top: 4px; }

    /* ── Summary cards ── */
    .summary-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }
    .summary-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 16px 18px;
        box-shadow: var(--sh-sm);
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .summary-label {
        font-size: 11px;
        font-weight: 700;
        color: var(--ink-3);
        text-transform: uppercase;
        letter-spacing: .5px;
    }
    .summary-value { font-size: 26px; font-weight: 800; color: var(--ink); }
    .summary-card.danger .summary-value { color: var(--brand); }
    .summary-card.warn .summary-value { color: var(--warn); }
    .summary-card.ok .summary-value { color: var(--ok); }

    /* ── Filter card ── */
    .filter-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 16px 18px;
        margin-bottom: 18px;
        box-shadow: var(--sh-sm);
        display: flex;
        align-items: end;
        gap: 12px;
        flex-wrap: wrap;
    }
    .filter-group { display: flex; flex-direction: column; }
    .filter-card label {
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--ink-3);
        text-transform: uppercase;
        letter-spacing: .6px;
    }
    .filter-card .form-control {
        height: 38px;
        border: 1px solid var(--border-2);
        border-radius: var(--r);
        padding: 0 12px;
        font-size: 13.5px;
        background: var(--surface);
        color: var(--ink);
    }
    .filter-card .form-control:focus {
        outline: none;
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(220,38,38,.1);
    }
    .quick-dates { display: flex; gap: 6px; }

    .btn {
        border: 0;
        border-radius: var(--r);
        padding: 9px 14px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        white-space: nowrap;
        transition: all .15s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        line-height: 1;
    }
    .btn-primary { background: var(--brand); color: #fff; }
    .btn-primary:hover { background: var(--brand-dark); color: #fff; }
    .btn-outline { background: var(--surface); color: var(--ink-2); border: 1px solid var(--border-2); }
    .btn-outline:hover { background: var(--base); }
    .btn-outline.active { background: var(--ink); color: #fff; border-color: var(--ink); }

    /* ── Table ── */
    .table-wrap {
        overflow: auto;
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--surface);
        box-shadow: var(--sh);
    }
    table { width: 100%; border-collapse: collapse; min-width: 1000px; }
    th, td { border-bottom: 1px solid var(--border); padding: 11px 14px; font-size: 13px; text-align: left; }
    th {
        background: var(--ink);
        color: #fff;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 10;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: .5px;
    }
    tbody tr:hover td { background: var(--brand-dim); }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr.overdue td { background: var(--warn-dim); }
    tbody tr.overdue:hover td { background: rgba(217,119,6,.14); }

    .badge {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }
    .badge-stop { background: var(--brand-dim); color: var(--brand-dark); }
    .badge-overdue { background: rgba(217,119,6,.15); color: var(--warn); }
    .badge-auto { background: rgba(37,99,235,.1); color: #2563eb; }
    .badge-est-auto { background: rgba(124,58,237,.1); color: #7c3aed; }

    .no-data {
        text-align: center;
        padding: 56px 20px;
        color: var(--ink-4);
        font-size: 14px;
    }
    .no-data .big { font-size: 34px; margin-bottom: 8px; }

    .info-banner {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: rgba(124,58,237,.06);
        border: 1px solid rgba(124,58,237,.2);
        border-radius: var(--r-lg);
        padding: 12px 16px;
        margin-bottom: 18px;
        font-size: 12.5px;
        color: var(--ink-2);
        line-height: 1.5;
    }
    .info-banner .icon { font-size: 16px; flex-shrink: 0; }
    .info-banner b { color: #7c3aed; }

    @@media (max-width: 900px) {
        .summary-row { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 640px) {
        .container { padding: 0 14px; }
        .summary-row { grid-template-columns: 1fr; }
        .filter-card { flex-direction: column; align-items: stretch; }
        th, td { padding: 9px 10px; }
    }
</style>

<div class="container">
    <div class="page-header">
        <div>
            <h2 class="page-title">Dashboard - Bản ghi chưa Run</h2>
            <div class="page-subtitle">Cập nhật lúc @generatedAt.ToString("HH:mm dd/MM/yyyy") &middot; Các bản ghi Stop trong ngày vẫn chưa có Run tương ứng</div>
        </div>
    </div>

    <div class="summary-row">
        <div class="summary-card danger">
            <span class="summary-label">Đang dừng máy (chưa Run)</span>
            <span class="summary-value">@totalPending</span>
        </div>
        <div class="summary-card warn">
            <span class="summary-label">Quá thời gian ước tính</span>
            <span class="summary-value">@overdueCount</span>
        </div>
        <div class="summary-card ok">
            <span class="summary-label">Ngày xem</span>
            <span class="summary-value" style="font-size:18px;">@DateTime.Parse(selectedDate).ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    @if (Model != null && Model.Any(x => x.IsAutoEstimated))
    {
        <div class="info-banner">
            <span class="icon">ℹ️</span>
            <span>
                <b>Tự động theo KH SX</b>: bản ghi Stop không có "Thời gian ước tính" do người nhập bỏ trống.
                Hệ thống tự tính giờ dự kiến dựa trên bảng kế hoạch sản xuất (Target còn lại theo ca Day/Night) —
                lấy giờ kết thúc của khung giờ (Time1-5) cuối cùng còn Target &gt; 0 trong ngày.
                Nếu tới giờ đó vẫn chưa có Run thật, hệ thống sẽ <b>tự động ghi nhận Run</b> giúp, không cần chờ ai bấm.
            </span>
        </div>
    }

    <div class="filter-card">
        <form method="get" asp-action="PendingStopsDashboard" style="display:flex; align-items:end; gap:12px; flex-wrap:wrap;">
            <div class="filter-group">
                <label>Chọn ngày</label>
                <input type="date" name="date" value="@selectedDate" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Xem</button>
            <div class="quick-dates">
                <a class="btn btn-outline @(selectedDate == DateTime.Now.ToString("yyyy-MM-dd") ? "active" : "")"
                   href="@Url.Action("PendingStopsDashboard", new { date = DateTime.Now.ToString("yyyy-MM-dd") })">Hôm nay</a>
                <a class="btn btn-outline @(selectedDate == DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd") ? "active" : "")"
                   href="@Url.Action("PendingStopsDashboard", new { date = DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd") })">Hôm qua</a>
            </div>
        </form>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>SVN Code</th>
                    <th>Operation</th>
                    <th>ISS Code</th>
                    <th>Tên lỗi</th>
                    <th>Mô tả</th>
                    <th>Thời gian Stop</th>
                    <th>Đã dừng</th>
                    <th>Ước tính Run</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="10">
                            <div class="no-data">
                                <div class="big">✅</div>
                                Không có bản ghi nào đang chờ Run trong ngày này.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int i = 0;
                    foreach (var item in Model)
                    {
                        i++;
                        var durationText = $"{(int)item.Duration.TotalHours}h {item.Duration.Minutes}m";
                        <tr class="@(item.IsOverdue ? "overdue" : "")">
                            <td>@i</td>
                            <td>@item.SVNCode</td>
                            <td>@item.Operation</td>
                            <td>@item.ISS_Code</td>
                            <td>@item.ErrorName</td>
                            <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                            <td>@(item.StopDatetime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>@durationText</td>
                            <td>
                                @if (item.EstimateAt.HasValue)
                                {
                                    @item.EstimateAt.Value.ToString("HH:mm")
                                    @if (!item.IsAutoEstimated)
                                    {
                                        @: (@item.EstimateTime)
                                    }
                                }
                                else
                                {
                                    @:-
                                }
                                @if (item.IsAutoEstimated)
                                {
                                    <span class="badge badge-est-auto" style="margin-left:6px;" title="Tự tính từ kế hoạch sản xuất (hết Target trong ngày), Operation này sẽ tự động Run vào giờ này nếu vẫn chưa có Run thật">Tự động theo KH SX</span>
                                }
                                @if (item.AutoRunEnabled)
                                {
                                    <span class="badge badge-auto" style="margin-left:6px;">Auto-Run</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-stop">Đang Stop</span>
                                @if (item.IsOverdue)
                                {
                                    <span class="badge badge-overdue" style="margin-left:4px;">Quá hạn</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
