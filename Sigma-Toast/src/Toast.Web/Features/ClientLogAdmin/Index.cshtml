@{
    ViewData["Title"] = "Log trạm";
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h4 class="card-title mb-1">Log trạm</h4>
            <span class="text-muted small" id="cl-summary">Đang tải...</span>
        </div>
        <a class="btn btn-sm btn-label-secondary d-none" id="cl-download"><i class="icon-base ti tabler-download me-1"></i>Tải file</a>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
            <select class="form-select" id="cl-day" aria-label="Ngày" style="flex: 0 1 170px; width: auto;"></select>
            <select class="form-select" id="cl-level" aria-label="Lọc mức" style="flex: 0 1 160px; width: auto;">
                <option value="">Tất cả mức</option>
                <option value="error">Lỗi</option>
                <option value="warn">Cảnh báo</option>
                <option value="info">Thông tin</option>
            </select>
            <div class="input-group" style="flex: 2 1 280px; width: auto;">
                <input type="text" class="form-control" id="cl-search" placeholder="Tìm theo WO, máy, IP, sự kiện, nội dung..." aria-label="Tìm log" />
                <span class="input-group-text"><i class="icon-base ti tabler-search"></i></span>
            </div>
            <div class="d-flex gap-2 ms-auto">
                <button type="button" class="btn btn-icon btn-label-secondary" id="cl-reload" aria-label="Tải lại" title="Tải lại"><i class="icon-base ti tabler-refresh"></i></button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0" style="min-width: 1100px;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;" aria-sort="none"><button type="button" class="list-sort" data-sort="server">Giờ server<i class="icon-base ti tabler-arrows-sort"></i></button></th>
                        <th style="width: 100px;" aria-sort="none"><button type="button" class="list-sort" data-sort="client">Giờ trạm<i class="icon-base ti tabler-arrows-sort"></i></button></th>
                        <th style="width: 100px;" aria-sort="none"><button type="button" class="list-sort" data-sort="level">Mức<i class="icon-base ti tabler-arrows-sort"></i></button></th>
                        <th style="width: 150px;" aria-sort="none"><button type="button" class="list-sort" data-sort="device">Máy<i class="icon-base ti tabler-arrows-sort"></i></button></th>
                        <th style="width: 150px;" aria-sort="none"><button type="button" class="list-sort" data-sort="wo">WO<i class="icon-base ti tabler-arrows-sort"></i></button></th>
                        <th style="width: 150px;" aria-sort="none"><button type="button" class="list-sort" data-sort="event">Sự kiện<i class="icon-base ti tabler-arrows-sort"></i></button></th>
                        <th>Nội dung</th>
                        <th style="width: 70px;"></th>
                    </tr>
                </thead>
                <tbody id="cl-tbody">
                    <tr><td colspan="8" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></td></tr>
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_ListFooter", "cl")
    </div>
</div>

@* ===== Chi tiết 1 dòng log ===== *@
<div class="modal fade" id="cl-modal" tabindex="-1" aria-labelledby="cl-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex flex-wrap align-items-center gap-2" id="cl-modal-title">Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="cl-detail"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .cl-info { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: .5rem 1rem; margin: 0; }
        .cl-info dt { font-weight: 400; color: var(--bs-secondary-color); }
        .cl-info dd { margin: 0; color: var(--bs-heading-color); overflow-wrap: anywhere; }
        .cl-data { background: var(--bs-tertiary-bg); border-radius: var(--bs-border-radius); padding: .75rem 1rem; white-space: pre-wrap; word-break: break-all; font-size: .8125rem; margin: 0; }
        .cl-msg { overflow-wrap: anywhere; }
    </style>
}

@section Scripts {
    <script>
        window.ClientLogPage = {
            apiUrl: '@Url.Content("~/toast/admin/client-log/api")',
            downloadUrl: '@Url.Content("~/toast/admin/client-log/download")',
            loginUrl: '@Url.Content("~/toast/admin/account/login")'
        };
    </script>
    <script src="~/js/shared/list-table.js" asp-append-version="true"></script>
    <script src="~/js/shared/row-click.js" asp-append-version="true"></script>
    <script src="~/js/client-log/client-log.js" asp-append-version="true"></script>
}
