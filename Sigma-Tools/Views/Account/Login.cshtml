@{
    Layout = null; // Trang Login thường đứng độc lập, không dùng chung Main Layout
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link href="~/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <!-- iCheck -->
    <link href="~/plugins/icheck-bootstrap/icheck-bootstrap.min.css" rel="stylesheet" />
    <!-- Theme style -->
    <link href="~/dist/css/adminlte.min.css" rel="stylesheet" />

    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <!-- Bộ chọn ngôn ngữ nhanh góc trên -->
        <div class="text-right mb-2">
            <select id="login-lang-switch" class="form-control form-control-sm" style="width: 110px; display: inline-block;">
                <option value="vi">Tiếng Việt</option>
                <option value="en">English</option>
                <option value="zh">中文</option>
            </select>
        </div>

        <!-- /.login-logo -->
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <img src="~/dist/img/sigma-logo.svg" alt="AdminLTE Logo" class="sigma-brand-image" style="opacity: .8">
            </div>
            <div class="card-body login-card-body">
                <p class="login-box-msg" data-key="login_msg">Đăng nhập để bắt đầu phiên làm việc</p>

                <!-- Hiển thị thông báo lỗi nếu đăng nhập thất bại -->
                @if (TempData["LoginError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle mr-1"></i> @TempData["LoginError"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <!-- Form Đăng nhập truyền thống -->
                <form asp-controller="Account" asp-action="Login" method="post">
                    <div class="input-group mb-3">
                        <input type="text" name="Username" class="form-control" placeholder="Tài khoản / Username" id="input-username" required autofocus>
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-user"></span>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mb-3">
                        <input type="password" name="Password" class="form-control" placeholder="Mật khẩu / Password" id="input-password" required>
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <div class="icheck-primary">
                                <input type="checkbox" id="remember" name="RememberMe" value="true">
                                <label for="remember" data-key="remember_me">
                                    Nhớ mật khẩu
                                </label>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-12 mt-2">
                            <button type="submit" class="btn btn-sigma-pink btn-block" data-key="btn_login">Đăng nhập</button>
                        </div>
                        <!-- /.col -->
                    </div>
                </form>

                <div class="social-auth-links text-center mt-3 mb-3">
                    <p data-key="or_divider">- HOẶC -</p>
                    <!-- Nút Đăng nhập bằng Microsoft -->
                    <a href="@Url.Action("SignInMicrosoft", "Account")" class="btn btn-block btn-outline-dark">
                        <!-- SVG Logo Microsoft chuẩn màu -->
                        <svg class="mr-2" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 21 21">
                            <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                            <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                            <rect x="1" y="11" width="9" height="9" fill="#01a4ef" />
                            <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                        </svg>
                        <span data-key="btn_microsoft">Đăng nhập bằng tài khoản Microsoft</span>
                    </a>
                </div>
                <!-- /.social-auth-links -->

            </div>
            <!-- /.login-card-body -->
        </div>
    </div>
    <!-- /.login-box -->
    <!-- jQuery -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/dist/js/adminlte.min.js"></script>

    <!-- Script xử lý đa ngôn ngữ load từ file JSON -->
    <script>
        function loadLoginTranslations(lang) {
            $.getJSON(`/json/${lang}.json`, function (data) {
                // Duyệt qua các thẻ có attribute data-key
                $('[data-key]').each(function() {
                    const key = $(this).attr('data-key');
                    if (data[key]) {
                        $(this).text(data[key]);
                    }
                });

                // Cập nhật Placeholder cho ô input dựa trên file JSON hoặc giá trị fallback
                if (data['placeholder_username']) {
                    $('#input-username').attr('placeholder', data['placeholder_username']);
                }
                if (data['placeholder_password']) {
                    $('#input-password').attr('placeholder', data['placeholder_password']);
                }
            }).fail(function() {
                console.error("Không thể tải file ngôn ngữ: " + lang);
            });
        }

        $(document).ready(function() {
            // Lấy ngôn ngữ đã lưu hoặc mặc định là 'vi'
            const currentLang = localStorage.getItem('app_lang') || 'vi';
            $('#login-lang-switch').val(currentLang);
            loadLoginTranslations(currentLang);

            // Khi user thay đổi ngôn ngữ trên dropdown góc trên
            $('#login-lang-switch').on('change', function() {
                const selectedLang = $(this).val();
                localStorage.setItem('app_lang', selectedLang);
                loadLoginTranslations(selectedLang);
            });
        });
    </script>
</body>
</html>