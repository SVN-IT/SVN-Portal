<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <link rel="icon" type="image/png" sizes="20x20" href="~/dist/img/sigma-logo.svg">
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link href="~/plugins/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- Tempusdominus Bootstrap 4 -->
    <link href="~/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <!-- iCheck -->
    <link href="~/plugins/icheck-bootstrap/icheck-bootstrap.min.css" rel="stylesheet" />
    <!-- JQVMap -->
    <link href="~/plugins/jqvmap/jqvmap.min.css" rel="stylesheet" />



    <!-- Theme style -->
    <link href="~/dist/css/adminlte.min.css" rel="stylesheet" />
    <!-- overlayScrollbars -->
    <link href="~/plugins/overlayscrollbars/css/overlayscrollbars.min.css" rel="stylesheet" />
    <!-- Daterange picker -->
    <link href="~/plugins/daterangepicker/daterangepicker.css" rel="stylesheet" />
    <!-- summernote -->
    <link href="~/plugins/summernote/summernote-bs4.min.css" rel="stylesheet" />
    <link href="~/css/responsives.css" rel="stylesheet" />
    <!-- jQuery -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <!-- jQuery UI 1.11.4 -->
    <script src="~/plugins/jquery-ui/jquery-ui.min.js"></script>
    <!-- ChartJS -->
    <script src="~/plugins/chart.js/chart.min.js"></script>
    <script src="~/plugins/chart.js/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/js/site.js"></script>

    <!-- Bootstrap -->
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

</head>
<body class="hold-transition sidebar-mini layout-fixed sidebar-collapse">
    <div class="wrapper">
        @{
            DateTime date = DateTime.Now;
            string shift = "Day";
            string companyCode = "SVN";
            string titleName = ViewBag.TitleName;
            string accessMode = ViewBag.AccessMode;

            string selectedPage = ViewBag.SelectedPage;

            string controllerName = ViewBag.ControllerName;
            string indexPage = ViewBag.IndexPage;
            if (string.IsNullOrWhiteSpace(indexPage))
            {
                indexPage = "a";
            }
            string masterOperations = "a,b,c";
            List<string> masterOperList = masterOperations.Split(',').ToList();
            if (!string.IsNullOrWhiteSpace(companyCode))
            {
                switch (companyCode)
                {
                    case "SM":
                        // Lọc các item có đuôi (SM)
                        masterOperList = masterOperList.Where(x => x.EndsWith("(SM)")).ToList();
                        break;

                    case "ITA":
                        // Lọc các item có đuôi (ITA)
                        masterOperList = masterOperList.Where(x => x.EndsWith("(ITA)")).ToList();
                        break;

                    case "BT":
                        // Lọc các item có đuôi (BT)
                        masterOperList = masterOperList.Where(x => x.EndsWith("(BT)")).ToList();
                        break;

                    case "SVN":
                        // Lọc các item KHÔNG chứa (SM) và KHÔNG chứa (ITA)
                        masterOperList = masterOperList.Where(x => !x.EndsWith("(SM)") && !x.EndsWith("(ITA)")).ToList();
                        break;
                }
            }
        }
        <!-- Preloader -->
        <div class="preloader flex-column justify-content-center align-items-center">
            <img class="animation__shake img-preloader" src="~/dist/img/sigma-logo.svg" alt="AdminLTELogo">
        </div>

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <!-- Navbar Search -->
                <li class="nav-item">
                    <a class="nav-link" data-widget="navbar-search" href="#" role="button">
                        <i class="fas fa-search"></i>
                    </a>
                    <div class="navbar-search-block">
                        <form method="post" class="form-inline">
                            <div class="input-group input-group-sm">
                                @if ((indexPage == "Index" || indexPage == "ChartPageByOperation") && controllerName == "Home")
                                {
                                    int pageSize = 9;
                                    <select class="form-control form-control-navbar" name="pageSize">
                                        <option value="3" selected="@(pageSize == 3)">3</option>
                                        <option value="6" selected="@(pageSize == 6)">6</option>
                                        <option value="9" selected="@(pageSize == 9)">9</option>
                                        <option value="12" selected="@(pageSize == 12)">12</option>
                                        <option value="15" selected="@(pageSize == 15)">15</option>
                                        <option value="0" selected="@(pageSize == 0)">All</option>
                                    </select>
                                }
                                <select class="form-control form-control-navbar" name="companyCode">
                                    <option value="SVN" selected="@(companyCode == "SVN")">SVN</option>
                                    <option value="SM" selected="@(companyCode == "SM")">SM</option>
                                    <option value="ITA" selected="@(companyCode == "ITA")">ITA</option>
                                    <option value="BT" selected="@(companyCode == "BT")">BT</option>
                                </select>
                                @if (((indexPage == "Index" || indexPage == "ChartPageByOperation") && controllerName == "Home") || (indexPage == "Index" && controllerName == "DailyTarget") || (indexPage == "Index" && controllerName == "HourlyTarget"))
                                {
                                    <select class="form-control form-control-navbar" name="shift">
                                        <option value="Day" selected="@(shift == "Day")">Day</option>
                                        <option value="Night" selected="@(shift == "Night")">Night</option>
                                    </select>
                                    <input id="inputDate" class="form-control form-control-navbar" type="date" name="date" value="@date.ToString("yyyy-MM-dd")">
                                }
                                @if (indexPage == "DailyProductionResultReport" && controllerName == "Report")
                                {
                                    DateTime fromDate = DateTime.Now;
                                    DateTime toDate = DateTime.Now;
                                    <input id="inputFromDate" class="form-control form-control-navbar" type="date" name="fromDate" value="@fromDate.ToString("yyyy-MM-dd")">
                                    <input id="inputToDate" class="form-control form-control-navbar" type="date" name="toDate" value="@toDate.ToString("yyyy-MM-dd")">
                                }
                                
                                
                                <div class="input-group-append">
                                    <button class="btn btn-navbar" type="submit" asp-controller="@controllerName" asp-action="@indexPage"
                                        asp-route-isManualLoad=true>
                                        <i class="fas fa-search"></i>
                                    </button>
                                    <button class="btn btn-navbar" type="button" id="btnCloseSearchBar">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="control-sidebar" data-slide="true" href="#" role="button">
                        <i class="fas fa-th-large"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a asp-controller="Home" asp-action="Index" asp-route-shift="Day" asp-route-companyCode="@companyCode" asp-route-isManualLoad=false class="brand-link">
                <img src="~/dist/img/sigma-logo.svg" alt="AdminLTE Logo" class="sigma-brand-image" style="opacity: .8">
                @* <span class="brand-text font-weight-light">AdminLTE 3</span> *@
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    @{
                        var currentUser = permissionService.GetCurrentUser();
                        string displayName = currentUser?.FullName
                        ?? currentUser?.UserName
                        ?? "Unknown User";
                    }
                    <div class="image">
                        <img src="../../dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image">
                    </div>
                    <div class="info">
                        <a href="#" class="d-block">@displayName</a>
                    </div>
                </div>
                <!-- SidebarSearch Form -->
                <div class="form-inline mt-2">
                    <div class="input-group" data-widget="sidebar-search">
                        <input class="form-control form-control-sidebar" type="search" placeholder="Search for menu" aria-label="Search">
                        <div class="input-group-append">
                            <button class="btn btn-sidebar">
                                <i class="fas fa-search fa-fw"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
