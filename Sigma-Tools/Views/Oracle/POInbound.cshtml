@model Sigma_Tools.Models.InboundPOReviewViewModel
@{
    ViewData["Title"] = ViewBag.TitleName;
}
<style>
    body {
        background-color: #f4f6f9;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 0.88rem;
    }

    /* Top Header Navigation Bar */
    .netsuite-header {
        background-color: #0d5287;
        color: #ffffff;
        padding: 8px 16px;
    }

    .action-bar {
        background-color: #ffffff;
        padding: 10px 20px;
        border-bottom: 1px solid #e0e0e0;
    }

    /* PDF Viewer Left Side */
    .pdf-panel {
        background-color: #525659;
        /* min-height: calc(100vh - 120px); */
        padding-top: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 15px;
    }

    .pdf-preview-box {
        width: 100%;
        height: 780px;
        background-color: #ffffff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        border-radius: 2px;
        overflow: hidden;
    }

    /* Card Customizations */
    .card-custom {
        border: 1px solid #e3e6f0;
        border-radius: 4px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.04);
        background-color: #ffffff;
        margin-bottom: 15px;
    }

        .card-custom .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
            font-weight: 700;
            font-size: 0.82rem;
            color: #4e73df;
            letter-spacing: 0.5px;
            padding: 8px 15px;
        }

    .alert-error-custom {
        background-color: #fdf2f2;
        border: 1px solid #f8b4b4;
        color: #9b1c1c;
        border-radius: 4px;
        padding: 12px 15px;
    }

    .table-custom th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-size: 0.75rem;
        text-transform: uppercase;
        border-bottom: 2px solid #dee2e6;
        padding: 8px;
    }

    .table-custom td {
        padding: 8px;
        vertical-align: middle;
    }

    .summary-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 10px;
        font-weight: 600;
    }

    /* Khung cảnh báo LỖI (Màu đỏ) */
    .alert-error-custom {
        background-color: #fdf2f2;
        border: 1px solid #f8b4b4;
        color: #9b1c1c;
        border-radius: 4px;
        padding: 12px 15px;
    }

    /* Khung THÀNH CÔNG (Màu xanh) */
    .alert-success-custom {
        background-color: #f3faf7;
        border: 1px solid #bcf0da;
        color: #03543f;
        border-radius: 4px;
        padding: 12px 15px;
    }

    /* Tùy chỉnh ô input trong bảng khi Edit */
    .edit-input {
        width: 100%;
        padding: 2px 6px;
        font-size: 0.85rem;
        border: 1px solid #4e73df;
        border-radius: 3px;
        background-color: #ffffff;
    }

        .edit-input:focus {
            outline: none;
            border-color: #2e59d9;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }

    .btn-xs {
        padding: 2px 6px;
        font-size: 0.75rem;
        line-height: 1;
        border-radius: 3px;
    }

    /* =========================================================
       NETSUITE STYLE STEP PROGRESS BAR
       ========================================================= */
    .netsuite-stepper-wrapper {
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
        padding: 12px 0 8px 0;
    }

    .netsuite-stepper {
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 550px;
        margin: 0 auto;
        position: relative;
    }

    /* Đường nối ngang giữa các bước */
    .netsuite-stepper-line {
        position: absolute;
        top: 15px;
        left: 80px;
        right: 80px;
        height: 2px;
        background-color: #d1d5db;
        z-index: 1;
    }

    .netsuite-step {
        position: relative;
        z-index: 2;
        text-align: center;
        flex: 1;
        background-color: transparent;
    }

        /* Vòng tròn số */
        .netsuite-step .step-num {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #ffffff;
            color: #6c757d;
            border: 2px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.82rem;
            margin: 0 auto 4px auto;
            transition: all 0.25s ease-in-out;
        }

        /* Nhãn tên bước */
        .netsuite-step .step-text {
            font-size: 0.76rem;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* Trạng thái BƯỚC HIỆN TẠI (Step 1 Active) */
        .netsuite-step.active .step-num {
            background-color: #0d5287;
            color: #ffffff;
            border-color: #0d5287;
            box-shadow: 0 0 0 3px rgba(13, 82, 135, 0.2);
        }

        .netsuite-step.active .step-text {
            color: #0d5287;
            font-weight: 700;
        }

        /* Trạng thái BƯỚC ĐÃ HOÀN THÀNH (Completed) */
        .netsuite-step.completed .step-num {
            background-color: #28a745;
            color: #ffffff;
            border-color: #28a745;
        }

        .netsuite-step.completed .step-text {
            color: #28a745;
        }

    /* Nút Xác nhận chuẩn NetSuite */
    .btn-confirm-netsuite {
        background-color: #0d5287;
        color: #ffffff;
        font-weight: 600;
        border: none;
        padding: 6px 18px;
        border-radius: 3px;
        transition: background-color 0.2s ease;
    }

        .btn-confirm-netsuite:hover {
            background-color: #093b62;
            color: #ffffff;
        }

    /* --- Styles cho Bảng Price Verification (Bước 2) --- */
    .table-verification th {
        background-color: #f8f9fa;
        color: #495057;
        font-size: 0.78rem;
        text-transform: uppercase;
        font-weight: 700;
    }

    .table-verification td {
        vertical-align: middle;
        font-size: 0.85rem;
    }

    /* Dòng bị lệch giá (Variance Row) */
    .row-variance {
        background-color: #fdf2f2 !important;
    }

    .text-variance {
        color: #9b1c1c;
        font-weight: 600;
    }

    .text-matched {
        color: #03543f;
        font-weight: 600;
    }

    .verification-notice {
        font-size: 0.82rem;
        color: #b45309;
        background-color: #fffbeb;
        border: 1px solid #fde68a;
        padding: 10px 15px;
        border-radius: 4px;
        margin-top: 12px;
    }

    /* --- Hiệu ứng chuyển đổi giữa các bước (Fade & Slide Transition) --- */
    .table-transition-wrapper {
        position: relative;
        transition: all 0.35s ease-in-out;
    }

    @@keyframes fadeInScale {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-fade-in {
        animation: fadeInScale 0.4s ease-in-out forwards;
    }

    /* Styling ô input OCR Price khi Edit ở Bước 2 */
    .input-ocr-price {
        width: 100px;
        padding: 2px 6px;
        font-size: 0.85rem;
        border: 1px solid #4e73df;
        border-radius: 3px;
        text-align: right;
        display: inline-block;
    }

        .input-ocr-price:focus {
            outline: none;
            border-color: #2e59d9;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }
</style>
<!-- Thêm CSS của Select2 -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/@@ttskch/select2-bootstrap4-theme@1.5.2/dist/select2-bootstrap4.min.css" rel="stylesheet" />

<!-- Thêm JS của Select2 (Đảm bảo đặt sau thư viện jQuery) -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- ========================================================= -->
<!-- GLOBAL AJAX LOADING SPINNER OVERLAY -->
<!-- ========================================================= -->
<div id="global-loader" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.4); z-index: 99999; justify-content: center; align-items: center;">
    <div class="bg-white p-4 rounded shadow-lg text-center" style="min-width: 200px;">
        <div class="spinner-border text-primary mb-2" role="status" style="width: 2.5rem; height: 2.5rem;">
            <span class="sr-only">Loading...</span>
        </div>
        <div id="loader-text" class="small font-weight-bold text-dark"><span class="lang-text">loadingData</span></div>
    </div>
</div>

<!-- Header NetSuite -->
<div class="netsuite-header d-flex justify-content-between align-items-center">
    <div class="font-weight-bold">ORACLE NetSuite <span class="font-weight-normal lang-text">| @ViewBag.TitleName</span></div>
    @* <div class="small">User: <strong>Duong Hai Linh</strong> | Role: <strong>IT Administrator</strong></div> *@
</div>

<!-- Step Progress Bar (Đặt ngay trên Action Bar) -->
<div class="netsuite-stepper-wrapper">
    <div class="netsuite-stepper">
        <div class="netsuite-stepper-line"></div>

        <!-- Step 1: Active -->
        <div class="netsuite-step active" id="step-node-1">
            <div class="step-num">1</div>
            <div class="step-text"><span class="lang-text">Inbound PO Review</span></div>
        </div>

        <!-- Step 2 -->
        <div class="netsuite-step" id="step-node-2">
            <div class="step-num">2</div>
            <div class="step-text"><span class="lang-text">ERP Price Compare</span></div>
        </div>

        <!-- Step 3 -->
        <div class="netsuite-step" id="step-node-3">
            <div class="step-num">3</div>
            <div class="step-text"><span class="lang-text">Create ERP PO</span></div>
        </div>
    </div>
</div>

<!-- Action Bar & Controls -->
<div class="action-bar d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <!-- Button Import PDF (Duy nhất được hoạt động) -->
        <label class="btn btn-sm btn-info mb-0 mr-1 shadow-sm cursor-pointer" id="btn-import-wrapper">
            <i class="fas fa-file-upload mr-1"></i> <span class="lang-text">Import File PDF</span>
            <input type="file" id="pdf-file-input" accept="application/pdf" style="display: none;">
        </label>

        <!-- Các nút chức năng khác mặc định bị disabled -->
        <button type="button" class="btn btn-sm btn-secondary font-weight-bold mr-1 d-none" id="btn-convert" disabled><span class="lang-text">Convert to ERP PO</span></button>

        <!-- Nút Edit Data -->
        <button type="button" class="btn btn-sm btn-warning text-white font-weight-bold mr-1" id="btn-edit-data" disabled>
            <i class="fas fa-edit mr-1"></i> <span class="lang-text">Edit Data</span>
        </button>

        <!-- Nhóm nút Edit (Ẩn mặc định) -->
        <div id="edit-actions-group" class="align-items-center mr-1" style="display: none !important;">
            <button type="button" class="btn btn-sm btn-success font-weight-bold mr-1" id="btn-add-line">
                <i class="fas fa-plus mr-1"></i> <span class="lang-text">Add Item</span>
            </button>
            <button type="button" class="btn btn-sm btn-primary font-weight-bold mr-1" id="btn-save-edit">
                <i class="fas fa-check mr-1"></i> <span class="lang-text">Save Changes</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary font-weight-bold" id="btn-cancel-edit">
                <i class="fas fa-times mr-1"></i> <span class="lang-text">Cancel</span>
            </button>
        </div>

        <button type="button" class="btn btn-sm btn-outline-danger font-weight-bold" id="btn-reject" disabled><span class="lang-text">Reject PO</span></button>

        <!-- NÚT RELOAD ERP DATA (Nằm ở vị trí khoanh đỏ, chỉ hiển thị khi sang Bước 2) -->
        <button type="button" id="btn-reload-erp" class="btn btn-sm btn-outline-primary font-weight-bold shadow-sm ml-2 d-none">
            <i class="fas fa-sync-alt mr-1"></i> <span class="lang-text">Reload ERP data</span>
        </button>
    </div>

    <!-- Modal Confirm Reject PO -->
    <div class="modal fade" id="rejectPoModal" tabindex="-1" role="dialog" aria-labelledby="rejectPoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title font-weight-bold" id="rejectPoModalLabel">
                        <i class="fas fa-exclamation-triangle mr-1"></i> <span class="lang-text">ConfirmReject</span>
                    </h6>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-2 text-dark"><span class="lang-text">RejectConfirmDeatails</span></p>
                    <div class="form-group mb-0">
                        <label for="reject-reason" class="small font-weight-bold text-muted mb-1"><span class="lang-text">Reject Reason</span> <span class="text-danger">*</span>:</label>
                        <textarea class="form-group form-control text-dark" id="reject-reason" rows="3" placeholder="Enter the detailed reason for rejecting the PO..."></textarea>
                        <small id="reject-reason-error" class="text-danger font-weight-bold d-none"><span class="lang-text">RejectReasonDeatils</span></small>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary font-weight-bold" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> <span class="lang-text">Cancel</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-danger font-weight-bold" id="btn-confirm-reject">
                        <i class="fas fa-check mr-1"></i> <span class="lang-text">Agree</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Thông báo kết quả tạo Sales Order / PO NetSuite -->
    <div class="modal fade" id="netsuiteResultModal" tabindex="-1" role="dialog" aria-labelledby="netsuiteResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header" id="ns-modal-header">
                    <h6 class="modal-title font-weight-bold text-white" id="netsuiteResultModalLabel">
                        <i id="ns-modal-icon" class="fas fa-info-circle mr-1"></i> <span class="lang-text">CreateERPPOTitle</span>
                    </h6>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="ns-modal-message" class="font-weight-bold mb-2 text-dark"></p>
                    <div id="ns-modal-po-info" class="small text-muted d-none">
                        <span>PO Number</span>: <strong id="ns-modal-po-number" class="text-primary"></strong>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary font-weight-bold" data-dismiss="modal"><span class="lang-text">Close</span></button>
                    <!-- Nút mở link NetSuite (Chỉ hiện khi thành công) -->
                    <a href="#" id="ns-modal-link-btn" target="_blank" class="btn btn-sm btn-success font-weight-bold d-none">
                        <i class="fas fa-external-link-alt mr-1"></i> <span class="lang-text">OpenAPOInNetSuite</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Xác nhận đúng SigmaCode khi Edit ItemCode -->
    <div class="modal fade" id="confirmSigmaCodeModal" tabindex="-1" role="dialog" aria-labelledby="confirmSigmaCodeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header bg-warning text-dark py-2">
                    <h6 class="modal-title font-weight-bold" id="confirmSigmaCodeModalLabel">
                        <i class="fas fa-exclamation-triangle mr-1"></i> Confirm that the item code matches the ERP system.
                    </h6>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-2 text-dark"><span>You have just changed the item code (ItemCode). Please ensure that the code you have entered is correct</span> <strong>SigmaCode</strong> <span>has been configured on the ERP system.</span></p>
                    <p class="small text-muted mb-0"><span>Code currently being modified:</span> <strong id="lbl-editing-itemcode" class="text-primary"></strong></p>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary font-weight-bold" id="btn-cancel-sigmacode">
                        <i class="fas fa-times mr-1"></i> Cancel
                    </button>
                    <button type="button" class="btn btn-sm btn-primary font-weight-bold" id="btn-confirm-sigmacode">
                        <i class="fas fa-check mr-1"></i> Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Chọn Subsidiary trước khi tạo Sales Order -->
    <!-- Modal Chọn Thông Số NetSuite trước khi tạo Sales Order -->
    <div class="modal fade" id="subsidiarySelectModal" tabindex="-1" role="dialog" aria-labelledby="subsidiarySelectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title font-weight-bold" id="subsidiarySelectModalLabel">
                        <i class="fas fa-sliders-h mr-1"></i> <span class="lang-text" data-key="NetSuite Configuration">NetSuite Configuration</span>
                    </h6>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-3">
                    <!-- 1. Subsidiary -->
                    <div class="form-group mb-2">
                        <label for="select-subsidiary" class="small font-weight-bold text-muted mb-1">
                            <span class="lang-text" data-key="Subsidiary">Subsidiary</span> <span class="text-danger">*</span>:
                        </label>
                        <select id="select-subsidiary" class="form-control text-dark">
                            <option value="">-- Select --</option>
                        </select>
                    </div>

                    <!-- 2. Location -->
                    <div class="form-group mb-2">
                        <label for="select-location" class="small font-weight-bold text-muted mb-1">
                            <span class="lang-text" data-key="Location">Location</span> <span class="text-danger">*</span>:
                        </label>
                        <select id="select-location" class="form-control text-dark">
                            <option value="">-- Select --</option>
                        </select>
                    </div>

                    <!-- 3. Tax Code -->
                    <div class="form-group mb-2">
                        <label for="select-taxcode" class="small font-weight-bold text-muted mb-1">
                            <span class="lang-text" data-key="Tax Code">Tax Code</span> <span class="text-danger">*</span>:
                        </label>
                        <select id="select-taxcode" class="form-control text-dark">
                            <option value="">-- Select --</option>
                        </select>
                    </div>

                    <!-- 4. Project Code -->
                    <div class="form-group mb-0">
                        <label for="select-projectcode" class="small font-weight-bold text-muted mb-1">
                            <span class="lang-text" data-key="Project Code">Project Code</span>:
                        </label>
                        <select id="select-projectcode" class="form-control text-dark">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary font-weight-bold" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> <span class="lang-text" data-key="Cancel">Cancel</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-primary font-weight-bold" id="btn-confirm-create-so">
                        <i class="fas fa-check mr-1"></i> <span class="lang-text" data-key="Confirm & Create SO">Confirm & Create SO</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Badge Trạng thái phía trên góc phải -->
    <div class="d-flex align-items-center">
        <span class="mr-2 text-secondary font-weight-bold small">System Validations:</span>
        <span id="ocr-badge-status" class="badge badge-secondary p-2 font-weight-normal">
            <i id="ocr-badge-icon" class="fas fa-info-circle mr-1"></i>
            <span id="ocr-badge-text">OCR Audit: <span class="lang-text">Pending PDF Upload</span></span>
        </span>
        <!-- Badge Trạng thái Bước 2 (ERP Pricing Verification) - Mặc định ẩn, hiện khi sang Bước 2 -->
        <span id="erp-badge-status" class="badge badge-secondary p-2 font-weight-normal ml-2 d-none">
            <i id="erp-badge-icon" class="fas fa-info-circle mr-1"></i>
            <span id="erp-badge-text">ERP Pricing: <span class="lang-text">Pending Verification</span></span>
        </span>
        <!-- Badge Trạng thái Bước 3 (Sales Order Conversion) - Độc lập cho Bước 3 -->
        <span id="so-badge-status" class="badge badge-secondary p-2 font-weight-normal ml-2 d-none">
            <i id="so-badge-icon" class="fas fa-check-circle mr-1"></i>
            <span id="so-badge-text">Sales Order: <span class="lang-text">Ready for Conversion</span></span>
        </span>
    </div>
</div>

<!-- Main Content Area -->
<div class="container-fluid px-0">
    <div class="row no-gutters">

        <!-- Cột trái: Review File PDF -->
        <div class="col-md-5 pdf-panel">
            <div class="w-100 d-flex justify-content-between align-items-center mb-2 text-white">
                <span class="small font-weight-bold ml-2"><i class="fas fa-file-pdf mr-1"></i> <span class="lang-text" data-key="Document Viewer">Document Viewer</span></span>
                <span id="file-name-display" style="margin-right:.5rem" class="small text-warning font-italic lang-text" data-key="No File Selected">Chưa chọn file</span>
            </div>

            <div id="pdf-preview-container" class="pdf-preview-box">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted">
                    <i class="fas fa-file-pdf fa-4x mb-3 text-secondary"></i>
                    <p class="mb-1"><span class="lang-text" data-key="Import PDF Notice Part 1">Nhấn</span> <strong class="lang-text" data-key="Import File PDF">"Import File PDF"</strong> <span class="lang-text" data-key="Import PDF Notice Part 2">ở trên để tải file lên.</span></p>
                    <small class="text-muted lang-text" data-key="Import PDF Notice Sub">Nội dung sẽ tự động hiển thị và bóc tách tại đây.</small>
                </div>
            </div>
        </div>

        <!-- Cột phải: Dữ liệu AI Extracted & Bảng chi tiết -->
        <div class="col-md-7 p-3">

            <!-- Cảnh báo Audit OCR (Mặc định ẩn khi chưa upload PDF) -->
            <div id="ocr-audit-alert-box" class="alert-error-custom mb-3" style="display: none;">
                <div id="ocr-audit-title" class="font-weight-bold mb-1">
                    <span class="text-danger mr-1">●</span> <span class="lang-text" data-key="CRITICAL OCR AUDIT ERROR">CRITICAL OCR AUDIT ERROR: Data Integrity Check Failed</span>
                </div>
                <ul id="ocr-audit-details" class="mb-1 pl-4 small"></ul>
                <div id="ocr-audit-action" class="font-italic small mt-1"></div>
            </div>

            <!-- PO Header Extracted -->
            <div class="card card-custom">
                <div class="card-header lang-text" data-key="PO HEADER (AI EXTRACTED)">
                    PO HEADER (AI EXTRACTED)
                </div>
                <div class="card-body py-2">
                    <div class="row text-uppercase text-muted small font-weight-bold">
                        <div class="col-md-3 lang-text" data-key="PO Number">PO Number</div>
                        <div class="col-md-3 lang-text" data-key="Date">Date</div>
                        <div class="col-md-3 lang-text" data-key="Customer">Customer</div>
                        <div class="col-md-3 lang-text" data-key="Requisitioner">Requisitioner</div>
                        <!-- Trường ẩn lưu trữ Currency của PO -->
                        <input type="hidden" id="po-currency-hidden" name="Currency" value="USD" />
                        <!-- Trường ẩn lưu trữ toàn bộ Object Raw OCR JSON trả về từ API -->
                        <input type="hidden" id="ocr-raw-json-hidden" value="" />
                    </div>
                    <div class="row font-weight-bold text-dark mt-1">
                        <div class="col-md-3" id="po-number-display">N/A</div>
                        <div class="col-md-3" id="po-date-display">N/A</div>
                        <div class="col-md-3" id="po-customer-display">N/A</div>
                        <div class="col-md-3" id="po-requisitioner-display">N/A</div>
                    </div>
                </div>
            </div>

            <!-- Extracted Line Items -->
            <div class="card card-custom">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span id="line-items-header" class="lang-text" data-key="EXTRACTED LINE ITEMS (0 LINES FOUND)">EXTRACTED LINE ITEMS (0 LINES FOUND)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom table-hover mb-0" id="po-line-table">
                            <thead>
                                <tr>
                                    <th style="width: 6%;" data-key="Line"><span class="lang-text">Line</span></th>
                                    <th style="width: 22%;" data-key="Item Code"><span class="lang-text">Item Code</span></th>
                                    <th style="width: 32%;" data-key="Description"><span class="lang-text">Description</span></th>
                                    <th style="width: 12%; text-align: right;" data-key="Qty"><span class="lang-text">Qty</span></th>
                                    <th style="width: 12%; text-align: right;" data-key="Unit Price"><span class="lang-text">Unit Price</span></th>
                                    <th style="width: 12%; text-align: right;" data-key="Amount"><span class="lang-text">Amount</span></th>
                                    <th style="width: 4%; text-align: center;" class="col-action d-none" data-key="Action"><span class="lang-text">Action</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-3" data-key="No Data Notice"><span class="lang-text">No data available</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Calculations Summary Footer -->
            <div class="row justify-content-end align-items-center mt-3">
                <!-- Nút Xác nhận chuyển sang bước 2 (Chỉ hiện khi Audit Passed) -->
                <div class="mr-3">
                    <button type="button" id="btn-confirm-next" class="btn btn-confirm-netsuite shadow-sm d-none">
                        <i class="fas fa-arrow-right mr-1"></i> <span class="lang-text" data-key="Compare with ERP price">Compare with ERP price</span>
                    </button>
                </div>
                <div class="col-md-6">
                    <div class="summary-box">
                        <div class="d-flex justify-content-between align-items-center mb-1 text-danger">
                            <span class="lang-text" data-key="Calculated Sum:">Calculated Sum:</span>
                            <span id="calculated-sum-display">0 Units / $0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center text-success">
                            <span class="lang-text" data-key="Expected Total (PDF):">Expected Total (PDF):</span>
                            <span id="expected-sum-display">0 Units / $0.00</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- JS Scripts (JQuery, Bootstrap 4.6) -->
@* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script> *@

<!-- JavaScript Xử lý Import PDF và Thế chỗ File Cũ -->
<script>
    $(document).ready(function() {
        // Khởi tạo Select2 cho các ô select trong Modal cấu hình NetSuite
        $('#select-subsidiary, #select-location, #select-taxcode, #select-projectcode').select2({
            theme: 'bootstrap4',
            width: '100%',
            placeholder: '-- Select --',
            allowClear: true,
            dropdownParent: $('#subsidiarySelectModal') // Quan trọng giúp ô tìm kiếm hoạt động mượt mà trong Modal
        });
    });

    // Biến đánh dấu bước hiện tại
    let currentStep = 1;


    document.getElementById('pdf-file-input').addEventListener('change', function (event) {
        const file = event.target.files[0];
        if (!file) return;

        // Lấy ngôn ngữ hiện tại đang chọn (mặc định là 'vi')
        const currentLang = localStorage.getItem('app_lang') || 'vi';

        // Kiểm tra loại file (Có thể chuẩn hóa thông báo qua file JSON nếu muốn)
        if (file.type !== 'application/pdf') {
            let msg = (currentLang === 'en') ? 'Please select a PDF format file!' :
                      (currentLang === 'zh') ? '请选择 PDF 格式的文件！' : 'Vui lòng chọn file định dạng PDF!';
            alert(msg);
            return;
        }

        // Hiển thị tên file vừa import
        document.getElementById('file-name-display').innerText = file.name;

        // Tạo đường dẫn tạm thời cho file PDF
        const fileURL = URL.createObjectURL(file);
        const container = document.getElementById('pdf-preview-container');

        // 1. DỌN DẸP / THẾ VÀO: Xóa sạch khung xem trước cũ
        container.innerHTML = '';

        // 2. Tạo thẻ object mới chứa file PDF
        const pdfObject = document.createElement('object');
        pdfObject.data = fileURL + '#toolbar=0&view=FitH';
        pdfObject.type = 'application/pdf';
        pdfObject.width = '100%';
        pdfObject.height = '100%';

        // Thông báo dự phòng nếu trình duyệt chặn viewer
        let browserSupportMsg = (currentLang === 'en') ? 'Your browser does not support direct PDF viewing.' :
                                (currentLang === 'zh') ? '您的浏览器不支持直接查看 PDF。' : 'Trình duyệt của bạn không hỗ trợ xem trực tiếp PDF.';
        let downloadBtnText = (currentLang === 'en') ? 'Download file to view' :
                              (currentLang === 'zh') ? '下载文件查看' : 'Tải file về xem';

        pdfObject.innerHTML = `
            <div class="p-4 text-center">
                <p>${browserSupportMsg}</p>
                <a href="${fileURL}" target="_blank" class="btn btn-sm btn-primary">${downloadBtnText}</a>
            </div>
        `;

        // 3. Đưa file mới vào giao diện
        container.appendChild(pdfObject);

        // ==========================================
        // 2. GỬI FILE XUỐNG CONTROLLER THÔNG QUA AJAX
        // ==========================================
        let formData = new FormData();
        formData.append('pdfFile', file);

        $.ajax({
            url: '@Url.Action("UploadPOPdf", "Oracle")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.success) {
                    let m = response.data;
                    let unmappedList = response.unmappedCodes || []; // Lấy danh sách mã chưa ánh xạ được từ server

                    // LƯU TOÀN BỘ RAW JSON VÀO THẺ ẨN
                    if (response.rawJsonStr) {
                        $('#ocr-raw-json-hidden').val(response.rawJsonStr);
                    }

                    let currency = response.currency || m.currency || 'USD';
                    $('#po-currency-hidden').val(currency);
                    console.log("PO Currency:", currency);

                    let audit = m.auditReport || {};

                    // 1. KÍCH HOẠT LẠI TẤT CẢ CÁC NÚT BẤM
                    $('#btn-convert, #btn-edit-data, #btn-reject').prop('disabled', false);

                    // 2. Cập nhật Header & Bảng
                    document.getElementById('po-number-display').innerText = m.poNumber || 'N/A';
                    document.getElementById('po-date-display').innerText = m.date || 'N/A';
                    document.getElementById('po-customer-display').innerText = m.customer || 'N/A';
                    document.getElementById('po-requisitioner-display').innerText = m.requisitioner || 'N/A';

                    // Tải file JSON từ điển để dịch động dòng số lượng lines tìm thấy
                    const jsonUrl = '@Url.Content("~/json/")' + currentLang + '.json';

                    $.getJSON(jsonUrl, function (dict) {
                        let lineFoundTemplate = dict["EXTRACTED LINE ITEMS (0 LINES FOUND)"] || "EXTRACTED LINE ITEMS ({0} LINES FOUND)";
                        let formattedLineText = lineFoundTemplate.replace("0", m.lineItems.length);
                        document.getElementById('line-items-header').innerText = formattedLineText;
                    });

                    let tbodyHtml = '';
                    m.lineItems.forEach(item => {
                        let formattedPrice = Number(item.unitPrice).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        let formattedAmount = Number(item.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                        // Kiểm tra xem mã mặt hàng này có nằm trong danh sách thiếu SigmaCode không để gắn icon cảnh báo
                        let isUnmapped = unmappedList.includes(item.itemCode) || !item.itemCode;
                        let warningIcon = isUnmapped ? `<span class="text-warning ml-1" title="Cảnh báo: Chưa tìm thấy SigmaCode tương ứng trên hệ thống ERP!"><i class="fas fa-exclamation-triangle text-warning"></i></span>` : '';

                        tbodyHtml += `<tr>
                            <td>${item.line}</td>
                            <td><span class="display-item-code">${item.itemCode || ''}</span>${warningIcon}</td>
                            <td>${item.description || ''}</td>
                            <td class="text-right">${Number(item.qty).toLocaleString()}</td>
                            <td class="text-right" data-original-price="${item.unitPrice}">$${formattedPrice}</td>
                            <td class="text-right" data-original-amount="${item.amount}">$${formattedAmount}</td>
                            <td class="text-center col-action d-none">
                                <button type="button" class="btn btn-xs btn-outline-danger btn-delete-line"><i class="fas fa-trash-alt"></i></button>
                            </td>
                        </tr>`;
                    });
                    $('#po-line-table tbody').html(tbodyHtml);

                    // =========================================================
                    // THÊM ALERT THÔNG BÁO CÁC MÃ CHƯA ÁNH XẠ Ở ĐÂY
                    // =========================================================
                    if (unmappedList.length > 0) {
                        let msg = (currentLang === 'en') ? 
                            `Warning: The following ${unmappedList.length} item code(s) could not be mapped to an ERP SigmaCode: \n\n- ${unmappedList.join('\n- ')}\n\nPlease check and update them.` :
                            (currentLang === 'zh') ? 
                            `警告：以下 ${unmappedList.length} 个物料代码无法映射到 ERP SigmaCode：\n\n- ${unmappedList.join('\n- ')}\n\请检查并更新。` :
                            `Cảnh báo: Có ${unmappedList.length} mã hàng sau chưa ánh xạ được sang SigmaCode trên hệ thống ERP:\n\n- ${unmappedList.join('\n- ')}\n\nVui lòng kiểm tra lại.`;
                
                        alert(msg);
                    }
                    // =========================================================

                    const calcUnits = Number(m.calculatedUnits).toLocaleString();
                    const calcAmt = Number(m.calculatedAmount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    const expUnits = Number(m.expectedUnits).toLocaleString();
                    const expAmt = Number(m.expectedAmount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                    document.getElementById('calculated-sum-display').innerText = `${calcUnits} Units / $${calcAmt}`;
                    document.getElementById('expected-sum-display').innerText = `${expUnits} Units / $${expAmt}`;

                    // 3. HIỂN THỊ VÀ CẬP NHẬT KHUNG CẢNH BÁO AUDIT
                    $('#ocr-audit-alert-box').show();

                    const isPassed = (audit.lineIntegrityPassed == true) && (audit.unitsMatched == true) && (audit.amountMatched == true);

                    updateAuditStatusUI(isPassed, calcUnits, expUnits, calcAmt, expAmt);

                } else {
                    let errorPrefix = (currentLang === 'en') ? 'Error: ' : (currentLang === 'zh') ? '错误：' : 'Lỗi: ';
                    alert(errorPrefix + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Lỗi kết nối:", error);
                let connErrorMsg = (currentLang === 'en') ? 'An error occurred while sending the file to the server!' :
                                   (currentLang === 'zh') ? '将文件发送到服务器时发生错误！' : 'Đã xảy ra lỗi khi gửi file lên server!';
                alert(connErrorMsg);
            }
        });
    });

    // =============================================================
    // HÀM CHUNG: LẤY VÀ ĐỐI CHIẾU GIÁ ERP CHO BƯỚC 2
    // =============================================================
    function loadStep2ErpPrices() {
        const currentLang = localStorage.getItem('app_lang') || 'vi';
        let currentLineItems = [];

        $('#po-line-table tbody tr').each(function () {
            const $tr = $(this);
            if ($tr.find('td').length <= 1) return;

            let qty = 0;
            let ocrPrice = 0;
            let itemCode = '';
            let description = '';

            if (currentStep === 1) {
                itemCode = $tr.find('td:nth-child(2)').text().trim();
                description = $tr.find('td:nth-child(3)').text().trim();
                qty = parseInt($tr.find('td:nth-child(4)').text().replace(/,/g, '')) || 0;

                ocrPrice = parseFloat($tr.find('td:nth-child(5)').attr('data-original-price'));
                if (isNaN(ocrPrice)) {
                    ocrPrice = parseFloat($tr.find('td:nth-child(5)').text().replace(/[$,]/g, '')) || 0;
                }
            } else {
                itemCode = $tr.find('.cell-item-code').text().trim();
                if (!itemCode) {
                    itemCode = $tr.find('td:nth-child(2)').text().trim();
                }

                description = $tr.attr('data-description') || '';

                qty = parseInt($tr.find('.cell-qty').attr('data-original-qty'));
                if (isNaN(qty)) {
                    qty = parseInt($tr.find('.cell-qty').text().replace(/,/g, '')) || 0;
                }

                ocrPrice = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price'));
                if (isNaN(ocrPrice)) {
                    ocrPrice = parseFloat($tr.find('.cell-ocr-price').text().replace(/[$,]/g, '')) || 0;
                }
            }

            currentLineItems.push({
                Line: parseInt($tr.find('td:nth-child(1)').text()) || 1,
                ItemCode: itemCode,
                Description: description,
                Qty: qty,
                UnitPrice: ocrPrice
            });
        });

        if (currentLineItems.length === 0) {
            let noDataMsg = (currentLang === 'en') ? "No Line Items data available for comparison!" :
                            (currentLang === 'zh') ? "没有可用于比对的行项目数据！" : "Không có dữ liệu Line Items để đối chiếu!";
            alert(noDataMsg);
            return;
        }

        // Lấy thông tin Customer và Currency từ giao diện
        let customer = $('#po-customer-display').text().trim();
        let currency = $('#po-currency-hidden').val() || 'USD';

        // Đóng gói thành một object request chung
        let requestData = {
            Customer: customer,
            Currency: currency,
            Items: currentLineItems
        };

        // Gửi Ajax xuống Controller
        $.ajax({
            url: '@Url.Action("VerifyErpPrices", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(requestData),
            success: function (response) {
                if (response.success) {
                    currentStep = 2;

                    $('#btn-import-wrapper').fadeOut(200);
                    $('#btn-edit-data').fadeOut(200);
                    $('#btn-reload-erp').removeClass('d-none');

                    const $cardContainer = $('#po-line-table').closest('.card-custom');
                    $cardContainer.fadeOut(200, function () {

                        $('#step-node-1').removeClass('active').addClass('completed');
                        $('#step-node-2').addClass('active');

                        // Cập nhật tiêu đề card header theo ngôn ngữ nếu cần, hoặc giữ nguyên key
                        $cardContainer.find('.card-header span:first').text('LINE ITEMS & PRICE VERIFICATION');

                        let tableHeaderHtml = `
                            <tr>
                                <th style="width: 8%;">Line</th>
                                <th style="width: 35%;">Customer Item #</th>
                                <th style="width: 15%; text-align: right;">Qty</th>
                                <th style="width: 14%; text-align: right;">OCR Price</th>
                                <th style="width: 14%; text-align: right;">ERP Base Price</th>
                                <th style="width: 14%; text-align: center;">Validation Status</th>
                            </tr>
                        `;
                        $('#po-line-table thead').html(tableHeaderHtml);

                        renderStep2Table(response.data);

                        if ($('#btn-confirm-next').length > 0) {
                            // Lấy từ điển đa ngôn ngữ (dict) hoặc dùng từ khóa fallback
                            let proceedText = (currentLang === 'en') ? 'Proceed to Create ERP PO' :
                                              (currentLang === 'zh') ? '继续创建 ERP PO' : 'Tiến hành tạo ERP PO';

                            $('#btn-confirm-next')
                                .html(`<i class="fas fa-arrow-right mr-1"></i> ${proceedText}`)
                                .attr('id', 'btn-proceed-step3');
                        }

                        checkAllStep2Matched();
                        $cardContainer.fadeIn(300);
                    });

                } else {
                    let errPrefix = (currentLang === 'en') ? "ERP price comparison error: " :
                                    (currentLang === 'zh') ? "ERP 价格比对错误：" : "Lỗi đối chiếu giá ERP: ";
                    alert(errPrefix + response.message);
                }
            },
            error: function () {
                let connError = (currentLang === 'en') ? "Connection error while fetching ERP data from server!" :
                                (currentLang === 'zh') ? "从服务器获取 ERP 数据时连接出错！" : "Lỗi kết nối khi gọi dữ liệu ERP từ server!";
                alert(connError);
            }
        });
    }

    // -------------------------------------------------------------
    // 1. XỬ LÝ SỰ KIỆN NÚT "XÁC NHẬN & CHUYỂN BƯỚC 2"
    // -------------------------------------------------------------
    $(document).on('click', '#btn-confirm-next', function () {
        loadStep2ErpPrices();
    });

    // =============================================================
    // XỬ LÝ SỰ KIỆN CHUYỂN TỪ BƯỚC 2 SANG BƯỚC 3 (CREATE SO)
    // =============================================================
    $(document).on('click', '#btn-proceed-step3', function () {
        const $btnStep3 = $(this);
        const currentLang = localStorage.getItem('app_lang') || 'vi';

        // 1. Khóa nút tạm thời để tránh bấm nhiều lần và thông báo đang kiểm tra
        let checkingMsg = (currentLang === 'en') ? '<i class="fas fa-spinner fa-spin mr-1"></i> Re-verifying ERP prices...' :
                          (currentLang === 'zh') ? '<i class="fas fa-spinner fa-spin mr-1"></i> 正在重新验证 ERP 价格...' :
                          '<i class="fas fa-spinner fa-spin mr-1"></i> Đang kiểm tra lại giá ERP...';
        $btnStep3.prop('disabled', true).html(checkingMsg);

        // 2. Thu thập lại danh sách dòng hiện tại
        let currentLineItems = [];
        $('#po-line-table tbody tr').each(function () {
            const $tr = $(this);
            if ($tr.find('td').length <= 1) return;

            let itemCode = $tr.find('.cell-item-code').text().trim();
            if (!itemCode) {
                itemCode = $tr.find('td:nth-child(2)').text().trim();
            }

            let description = $tr.attr('data-description') || '';
            let qty = parseInt($tr.find('.cell-qty').attr('data-original-qty') || $tr.find('.cell-qty').text().replace(/,/g, '')) || 0;
            let ocrPrice = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price') || $tr.find('.cell-ocr-price').text().replace(/[$,]/g, '')) || 0;

            currentLineItems.push({
                Line: parseInt($tr.find('td:nth-child(1)').text()) || 1,
                ItemCode: itemCode,
                Description: description,
                Qty: qty,
                UnitPrice: ocrPrice
            });
        });

        let customer = $('#po-customer-display').text().trim();
        let currency = $('#po-currency-hidden').val() || 'USD';

        let requestData = {
            Customer: customer,
            Currency: currency,
            Items: currentLineItems
        };

        // 3. GỌI LẠI API VERIFY ERP PRICES ĐỂ KIỂM TRA LẦN CUỐI TRƯỚC KHI SANG BƯỚC 3
        $.ajax({
            url: '@Url.Action("VerifyErpPrices", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(requestData),
            success: function (response) {
                let btnResetHtml = (currentLang === 'en') ? '<i class="fas fa-arrow-right mr-1"></i> Proceed to Create SO (Step 3)' :
                                   (currentLang === 'zh') ? '<i class="fas fa-arrow-right mr-1"></i> 继续创建 SO (步骤 3)' :
                                   '<i class="fas fa-arrow-right mr-1"></i> Proceed to Create SO (Bước 3)';

                if (response.success) {
                    let hasNewVariance = false;
                    response.data.forEach(item => {
                        if (!item.isMatched) {
                            hasNewVariance = true;
                        }
                    });

                    // Cập nhật lại giao diện bảng với dữ liệu mới nhất từ server
                    renderStep2Table(response.data);

                    if (hasNewVariance) {
                        let varianceWarn = (currentLang === 'en') ? "WARNING: ERP system prices have changed since the previous comparison. Please review the mismatched lines before proceeding to Step 3!" :
                                           (currentLang === 'zh') ? "警告：与上次比对相比，ERP 系统价格刚发生了变化。进入步骤 3 之前请检查存在偏差的行！" :
                                           "CẢNH BÁO: Giá trên hệ thống ERP vừa có sự thay đổi so với lúc đối chiếu trước đó. Vui lòng kiểm tra lại các dòng bị lệch trước khi chuyển sang Bước 3!";
                        alert(varianceWarn);
                        $btnStep3.prop('disabled', false).html(btnResetHtml);
                        return;
                    }

                    // ==========================================
                    // MỌI THỨ VẪN KHỚP HOÀN TOÀN -> CHUYỂN SANG BƯỚC 3
                    // ==========================================
                    currentStep = 3;

                    $('#step-node-2').removeClass('active').addClass('completed');
                    $('#step-node-3').addClass('active');

                    $('#btn-reload-erp').addClass('d-none');
                    $('#btn-convert').removeClass('d-none').prop('disabled', false);
                    $btnStep3.fadeOut(200);

                    const $cardContainer = $('#po-line-table').closest('.card-custom');
                    $cardContainer.find('.card-header span:first').text('READY TO CONVERT SALES ORDER (STEP 3)');

                    $('#erp-badge-status').removeClass('d-none');
                    $('#so-badge-status')
                        .removeClass('d-none')
                        .removeClass('badge-secondary badge-warning')
                        .addClass('badge-success')
                        .css({ 'background-color': '#28a745', 'color': '#fff' });
                    $('#so-badge-text').text('Sales Order: Ready for Conversion');

                    const $alertBox = $('#ocr-audit-alert-box');
                    $alertBox.show()
                             .removeClass('alert-error-custom alert-warning-custom')
                             .addClass('alert-success-custom')
                             .css({ 'background-color': '#f3faf7', 'border': '1px solid #bcf0da', 'color': '#03543f' });

                    $('#ocr-audit-title').html('<span class="text-success mr-1">●</span> SALES ORDER CREATION READY: Re-verified Successfully');
                    $('#ocr-audit-details').html(`
                        <li><strong>Final Price Check:</strong> ERP base prices re-verified successfully just before conversion.</li>
                        <li><strong>Status:</strong> All compliance checkpoints passed securely. Ready for NetSuite SO generation.</li>
                    `);
                    $('#ocr-audit-action').removeClass('text-danger text-warning').addClass('text-success')
                           .css('color', '#0e9f6e')
                           .html('<strong>Status:</strong> Security check passed. Click <strong>"Convert to ERP PO"</strong> above to finalize.');

                    let successMsg = (currentLang === 'en') ? "Confirmation successful! ERP prices re-checked and ready to Convert to Sales Order." :
                                     (currentLang === 'zh') ? "确认成功！ERP 价格已重新核对，随时可以转换为销售订单。" :
                                     "Xác nhận thành công! Hệ thống đã re-check lại giá ERP và sẵn sàng để Convert to Sales Order.";
                    alert(successMsg);

                } else {
                    let errCheckMsg = (currentLang === 'en') ? "Error re-verifying ERP prices: " :
                                      (currentLang === 'zh') ? "重新验证 ERP 价格出错：" : "Lỗi kiểm tra lại giá ERP: ";
                    alert(errCheckMsg + response.message);
                    $btnStep3.prop('disabled', false).html(btnResetHtml);
                }
            },
            error: function () {
                let connErr = (currentLang === 'en') ? "Connection error while re-verifying ERP prices from server!" :
                              (currentLang === 'zh') ? "从服务器重新验证 ERP 价格时连接出错！" : "Đã xảy ra lỗi kết nối khi kiểm tra lại giá ERP từ server!";
                let btnResetHtml = (currentLang === 'en') ? '<i class="fas fa-arrow-right mr-1"></i> Proceed to Create SO (Step 3)' :
                                   (currentLang === 'zh') ? '<i class="fas fa-arrow-right mr-1"></i> 继续创建 SO (步骤 3)' :
                                   '<i class="fas fa-arrow-right mr-1"></i> Proceed to Create SO (Bước 3)';
                alert(connErr);
                $btnStep3.prop('disabled', false).html(btnResetHtml);
            }
        });
    });

    // -------------------------------------------------------------
    // 2. HÀM RENDER BẢNG BƯỚC 2 & HIỂN THỊ CẢNH BÁO NOTICE
    // -------------------------------------------------------------
    function renderStep2Table(dataList) {
        const currentLang = localStorage.getItem('app_lang') || 'vi';
        let hasVariance = false;
        let tbodyHtml = '';

        dataList.forEach(item => {
            let statusHtml = '';
            let rowClass = '';
            const ocrPrice = parseFloat(item.ocrPrice) || 0;
            const erpPrice = parseFloat(item.erpBasePrice) || 0;
            const variance = ocrPrice - erpPrice;
            const isMatched = Math.abs(variance) < 0.0001;

            if (isMatched) {
                let matchedText = (currentLang === 'en') ? 'Matched' :
                                  (currentLang === 'zh') ? '已匹配' : 'Đã khớp';
                statusHtml = `<span class="text-matched"><i class="fas fa-check mr-1"></i> ${matchedText}</span>`;
            } else {
                hasVariance = true;
                rowClass = 'row-variance animate-fade-in';
                let varianceLabel = (currentLang === 'en') ? 'Variance' :
                                    (currentLang === 'zh') ? '偏差' : 'Lệch giá';
                let sign = variance > 0 ? `+$${variance.toFixed(2)}` : `-$${Math.abs(variance).toFixed(2)}`;
                statusHtml = `<span class="text-variance"><i class="fas fa-exclamation-triangle mr-1"></i> ${varianceLabel}: ${sign}</span>`;
            }

            // ĐÃ XÓA CỘT DESCRIPTION TRÊN GIAO DIỆN, LƯU NGẦM QUA data-description
            tbodyHtml += `
                <tr class="${rowClass}" data-erp-price="${erpPrice}" data-description="${item.description || ''}">
                    <td>${item.line}</td>
                    <td class="font-weight-bold cell-item-code">${item.itemCode}</td>
                    <td class="text-right cell-qty" data-original-qty="${item.qty}">${item.qty.toLocaleString()}</td>
                    <td class="text-right cell-ocr-price ${!isMatched ? 'text-variance font-weight-bold' : ''}" data-original-price="${ocrPrice}">$${ocrPrice}</td>
                    <td class="text-right cell-erp-price">$${erpPrice}</td>
                    <td class="text-center cell-status">${statusHtml}</td>
                </tr>
            `;
        });

        $('#po-line-table tbody').html(tbodyHtml);

        updateStep2NoticeBox(hasVariance);
        updateStep2BadgeStatus(hasVariance);
        updateStep2AuditAlertBox(dataList, hasVariance); // CẬP NHẬT KHUNG THÔNG BÁO PHÍA TRÊN
        $('#btn-reload-erp').removeClass('d-none');
        checkAllStep2Matched();
    }

    // Hàm bật/tắt khung thông báo Notice thời gian thực
    function updateStep2NoticeBox(hasVariance) {
        const currentLang = localStorage.getItem('app_lang') || 'vi';
        const $cardContainer = $('#po-line-table').closest('.card-custom');
        $('#variance-notice-box').remove();

        if (hasVariance) {
            let noticeTitle = (currentLang === 'en') ? 'Notice:' :
                              (currentLang === 'zh') ? '注意：' : 'Lưu ý:';
            let noticeDesc = (currentLang === 'en') ? 'One or more lines trigger custom pricing logic. Converting this record will route the Sales Order to <strong>Pending Approval</strong> status.' :
                             (currentLang === 'zh') ? '一个或多个行触发了自定义定价逻辑。转换此记录将使销售订单进入<strong>待审批 (Pending Approval)</strong> 状态。' :
                             'Một hoặc nhiều dòng kích hoạt logic định giá tùy chỉnh. Việc chuyển đổi bản ghi này sẽ chuyển Đơn hàng Bán sang trạng thái <strong>Chờ phê duyệt (Pending Approval)</strong>.';

            let noticeHtml = `
                <div class="verification-notice animate-fade-in" id="variance-notice-box">
                    <i class="fas fa-info-circle mr-1"></i> <strong>${noticeTitle}</strong> ${noticeDesc}
                </div>
            `;
            $cardContainer.after(noticeHtml);
        }
    }
</script>

<script>
    // Biến lưu trữ trạng thái dữ liệu hiện tại
    let isEditingMode = false;
    let originalDataBackup = null; // Backup dữ liệu để khôi phục nếu nhấn Cancel

    // -------------------------------------------------------------
    // 1. BẬT CHẾ ĐỘ CHỈNH SỬA (EDIT MODE)
    // -------------------------------------------------------------
    $('#btn-edit-data').on('click', function () {
        enableEditMode(true);
    });

    // HỦY CHỈNH SỬA (CANCEL)
        $('#btn-cancel-edit').on('click', function () {
        const currentLang = localStorage.getItem('app_lang') || 'vi';

        if (originalDataBackup) {
            if (currentStep === 1) {
                // Restore lại bảng dữ liệu cũ
                renderTableFromData(originalDataBackup.lineItems);
                // Restore lại PO Header
                $('#po-number-display').text(originalDataBackup.poNumber);
                $('#po-date-display').text(originalDataBackup.date);
                $('#po-customer-display').text(originalDataBackup.customer);
                $('#po-requisitioner-display').text(originalDataBackup.requisitioner);
            } else if (currentStep === 2) {
                // Ở bước 2, khôi phục lại giá OCR gốc từ bản backup
                let i = 0;
                $('#po-line-table tbody tr').each(function () {
                    const $tr = $(this);
                    if (originalDataBackup.lineItems[i]) {
                        const origPrice = originalDataBackup.lineItems[i].unitPrice;
                        $tr.find('.cell-ocr-price').attr('data-original-price', origPrice).text(`$${origPrice}`);

                        // Tính lại match/variance
                        const erpPrice = parseFloat($tr.attr('data-erp-price')) || 0;
                        const variance = origPrice - erpPrice;
                        const isMatched = Math.abs(variance) < 0.0001;

                        if (isMatched) {
                            let matchedText = (currentLang === 'en') ? 'Matched' :
                                              (currentLang === 'zh') ? '已匹配' : 'Đã khớp';
                            $tr.removeClass('row-variance');
                            $tr.find('.cell-status').html(`<span class="text-matched"><i class="fas fa-check mr-1"></i> ${matchedText}</span>`);
                        } else {
                            let varianceLabel = (currentLang === 'en') ? 'Variance' :
                                                (currentLang === 'zh') ? '偏差' : 'Lệch giá';
                            $tr.addClass('row-variance');
                            let sign = variance > 0 ? `+$${variance.toFixed(2)}` : `-$${Math.abs(variance).toFixed(2)}`;
                            $tr.find('.cell-status').html(`<span class="text-variance"><i class="fas fa-exclamation-triangle mr-1"></i> ${varianceLabel}: ${sign}</span>`);
                        }
                    }
                    i++;
                });
                checkAndUpdateStep2Notice();
            }
        }
        enableEditMode(false);
        if (currentStep === 1) recalculateAndAudit();
    });

    let pendingSaveAction = false;

// 1. TOÀN BỘ SỰ KIỆN NÚT SAVE CHANGES VÀ XỬ LÝ MODAL SIGMACODE
$('#btn-save-edit').on('click', function () {
    const currentLang = localStorage.getItem('app_lang') || 'vi';

    // Kiểm tra xem người dùng có đang sửa cột Item Code (Mã hàng) hay không
    let codeChanged = false;
    let modifiedCode = "";

    $('#po-line-table tbody tr').each(function () {
        const $tr = $(this);
        const $input = $tr.find('.input-item-code');
        if ($input.length > 0) {
            codeChanged = true;
            modifiedCode = $input.val().trim();
        }
    });

    // Nếu có sửa đổi ItemCode và chưa qua bước bấm Confirm ở Modal -> Bật Modal cảnh báo yêu cầu đúng SigmaCode
    if (codeChanged && !pendingSaveAction) {
        $('#lbl-editing-itemcode').text(modifiedCode);
        $('#confirmSigmaCodeModal').modal('show');
        return; // Dừng lại chờ user bấm Confirm/Cancel trên modal
    }

    if (currentStep === 1) {
        let hasEmptyError = false;
        let emptyErrorMessage = "";

        // 1. KIỂM TRA DỮ LIỆU BỎ TRỐNG / KHÔNG HỢP LỆ TRÊN TỪNG DÒNG
        $('#po-line-table tbody tr').each(function (index) {
            const $tr = $(this);
            const itemCode = $tr.find('.input-item-code').val().trim();
            const qty = parseFloat($tr.find('.input-qty').val()) || 0;
            const price = parseFloat($tr.find('.input-price').val()) || 0;

            if (itemCode === "" || qty <= 0 || price <= 0) {
                hasEmptyError = true;
                emptyErrorMessage = (currentLang === 'en') ? `Line ${index + 1} is empty or has invalid data (Item Code, Quantity, or Unit Price). Please review or delete extra rows before saving!` :
                                    (currentLang === 'zh') ? `第 ${index + 1} 行数据为空或无效（物料代码、数量或单价）。保存前请检查或删除多余的行！` :
                                    `Dòng số ${index + 1} đang bị bỏ trống hoặc có dữ liệu không hợp lệ (Mã hàng, Số lượng hoặc Đơn giá). Vui lòng kiểm tra lại hoặc xóa dòng thừa trước khi lưu!`;
                return false;
            }
        });

        if (hasEmptyError) {
            alert(emptyErrorMessage);
            pendingSaveAction = false;
            return;
        }

        // 2. KIỂM TRA TÍNH KHỐP CỦA AUDIT (CALCULATED VS EXPECTED)
        let totalUnits = 0;
        let totalAmount = 0;

        $('#po-line-table tbody tr').each(function () {
            const $tr = $(this);
            const qty = parseFloat($tr.find('.input-qty').val()) || 0;
            const price = parseFloat($tr.find('.input-price').val()) || 0;
            totalUnits += qty;
            totalAmount += (qty * price);
        });

        totalAmount = Math.round(totalAmount * 100) / 100;

        const expText = $('#expected-sum-display').text();
        const expMatch = expText.match(/([\d,]+)\s*Units\s*\/\s*\$([\d,.]+)/);
        let expectedUnits = 0;
        let expectedAmount = 0;

        if (expMatch) {
            expectedUnits = parseInt(expMatch[1].replace(/,/g, '')) || 0;
            expectedAmount = parseFloat(expMatch[2].replace(/,/g, '')) || 0;
        }

        const isUnitsMatched = (totalUnits === expectedUnits);
        const isAmountMatched = (Math.abs(totalAmount - expectedAmount) < 0.01);

        if (!isUnitsMatched || !isAmountMatched) {
            let titleMsg = (currentLang === 'en') ? "Cannot save data because it does not match the totals on the PDF!\n\n" :
                           (currentLang === 'zh') ? "无法保存数据，因为与 PDF 上的总计不符！\n\n" :
                           "Không thể lưu dữ liệu vì dữ liệu chưa khớp với tổng trên PDF!\n\n";
            let auditErrorMsg = titleMsg;

            if (!isUnitsMatched) {
                let unitLabel = (currentLang === 'en') ? `- Total Units: Calculated (${totalUnits.toLocaleString()}) != Expected (${expectedUnits.toLocaleString()})\n` :
                                (currentLang === 'zh') ? `- 总数量 (Units)：计算值 (${totalUnits.toLocaleString()}) != 期望值 (${expectedUnits.toLocaleString()})\n` :
                                `- Tổng số lượng (Units): Tính toán (${totalUnits.toLocaleString()}) != Kỳ vọng (${expectedUnits.toLocaleString()})\n`;
                auditErrorMsg += unitLabel;
            }
            if (!isAmountMatched) {
                let amtLabel = (currentLang === 'en') ? `- Total Amount: Calculated ($${totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}) != Expected ($${expectedAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })})\n` :
                               (currentLang === 'zh') ? `- 总金额 (Amount)：计算值 ($${totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}) != 期望值 ($${expectedAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })})\n` :
                               `- Tổng tiền (Amount): Tính toán ($${totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}) != Kỳ vọng ($${expectedAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })})\n`;
                auditErrorMsg += amtLabel;
            }
            alert(auditErrorMsg);
            pendingSaveAction = false;
            return;
        }

        // ==========================================
        // 3. THU THẬP TRẠNG THÁI "SAU KHI SỬA" (AFTER)
        // ==========================================
        let afterStateData = {
            poNumber: $('#po-number-display').find('input').val() || $('#po-number-display').text().trim(),
            date: $('#po-date-display').find('input').val() || $('#po-date-display').text().trim(),
            customer: $('#po-customer-display').find('input').val() || $('#po-customer-display').text().trim(),
            requisitioner: $('#po-requisitioner-display').find('input').val() || $('#po-requisitioner-display').text().trim(),
            lineItems: []
        };

        $('#po-line-table tbody tr').each(function () {
            const $tr = $(this);
            let qty = parseFloat($tr.find('.input-qty').val()) || 0;
            let price = parseFloat($tr.find('.input-price').val()) || 0;
            afterStateData.lineItems.push({
                line: $tr.find('td:nth-child(1)').text().trim(),
                itemCode: $tr.find('.input-item-code').val() || '',
                description: $tr.find('.input-desc').val() || '',
                qty: qty,
                unitPrice: price,
                amount: qty * price
            });
        });

        // 4. IN RA CONSOLE HOẶC GỬI NGẦM LÊN SERVER ĐỂ LOG LẠI
        console.log("--- TRẠNG THÁI TRƯỚC KHI SỬA (BEFORE) ---", originalDataBackup);
        console.log("--- TRẠNG THÁI SAU KHI SỬA (AFTER) ---", afterStateData);

        $.ajax({
            url: '@Url.Action("LogPoEdits", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                PONumber: afterStateData.poNumber,
                BeforeState: JSON.stringify(originalDataBackup),
                AfterState: JSON.stringify(afterStateData)
            })
        });

        // 5. LƯU THỰC THẾ TRÊN GIAO DIỆN
        saveTableEdits();
        updateHiddenRawJson();
        enableEditMode(false);
        recalculateAndAudit();
        pendingSaveAction = false; // Reset cờ trạng thái

        let successMsg1 = (currentLang === 'en') ? "PO data updated successfully!" :
                          (currentLang === 'zh') ? "PO 数据更新成功！" : "Đã cập nhật dữ liệu PO thành công!";
        alert(successMsg1);

    } else if (currentStep === 2) {
        saveStep2Edits();
        enableEditMode(false);
        pendingSaveAction = false; // Reset cờ trạng thái

        let successMsg2 = (currentLang === 'en') ? "OCR Price updated successfully!" :
                          (currentLang === 'zh') ? "OCR 价格更新成功！" : "Đã cập nhật OCR Price thành công!";
        alert(successMsg2);
    }
});

// 2. SỰ KIỆN BẤM CONFIRM TRÊN MODAL XÁC NHẬN SIGMACODE
$(document).on('click', '#btn-confirm-sigmacode', function () {
    pendingSaveAction = true; // Đánh dấu đã xác nhận qua modal
    $('#confirmSigmaCodeModal').modal('hide');
    $('#btn-save-edit').trigger('click'); // Kích hoạt lại sự kiện Save
});

// 3. SỰ KIỆN BẤM CANCEL TRÊN MODAL XÁC NHẬN SIGMACODE
$(document).on('click', '#btn-cancel-sigmacode', function () {
    pendingSaveAction = false;
    $('#confirmSigmaCodeModal').modal('hide');
});

    // -------------------------------------------------------------
    // 2. CHUYỂN ĐỔI GIAO DIỆN EDIT <-> VIEW
    // -------------------------------------------------------------
    function enableEditMode(enable) {
        isEditingMode = enable;

        if (enable) {
            // --- BẬT CHẾ ĐỘ CHỈNH SỬA ---
            backupCurrentData();

            // Ẩn nút "Edit Data", hiện nhóm nút thao tác cùng hàng ngang
            $('#btn-edit-data').hide();
            $('#edit-actions-group').css('display', 'inline-flex'); // Hiển thị chuẩn dạng Flex/Inline không bị nhảy xuống dòng

            // 2. ẨN NÚT XÁC NHẬN CHUYỂN BƯỚC KHI ĐANG EDIT
            $('#btn-confirm-next').addClass('d-none');

            // NẾU ĐANG Ở BƯỚC 2: Ẩn nút Add Item đi vì không cho phép thêm dòng mới ở bước này
            if (currentStep === 2) {
                $('#btn-add-line').hide();
            } else {
                $('#btn-add-line').show();
            }

            // Hiện cột thao tác Xóa (Thùng rác) trong bảng
            if (currentStep === 1) {
                $('.col-action').removeClass('d-none');
            }

            // Chuyển Header và Bảng thành các ô Input
            makeHeaderEditable(true);
            makeTableEditable(true);
        } else {
            // --- TẮT CHẾ ĐỘ CHỈNH SỬA ---
            // Hiện lại nút "Edit Data", ẩn nhóm nút thao tác
            //$('#btn-edit-data').show();
            $('#edit-actions-group').css('display', 'none');

            // Ẩn cột thao tác Xóa trong bảng
            $('.col-action').addClass('d-none');

            // CHỈ HIỆN LẠI NÚT "EDIT DATA" NẾU ĐANG Ở BƯỚC 1. Ở BƯỚC 2 SẼ ẨN LUÔN NHƯNG GIỮ LOGIC.
            if (currentStep === 1) {
                $('#btn-edit-data').show();
            } else {
                $('#btn-edit-data').hide(); // Ẩn hoàn toàn nút Edit ở Bước 2 theo yêu cầu mới
            }

            // Chuyển Header và Bảng về dạng text tĩnh
            makeHeaderEditable(false);
            makeTableEditable(false);

            // 3. HIỂN THỊ LẠI NÚT XÁC NHẬN NẾU DỮ LIỆU ĐÃ KHỐP AUDIT (PASSED)
            if (currentStep === 1) {
                recalculateAndAudit(); // Hàm này sẽ tự động bật lại #btn-confirm-next nếu Audit Passed
            }
        }
    }

    // -------------------------------------------------------------
    // 3. THÊM BỚT DÒNG (ADD & DELETE LINE)
    // -------------------------------------------------------------
    // Thêm dòng mới
    $('#btn-add-line').on('click', function () {
        const lineCount = $('#po-line-table tbody tr').length + 1;
        const newRowHtml = `
            <tr>
                <td class="row-line-no">${lineCount}</td>
                <td><input type="text" class="edit-input input-item-code" value=""></td>
                <td><input type="text" class="edit-input input-desc" value=""></td>
                <td class="text-right"><input type="number" class="edit-input input-qty text-right" value="1" min="1"></td>
                <td class="text-right"><input type="number" step="0.0001" class="edit-input input-price text-right" value="0.0000"></td>
                <td class="text-right row-amount-text" data-original-amount="0">$0.00</td>
                <td class="text-center col-action">
                    <button type="button" class="btn btn-xs btn-outline-danger btn-delete-line"><i class="fas fa-trash-alt"></i></button>
                </td>
            </tr>
        `;
        $('#po-line-table tbody').append(newRowHtml);
        reindexLines();
        recalculateAndAudit();
    });

    // Xóa dòng
    $(document).on('click', '.btn-delete-line', function () {$(this).closest('tr').remove();
        reindexLines();
        recalculateAndAudit();
    });

    // Đánh lại số thứ tự Line (1, 2, 3...)
    function reindexLines() {
        $('#po-line-table tbody tr').each(function (index) {
            $(this).find('.row-line-no').text(index + 1);
        });
        const totalLines = $('#po-line-table tbody tr').length;
        $('#line-items-header').text(`EXTRACTED LINE ITEMS (${totalLines} LINES FOUND)`);
    }

    // -------------------------------------------------------------
    // 4. CHUYỂN Ô THÀNH INPUT HOẶC TEXT
    // -------------------------------------------------------------
    function makeTableEditable(editable) {
        if(currentStep === 1){
            $('#po-line-table tbody tr').each(function () {
                const $tr =$(this);
                if (editable) {
                    const code = $tr.find('td:nth-child(2)').text().trim();
                    const desc = $tr.find('td:nth-child(3)').text().trim();
                    const qty = parseInt($tr.find('td:nth-child(4)').text().replace(/,/g, '')) || 0;

                    // Ưu tiên lấy giá trị chuẩn chính xác từ data-original-price
                    let price = parseFloat($tr.find('td:nth-child(5)').attr('data-original-price'));
                    if (isNaN(price)) {
                        price = parseFloat($tr.find('td:nth-child(5)').text().replace(/[$,]/g, '')) || 0;
                    }

                    let amt = parseFloat($tr.find('td:nth-child(6)').attr('data-original-amount'));
                    if (isNaN(amt)) {
                        amt = parseFloat($tr.find('td:nth-child(6)').text().replace(/[$,]/g, '')) || (qty * price);
                    }

                    $tr.find('td:nth-child(2)').html(`<input type="text" class="edit-input input-item-code" value="${code}">`);
                    $tr.find('td:nth-child(3)').html(`<input type="text" class="edit-input input-desc" value="${desc}">`);
                    $tr.find('td:nth-child(4)').html(`<input type="number" class="edit-input input-qty text-right" value="${qty}">`);

                    // Đặt step="0.0001" để cho phép nhập đơn giá nhiều chữ số thập phân chính xác
                    $tr.find('td:nth-child(5)').html(`<input type="number" step="0.0001" class="edit-input input-price text-right" value="${price}">`);
                    $tr.find('td:nth-child(6)').addClass('row-amount-text').text(`$${amt.toFixed(2)}`);
                } else {
                    saveTableEdits();
                }
            });
        } else if (currentStep === 2) {
        // --- CHẾ ĐỘ EDIT BƯỚC 2 (Chỉ sửa OCR Price để khớp với ERP) ---
        $('#po-line-table tbody tr').each(function () {
            const $tr =$(this);
            const $ocrCell =$tr.find('.cell-ocr-price');

            if (editable) {
                let ocrPrice = parseFloat($ocrCell.attr('data-original-price')) || parseFloat($ocrCell.text().replace(/[$,]/g, '')) || 0;
                $ocrCell.html(`<input type="number" step="0.0001" class="input-ocr-price" value="${ocrPrice}">`);
            } else {
                saveStep2Edits();
            }
        });
    }
        
    }

    function saveTableEdits() {
        $('#po-line-table tbody tr').each(function () {
            const $tr = $(this);
            if ($tr.find('input').length > 0) {
                const code = $tr.find('.input-item-code').val();
                const desc = $tr.find('.input-desc').val();
                const qty = parseInt($tr.find('.input-qty').val()) || 0;
                const price = parseFloat($tr.find('.input-price').val()) || 0;
                const amt = qty * price;

                // Định dạng có dấu phẩy phần nghìn
                let formattedPrice = price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                let formattedAmt = amt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                $tr.find('td:nth-child(2)').text(code);
                $tr.find('td:nth-child(3)').text(desc);
                $tr.find('td:nth-child(4)').text(qty.toLocaleString());
                $tr.find('td:nth-child(5)').text(`$${formattedPrice}`);
                $tr.find('td:nth-child(6)').text(`$${formattedAmt}`);
            }
        });
    }

    function makeHeaderEditable(editable) {
        const fields = ['po-number-display', 'po-date-display', 'po-customer-display', 'po-requisitioner-display'];
        fields.forEach(id => {
            const $el =$('#' + id);
            if (editable) {
                const val = $el.text().trim();$el.html(`<input type="text" class="edit-input input-header-field" value="${val}">`);
            } else {
                const $input =$el.find('input');
                if ($input.length > 0) {
                    $el.text($input.val());
                }
            }
        });
    }

    // -------------------------------------------------------------
    // 5. LỚP LÍNH TÍNH TOÁN VÀ SỰ KIỆN NHAU THỜI GIAN THỰC (REAL-TIME AUDIT)
    // -------------------------------------------------------------
    $(document).on('input', '.input-qty, .input-price', function () {
        const $tr =$(this).closest('tr');
        const qty = parseInt($tr.find('.input-qty').val()) || 0;
        const price = parseFloat($tr.find('.input-price').val()) || 0;
        const amt = qty * price;

        $tr.find('.row-amount-text').text(`$${amt.toFixed(2)}`);
        recalculateAndAudit();
    });

    function recalculateAndAudit() {
        let totalUnits = 0;
        let totalAmount = 0;

        $('#po-line-table tbody tr').each(function () {
            const $tr =$(this);
            let qty = 0;
            let amount = 0;

            if ($tr.find('input').length > 0) {
                // Đang ở chế độ nhập/edit: lấy Qty nhân trực tiếp với Unit Price không làm tròn sớm
                const qtyInput = parseFloat($tr.find('.input-qty').val()) || 0;
                const priceInput = parseFloat($tr.find('.input-price').val()) || 0;
                qty = qtyInput;
                amount = qtyInput * priceInput;
            } else {
                // Dòng tĩnh: ưu tiên đọc từ data-original-amount để giữ nguyên con số chính xác của hãng
                qty = parseInt($tr.find('td:nth-child(4)').text().replace(/,/g, '')) || 0;
                let savedAmt = parseFloat($tr.find('td:nth-child(6)').attr('data-original-amount'));
                if (!isNaN(savedAmt)) {
                    amount = savedAmt;
                } else {
                    amount = parseFloat($tr.find('td:nth-child(6)').text().replace(/[$,]/g, '')) || 0;
                }
            }

            totalUnits += qty;
            totalAmount += amount;
        });

        // Làm tròn tổng tiền ở bước cuối cùng
        totalAmount = Math.round(totalAmount * 100) / 100;

        // Lấy Expected Total từ giao diện để so sánh Audit
        const expText = $('#expected-sum-display').text();
        const expMatch = expText.match(/([\d,]+)\s*Units\s*\/\s*\$([\d,.]+)/);
        let expectedUnits = 0;
        let expectedAmount = 0;

        if (expMatch) {
            expectedUnits = parseInt(expMatch[1].replace(/,/g, '')) || 0;
            expectedAmount = parseFloat(expMatch[2].replace(/,/g, '')) || 0;
        }

        const calcUnitsStr = totalUnits.toLocaleString();
        const calcAmtStr = totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        $('#calculated-sum-display').text(`${calcUnitsStr} Units / $${calcAmtStr}`);

        const isUnitsMatched = (totalUnits === expectedUnits);
        const isAmountMatched = (Math.abs(totalAmount - expectedAmount) < 0.01);
        const isPassed = isUnitsMatched && isAmountMatched;

        updateAuditStatusUI(isPassed, totalUnits, expectedUnits, totalAmount, expectedAmount);
    }

    // -------------------------------------------------------------
    // 6. CẬP NHẬT MÀU SẮC & THÔNG BÁO CẢNH BÁO
    // -------------------------------------------------------------
    function updateAuditStatusUI(isPassed, calcUnits, expUnits, calcAmt, expAmt) {
        const currentLang = localStorage.getItem('app_lang') || 'vi';
        const calcUnitsStr = calcUnits.toLocaleString();
        const expUnitsStr = expUnits.toLocaleString();
        const calcAmtStr = calcAmt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const expAmtStr = expAmt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        if (isPassed) {
            // MÀU XANH LÁ (PASSED)
            $('#ocr-badge-status').removeClass('badge-danger').addClass('badge-success').css({'background-color': '#28a745', 'color': '#fff'});
            $('#ocr-badge-icon').removeClass('fa-exclamation-triangle').addClass('fa-check-circle');

            let badgeText = (currentLang === 'en') ? 'OCR Audit: PASSED (Data Verified)' :
                            (currentLang === 'zh') ? 'OCR 审计：通过（数据已验证）' : 'OCR Audit: ĐÃ KHỚP (Đã xác thực dữ liệu)';
            $('#ocr-badge-text').text(badgeText);

            $('#ocr-audit-alert-box').removeClass('alert-error-custom').addClass('alert-success-custom')
                .css({'background-color': '#f3faf7', 'border': '1px solid #bcf0da', 'color': '#03543f'});

            let titlePassed = (currentLang === 'en') ? 'OCR AUDIT PASSED: Data Integrity Verified' :
                              (currentLang === 'zh') ? 'OCR 审计通过：数据完整性已验证' : 'OCR AUDIT PASSED: Đã xác thực tính toàn vẹn dữ liệu';
            $('#ocr-audit-title').html(`<span class="text-success mr-1">●</span> ${titlePassed}`);

            let unitsMatchedLabel = (currentLang === 'en') ? 'Units Matched:' : (currentLang === 'zh') ? '数量匹配：' : 'Khớp số lượng (Units):';
            let sumUnitsLabel = (currentLang === 'en') ? 'Sum of line items' : (currentLang === 'zh') ? '行项目总和' : 'Tổng các dòng';
            let expectedUnitsLabel = (currentLang === 'en') ? 'Total Units Expected' : (currentLang === 'zh') ? '期望总数量' : 'Tổng số lượng kỳ vọng';

            let amountMatchedLabel = (currentLang === 'en') ? 'Amount Matched:' : (currentLang === 'zh') ? '金额匹配：' : 'Khớp thành tiền (Amount):';
            let subtotalExpectedLabel = (currentLang === 'en') ? 'Subtotal Expected' : (currentLang === 'zh') ? '期望小计' : 'Thành tiền kỳ vọng';

            let detailsHtml = `
                <li><strong>${unitsMatchedLabel}</strong> ${sumUnitsLabel} (${calcUnitsStr}) == ${expectedUnitsLabel} (${expUnitsStr})</li>
                <li><strong>${amountMatchedLabel}</strong> ${sumUnitsLabel} ($${calcAmtStr}) == ${subtotalExpectedLabel} ($${expAmtStr})</li>
            `;
            $('#ocr-audit-details').html(detailsHtml);

            let statusActionPassed = (currentLang === 'en') ? '<strong>Status:</strong> All line items matched perfectly. Ready to compare with ERP price.' :
                                     (currentLang === 'zh') ? '<strong>状态：</strong> 所有行项目完全匹配。准备与 ERP 价格进行比对。' :
                                     '<strong>Trạng thái:</strong> Tất cả các dòng đã khớp hoàn toàn. Sẵn sàng đối chiếu với giá ERP.';
            $('#ocr-audit-action').removeClass('text-danger').addClass('text-success').css('color', '#0e9f6e')
                .html(statusActionPassed);

            // CHỈ HIỆN NÚT XÁC NHẬN KHI KHÔNG TRONG CHẾ ĐỘ EDIT (ĐÃ LƯU XONG)
            if (!isEditingMode) {
                $('#btn-confirm-next').removeClass('d-none');
            } else {
                $('#btn-confirm-next').addClass('d-none');
            }
        } else {
            // MÀU ĐỎ (MISMATCH)
            $('#ocr-badge-status').removeClass('badge-success').addClass('badge-danger').css({'background-color': '#dc3545', 'color': '#fff'});
            $('#ocr-badge-icon').removeClass('fa-check-circle').addClass('fa-exclamation-triangle');

            let badgeTextErr = (currentLang === 'en') ? 'OCR Audit: FATAL ERROR (Mismatch)' :
                               (currentLang === 'zh') ? 'OCR 审计：严重错误（不匹配）' : 'OCR Audit: LỖI NGHIÊM TRỌNG (Không khớp)';
            $('#ocr-badge-text').text(badgeTextErr);

            $('#ocr-audit-alert-box').removeClass('alert-success-custom').addClass('alert-error-custom')
                .css({'background-color': '#fdf2f2', 'border': '1px solid #f8b4b4', 'color': '#9b1c1c'});

            let titleErr = (currentLang === 'en') ? 'CRITICAL OCR AUDIT ERROR: Data Integrity Check Failed' :
                           (currentLang === 'zh') ? '严重 OCR 审计错误：数据完整性检查失败' : 'LỖI KIỂM TRA OCR: Kiểm tra tính toàn vẹn dữ liệu thất bại';
            $('#ocr-audit-title').html(`<span class="text-danger mr-1">●</span> ${titleErr}`);

            let detailsHtml = '';
            if (calcUnits !== expUnits) {
                let unitsMismatchLabel = (currentLang === 'en') ? 'Units Mismatch:' : (currentLang === 'zh') ? '数量不匹配：' : 'Lệch số lượng (Units):';
                let sumUnitsLabel = (currentLang === 'en') ? 'Sum of line items' : (currentLang === 'zh') ? '行项目总和' : 'Tổng các dòng';
                let expectedUnitsLabel = (currentLang === 'en') ? 'Total Units Expected' : (currentLang === 'zh') ? '期望总数量' : 'Tổng số lượng kỳ vọng';
                detailsHtml += `<li><strong>${unitsMismatchLabel}</strong> ${sumUnitsLabel} (${calcUnitsStr}) != ${expectedUnitsLabel} (${expUnitsStr})</li>`;
            }
            if (Math.abs(calcAmt - expAmt) >= 0.01) {
                let amountMismatchLabel = (currentLang === 'en') ? 'Amount Mismatch:' : (currentLang === 'zh') ? '金额不匹配：' : 'Lệch thành tiền (Amount):';
                let sumUnitsLabel = (currentLang === 'en') ? 'Sum of line items' : (currentLang === 'zh') ? '行项目总和' : 'Tổng các dòng';
                let subtotalExpectedLabel = (currentLang === 'en') ? 'Subtotal Expected' : (currentLang === 'zh') ? '期望小计' : 'Thành tiền kỳ vọng';
                detailsHtml += `<li><strong>${amountMismatchLabel}</strong> ${sumUnitsLabel} ($${calcAmtStr}) != ${subtotalExpectedLabel} ($${expAmtStr})</li>`;
            }
            $('#ocr-audit-details').html(detailsHtml);

            let actionRequiredText = (currentLang === 'en') ? '<strong>Action Required:</strong> Data mismatch detected. Please add/edit lines to match expected totals or reject the PO.' :
                                     (currentLang === 'zh') ? '<strong>操作要求：</strong> 检测到数据不匹配。请添加/编辑行以匹配期望总计或拒绝该 PO。' :
                                     '<strong>Yêu cầu hành động:</strong> Phát hiện dữ liệu không khớp. Vui lòng thêm/sửa các dòng để khớp với tổng kỳ vọng hoặc từ chối PO.';
            $('#ocr-audit-action').removeClass('text-success').addClass('text-danger').css('color', '#9b1c1c')
                .html(actionRequiredText);

            // ẨN NÚT XÁC NHẬN KHI CÒN LỖI HOẶC ĐANG EDIT
            $('#btn-confirm-next').addClass('d-none');
        }
    }

    // Bấm nút Xác Nhận để chuẩn bị cho Bước 2
    $(document).on('click', '#btn-confirm-next', function () {
        const currentLang = localStorage.getItem('app_lang') || 'vi';

        let confirmMsg = (currentLang === 'en') ? "Data confirmation successful! Moving to Step 2: Custom Record..." :
                         (currentLang === 'zh') ? "数据确认成功！正在转到步骤 2：自定义记录..." :
                         "Xác nhận dữ liệu thành công! Đang chuyển sang Bước 2: Custom Record...";
