        // 5. Cập nhật tiêu đề bảng
        const $cardContainer =$('#po-line-table').closest('.card-custom');
        $cardContainer.find('.card-header span:first').text('READY TO CONVERT SALES ORDER (STEP 3)');

        // 6. GIỮ NGUYÊN HIỂN THỊ THẺ BƯỚC 2 VÀ HIỆN THÊM THẺ BƯỚC 3 (ĐỦ CẢ 3 THẺ)
        $('#erp-badge-status').removeClass('d-none');

        $('#so-badge-status')
            .removeClass('d-none')
            .removeClass('badge-secondary badge-warning')
            .addClass('badge-success')
            .css({ 'background-color': '#28a745', 'color': '#fff' });

        $('#so-badge-text').text('Sales Order: Ready for Conversion');

        // ==========================================
        // 7. CẬP NHẬT NỘI DUNG KHUNG THÔNG BÁO LỚN PHÍA TRÊN CHO BƯỚC 3
        // ==========================================
        const $alertBox =$('#ocr-audit-alert-box');
        const $title =$('#ocr-audit-title');
        const $details =$('#ocr-audit-details');
        const $action =$('#ocr-audit-action');

        $alertBox.show()
                 .removeClass('alert-error-custom alert-warning-custom')
                 .addClass('alert-success-custom')
                 .css({ 'background-color': '#f3faf7', 'border': '1px solid #bcf0da', 'color': '#03543f' });

        $title.html('<span class="text-success mr-1">●</span> SALES ORDER CREATION READY: All Validations Passed');

        let detailsHtml = `
            <li><strong>OCR & ERP Verification:</strong> Data integrity verified and base prices successfully reconciled.</li>
            <li><strong>Workflow Status:</strong> Record validated across all compliance checkpoints. Ready for NetSuite SO generation.</li>
        `;
        $details.html(detailsHtml);

        $action.removeClass('text-danger text-warning').addClass('text-success')
               .css('color', '#0e9f6e')
               .html('<strong>Status:</strong> All prerequisites completed. Click <strong>"Convert to Sales Order"</strong> above to finalize.');

        alert("Xác nhận thành công! Hệ thống đã sẵn sàng để Convert to Sales Order ở Bước 3.");
    });

    // -------------------------------------------------------------
    // 2. HÀM RENDER BẢNG BƯỚC 2 & HIỂN THỊ CẢNH BÁO NOTICE
    // -------------------------------------------------------------
    function renderStep2Table(dataList) {
        let hasVariance = false;
        let tbodyHtml = '';

        dataList.forEach(item => {
            let statusHtml = '';
            let rowClass = '';
            const ocrPrice = parseFloat(item.ocrPrice) || 0;
            const erpPrice = parseFloat(item.erpBasePrice) || 0;
            const variance = ocrPrice - erpPrice;
            const isMatched = Math.abs(variance) < 0.0001;

            if (isMatched) {
                statusHtml = `<span class="text-matched"><i class="fas fa-check mr-1"></i> Matched</span>`;
            } else {
                hasVariance = true;
                rowClass = 'row-variance animate-fade-in';
                let sign = variance > 0 ? `+$${variance.toFixed(2)}` : `-$${Math.abs(variance).toFixed(2)}`;
                statusHtml = `<span class="text-variance"><i class="fas fa-exclamation-triangle mr-1"></i> Variance: ${sign}</span>`;
            }

            // ĐÃ XÓA CỘT DESCRIPTION TRÊN GIAO DIỆN, LƯU NGẦM QUA data-description
            tbodyHtml += `
                <tr class="${rowClass}" data-erp-price="${erpPrice}" data-description="${item.description || ''}">
                    <td>${item.line}</td>
                    <td class="font-weight-bold cell-item-code">${item.itemCode}</td>
                    <td class="text-right cell-qty" data-original-qty="${item.qty}">${item.qty.toLocaleString()}</td>
                    <td class="text-right cell-ocr-price ${!isMatched ? 'text-variance font-weight-bold' : ''}" data-original-price="${ocrPrice}">$${ocrPrice}</td>
                    <td class="text-right cell-erp-price">$${erpPrice}</td>
                    <td class="text-center cell-status">${statusHtml}</td>
                </tr>
            `;
        });

        $('#po-line-table tbody').html(tbodyHtml);

        updateStep2NoticeBox(hasVariance);
        updateStep2BadgeStatus(hasVariance);
        updateStep2AuditAlertBox(dataList, hasVariance); // CẬP NHẬT KHUNG THÔNG BÁO PHÍA TRÊN
        $('#btn-reload-erp').removeClass('d-none');
        checkAllStep2Matched();
    }

    // Hàm bật/tắt khung thông báo Notice thời gian thực
    function updateStep2NoticeBox(hasVariance) {
        const $cardContainer =$('#po-line-table').closest('.card-custom');
        $('#variance-notice-box').remove();

        if (hasVariance) {
            let noticeHtml = `
                <div class="verification-notice animate-fade-in" id="variance-notice-box">
                    <i class="fas fa-info-circle mr-1"></i> <strong>Notice:</strong> One or more lines trigger custom pricing logic. Converting this record will route the Sales Order to <strong>Pending Approval</strong> status.
                </div>
            `;
            $cardContainer.after(noticeHtml);
        }
    }
</script>

<script>
    // Biến lưu trữ trạng thái dữ liệu hiện tại
    let isEditingMode = false;
    let originalDataBackup = null; // Backup dữ liệu để khôi phục nếu nhấn Cancel

    // -------------------------------------------------------------
    // 1. BẬT CHẾ ĐỘ CHỈNH SỬA (EDIT MODE)
    // -------------------------------------------------------------
    $('#btn-edit-data').on('click', function () {
        enableEditMode(true);
    });

    // HỦY CHỈNH SỬA (CANCEL)
    $('#btn-cancel-edit').on('click', function () {
        if (originalDataBackup) {
            if(currentStep === 1) {
                // Restore lại bảng dữ liệu cũ
                renderTableFromData(originalDataBackup.lineItems);
                // Restore lại PO Header
                $('#po-number-display').text(originalDataBackup.poNumber);
                $('#po-date-display').text(originalDataBackup.date);
                $('#po-customer-display').text(originalDataBackup.customer);
                $('#po-requisitioner-display').text(originalDataBackup.requisitioner);
            } else if (currentStep === 2) {
                // Ở bước 2, khôi phục lại giá OCR gốc từ bản backup
                let i = 0;
                $('#po-line-table tbody tr').each(function () {
                    const $tr =$(this);
                    if (originalDataBackup.lineItems[i]) {
                        const origPrice = originalDataBackup.lineItems[i].unitPrice;
                        $tr.find('.cell-ocr-price').attr('data-original-price', origPrice).text(`$${origPrice}`);

                        // Tính lại match/variance
                        const erpPrice = parseFloat($tr.attr('data-erp-price')) || 0;
                        const variance = origPrice - erpPrice;
                        const isMatched = Math.abs(variance) < 0.0001;

                        if (isMatched) {
                            $tr.removeClass('row-variance');$tr.find('.cell-status').html(`<span class="text-matched"><i class="fas fa-check mr-1"></i> Matched</span>`);
                        } else {
                            $tr.addClass('row-variance');
                            let sign = variance > 0 ? `+$${variance.toFixed(2)}` : `-$${Math.abs(variance).toFixed(2)}`;
                            $tr.find('.cell-status').html(`<span class="text-variance"><i class="fas fa-exclamation-triangle mr-1"></i> Variance: ${sign}</span>`);
                        }
                    }
                    i++;
                });
                checkAndUpdateStep2Notice();
            }
            
        }
        enableEditMode(false);
        if (currentStep === 1) recalculateAndAudit();
    });

        // LƯU CHỈNH SỬA (SAVE CHANGES)
    $('#btn-save-edit').on('click', function () {
        if (currentStep === 1) {
            let hasEmptyError = false;
            let emptyErrorMessage = "";

            // 1. KIỂM TRA DỮ LIỆU BỎ TRỐNG / KHÔNG HỢP LỆ TRÊN TỪNG DÒNG
            $('#po-line-table tbody tr').each(function (index) {
                const $tr =$(this);
                const itemCode = $tr.find('.input-item-code').val().trim();
                const qty = parseFloat($tr.find('.input-qty').val()) || 0;
                const price = parseFloat($tr.find('.input-price').val()) || 0;

                if (itemCode === "" || qty <= 0 || price <= 0) {
                    hasEmptyError = true;
                    emptyErrorMessage = `Dòng số ${index + 1} đang bị bỏ trống hoặc có dữ liệu không hợp lệ (Mã hàng, Số lượng hoặc Đơn giá). Vui lòng kiểm tra lại hoặc xóa dòng thừa trước khi lưu!`;
                    return false; // Dừng vòng lặp each
                }
            });

            if (hasEmptyError) {
                alert(emptyErrorMessage);
                return; // Chặn lưu
            }

            // 2. KIỂM TRA TÍNH KHỐP CỦA AUDIT (CALCULATED VS EXPECTED)
            let totalUnits = 0;
            let totalAmount = 0;

            $('#po-line-table tbody tr').each(function () {
                const $tr =$(this);
                const qty = parseFloat($tr.find('.input-qty').val()) || 0;
                const price = parseFloat($tr.find('.input-price').val()) || 0;
                totalUnits += qty;
                totalAmount += (qty * price);
            });

            totalAmount = Math.round(totalAmount * 100) / 100;

            // Lấy Expected Total từ giao diện
            const expText = $('#expected-sum-display').text();
            const expMatch = expText.match(/([\d,]+)\s*Units\s*\/\s*\$([\d,.]+)/);
            let expectedUnits = 0;
            let expectedAmount = 0;

            if (expMatch) {
                expectedUnits = parseInt(expMatch[1].replace(/,/g, '')) || 0;
                expectedAmount = parseFloat(expMatch[2].replace(/,/g, '')) || 0;
            }

            const isUnitsMatched = (totalUnits === expectedUnits);
            const isAmountMatched = (Math.abs(totalAmount - expectedAmount) < 0.01);

            // BÁO LỖI VÀ CHẶN LƯU NẾU KHÔNG KHỐP AUDIT
            if (!isUnitsMatched || !isAmountMatched) {
                let auditErrorMsg = "Không thể lưu dữ liệu vì dữ liệu chưa khớp với tổng trên PDF!\n\n";
                if (!isUnitsMatched) {
                    auditErrorMsg += `- Tổng số lượng (Units): Tính toán (${totalUnits.toLocaleString()}) != Kỳ vọng (${expectedUnits.toLocaleString()})\n`;
                }
                if (!isAmountMatched) {
                    auditErrorMsg += `- Tổng tiền (Amount): Tính toán ($${totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })}) != Kỳ vọng ($${expectedAmount.toLocaleString('en-US', { minimumFractionDigits: 2 })})\n`;
                }
                auditErrorMsg += "\nVui lòng điều chỉnh lại danh sách Line Items để khớp với tổng số tiền và số lượng trước khi lưu.";

                alert(auditErrorMsg);
                return; // Chặn lưu hoàn toàn!
            }

            // 3. NẾU TẤT CẢ DỮ LIỆU ĐÃ HỢP LỆ VÀ KHỐP AUDIT
            saveTableEdits();
            enableEditMode(false);
            recalculateAndAudit();
            alert("Đã cập nhật dữ liệu PO thành công!");
        } else if (currentStep === 2) {
            // --- LOGIC LƯU CỦA BƯỚC 2 (Chỉ lưu các thay đổi về giá OCR Price) ---
            saveStep2Edits();
            enableEditMode(false);
            alert("Đã cập nhật OCR Price thành công!");
        }
    });

    // -------------------------------------------------------------
    // 2. CHUYỂN ĐỔI GIAO DIỆN EDIT <-> VIEW
    // -------------------------------------------------------------
    function enableEditMode(enable) {
        isEditingMode = enable;

        if (enable) {
            // --- BẬT CHẾ ĐỘ CHỈNH SỬA ---
            backupCurrentData();

            // Ẩn nút "Edit Data", hiện nhóm nút thao tác cùng hàng ngang
