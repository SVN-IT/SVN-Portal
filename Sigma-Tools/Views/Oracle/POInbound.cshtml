    // Tự động tính toán lại Validation Status & Notice khi gõ thay đổi OCR Price ở Bước 2
    $(document).on('input', '.input-ocr-price', function () {
        const $tr =$(this).closest('tr');
        const newOcrPrice = parseFloat($(this).val()) || 0;
        const erpPrice = parseFloat($tr.attr('data-erp-price')) || 0;
        const variance = newOcrPrice - erpPrice;
        const isMatched = Math.abs(variance) < 0.0001;

        // Cập nhật nhãn trạng thái trực tiếp trên dòng
        if (isMatched) {
            $tr.removeClass('row-variance');$tr.find('.cell-status').html(`<span class="text-matched"><i class="fas fa-check mr-1"></i> Matched</span>`);
        } else {
            $tr.addClass('row-variance');
            let sign = variance > 0 ? `+$${variance.toFixed(2)}` : `-$${Math.abs(variance).toFixed(2)}`;
            $tr.find('.cell-status').html(`<span class="text-variance"><i class="fas fa-exclamation-triangle mr-1"></i> Variance: ${sign}</span>`);
        }

        // Kiểm tra xem còn dòng nào bị lệch giá để ẩn/hiện Notice Box
        checkAndUpdateStep2Notice();
        checkAllStep2Matched(); // Cập nhật trạng thái nút sang bước 3 theo thời gian thực
    });

    // Hàm kiểm tra lại toàn bộ bảng ở Bước 2 để cập nhật Notice Box
    function checkAndUpdateStep2Notice() {
        let hasVariance = false;

        $('#po-line-table tbody tr').each(function () {
            const $tr =$(this);
            let ocrVal = 0;
            if ($tr.find('.input-ocr-price').length > 0) {
                ocrVal = parseFloat($tr.find('.input-ocr-price').val()) || 0;
            } else {
                ocrVal = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price')) || 0;
            }
            const erpVal = parseFloat($tr.attr('data-erp-price')) || 0;

            if (Math.abs(ocrVal - erpVal) >= 0.0001) {
                hasVariance = true;
            }
        });

        updateStep2NoticeBox(hasVariance);
        updateStep2BadgeStatus(hasVariance); // Tự động cập nhật badge theo thời gian thực
        updateStep2AuditAlertBox(null, hasVariance);
        checkAllStep2Matched();
    }

    // Lưu giá trị chỉnh sửa ô Input ở Bước 2
    function saveStep2Edits() {
        let hasVariance = false;

        $('#po-line-table tbody tr').each(function () {
            const $tr =$(this);
            const $input =$tr.find('.input-ocr-price');

            if ($input.length > 0) {
                const newOcrPrice = parseFloat($input.val()) || 0;
                const erpPrice = parseFloat($tr.attr('data-erp-price')) || 0;
                const variance = newOcrPrice - erpPrice;
                const isMatched = Math.abs(variance) < 0.0001;

                $tr.find('.cell-ocr-price')
                    .attr('data-original-price', newOcrPrice)
                    .text(`$${newOcrPrice}`);

                if (isMatched) {
                    $tr.removeClass('row-variance');
                    $tr.find('.cell-ocr-price').removeClass('text-variance font-weight-bold');$tr.find('.cell-status').html(`<span class="text-matched"><i class="fas fa-check mr-1"></i> Matched</span>`);
                } else {
                    hasVariance = true;
                    $tr.addClass('row-variance');$tr.find('.cell-ocr-price').addClass('text-variance font-weight-bold');
                    let sign = variance > 0 ? `+$${variance.toFixed(2)}` : `-$${Math.abs(variance).toFixed(2)}`;
                    $tr.find('.cell-status').html(`<span class="text-variance"><i class="fas fa-exclamation-triangle mr-1"></i> Variance: ${sign}</span>`);
                }
            }
        });

        updateStep2NoticeBox(hasVariance);
    }

        // Hàm kiểm tra trạng thái khớp giá ở Bước 2 để ẩn/hiện nút sang Bước 3
        function checkAllStep2Matched() {
            let allMatched = true;

            $('#po-line-table tbody tr').each(function () {
                const $tr = $(this);
                let ocrVal = 0;
                if ($tr.find('.input-ocr-price').length > 0) {
                    ocrVal = parseFloat($tr.find('.input-ocr-price').val()) || 0;
                } else {
                    ocrVal = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price')) || 0;
                }
                const erpVal = parseFloat($tr.attr('data-erp-price')) || 0;

                if (Math.abs(ocrVal - erpVal) >= 0.0001) {
                    allMatched = false;
                    return false; // Thoát vòng lặp nếu có 1 dòng chưa khớp
                }
            });

            if (currentStep === 2) {
                if (allMatched) {
                    // Khớp hết -> Hiện nút sang Bước 3
                    $('#btn-proceed-step3').removeClass('d-none');
                } else {
                    // Còn dòng lệch -> Ẩn nút sang Bước 3
                    $('#btn-proceed-step3').addClass('d-none');
                }
            }
        }

        // Khi chuyển sang Bước 2 thành công, hiển thị nút Reload lên vị trí khoanh đỏ
        // (Được đặt trong Ajax success khi chuyển bước 2):
        // $('#btn-reload-erp').removeClass('d-none');
        // checkAllStep2Matched();

        // Sự kiện bấm nút Tải lại dữ liệu ERP ở vị trí khoanh đỏ
        $(document).on('click', '#btn-reload-erp', function () {
            alert("Đang kết nối lại hệ thống ERP để đồng bộ dữ liệu mới nhất...");
            // Thực hiện logic reload hoặc gọi lại hàm kiểm tra đối chiếu giá ERP tại đây
            loadStep2ErpPrices(); // Tự động trigger lại dữ liệu bước 2
        });

        // Hàm cập nhật trạng thái Badge cho Bước 2
        function updateStep2BadgeStatus(hasVariance) {
            const $badge = $('#erp-badge-status');
            const $icon = $('#erp-badge-icon');
            const $text = $('#erp-badge-text');

            // Hiển thị badge Bước 2 khi đã ở Bước 2
            if (currentStep === 2) {
                $badge.removeClass('d-none');
            }

            if (!hasVariance) {
                // TRƯỜNG HỢP PASSED (Tất cả đã match hoàn toàn với ERP)
                $badge.removeClass('badge-danger badge-warning badge-secondary').addClass('badge-success')
                      .css({ 'background-color': '#28a745', 'color': '#fff' });
                $icon.removeClass('fa-exclamation-triangle fa-info-circle').addClass('fa-check-circle');
                $text.text('ERP Pricing: PASSED (All Matched)');
            } else {
                // TRƯỜNG HỢP CÒN LỆCH GIÁ (Variance detected -> Pending Approval)
                $badge.removeClass('badge-success badge-secondary').addClass('badge-warning')
                      .css({ 'background-color': '#f0ad4e', 'color': '#fff' });
                $icon.removeClass('fa-check-circle fa-info-circle').addClass('fa-exclamation-triangle');
                $text.text('ERP Pricing: VARIANCE DETECTED (Pending Approval)');
            }
        }

        // Hàm cập nhật khung thông báo chính phía trên CHỈ DÙNG CHO BƯỚC 2
        function updateStep2AuditAlertBox(dataList, hasVariance) {
            // Đảm bảo chỉ chạy khi đang ở Bước 2
            if (currentStep !== 2) return;

            const $alertBox =$('#ocr-audit-alert-box');
            const $title =$('#ocr-audit-title');
            const $details =$('#ocr-audit-details');
            const $action =$('#ocr-audit-action');

            $alertBox.show();

            if (!hasVariance) {
                // --- TRƯỜNG HỢP BƯỚC 2: PASSED (MATCHED ALL) ---
                $alertBox.removeClass('alert-error-custom alert-warning-custom').addClass('alert-success-custom')
                         .css({ 'background-color': '#f3faf7', 'border': '1px solid #bcf0da', 'color': '#03543f' });

                $title.html('<span class="text-success mr-1">●</span> ERP PRICING PASSED: Data & Base Prices Verified');

                let detailsHtml = `
                    <li><strong>Reconciliation:</strong> All line items matched perfectly with ERP Base Prices.</li>
                    <li><strong>Variance Status:</strong> No price discrepancies detected across all line items.</li>
                `;
                $details.html(detailsHtml);

                $action.removeClass('text-danger text-warning').addClass('text-success')
                       .css('color', '#0e9f6e')
                       .html('<strong>Status:</strong> All line items matched perfectly. Ready to convert to Sales Order.');
            } else {
                // --- TRƯỜNG HỢP BƯỚC 2: VARIANCE DETECTED (MÀU CAM/VÀNG) ---
                $alertBox.removeClass('alert-error-custom alert-success-custom').addClass('alert-warning-custom')
                         .css({ 'background-color': '#fffbeb', 'border': '1px solid #fde68a', 'color': '#92400e' });

                $title.html('<span class="text-warning mr-1" style="color: #d97706 !important;">●</span> ERP PRICING VARIANCE: Custom Pricing Logic Triggered');

                let detailsHtml = `
                    <li><strong>Notice:</strong> One or more lines trigger custom pricing logic.</li>
                    <li><strong>Workflow Notice:</strong> Converting this record will route the Sales Order to Pending Approval status.</li>
                `;
                $details.html(detailsHtml);

                $action.removeClass('text-success text-danger').addClass('text-warning')
                       .css('color', '#b45309')
                       .html('<strong>Action Required:</strong> Please review price variances or proceed to route for Pending Approval.');
            }
        }

        // =============================================================
        // XỬ LÝ NÚT REJECT PO (HIỂN THỊ POPUP & GỬI AJAX)
        // =============================================================

        // 1. Khi bấm nút Reject PO trên Action Bar -> Mở Popup
        $(document).on('click', '#btn-reject', function () {
            $('#reject-reason').val('');
            $('#reject-reason-error').addClass('d-none');
            $('#rejectPoModal').modal('show');
        });

        // 2. Khi bấm nút Đồng Ý (Reject) trong Popup
        $(document).on('click', '#btn-confirm-reject', function () {
            const reason = $('#reject-reason').val().trim();
            const poNumber = $('#po-number-display').text().trim();

            // Validate bắt buộc nhập lý do
            if (reason === '') {
                $('#reject-reason-error').removeClass('d-none');
                return;
            }
            $('#reject-reason-error').addClass('d-none');

            // Khóa nút để tránh bấm nhiều lần
            const $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang xử lý...');

            // Gửi dữ liệu xuống Controller
            $.ajax({
                url: '/Oracle/RejectPO',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    PONumber: poNumber,
                    Reason: reason
                }),
                success: function (response) {
                    if (response.success) {
                        $('#rejectPoModal').modal('hide');
                        alert(response.message);
                        // Refresh lại trang khi thành công
                        window.location.reload();
                    } else {
                        alert("Lỗi: " + response.message);
                        $btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Đồng Ý (Reject)');
                    }
                },
                error: function () {
                    alert("Đã xảy ra lỗi kết nối khi từ chối PO!");
                    $btn.prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Đồng Ý (Reject)');
                }
            });
        });
</script>
