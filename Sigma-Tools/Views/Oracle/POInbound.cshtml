            // 2. ẨN NÚT XÁC NHẬN CHUYỂN BƯỚC KHI ĐANG EDIT
            $('#btn-confirm-next').addClass('d-none');

            // NẾU ĐANG Ở BƯỚC 2: Ẩn nút Add Item đi vì không cho phép thêm dòng mới ở bước này
            if (currentStep === 2) {
                $('#btn-add-line').hide();
            } else {
                $('#btn-add-line').show();
            }

            // Hiện cột thao tác Xóa (Thùng rác) trong bảng
            if (currentStep === 1) {
                $('.col-action').removeClass('d-none');
            }

            // Chuyển Header và Bảng thành các ô Input
            makeHeaderEditable(true);
            makeTableEditable(true);
        } else {
            // --- TẮT CHẾ ĐỘ CHỈNH SỬA ---
            // Hiện lại nút "Edit Data", ẩn nhóm nút thao tác
            //$('#btn-edit-data').show();
            $('#edit-actions-group').css('display', 'none');

            // Ẩn cột thao tác Xóa trong bảng
            $('.col-action').addClass('d-none');

            // CHỈ HIỆN LẠI NÚT "EDIT DATA" NẾU ĐANG Ở BƯỚC 1. Ở BƯỚC 2 SẼ ẨN LUÔN NHƯNG GIỮ LOGIC.
            if (currentStep === 1) {
                $('#btn-edit-data').show();
            } else {
                $('#btn-edit-data').hide(); // Ẩn hoàn toàn nút Edit ở Bước 2 theo yêu cầu mới
            }

            // Chuyển Header và Bảng về dạng text tĩnh
            makeHeaderEditable(false);
