    // -------------------------------------------------------------
    // 7. BACKUP & RESTORE DỮ LIỆU
    // -------------------------------------------------------------
    function backupCurrentData() {
        originalDataBackup = {
            poNumber: $('#po-number-display').text().trim(),
            date: $('#po-date-display').text().trim(),
            customer: $('#po-customer-display').text().trim(),
            requisitioner: $('#po-requisitioner-display').text().trim(),
            lineItems: []
        };
        if (currentStep === 1) {
            $('#po-line-table tbody tr').each(function () {
                const $tr = $(this);
                // Ưu tiên lấy từ data-original-price nếu có, nếu không thì lấy từ input hoặc text
                let origPrice = $tr.find('td:nth-child(5)').attr('data-original-price');
                if (!origPrice) {
                    origPrice = $tr.find('.input-price').val() || $tr.find('td:nth-child(5)').text().replace(/[$,]/g, '');
                }

                originalDataBackup.lineItems.push({
                    line: $tr.find('td:nth-child(1)').text().trim(),
                    itemCode: $tr.find('td:nth-child(2)').find('input').val() || $tr.find('td:nth-child(2)').text().trim(),
                    description: $tr.find('td:nth-child(3)').find('input').val() || $tr.find('td:nth-child(3)').text().trim(),
                    qty: parseInt($tr.find('.input-qty').val()) || parseInt($tr.find('td:nth-child(4)').text().replace(/,/g, '')) || 0,
                    unitPrice: parseFloat(origPrice) || 0,
                    amount: parseFloat($tr.find('td:nth-child(6)').attr('data-original-amount')) || parseFloat($tr.find('td:nth-child(6)').text().replace(/[$,]/g, '')) || 0
                });
            });
        } else if (currentStep === 2) {
            $('#po-line-table tbody tr').each(function () {
                const $tr = $(this);
                let ocrPrice = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price')) || 0;
                originalDataBackup.lineItems.push({
                    unitPrice: ocrPrice
                });
            });
        }
        
    }

    function renderTableFromData(lineItems) {
        let tbodyHtml = '';
        lineItems.forEach(item => {
            let formattedPrice = Number(item.unitPrice).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            let formattedAmount = Number(item.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            tbodyHtml += `<tr>
                <td>${item.line}</td>
                <td>${item.itemCode}</td>
                <td>${item.description}</td>
                <td class="text-right">${Number(item.qty).toLocaleString()}</td>
                <td class="text-right" data-original-price="${item.unitPrice}">$${formattedPrice}</td>
                <td class="text-right" data-original-amount="${item.amount}">$${formattedAmount}</td>
                <td class="text-center col-action d-none">
                    <button type="button" class="btn btn-xs btn-outline-danger btn-delete-line"><i class="fas fa-trash-alt"></i></button>
                </td>
            </tr>`;
        });
        $('#po-line-table tbody').html(tbodyHtml);
