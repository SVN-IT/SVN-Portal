    // -------------------------------------------------------------
    // 7. BACKUP & RESTORE DỮ LIỆU
    // -------------------------------------------------------------
    function backupCurrentData() {
        originalDataBackup = {
            poNumber: $('#po-number-display').text().trim(),
            date: $('#po-date-display').text().trim(),
            customer: $('#po-customer-display').text().trim(),
