@model Sigma_Tools.Models.InboundPOReviewViewModel
@{
    ViewData["Title"] = ViewBag.TitleName;
}
<style>
    body {
        background-color: #f4f6f9;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 0.88rem;
    }

    /* Top Header Navigation Bar */
    .netsuite-header {
        background-color: #0d5287;
        color: #ffffff;
        padding: 8px 16px;
    }

    .action-bar {
        background-color: #ffffff;
        padding: 10px 20px;
        border-bottom: 1px solid #e0e0e0;
    }

    /* PDF Viewer Left Side */
    .pdf-panel {
        background-color: #525659;
        /* min-height: calc(100vh - 120px); */
        padding-top: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 15px;
    }

    .pdf-preview-box {
        width: 100%;
        height: 780px;
        background-color: #ffffff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        border-radius: 2px;
        overflow: hidden;
    }

    /* Card Customizations */
    .card-custom {
        border: 1px solid #e3e6f0;
        border-radius: 4px;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.04);
        background-color: #ffffff;
        margin-bottom: 15px;
    }

        .card-custom .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
            font-weight: 700;
            font-size: 0.82rem;
            color: #4e73df;
            letter-spacing: 0.5px;
            padding: 8px 15px;
        }

    .alert-error-custom {
        background-color: #fdf2f2;
        border: 1px solid #f8b4b4;
        color: #9b1c1c;
        border-radius: 4px;
        padding: 12px 15px;
    }

    .table-custom th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-size: 0.75rem;
        text-transform: uppercase;
        border-bottom: 2px solid #dee2e6;
        padding: 8px;
    }

    .table-custom td {
        padding: 8px;
        vertical-align: middle;
    }

    .summary-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 10px;
        font-weight: 600;
    }

    /* Khung cảnh báo LỖI (Màu đỏ) */
    .alert-error-custom {
        background-color: #fdf2f2;
        border: 1px solid #f8b4b4;
        color: #9b1c1c;
        border-radius: 4px;
        padding: 12px 15px;
    }

    /* Khung THÀNH CÔNG (Màu xanh) */
    .alert-success-custom {
        background-color: #f3faf7;
        border: 1px solid #bcf0da;
        color: #03543f;
        border-radius: 4px;
        padding: 12px 15px;
    }

    /* Tùy chỉnh ô input trong bảng khi Edit */
    .edit-input {
        width: 100%;
        padding: 2px 6px;
        font-size: 0.85rem;
        border: 1px solid #4e73df;
        border-radius: 3px;
        background-color: #ffffff;
    }

        .edit-input:focus {
            outline: none;
            border-color: #2e59d9;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }

    .btn-xs {
        padding: 2px 6px;
        font-size: 0.75rem;
        line-height: 1;
        border-radius: 3px;
    }

    /* =========================================================
       NETSUITE STYLE STEP PROGRESS BAR
       ========================================================= */
    .netsuite-stepper-wrapper {
        background-color: #ffffff;
        border-bottom: 1px solid #e0e0e0;
        padding: 12px 0 8px 0;
    }

    .netsuite-stepper {
        display: flex;
        justify-content: center;
        align-items: center;
        max-width: 720px;
        margin: 0 auto;
        position: relative;
    }

    /* Đường nối ngang giữa các bước */
    .netsuite-stepper-line {
        position: absolute;
        top: 15px;
        left: 60px;
        right: 60px;
        height: 2px;
        background-color: #d1d5db;
        z-index: 1;
    }

    .netsuite-step {
        position: relative;
        z-index: 2;
        text-align: center;
        flex: 1;
        background-color: transparent;
    }

        /* Vòng tròn số */
        .netsuite-step .step-num {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #ffffff;
            color: #6c757d;
            border: 2px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.82rem;
            margin: 0 auto 4px auto;
            transition: all 0.25s ease-in-out;
        }

        /* Nhãn tên bước */
        .netsuite-step .step-text {
            font-size: 0.76rem;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* Trạng thái BƯỚC HIỆN TẠI (Step 1 Active) */
        .netsuite-step.active .step-num {
            background-color: #0d5287;
            color: #ffffff;
            border-color: #0d5287;
            box-shadow: 0 0 0 3px rgba(13, 82, 135, 0.2);
        }

        .netsuite-step.active .step-text {
            color: #0d5287;
            font-weight: 700;
        }

        /* Trạng thái BƯỚC ĐÃ HOÀN THÀNH (Completed) */
        .netsuite-step.completed .step-num {
            background-color: #28a745;
            color: #ffffff;
            border-color: #28a745;
        }

        .netsuite-step.completed .step-text {
            color: #28a745;
        }

    /* Nút Xác nhận chuẩn NetSuite */
    .btn-confirm-netsuite {
        background-color: #0d5287;
        color: #ffffff;
        font-weight: 600;
        border: none;
        padding: 6px 18px;
        border-radius: 3px;
        transition: background-color 0.2s ease;
    }

        .btn-confirm-netsuite:hover {
            background-color: #093b62;
            color: #ffffff;
        }

    /* --- Styles cho Bảng Price Verification (Bước 2) --- */
    .table-verification th {
        background-color: #f8f9fa;
        color: #495057;
        font-size: 0.78rem;
        text-transform: uppercase;
        font-weight: 700;
    }

    .table-verification td {
        vertical-align: middle;
        font-size: 0.85rem;
    }

    /* Dòng bị lệch giá (Variance Row) */
    .row-variance {
        background-color: #fdf2f2 !important;
    }

    .text-variance {
        color: #9b1c1c;
        font-weight: 600;
    }

    .text-matched {
        color: #03543f;
        font-weight: 600;
    }

    .verification-notice {
        font-size: 0.82rem;
        color: #b45309;
        background-color: #fffbeb;
        border: 1px solid #fde68a;
        padding: 10px 15px;
        border-radius: 4px;
        margin-top: 12px;
    }

    /* --- Hiệu ứng chuyển đổi giữa các bước (Fade & Slide Transition) --- */
    .table-transition-wrapper {
        position: relative;
        transition: all 0.35s ease-in-out;
    }

    @@keyframes fadeInScale {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .animate-fade-in {
        animation: fadeInScale 0.4s ease-in-out forwards;
    }

    /* Styling ô input OCR Price khi Edit ở Bước 2 */
    .input-ocr-price {
        width: 100px;
        padding: 2px 6px;
        font-size: 0.85rem;
        border: 1px solid #4e73df;
        border-radius: 3px;
        text-align: right;
        display: inline-block;
    }

        .input-ocr-price:focus {
            outline: none;
            border-color: #2e59d9;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
        }

    /* Đồng bộ kích thước Select2 cho Person in charge trong Card Bước 4 */
    #so-config-card .select2-container--bootstrap4 .select2-selection--single {
        height: calc(1.8125rem + 2px) !important;
        font-size: 0.85rem !important;
        padding: 0.2rem 0.5rem !important;
    }
    #so-config-card .select2-container--bootstrap4 .select2-selection--single .select2-selection__rendered {
        line-height: 1.4 !important;
        padding-left: 0 !important;
        font-weight: 600 !important;
        color: #212529 !important;
    }
    #so-config-card .select2-container--bootstrap4 .select2-selection--single .select2-selection__arrow {
        height: calc(1.8125rem + 2px) !important;
        top: 0 !important;
    }
    #so-config-card .select2-container--bootstrap4 .select2-selection--single .select2-selection__clear {
        margin-right: 18px !important;
    }
</style>
<!-- Thêm CSS của Select2 -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/@@ttskch/select2-bootstrap4-theme@1.5.2/dist/select2-bootstrap4.min.css" rel="stylesheet" />

<!-- Thêm JS của Select2 (Đảm bảo đặt sau thư viện jQuery) -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- ========================================================= -->
<!-- GLOBAL AJAX LOADING SPINNER OVERLAY -->
<!-- ========================================================= -->
<div id="global-loader" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.4); z-index: 99999; justify-content: center; align-items: center;">
    <div class="bg-white p-4 rounded shadow-lg text-center" style="min-width: 200px;">
        <div class="spinner-border text-primary mb-2" role="status" style="width: 2.5rem; height: 2.5rem;">
            <span class="sr-only">Loading...</span>
        </div>
        <div id="loader-text" class="small font-weight-bold text-dark"><span class="lang-text">loadingData</span></div>
    </div>
</div>

<!-- Header NetSuite -->
<div class="netsuite-header d-flex justify-content-between align-items-center">
    <div class="font-weight-bold">ORACLE NetSuite <span class="font-weight-normal lang-text">| @ViewBag.TitleName</span></div>
    @* <div class="small">User: <strong>Duong Hai Linh</strong> | Role: <strong>IT Administrator</strong></div> *@
</div>

<!-- Banner Khôi phục Tiến trình (Khi F5 hoặc phát hiện phiên dở dang) -->
<div id="restore-session-banner" class="alert alert-warning border-warning shadow-sm mx-3 mt-2 mb-2 d-none" style="border-left: 5px solid #f59e0b !important; background-color: #fffbeb;">
    <div class="d-flex justify-content-between align-items-center flex-wrap py-1">
        <div class="d-flex align-items-center py-1">
            <i class="fas fa-history text-warning mr-2" style="font-size: 1.3rem;"></i>
            <div>
                <strong class="text-dark"><span class="lang-text" data-i18n="Active Incomplete Session Detected">Phát hiện tiến trình đang thực hiện dở</span>:</strong>
                <span class="text-dark ml-1">PO <strong id="restore-po-number" class="text-primary">-</strong> | Khách hàng: <strong id="restore-customer-name" class="text-primary">-</strong> (<span id="restore-step-desc" class="badge badge-warning text-dark font-weight-bold">Bước 4</span>)</span>
            </div>
        </div>
        <div class="py-1">
            <button type="button" id="btn-restore-session-action" class="btn btn-sm btn-primary font-weight-bold shadow-sm mr-2 px-3">
                <i class="fas fa-play mr-1"></i> <span class="lang-text" data-i18n="Resume Process">Tiếp tục tiến trình này</span>
            </button>
            <button type="button" id="btn-discard-session-action" class="btn btn-sm btn-outline-secondary font-weight-bold px-2">
                <i class="fas fa-times mr-1"></i> <span class="lang-text" data-i18n="Start Fresh">Làm phiên mới</span>
            </button>
        </div>
    </div>
</div>

<!-- Step Progress Bar (Đặt ngay trên Action Bar) -->
<div class="netsuite-stepper-wrapper">
    <div class="netsuite-stepper">
        <div class="netsuite-stepper-line"></div>

        <!-- Step 1: Active -->
        <div class="netsuite-step active" id="step-node-1">
            <div class="step-num">1</div>
            <div class="step-text"><span class="lang-text">Inbound PO Review</span></div>
        </div>

        <!-- Step 2 -->
        <div class="netsuite-step" id="step-node-2">
            <div class="step-num">2</div>
            <div class="step-text"><span class="lang-text">ERP Price Compare</span></div>
        </div>

        <!-- Step 3 -->
        <div class="netsuite-step" id="step-node-3">
            <div class="step-num">3</div>
            <div class="step-text"><span class="lang-text" data-i18n="Create ERP PO">Create ERP PO</span></div>
        </div>

        <!-- Step 4 -->
        <div class="netsuite-step" id="step-node-4">
            <div class="step-num">4</div>
            <div class="step-text"><span class="lang-text" data-i18n="Create Sales Order">Create Sales Order</span></div>
        </div>
    </div>
</div>

<!-- Action Bar & Controls -->
<div class="action-bar d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <!-- Button Import PDF (Duy nhất được hoạt động) -->
        <label class="btn btn-sm btn-info mb-0 mr-1 shadow-sm cursor-pointer" id="btn-import-wrapper">
            <i class="fas fa-file-upload mr-1"></i> <span class="lang-text">Import File PDF</span>
            <input type="file" id="pdf-file-input" accept="application/pdf" style="display: none;">
        </label>

        <!-- Các nút chức năng khác mặc định bị disabled -->
        <button type="button" class="btn btn-sm btn-secondary font-weight-bold mr-1 d-none" id="btn-convert" disabled><span class="lang-text">Convert to ERP PO</span></button>

        <!-- Nút Submit Sales Order (Chỉ hiển thị ở Bước 4) -->
        <button type="button" class="btn btn-sm btn-success font-weight-bold mr-1 d-none shadow-sm" id="btn-submit-so">
            <i class="fas fa-paper-plane mr-1"></i> <span class="lang-text" data-i18n="Submit & Create SO">Submit & Create SO</span>
        </button>

        <!-- Nút Edit Data -->
        <button type="button" class="btn btn-sm btn-warning text-white font-weight-bold mr-1" id="btn-edit-data" disabled>
            <i class="fas fa-edit mr-1"></i> <span class="lang-text">Edit Data</span>
        </button>

        <!-- Nhóm nút Edit (Ẩn mặc định) -->
        <div id="edit-actions-group" class="align-items-center mr-1" style="display: none !important;">
            <button type="button" class="btn btn-sm btn-success font-weight-bold mr-1" id="btn-add-line">
                <i class="fas fa-plus mr-1"></i> <span class="lang-text">Add Item</span>
            </button>
            <button type="button" class="btn btn-sm btn-primary font-weight-bold mr-1" id="btn-save-edit">
                <i class="fas fa-check mr-1"></i> <span class="lang-text">Save Changes</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary font-weight-bold" id="btn-cancel-edit">
                <i class="fas fa-times mr-1"></i> <span class="lang-text">Cancel</span>
            </button>
        </div>

        <button type="button" class="btn btn-sm btn-outline-danger font-weight-bold" id="btn-reject" disabled><span class="lang-text">Reject PO</span></button>

        <!-- NÚT RELOAD ERP DATA (Nằm ở vị trí khoanh đỏ, chỉ hiển thị khi sang Bước 2) -->
        <button type="button" id="btn-reload-erp" class="btn btn-sm btn-outline-primary font-weight-bold shadow-sm ml-2 d-none">
            <i class="fas fa-sync-alt mr-1"></i> <span class="lang-text">Reload ERP data</span>
        </button>
    </div>

    <!-- Modal Confirm Reject PO -->
    <div class="modal fade" id="rejectPoModal" tabindex="-1" role="dialog" aria-labelledby="rejectPoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title font-weight-bold" id="rejectPoModalLabel">
                        <i class="fas fa-exclamation-triangle mr-1"></i> <span class="lang-text">ConfirmReject</span>
                    </h6>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-2 text-dark"><span class="lang-text">RejectConfirmDeatails</span></p>
                    <div class="form-group mb-0">
                        <label for="reject-reason" class="small font-weight-bold text-muted mb-1"><span class="lang-text">Reject Reason</span> <span class="text-danger">*</span>:</label>
                        <textarea class="form-group form-control text-dark" id="reject-reason" rows="3" placeholder="Enter the detailed reason for rejecting the PO..."></textarea>
                        <small id="reject-reason-error" class="text-danger font-weight-bold d-none"><span class="lang-text">RejectReasonDeatils</span></small>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary font-weight-bold" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> <span class="lang-text">Cancel</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-danger font-weight-bold" id="btn-confirm-reject">
                        <i class="fas fa-check mr-1"></i> <span class="lang-text">Agree</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Thông báo kết quả tạo Purchase Order / PO NetSuite -->
    <div class="modal fade" id="netsuiteResultModal" tabindex="-1" role="dialog" aria-labelledby="netsuiteResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header" id="ns-modal-header">
                    <h6 class="modal-title font-weight-bold text-white" id="netsuiteResultModalLabel">
                        <i id="ns-modal-icon" class="fas fa-info-circle mr-1"></i> <span class="lang-text">CreateERPPOTitle</span>
                    </h6>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="ns-modal-message" class="font-weight-bold mb-2 text-dark"></p>
                    <div id="ns-modal-po-info" class="small text-muted d-none">
                        <span>PO Number</span>: <strong id="ns-modal-po-number" class="text-primary"></strong>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary font-weight-bold" data-dismiss="modal"><span class="lang-text">Close</span></button>
                    <!-- Nút mở link NetSuite (Chỉ hiện khi thành công) -->
                    <a href="#" id="ns-modal-link-btn" target="_blank" class="btn btn-sm btn-success font-weight-bold d-none">
                        <i class="fas fa-external-link-alt mr-1"></i> <span class="lang-text">OpenAPOInNetSuite</span>
                    </a>
                    <!-- Nút chuyển sang Bước 4: Tạo Sales Order (Chỉ hiện khi tạo PO thành công) -->
                    <button type="button" class="btn btn-sm btn-primary font-weight-bold d-none shadow-sm" id="btn-proceed-step4-so">
                        <i class="fas fa-arrow-right mr-1"></i> <span class="lang-text" data-i18n="Proceed to Create SO (Step 4)">Proceed to Create SO (Step 4)</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Thông báo kết quả tạo Sales Order NetSuite (Bước 4) -->
    <div class="modal fade" id="salesOrderResultModal" tabindex="-1" role="dialog" aria-labelledby="salesOrderResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header bg-success text-white py-2" id="so-result-modal-header">
                    <h6 class="modal-title font-weight-bold" id="salesOrderResultModalLabel">
                        <i id="so-result-modal-icon" class="fas fa-check-circle mr-1"></i> <span class="lang-text" data-i18n="Sales Order Result">Sales Order Result</span>
                    </h6>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="so-result-modal-message" class="font-weight-bold mb-2 text-dark"></p>
                    <div id="so-result-modal-info" class="small text-muted mb-2">
                        <span class="lang-text" data-i18n="Sales Order Number">Sales Order Number</span>: <strong id="so-result-modal-number" class="text-primary font-weight-bold"></strong>
                    </div>
                    <div id="so-result-modal-ref-po" class="small text-muted">
                        <span class="lang-text" data-i18n="Ref NetSuite PO:">Ref NetSuite PO:</span> <strong id="so-result-modal-po-number" class="text-success font-weight-bold"></strong>
                    </div>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary font-weight-bold" data-dismiss="modal"><span class="lang-text" data-i18n="Close">Close</span></button>
                    <!-- Nút mở link SO NetSuite (Chỉ hiện khi thành công và có URL) -->
                    <a href="#" id="so-result-modal-link-btn" target="_blank" class="btn btn-sm btn-success font-weight-bold d-none">
                        <i class="fas fa-external-link-alt mr-1"></i> <span class="lang-text" data-i18n="Open SO in NetSuite">Open SO in NetSuite</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Xác nhận đúng SigmaCode khi Edit ItemCode -->
    <div class="modal fade" id="confirmSigmaCodeModal" tabindex="-1" role="dialog" aria-labelledby="confirmSigmaCodeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header bg-warning text-dark py-2">
                    <h6 class="modal-title font-weight-bold" id="confirmSigmaCodeModalLabel">
                        <i class="fas fa-exclamation-triangle mr-1"></i> Confirm that the item code matches the ERP system.
                    </h6>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-2 text-dark"><span>You have just changed the item code (ItemCode). Please ensure that the code you have entered is correct</span> <strong>SigmaCode</strong> <span>has been configured on the ERP system.</span></p>
                    <p class="small text-muted mb-0"><span>Code currently being modified:</span> <strong id="lbl-editing-itemcode" class="text-primary"></strong></p>
                </div>
                <div class="modal-footer py-2 bg-light">
