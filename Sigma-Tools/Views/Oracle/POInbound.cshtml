        // 2. Khi bấm nút Đồng Ý (Reject) trong Popup
    $(document).on('click', '#btn-confirm-reject', function () {
        const reason = $('#reject-reason').val().trim();
        const poNumber = $('#po-number-display').text().trim();

        // Validate bắt buộc nhập lý do
        if (reason === '') {
            $('#reject-reason-error').removeClass('d-none');
            return;
        }
        $('#reject-reason-error').addClass('d-none');

        // Khóa nút để tránh bấm nhiều lần
        const $btn = $(this);
        $btn.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin mr-1"></i> ${t('Processing...')}`);

        // Gửi dữ liệu xuống Controller
        $.ajax({
            url: '@Url.Action("RejectPO", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                PONumber: poNumber,
                Reason: reason
            }),
            success: function (response) {
                if (response.success) {
                    $('#rejectPoModal').modal('hide');
                    alert(response.message);
                    clearLocalSession();
                    saveServerSession('REJECTED', currentStep);
                    // Refresh lại trang khi thành công
                    window.location.reload();
                } else {
                    alert(t('Error:') + ' ' + response.message);
                    $btn.prop('disabled', false).html(`<i class="fas fa-check mr-1"></i> ${t('Confirm (Reject)')}`);
                }
            },
            error: function () {
                alert(t('A connection error occurred while rejecting the PO!'));
                $btn.prop('disabled', false).html(`<i class="fas fa-check mr-1"></i> ${t('Confirm (Reject)')}`);
            }
        });
    });

    
