            } else {
                $('#btn-edit-data').hide(); // Ẩn hoàn toàn nút Edit ở Bước 2 theo yêu cầu mới
            }

            // Chuyển Header và Bảng về dạng text tĩnh
            makeHeaderEditable(false);
