    // =============================================================
    // 1. Khi bấm nút Convert trên Action Bar -> Gọi API lấy Subsidiaries và mở Modal
    $(document).on('click', '#btn-convert', function () {
        $('#select-location, #select-taxcode, #select-projectcode').prop('disabled', true);
        $('#btn-confirm-create-so').prop('disabled', true);

        const customerId = $('#po-customer-display').text().trim();

        $.ajax({
            url: '@Url.Action("GetSubsidiaries", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ customerId: customerId }),
            success: function (response) {
                console.log("=== API SUBSIDIARIES RESPONSE ===", response);

                let $subSelect = $('#select-subsidiary');
                $subSelect.empty();

                let defaultText = t('-- Select Subsidiary --');
                $subSelect.append(`<option value="" selected disabled>${defaultText}</option>`);

                // Hứng qua response.data vì response.data lúc này chính là SubsidiaryApiResponse
                if (response && response.success && response.data) {
                    let subs = response.data.subsidiaries || [];

                    if (subs.length > 0) {
                        subs.forEach(sub => {
                            let name = sub.name;
                            let legalName = sub.legalname;
                            let id = sub.id;

                            let displayName = name;
                            $subSelect.append(`<option value="${id}">${displayName}</option>`);
                        });
                    } else {
                        $subSelect.append(`<option value="" disabled>Không có dữ liệu Subsidiary</option>`);
                    }
                }

                $('#subsidiarySelectModal').modal('show');
            },
            error: function (xhr, status, error) {
                console.error("Lỗi AJAX GetSubsidiaries:", error);
                alert('Lỗi khi tải dữ liệu Subsidiaries!');
                $('#subsidiarySelectModal').modal('show');
            }
        });
    });

    // Hàm kiểm tra xem cả 4 select đã được chọn giá trị đầy đủ chưa để bật nút Confirm
    function checkFormReady() {
        const sub = $('#select-subsidiary').val();
        const loc = $('#select-location').val();
        const tax = $('#select-taxcode').val();
        const prj = $('#select-projectcode').val();

        // Kiểm tra xem Tax Code có bắt buộc phải chọn ở Subsidiary này hay không
        const isTaxRequired = $('#select-taxcode').data('required') === true;

        // Điều kiện hợp lệ cho Tax Code: Hoặc là không bắt buộc, hoặc là bắt buộc và đã được chọn giá trị
        const isTaxValid = !isTaxRequired || (isTaxRequired && tax);

        // Nút Confirm chỉ sáng khi: Đã chọn Subsidiary, Location, Project Code VÀ Tax Code thỏa mãn điều kiện (có hoặc đã chọn)
        if (sub && loc && isTaxValid && prj) {
            $('#btn-confirm-create-so').prop('disabled', false);
        } else {
            $('#btn-confirm-create-so').prop('disabled', true);
        }
    }

    // 2. Khi người dùng chọn/thay đổi Subsidiary trên selectbox chính
    // Sự kiện khi chọn/thay đổi Subsidiary
    $(document).on('change', '#select-subsidiary', function () {
        const selectedSubId = $(this).val();

        // Lấy các element select
        let $locSelect = $('#select-location');
        let $taxSelect = $('#select-taxcode');
        let $prjSelect = $('#select-projectcode');

        // Reset và đưa về trạng thái mặc định cho 3 select còn lại
        $locSelect.empty().append(`<option value="" selected disabled>${t('-- Select Location --')}</option>`);
        $taxSelect.empty().append(`<option value="" selected disabled>${t('-- Select Tax Code --')}</option>`);
        $prjSelect.empty().append(`<option value="" selected disabled>${t('-- Select Project Code --')}</option>`);

        // Check lại form (lúc này sẽ disable nút Confirm vì thiếu 3 mục kia)
        checkFormReady();

        if (selectedSubId) {
            // Mở khóa tạm thời các ô select phía sau
            $('#select-location, #select-taxcode, #select-projectcode').prop('disabled', false);

            const subsidiaryIdInt = parseInt(selectedSubId, 10);
            const requestPayload = JSON.stringify({ SubsidiaryId: subsidiaryIdInt });

            // ==========================================
            // 1. GỌI AJAX LẤY LOCATIONS
            // ==========================================
            $.ajax({
                url: '@Url.Action("GetLocationsBySubsidiary", "Oracle")',
                type: 'POST',
                contentType: 'application/json',
                data: requestPayload,
                success: function (response) {
                    if (response && response.success && response.data) {
                        let locations = response.data.locations || [];
                        if (locations.length > 0) {
                            locations.forEach(loc => {
                                if (!loc.isinactive) {
                                    $locSelect.append(`<option value="${loc.id}">${loc.name}</option>`);
                                }
                            });
                        } else {
                            $locSelect.append(`<option value="" disabled>Không có dữ liệu Location</option>`);
                        }
                    }
                    checkFormReady();
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX Locations:", error);
                    checkFormReady();
                }
            });

            // ==========================================
            // 2. GỌI AJAX LẤY TAX CODES
            // ==========================================
            $.ajax({
                url: '@Url.Action("GetTaxCodesBySubsidiary", "Oracle")',
                type: 'POST',
                contentType: 'application/json',
                data: requestPayload,
                success: function (response) {
                    if (response && response.success && response.data) {
                        let taxCodes = response.data.taxCodes || [];

                        if (taxCodes.length > 0) {
                            // Trường hợp CÓ dữ liệu Tax Code -> Đổ dữ liệu và đánh dấu BẮT BUỘC chọn
                            taxCodes.forEach(tax => {
                                if (!tax.isinactive) {
                                    $taxSelect.append(`<option value="${tax.id}">${tax.itemid} (Rate: ${tax.rate})</option>`);
                                }
                            });
                            $taxSelect.prop('disabled', false);
                            $taxSelect.data('required', true); // Gắn cờ bắt buộc
                        } else {
                            // Trường hợp KHÔNG CÓ dữ liệu Tax Code -> Cho phép bỏ qua, đánh dấu KHÔNG BẮT BUỘC
                            let noTaxText = t('-- No Tax Code available --');
                            $taxSelect.empty().append(`<option value="" selected>${noTaxText}</option>`);
                            $taxSelect.prop('disabled', true); // Khóa ô lại vì không có gì để chọn
                            $taxSelect.data('required', false); // Gắn cờ không bắt buộc
                        }
                    } else {
                        // Xử lý khi phản hồi lỗi hoặc rỗng
                        $taxSelect.empty().append(`<option value="" selected>${t('-- No Tax Code available --')}</option>`);
                        $taxSelect.prop('disabled', true);
                        $taxSelect.data('required', false);
                    }
                    checkFormReady();
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX Tax Codes:", error);
                    $taxSelect.empty().append(`<option value="" selected>${t('-- No Tax Code available --')}</option>`);
                    $taxSelect.prop('disabled', true);
                    $taxSelect.data('required', false);
                    checkFormReady();
                }
            });

            // ==========================================
            // 3. GỌI AJAX LẤY PROJECT CODES
            // ==========================================
            $.ajax({
                url: '@Url.Action("GetProjectCodesBySubsidiary", "Oracle")',
                type: 'POST',
                contentType: 'application/json',
                data: requestPayload,
                success: function (response) {
                    if (response && response.success && response.data) {
                        let projectCodes = response.data.projectCodes || [];
                        if (projectCodes.length > 0) {
                            projectCodes.forEach(prj => {
                                if (!prj.isinactive) {
                                    $prjSelect.append(`<option value="${prj.id}">${prj.name}</option>`);
                                }
                            });
                        } else {
                            $prjSelect.append(`<option value="" disabled>Không có dữ liệu Project Code</option>`);
                        }
                    }
                    checkFormReady();
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX Project Codes:", error);
                    checkFormReady();
                }
            });

            $locSelect.trigger('change');
            $taxSelect.trigger('change');
            $prjSelect.trigger('change');

        } else {
            // Nếu bỏ chọn Subsidiary -> Khóa và reset trắng cả 3 ô còn lại
            $('#select-location, #select-taxcode, #select-projectcode').prop('disabled', true);
            checkFormReady();
        }
    });

    // 2. Theo dõi sự kiện change trên các ô Location, Tax Code, Project Code để tự động cập nhật nút Confirm
    $(document).on('change', '#select-location, #select-taxcode, #select-projectcode', function () {
        checkFormReady();
    });

    // 2. Khi bấm nút "Confirm & Create PO" trong Popup -> Tiến hành gom dữ liệu và gọi AJAX
    // Khi bấm "Confirm & Create PO" trong Popup
    $(document).on('click', '#btn-confirm-create-so', function () {
        // Đọc giá trị và text từ các thẻ select
        const selectedSubsidiary = parseInt($('#select-subsidiary').val(), 10) || 0;
        const selectedSubsidiaryText = $('#select-subsidiary option:selected').text().trim();
        const selectedLocation = parseInt($('#select-location').val(), 10) || 0;
        const selectedLocationText = $('#select-location option:selected').text().trim();
        const selectedTaxCode = parseInt($('#select-taxcode').val(), 10) || 0;
        const selectedTaxCodeText = $('#select-taxcode option:selected').text().trim();
        const selectedProjectCode = parseInt($('#select-projectcode').val(), 10) || 0;
        const selectedProjectCodeText = $('#select-projectcode option:selected').text().trim();

        $('#subsidiarySelectModal').modal('hide');

        const $btnConvert = $('#btn-convert');

        // Đồng bộ dữ liệu sửa đổi vào raw JSON ẩn
        updateHiddenRawJson();

        let rawJsonStr = $('#ocr-raw-json-hidden').val();
        let rawOcrData = {};
        try {
            if (rawJsonStr) rawOcrData = JSON.parse(rawJsonStr);
        } catch (e) {
            console.error("Lỗi parse Raw OCR JSON:", e);
        }

        let poNumber = $('#po-number-display').text().trim();
        let poDate = $('#po-date-display').text().trim();
        let customer = $('#po-customer-display').text().trim();
        let requisitioner = $('#po-requisitioner-display').text().trim();
        let currency = $('#po-currency-hidden').val() || 'USD';

        let lineItems = [];
        $('#po-line-table tbody tr').each(function () {
            const $tr = $(this);
            if ($tr.find('td').length <= 1) return;

            let itemCode = $tr.find('.cell-item-code').text().trim() || $tr.find('td:nth-child(2)').text().trim();
            let description = $tr.attr('data-description') || '';
            let qty = parseInt($tr.find('.cell-qty').attr('data-original-qty') || $tr.find('.cell-qty').text().replace(/,/g, '')) || 0;
            let unitPrice = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price') || $tr.find('.cell-ocr-price').text().replace(/[$,]/g, '')) || 0;
            let erpBasePrice = parseFloat($tr.attr('data-erp-price')) || 0;

            lineItems.push({
                Line: parseInt($tr.find('td:nth-child(1)').text()) || 1,
                ItemCode: itemCode,
                Description: description,
                Qty: qty,
                UnitPrice: unitPrice,
                Amount: qty * unitPrice,
                ErpBasePrice: erpBasePrice
            });
        });

        if (lineItems.length === 0) {
            let emptyLineMsg = t("No line items found to create a Purchase Order!");
            alert(emptyLineMsg);
            return;
        }

        let createSoPayload = {
            TransactionId: currentTransactionId,
            PONumber: poNumber,
            Date: poDate,
            Customer: customer,
            Requisitioner: requisitioner,
            Currency: currency,
            Subsidiary: selectedSubsidiary,     // Gửi lên kiểu int
            Location: selectedLocation,         // Gửi lên kiểu int
            TaxCode: selectedTaxCode,           // Gửi lên kiểu int
            ProjectCode: selectedProjectCode,   // Gửi lên kiểu int
            LineItems: lineItems,
            RawOcrResponse: JSON.stringify(rawOcrData)
        };

        let processingPoText = t("Creating Purchase Order...");
        $btnConvert.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin mr-1"></i> ${processingPoText}`);
        let btnDefaultText = t("Convert to Purchase Order");

        $.ajax({
            url: '@Url.Action("CreateNetsuiteSO", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(createSoPayload),
            success: function (response) {
                $btnConvert.prop('disabled', false).html(btnDefaultText);

                if (response.success) {
                    // Lưu lại toàn bộ dữ liệu vừa tạo PO thành công để phục vụ chuyển tiếp sang Bước 4 (Tạo SO)
                    createdPoData = {
                        poId: response.poId,
                        poNumber: response.poNumber || poNumber,
                        poUrl: response.poUrl,
                        subsidiary: selectedSubsidiary,
                        subsidiaryText: selectedSubsidiaryText,
                        location: selectedLocation,
                        locationText: selectedLocationText,
                        taxCode: selectedTaxCode,
                        taxCodeText: selectedTaxCodeText,
                        projectCode: selectedProjectCode,
                        projectCodeText: selectedProjectCodeText
                    };
                    proceedingToStep4 = false;

                    // Lưu tiến trình PO_CREATED cả ở LocalStorage và Database
                    saveLocalSession();
                    saveServerSession('PO_CREATED', 4);

                    $('#ns-modal-header').removeClass('bg-danger').addClass('bg-success');
                    $('#ns-modal-icon').removeClass('fa-exclamation-triangle').addClass('fa-check-circle');
                    $('#ns-modal-message').text(response.message);
                    $('#ns-modal-po-number').text(response.poNumber);
                    $('#ns-modal-po-info').removeClass('d-none');

                    if (response.poUrl) {
                        $('#ns-modal-link-btn').attr('href', response.poUrl).removeClass('d-none');
                    } else {
                        $('#ns-modal-link-btn').addClass('d-none');
                    }

                    // Hiển thị nút chuyển tiếp sang Bước 4 tạo Sales Order
                    $('#btn-proceed-step4-so').removeClass('d-none');

                    $('#netsuiteResultModal').modal('show');
                    $('#netsuiteResultModal').off('hidden.bs.modal').on('hidden.bs.modal', function () {
                        if (!proceedingToStep4) {
                            location.reload();
                        }
                    });
                } else {
                    $('#btn-proceed-step4-so').addClass('d-none');
                    $('#ns-modal-header').removeClass('bg-success').addClass('bg-danger');
                    $('#ns-modal-icon').removeClass('fa-check-circle').addClass('fa-exclamation-triangle');
                    let defaultErr = t("An error occurred while creating the PO in NetSuite.");
                    $('#ns-modal-message').text(response.message || defaultErr);
                    $('#ns-modal-po-info').addClass('d-none');
                    $('#ns-modal-link-btn').addClass('d-none');
                    $('#netsuiteResultModal').modal('show');
                }
            },
            error: function () {
                let connErrMsg = t("A connection error occurred while sending the Purchase Order request to the server!");
                alert(connErrMsg);
                $btnConvert.prop('disabled', false).html(btnDefaultText);
            }
        });
    });

    // Hàm cập nhật thông tin chỉnh sửa từ giao diện vào object Raw JSON ẩn một cách chính xác
    function updateHiddenRawJson() {
        let rawJsonStr = $('#ocr-raw-json-hidden').val();
        if (!rawJsonStr) return;

        let rawOcrData = {};
        try {
            rawOcrData = JSON.parse(rawJsonStr);
        } catch (e) {
            console.error("Không thể parse JSON từ thẻ ẩn:", e);
            return;
        }

        // 1. Cập nhật các trường Header cơ bản nếu có thay đổi
        if (!rawOcrData.header) rawOcrData.header = {};

        let poNum = $('#po-number-display').text().trim();
        if (poNum && poNum !== 'N/A') rawOcrData.header.po_number = poNum;

        let poDate = $('#po-date-display').text().trim();
        if (poDate && poDate !== 'N/A') rawOcrData.header.po_date = poDate;

        let customer = $('#po-customer-display').text().trim();
        if (customer && customer !== 'N/A') {
            if (!rawOcrData.header.buyer) rawOcrData.header.buyer = {};
            rawOcrData.header.buyer.name = customer;
        }

        let requisitioner = $('#po-requisitioner-display').text().trim();
        if (requisitioner && requisitioner !== 'N/A') {
            if (!rawOcrData.header.buyer_contact) rawOcrData.header.buyer_contact = {};
            rawOcrData.header.buyer_contact.name = requisitioner;
        }

        let currency = $('#po-currency-hidden').val();
        if (currency) rawOcrData.header.currency = currency;

        // 2. Cập nhật danh sách Line Items từ bảng hiển thị hiện tại
        let updatedRawLineItems = [];
        $('#po-line-table tbody tr').each(function (idx) {
            const $tr = $(this);
            if ($tr.find('td').length <= 1) return;

            let lineNo = parseInt($tr.find('td:nth-child(1)').text()) || (idx + 1);

            let itemCode = $tr.find('.cell-item-code').text().trim() || $tr.find('td:nth-child(2)').text().trim();
            let description = $tr.attr('data-description') || $tr.find('td:nth-child(3)').text().trim() || '';

            let qty = parseInt($tr.find('.cell-qty').attr('data-original-qty') || $tr.find('.cell-qty').text().replace(/,/g, '')) ||
                      parseInt($tr.find('.input-qty').val()) || 0;

            let unitPrice = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price')) ||
                            parseFloat($tr.find('.input-ocr-price').val()) ||
                            parseFloat($tr.find('.input-price').val()) ||
                            parseFloat($tr.find('td:nth-child(5)').text().replace(/[$,]/g, '')) || 0;

            let amount = qty * unitPrice;

            // Lấy lại dòng gốc tương ứng trong mảng line_items cũ (để bảo toàn các thông tin phụ như category, inv_org, uom, eta_date...)
            let origRawItem = (rawOcrData.line_items && rawOcrData.line_items[idx]) ? rawOcrData.line_items[idx] : {};

            // Ghi đè các giá trị mới nhất
            origRawItem.line_no = lineNo;
            origRawItem.item = itemCode;
            origRawItem.description = description;
            origRawItem.quantity = qty;
            origRawItem.price_each = unitPrice;
            origRawItem.amount = amount;

            updatedRawLineItems.push(origRawItem);
        });

        // Chỉ gán lại line_items nếu có dữ liệu hợp lệ, tránh làm rỗng mảng gốc
        if (updatedRawLineItems.length > 0) {
            rawOcrData.line_items = updatedRawLineItems;
        }

        // Lưu ngược lại chuỗi JSON hoàn chỉnh vào thẻ ẩn
        $('#ocr-raw-json-hidden').val(JSON.stringify(rawOcrData));
    }

    // =============================================================
    // BƯỚC 4: TẠO SALES ORDER (SO) SAU KHI TẠO PO THÀNH CÔNG
    // =============================================================

    // 1. Khi bấm nút "Proceed to Create SO (Step 4)" từ Modal kết quả PO
    $(document).on('click', '#btn-proceed-step4-so', function () {
        proceedingToStep4 = true;
        $('#netsuiteResultModal').modal('hide');
        goToStep4();
    });

    // 2. Chuyển giao diện sang Bước 4 (Create Sales Order)
    function goToStep4() {
        currentStep = 4;

        // Cập nhật Stepper: Bước 3 completed, Bước 4 active
        $('#step-node-3').removeClass('active').addClass('completed');
        $('#step-node-4').removeClass('completed').addClass('active');

        // Ẩn tất cả nút chức năng của các bước trước, hiển thị nút Submit SO
        $('#btn-convert, #btn-edit-data, #btn-reject, #btn-reload-erp, #btn-import-wrapper').addClass('d-none');
        $('#edit-actions-group').attr('style', 'display: none !important');
        $('#btn-submit-so').removeClass('d-none').prop('disabled', false);

        // Hiển thị Card cấu hình "SO in ERP"
        $('#so-config-card').removeClass('d-none');

        // Điền ngày SO mặc định là ngày hôm nay
        let todayStr = new Date().toISOString().substring(0, 10);
        $('#so-date-input').val(todayStr);

        // 1. Subsidiary & Location luôn cố định là "Sigma Worldwide" theo quy định SO (No. 8 & No. 9)
        $('#so-subsidiary-display').val('Sigma Worldwide');
        $('#so-location-display').val('Sigma Worldwide');

        // 2. Tự động kế thừa Project Code từ Bước 3 (PO)
        let projText = (createdPoData && createdPoData.projectCodeText) ? createdPoData.projectCodeText : $('#select-projectcode option:selected').text().trim();
        let projId = (createdPoData && createdPoData.projectCode) ? createdPoData.projectCode : $('#select-projectcode').val();

        $('#so-projcode-id-hidden').val(projId || '');

        let projMatch = projText.match(/\d{3}/);
        if (projMatch) {
            $('#so-projcode-input').val(projMatch[0]);
        } else if (projText && projText !== '-- Select --' && projText !== '-- Select Project Code --' && !projText.includes('-- Select')) {
            $('#so-projcode-input').val(projText);
        } else if (projId) {
            let pVal = projId.toString();
            $('#so-projcode-input').val(pVal.length > 3 ? pVal.substring(pVal.length - 3) : pVal.padStart(3, '0'));
        }

        // Mặc định khóa readonly và hiển thị trạng thái kế thừa tự động từ PO
        $('#so-projcode-input').prop('readonly', true).removeClass('bg-white').addClass('bg-light');
        $('#btn-toggle-edit-projcode').html(`<i class="fas fa-pen mr-1"></i><span class="lang-text">${t("Edit")}</span>`);

        // Prefetch & Fill danh sách Person in charge từ NetSuite ERP
        loadPersonInChargeList();

        // Tự động kiểm tra và prefill DRI PM nếu có từ Requisitioner
        let reqVal = $('#po-requisitioner-display').text().trim();
        if (reqVal && reqVal !== 'N/A' && reqVal !== 'None' && reqVal.length > 2) {
            let matched = erpEmployeesList.find(e => (e.name && e.name.toLowerCase() === reqVal.toLowerCase()) ||
                                                     (e.entityId && e.entityId.toLowerCase() === reqVal.toLowerCase()));
            if (matched && matched.id != null) {
                $('#so-dri-pm-select').val(matched.id.toString()).trigger('change');
            }
        }

        // Cập nhật Badges
        $('#so-badge-status').addClass('d-none');
        $('#so-step4-badge-status')
            .removeClass('d-none badge-secondary badge-warning')
            .addClass('badge-primary')
            .css({ 'background-color': '#0d5287', 'color': '#fff' });
        let readyText = t("Ready for Submission");
        $('#so-step4-badge-text').html(`Sales Order: <strong>${readyText}</strong>`);

        // Cập nhật Alert Box
        const $alertBox = $('#ocr-audit-alert-box');
        $alertBox.show()
                 .removeClass('alert-error-custom alert-warning-custom')
                 .addClass('alert-success-custom')
                 .css({ 'background-color': '#f0fdf4', 'border': '1px solid #bbf7d0', 'color': '#166534' });

        let refPoNum = (createdPoData && createdPoData.poNumber) ? createdPoData.poNumber : $('#po-number-display').text().trim();
        $('#ocr-audit-title').html('<span class="text-success mr-1">●</span> ' + t("STEP 4: SALES ORDER CREATION READY"));
        $('#ocr-audit-details').html(`
            <li><strong>${t("Ref NetSuite PO:")}</strong> ${refPoNum}</li>
            <li><strong>${t("Sales Order Customization")}:</strong> ${t("You can review and adjust Unit Prices in the table below before creating the Sales Order.")}</li>
            <li><strong>${t("SO in ERP Rules:")}</strong> Custom Form: <em>Sigma Worldwide Sales Order</em> | Tax Code: <em>0 (SW)</em> | Cross-Sub Fulfillment: <em>Enabled</em> | Inv Loc: <em>Sigma Asia</em></li>
        `);
        $('#ocr-audit-action').removeClass('text-danger text-warning').addClass('text-success')
               .css('color', '#15803d')
               .html(`<strong>${t("Notice")}:</strong> ${t("Adjust prices if needed, then click 'Submit & Create SO' to finalize.")}`);

        // Cập nhật Card Header
        const $cardContainer = $('#po-line-table').closest('.card-custom');
        $cardContainer.find('.card-header span:first').html(`<i class="fas fa-file-invoice mr-1 text-primary"></i> ${t("SALES ORDER CREATION (STEP 4)")} <span class="badge badge-success ml-2 font-weight-normal">${t("Ref NetSuite PO:")} ${refPoNum}</span>`);

        // Cập nhật Header Bảng dữ liệu cho Bước 4 (Có cột Expected Ship Date, Inventory Location, Tax Code theo SO in ERP)
        $('#po-line-table thead').html(`
            <tr>
                <th style="width: 4%;">#</th>
                <th style="width: 17%;"><span class="lang-text">${t("Item Code")}</span></th>
                <th style="width: 22%;"><span class="lang-text">${t("Description")}</span></th>
                <th style="width: 8%; text-align: right;"><span class="lang-text">${t("Qty")}</span></th>
                <th style="width: 13%; text-align: right;"><span class="lang-text">${t("Unit Price")}</span> <span class="badge badge-warning text-dark ml-1" style="font-size: 0.68rem;">${t("Editable")}</span></th>
                <th style="width: 13%; text-align: center;"><span class="lang-text">${t("Expected Ship Date")}</span></th>
                <th style="width: 11%; text-align: center;"><span class="lang-text">${t("Inv Location")}</span></th>
                <th style="width: 12%; text-align: right;"><span class="lang-text">${t("Amount")}</span></th>
            </tr>
        `);

        // Render toàn bộ các dòng hàng hóa cho Bước 4
        renderStep4Table();
    }

    // 3. Render bảng dữ liệu cho Bước 4
    function renderStep4Table() {
        let rawJsonStr = $('#ocr-raw-json-hidden').val();
        let lineItems = [];
        try {
            if (rawJsonStr) {
                let ocrObj = JSON.parse(rawJsonStr);
                if (ocrObj && ocrObj.line_items) {
                    lineItems = ocrObj.line_items;
                }
            }
        } catch (e) {
            console.error("Lỗi parse Raw OCR JSON trong Bước 4:", e);
        }

        // Dự phòng nếu không đọc được từ thẻ ẩn thì đọc từ DOM table
        if (!lineItems || lineItems.length === 0) {
            $('#po-line-table tbody tr').each(function (idx) {
                const $tr = $(this);
                if ($tr.find('td').length <= 1) return;
                lineItems.push({
                    line_no: idx + 1,
                    item: $tr.find('.cell-item-code').text().trim() || $tr.find('td:nth-child(2)').text().trim(),
                    description: $tr.attr('data-description') || $tr.find('td:nth-child(3)').text().trim() || '',
                    quantity: parseFloat($tr.find('.cell-qty').attr('data-original-qty') || $tr.find('.cell-qty').text().replace(/,/g, '')) || 1,
                    price_each: parseFloat($tr.find('.cell-ocr-price').attr('data-original-price') || $tr.find('.cell-ocr-price').text().replace(/[$,]/g, '')) || 0,
                    expected_ship_date: $tr.attr('data-eta-date') || ''
                });
            });
        }

        let tbodyHtml = '';
        let totalQty = 0;
        let totalAmount = 0;
        let todayStr = new Date().toISOString().substring(0, 10);

        lineItems.forEach((item, idx) => {
            let lineNo = item.line_no || (idx + 1);
            let itemCode = item.item || item.item_no || '';
            let desc = item.description || '';
            let qty = parseFloat(item.quantity) || 0;
            let price = parseFloat(item.price_each) || 0;
            let amount = qty * price;
            let shipDate = item.expected_ship_date || item.eta_date || todayStr;

            totalQty += qty;
            totalAmount += amount;

            tbodyHtml += `<tr class="step4-row" data-line="${lineNo}" data-item="${itemCode}" data-description="${desc}" data-qty="${qty}">
                <td class="align-middle">${lineNo}</td>
                <td class="align-middle font-weight-bold text-dark">${itemCode}</td>
                <td class="align-middle text-muted small">${desc}</td>
                <td class="align-middle text-right font-weight-bold cell-step4-qty">${qty.toLocaleString()}</td>
                <td class="align-middle text-right">
                    <div class="input-group input-group-sm justify-content-end" style="max-width: 125px; margin-left: auto;">
                        <div class="input-group-prepend">
                            <span class="input-group-text py-0 px-2 font-weight-bold text-muted">$</span>
                        </div>
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm text-right font-weight-bold input-so-price" value="${price.toFixed(2)}" data-original-price="${price}" style="font-size: 0.88rem; color: #0d5287;" />
                    </div>
                </td>
                <td class="align-middle text-center">
                    <input type="date" class="form-control form-control-sm text-center font-weight-bold input-so-shipdate mx-auto" value="${shipDate}" style="max-width: 140px; font-size: 0.82rem;" title="Expected Ship Date" />
                </td>
                <td class="align-middle text-center">
                    <span class="badge badge-info font-weight-normal py-1 px-2" style="font-size: 0.78rem;">Sigma Asia</span>
                </td>
                <td class="align-middle text-right font-weight-bold text-dark cell-step4-amount">$${amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
            </tr>`;
        });

        $('#po-line-table tbody').html(tbodyHtml);

        // Hiển thị Footer Tổng cộng
        let formattedTotalAmount = totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        let totalLabel = t("SO Calculated Total:");
        let totalUnitsLabel = t("Total Units:");
        let tfootHtml = `
            <tr class="bg-light font-weight-bold text-dark" id="step4-total-row" style="border-top: 2px solid #cbd5e1;">
                <td colspan="3" class="text-right text-uppercase small text-muted">${totalUnitsLabel} <span id="so-total-units" class="text-dark font-weight-bold ml-1">${totalQty.toLocaleString()}</span></td>
                <td class="text-right"></td>
                <td colspan="3" class="text-right text-uppercase small text-muted">${totalLabel}</td>
                <td class="text-right text-primary h6 mb-0 font-weight-bold" id="so-total-amount">$${formattedTotalAmount}</td>
            </tr>
        `;

        if ($('#po-line-table tfoot').length === 0) {
            $('#po-line-table').append(`<tfoot>${tfootHtml}</tfoot>`);
        } else {
            $('#po-line-table tfoot').html(tfootHtml);
        }

        // Cập nhật card summary phía dưới
        $('#calculated-sum-display').text(`${totalQty.toLocaleString()} Units / $${formattedTotalAmount}`);
    }

    // 4. Bắt sự kiện chỉnh sửa giá (Unit Price) trong Bước 4 để tự động tính lại Amount & Totals
    $(document).on('input', '.input-so-price', function () {
        const $input = $(this);
        const $tr = $input.closest('tr');
        let newPrice = parseFloat($input.val()) || 0;
        if (newPrice < 0) {
            newPrice = 0;
            $input.val(0);
        }

        let qty = parseFloat($tr.attr('data-qty')) || 0;
        let newAmount = qty * newPrice;

        $tr.find('.cell-step4-amount').text('$' + newAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        // Tính lại tổng số tiền toàn bảng
        recalculateStep4Totals();
    });

    // Hàm tính lại tổng các dòng ở Bước 4
    function recalculateStep4Totals() {
        let totalAmount = 0;
        let totalQty = 0;

        $('#po-line-table tbody tr.step4-row').each(function () {
            const $tr = $(this);
            let qty = parseFloat($tr.attr('data-qty')) || 0;
            let price = parseFloat($tr.find('.input-so-price').val()) || 0;
            totalQty += qty;
            totalAmount += (qty * price);
        });

        let formattedTotal = totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        $('#so-total-units').text(totalQty.toLocaleString());
        $('#so-total-amount').text('$' + formattedTotal);
        $('#calculated-sum-display').text(`${totalQty.toLocaleString()} Units / $${formattedTotal}`);
    }

    // Cho phép người dùng chuyển đổi giữa chế độ Khóa (Readonly) và Chỉnh sửa Project Code nếu cần
    $(document).on('click', '#btn-toggle-edit-projcode', function () {
        let $input = $('#so-projcode-input');
        if ($input.prop('readonly')) {
            $input.prop('readonly', false).removeClass('bg-light').addClass('bg-white').focus();
            $(this).html(`<i class="fas fa-lock mr-1"></i><span class="lang-text">${t("Lock")}</span>`);
        } else {
            $input.prop('readonly', true).removeClass('bg-white').addClass('bg-light');
            $(this).html(`<i class="fas fa-pen mr-1"></i><span class="lang-text">${t("Edit")}</span>`);
        }
    });

    // -------------------------------------------------------------
    // QUẢN LÝ DANH SÁCH PERSON IN CHARGE (DRI PM) TỪ NETSUITE ERP
    // -------------------------------------------------------------
    let erpEmployeesList = [];
    let isPersonInChargeLoading = false;

    function loadPersonInChargeList() {
        if (erpEmployeesList.length > 0) {
            renderPersonInChargeOptions(erpEmployeesList);
            return;
        }
        if (isPersonInChargeLoading) return;
        isPersonInChargeLoading = true;

        $('#so-pic-count-badge').html('<i class="fas fa-spinner fa-spin mr-1"></i>ERP syncing...');

        $.ajax({
            url: '@Url.Action("GetPersonInCharge", "Oracle")',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                isPersonInChargeLoading = false;
                if (res && res.success && res.data && res.data.employees && res.data.employees.length > 0) {
                    erpEmployeesList = res.data.employees;
                    renderPersonInChargeOptions(erpEmployeesList);
                } else {
                    $('#so-pic-count-badge').html('<span class="text-warning">Default ERP</span>');
                }
            },
            error: function (err) {
                isPersonInChargeLoading = false;
                console.warn("Could not fetch Person in charge from ERP:", err);
                $('#so-pic-count-badge').html('<span class="text-muted">Standard list</span>');
            }
        });
    }

    function renderPersonInChargeOptions(employees) {
        if (!employees || employees.length === 0) return;

        let $picSelect = $('#so-dri-pm-select');
        let currentVal = $picSelect.val() || $('#so-dri-pm-id-hidden').val();
        let currentName = $('#so-dri-pm-input').val();

        $picSelect.empty();
        $picSelect.append('<option value="">-- Select Person in charge --</option>');

        employees.forEach(function (emp) {
            let empId = (emp.id != null) ? emp.id.toString() : '';
            let empName = (emp.name || emp.entityId || '').trim();
            if (!empName && !empId) return;

            let extraParts = [];
            if (emp.entityId && emp.entityId !== empName && !empName.includes(emp.entityId)) {
                extraParts.push(emp.entityId);
            }
            if (emp.email && empName !== emp.email && !empName.includes(String.fromCharCode(64))) {
                extraParts.push(emp.email);
            }
            let extra = extraParts.length > 0 ? ` (${extraParts.join(' - ')})` : '';
            let displayLabel = `${empName}${extra}`;

            let opt = new Option(displayLabel, empId, false, false);
            $(opt).attr('data-id', empId)
                  .attr('data-name', empName)
                  .attr('data-entityid', emp.entityId || '')
                  .attr('data-email', emp.email || '');
            $picSelect.append(opt);
        });

        $('#so-pic-count-badge').html(`<i class="fas fa-check text-success mr-1"></i>${employees.length} ERP`);

        // Khôi phục giá trị đã chọn nếu có
        if (currentVal && employees.some(e => e.id != null && e.id.toString() === currentVal.toString())) {
            $picSelect.val(currentVal.toString()).trigger('change');
        } else if (currentName) {
            let matched = employees.find(e => (e.name && e.name.toLowerCase() === currentName.toLowerCase()) ||
                                              (e.entityId && e.entityId.toLowerCase() === currentName.toLowerCase()));
            if (matched && matched.id != null) {
                $picSelect.val(matched.id.toString()).trigger('change');
            }
        } else {
            // Tự động kiểm tra theo Requisitioner nếu chưa chọn
            let reqVal = $('#po-requisitioner-display').text().trim();
            if (reqVal && reqVal !== 'N/A' && reqVal !== 'None' && reqVal.length > 2) {
                let matched = employees.find(e => (e.name && e.name.toLowerCase() === reqVal.toLowerCase()) ||
                                                  (e.entityId && e.entityId.toLowerCase() === reqVal.toLowerCase()));
                if (matched && matched.id != null) {
                    $picSelect.val(matched.id.toString()).trigger('change');
                }
            }
        }
    }

    // Sự kiện khi chọn Person in charge trên Select2 (chuẩn tìm kiếm giống Subsidiary, Location)
    $(document).on('change', '#so-dri-pm-select', function () {
        let selId = $(this).val();
        if (!selId) {
            $('#so-dri-pm-input').val('');
            $('#so-dri-pm-id-hidden').val('');
            return;
        }
        let selOpt = $(this).find('option:selected');
        let selName = selOpt.attr('data-name') || '';
        if (!selName && erpEmployeesList) {
            let emp = erpEmployeesList.find(e => e.id != null && e.id.toString() === selId.toString());
            if (emp) selName = emp.name || emp.entityId || '';
        }
        $('#so-dri-pm-id-hidden').val(selId);
        $('#so-dri-pm-input').val(selName);
    });

    // 5. Khi bấm nút "Submit & Create SO"
    $(document).on('click', '#btn-submit-so', function () {
        const $btn = $('#btn-submit-so');
        let hasInvalidPrice = false;
        let updatedLines = [];

        let soDateVal = $('#so-date-input').val();
        if (!soDateVal) {
            alert(t("Please fill in the SO Date!"));
            $('#so-date-input').focus();
            return;
        }

        let projCodeVal = $('#so-projcode-input').val().trim();
        let projCodeId = parseInt($('#so-projcode-id-hidden').val(), 10) || (createdPoData?.projectCode) || 0;

        // Nếu ô nhập trống thì tự động fallback lấy từ createdPoData hoặc Bước 3
        if (!projCodeVal && createdPoData && createdPoData.projectCodeText) {
            let m = createdPoData.projectCodeText.match(/\d{3}/);
            projCodeVal = m ? m[0] : createdPoData.projectCodeText;
            $('#so-projcode-input').val(projCodeVal);
        }
        if (!projCodeVal && projCodeId) {
            projCodeVal = projCodeId.toString();
            $('#so-projcode-input').val(projCodeVal);
        }

        if (!projCodeVal && !projCodeId) {
            alert(t("Project code must be entered (3 digits)!"));
            $('#so-projcode-input').prop('readonly', false).removeClass('bg-light').addClass('bg-white').focus();
            return;
        }

        $('#po-line-table tbody tr.step4-row').each(function (idx) {
            const $tr = $(this);
            let lineNo = parseInt($tr.attr('data-line'), 10) || (idx + 1);
            let itemCode = $tr.attr('data-item') || '';
            let desc = $tr.attr('data-description') || '';
            let qty = parseFloat($tr.attr('data-qty')) || 0;
            let priceVal = $tr.find('.input-so-price').val();
            let price = parseFloat(priceVal);
            let lineShipDate = $tr.find('.input-so-shipdate').val() || soDateVal;

            if (isNaN(price) || price < 0) {
                hasInvalidPrice = true;
                $tr.find('.input-so-price').addClass('is-invalid');
                return false;
            } else {
                $tr.find('.input-so-price').removeClass('is-invalid');
            }

            updatedLines.push({
                line_no: lineNo,
                item: itemCode,
                description: desc,
                quantity: qty,
                price_each: price,
                amount: qty * price,
                expected_ship_date: lineShipDate,
                inventory_location: 'Sigma Asia',
                tax_code: 0
            });
        });

        if (hasInvalidPrice) {
            alert(t("Unit Price cannot be negative!"));
            return;
        }

        if (updatedLines.length === 0) {
            alert(t("No line items found to create a Sales Order!"));
            return;
        }

        // Cập nhật lại chuỗi JSON ẩn với giá mới đã sửa
        let rawJsonStr = $('#ocr-raw-json-hidden').val();
        let rawOcrData = {};
        try {
            if (rawJsonStr) rawOcrData = JSON.parse(rawJsonStr);
        } catch (e) {
            console.error("Lỗi parse raw JSON khi submit SO:", e);
        }

        if (rawOcrData && rawOcrData.line_items) {
            for (let i = 0; i < rawOcrData.line_items.length && i < updatedLines.length; i++) {
                rawOcrData.line_items[i].price_each = updatedLines[i].price_each;
                rawOcrData.line_items[i].amount = updatedLines[i].amount;
                rawOcrData.line_items[i].expected_ship_date = updatedLines[i].expected_ship_date;
                rawOcrData.line_items[i].inventory_location = updatedLines[i].inventory_location;
                rawOcrData.line_items[i].tax_code = 0;
            }
        }

        let poNumber = $('#po-number-display').text().trim();
        let customer = $('#po-customer-display').text().trim();
        let currency = $('#po-currency-hidden').val() || 'USD';

        let driPmId = $('#so-dri-pm-id-hidden').val() || $('#so-dri-pm-select').val() || null;
        let driPmName = $('#so-dri-pm-input').val().trim() || $('#so-dri-pm-select option:selected').attr('data-name') || '';
        if (!driPmName && driPmId && erpEmployeesList && erpEmployeesList.length > 0) {
            let matched = erpEmployeesList.find(e => e.id != null && e.id.toString() === driPmId.toString());
            if (matched) driPmName = matched.name || matched.entityId || '';
        }

        let submitPayload = {
            TransactionId: currentTransactionId,
            PONumber: createdPoData?.poNumber || poNumber,
            CustomerPONumber: poNumber,
            Customer: customer,
            Date: soDateVal,
            Currency: currency,
            Subsidiary: 1, // Rule 8: Always Sigma Worldwide (1) for Sales Order
            Location: 105, // Rule 9: Always Sigma Worldwide (105) for Sales Order
            SubsidiaryName: 'Sigma Worldwide',
            LocationName: 'Sigma Worldwide',
            TaxCode: 0,
            ProjectCode: projCodeId || (parseInt(projCodeVal, 10) || 0),
            ProjectCodeStr: projCodeVal,
            PersonInCharge: driPmName,
            PersonInChargeId: driPmId ? parseInt(driPmId, 10) : null,
            PoType: $('#so-potype-select').val() || 'MP',
            PrType: 'DRI',
            AllowCrossSubsidiaryFulfillment: $('#so-cross-sub-chk').is(':checked'),
            CustomForm: '111', // Rule 1: Sigma Worldwide Sales Order (111)
            InventoryLocation: 'Sigma Asia',
            CreatedPoId: createdPoData?.poId || 0,
            CreatedPoUrl: createdPoData?.poUrl || '',
            LineItems: updatedLines,
            RawOcrResponse: JSON.stringify(rawOcrData)
        };

        let originalBtnHtml = $btn.html();
        $btn.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin mr-1"></i> ${t("Submitting Sales Order...")}`);

        $.ajax({
            url: '@Url.Action("CreateSalesOrder", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(submitPayload),
            success: function (response) {
                $btn.prop('disabled', false).html(originalBtnHtml);

                if (response.success) {
                    clearLocalSession();
                    saveServerSession('SO_COMPLETED', 4);

                    $('#so-result-modal-header').removeClass('bg-danger').addClass('bg-success');
                    $('#so-result-modal-icon').removeClass('fa-exclamation-triangle').addClass('fa-check-circle');
                    $('#so-result-modal-message').text(response.message || t("Sales Order Created Successfully!"));
                    $('#so-result-modal-number').text(response.soNumber || 'N/A');
                    $('#so-result-modal-po-number').text(submitPayload.PONumber);

                    if (response.soUrl) {
                        $('#so-result-modal-link-btn').attr('href', response.soUrl).removeClass('d-none');
                    } else {
                        $('#so-result-modal-link-btn').addClass('d-none');
                    }

                    $('#salesOrderResultModal').modal('show');
                    $('#salesOrderResultModal').off('hidden.bs.modal').on('hidden.bs.modal', function () {
                        location.reload();
                    });
                } else {
                    $('#so-result-modal-header').removeClass('bg-success').addClass('bg-danger');
                    $('#so-result-modal-icon').removeClass('fa-check-circle').addClass('fa-exclamation-triangle');
                    let defaultErr = t("An error occurred while creating the Sales Order in NetSuite.");
                    $('#so-result-modal-message').text(response.message || defaultErr);
                    $('#so-result-modal-info').addClass('d-none');
                    $('#so-result-modal-link-btn').addClass('d-none');
                    $('#salesOrderResultModal').modal('show');
                }
            },
            error: function () {
                let connErrMsg = t("A connection error occurred while sending the Sales Order request to the server!");
                alert(connErrMsg);
                $btn.prop('disabled', false).html(originalBtnHtml);
            }
        });
    });
</script>

<script>
    // Tự động bật Loader khi bất kỳ một request AJAX nào bắt đầu
    $(document).ajaxStart(function () {
        $('#global-loader').css('display', 'flex');
    });

    // Tự động tắt Loader khi tất cả các request AJAX hoàn tất (dù thành công hay lỗi)
    $(document).ajaxStop(function () {
        $('#global-loader').hide();
    });
</script>
