        // 2. Khi bấm nút Đồng Ý (Reject) trong Popup
    $(document).on('click', '#btn-confirm-reject', function () {
        const currentLang = localStorage.getItem('app_lang') || 'vi';
        const reason = $('#reject-reason').val().trim();
        const poNumber = $('#po-number-display').text().trim();

        // Validate bắt buộc nhập lý do
        if (reason === '') {
            $('#reject-reason-error').removeClass('d-none');
            return;
        }
        $('#reject-reason-error').addClass('d-none');

        // Khóa nút để tránh bấm nhiều lần
        const $btn = $(this);
        let processingText = (currentLang === 'en') ? 'Processing...' :
                             (currentLang === 'zh') ? '处理中...' : 'Đang xử lý...';
        $btn.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin mr-1"></i> ${processingText}`);

        // Gửi dữ liệu xuống Controller
        $.ajax({
            url: '@Url.Action("RejectPO", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                PONumber: poNumber,
                Reason: reason
            }),
            success: function (response) {
                if (response.success) {
                    $('#rejectPoModal').modal('hide');
                    alert(response.message);
                    // Refresh lại trang khi thành công
                    window.location.reload();
                } else {
                    let errorPrefix = (currentLang === 'en') ? 'Error: ' :
                                      (currentLang === 'zh') ? '错误：' : 'Lỗi: ';
                    alert(errorPrefix + response.message);

                    let btnRejectText = (currentLang === 'en') ? 'Confirm (Reject)' :
                                        (currentLang === 'zh') ? '确认（拒绝）' : 'Đồng Ý (Từ chối)';
                    $btn.prop('disabled', false).html(`<i class="fas fa-check mr-1"></i> ${btnRejectText}`);
                }
            },
            error: function () {
                let connErrorMsg = (currentLang === 'en') ? 'A connection error occurred while rejecting the PO!' :
                                   (currentLang === 'zh') ? '拒绝 PO 时发生连接错误！' : 'Đã xảy ra lỗi kết nối khi từ chối PO!';
                alert(connErrorMsg);

                let btnRejectText = (currentLang === 'en') ? 'Confirm (Reject)' :
                                    (currentLang === 'zh') ? '确认（拒绝）' : 'Đồng Ý (Từ chối)';
                $btn.prop('disabled', false).html(`<i class="fas fa-check mr-1"></i> ${btnRejectText}`);
            }
        });
    });

    
    // =============================================================
    // SỰ KIỆN GỬI DỮ LIỆU LÊN CONTROLLER KHI BẤM "CONVERT TO SALES ORDER"
    // =============================================================
    // 1. Khi bấm nút Convert trên Action Bar -> Gọi API lấy Subsidiaries và mở Modal
    $(document).on('click', '#btn-convert', function () {
        $('#select-location, #select-taxcode, #select-projectcode').prop('disabled', true);
        $('#btn-confirm-create-so').prop('disabled', true);

        const customerId = $('#po-customer-display').text().trim();
        const currentLang = localStorage.getItem('app_lang') || 'vi';

        $.ajax({
            url: '@Url.Action("GetSubsidiaries", "Oracle")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ customerId: customerId }),
            success: function (response) {
                console.log("=== API SUBSIDIARIES RESPONSE ===", response);

                let $subSelect = $('#select-subsidiary');
                $subSelect.empty();

                let defaultText = (currentLang === 'en') ? '-- Select Subsidiary --' :
                                  (currentLang === 'zh') ? '-- 请选择子公司 --' : '-- Chọn Subsidiary --';
                $subSelect.append(`<option value="" selected disabled>${defaultText}</option>`);

                // Hứng qua response.data vì response.data lúc này chính là SubsidiaryApiResponse
                if (response && response.success && response.data) {
                    let subs = response.data.subsidiaries || [];

                    if (subs.length > 0) {
                        subs.forEach(sub => {
                            let name = sub.name;
                            let legalName = sub.legalname;
                            let id = sub.id;

                            let displayName = name;
                            $subSelect.append(`<option value="${id}">${displayName}</option>`);
                        });
                    } else {
                        $subSelect.append(`<option value="" disabled>Không có dữ liệu Subsidiary</option>`);
                    }
                }

                $('#subsidiarySelectModal').modal('show');
            },
            error: function (xhr, status, error) {
                console.error("Lỗi AJAX GetSubsidiaries:", error);
                alert('Lỗi khi tải dữ liệu Subsidiaries!');
                $('#subsidiarySelectModal').modal('show');
            }
        });
    });

    // Hàm kiểm tra xem cả 4 select đã được chọn giá trị đầy đủ chưa để bật nút Confirm
    function checkFormReady() {
        const sub = $('#select-subsidiary').val();
        const loc = $('#select-location').val();
        const tax = $('#select-taxcode').val();
        const prj = $('#select-projectcode').val();

        // Kiểm tra xem Tax Code có bắt buộc phải chọn ở Subsidiary này hay không
        const isTaxRequired = $('#select-taxcode').data('required') === true;

        // Điều kiện hợp lệ cho Tax Code: Hoặc là không bắt buộc, hoặc là bắt buộc và đã được chọn giá trị
        const isTaxValid = !isTaxRequired || (isTaxRequired && tax);

        // Nút Confirm chỉ sáng khi: Đã chọn Subsidiary, Location, Project Code VÀ Tax Code thỏa mãn điều kiện (có hoặc đã chọn)
        if (sub && loc && isTaxValid && prj) {
            $('#btn-confirm-create-so').prop('disabled', false);
        } else {
            $('#btn-confirm-create-so').prop('disabled', true);
        }
    }

    // 2. Khi người dùng chọn/thay đổi Subsidiary trên selectbox chính
    // Sự kiện khi chọn/thay đổi Subsidiary
    $(document).on('change', '#select-subsidiary', function () {
        const selectedSubId = $(this).val();
        const currentLang = localStorage.getItem('app_lang') || 'vi';

        // Lấy các element select
        let $locSelect = $('#select-location');
        let $taxSelect = $('#select-taxcode');
        let $prjSelect = $('#select-projectcode');

        // Reset và đưa về trạng thái mặc định cho 3 select còn lại
        $locSelect.empty().append(`<option value="" selected disabled>-- Chọn Location --</option>`);
        $taxSelect.empty().append(`<option value="" selected disabled>-- Chọn Tax Code --</option>`);
        $prjSelect.empty().append(`<option value="" selected disabled>-- Chọn Project Code --</option>`);

        // Check lại form (lúc này sẽ disable nút Confirm vì thiếu 3 mục kia)
        checkFormReady();

        if (selectedSubId) {
            // Mở khóa tạm thời các ô select phía sau
            $('#select-location, #select-taxcode, #select-projectcode').prop('disabled', false);

            const subsidiaryIdInt = parseInt(selectedSubId, 10);
            const requestPayload = JSON.stringify({ SubsidiaryId: subsidiaryIdInt });

            // ==========================================
            // 1. GỌI AJAX LẤY LOCATIONS
            // ==========================================
            $.ajax({
                url: '@Url.Action("GetLocationsBySubsidiary", "Oracle")',
                type: 'POST',
                contentType: 'application/json',
                data: requestPayload,
                success: function (response) {
                    if (response && response.success && response.data) {
                        let locations = response.data.locations || [];
                        if (locations.length > 0) {
                            locations.forEach(loc => {
                                if (!loc.isinactive) {
                                    $locSelect.append(`<option value="${loc.id}">${loc.name}</option>`);
                                }
                            });
                        } else {
                            $locSelect.append(`<option value="" disabled>Không có dữ liệu Location</option>`);
                        }
                    }
                    checkFormReady();
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX Locations:", error);
                    checkFormReady();
                }
            });

            // ==========================================
            // 2. GỌI AJAX LẤY TAX CODES
            // ==========================================
            $.ajax({
                url: '@Url.Action("GetTaxCodesBySubsidiary", "Oracle")',
                type: 'POST',
                contentType: 'application/json',
                data: requestPayload,
                success: function (response) {
                    if (response && response.success && response.data) {
                        let taxCodes = response.data.taxCodes || [];

                        if (taxCodes.length > 0) {
                            // Trường hợp CÓ dữ liệu Tax Code -> Đổ dữ liệu và đánh dấu BẮT BUỘC chọn
                            taxCodes.forEach(tax => {
                                if (!tax.isinactive) {
                                    $taxSelect.append(`<option value="${tax.id}">${tax.itemid} (Rate: ${tax.rate})</option>`);
                                }
                            });
                            $taxSelect.prop('disabled', false);
                            $taxSelect.data('required', true); // Gắn cờ bắt buộc
                        } else {
                            // Trường hợp KHÔNG CÓ dữ liệu Tax Code -> Cho phép bỏ qua, đánh dấu KHÔNG BẮT BUỘC
                            let noTaxText = (currentLang === 'en') ? '-- No Tax Code available --' :
                                            (currentLang === 'zh') ? '-- 无可用税码 --' : '-- Không có Tax Code --';
                            $taxSelect.empty().append(`<option value="" selected>${noTaxText}</option>`);
                            $taxSelect.prop('disabled', true); // Khóa ô lại vì không có gì để chọn
                            $taxSelect.data('required', false); // Gắn cờ không bắt buộc
                        }
                    } else {
                        // Xử lý khi phản hồi lỗi hoặc rỗng
                        $taxSelect.empty().append(`<option value="" selected>-- Không có Tax Code --</option>`);
                        $taxSelect.prop('disabled', true);
                        $taxSelect.data('required', false);
                    }
                    checkFormReady();
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX Tax Codes:", error);
                    $taxSelect.empty().append(`<option value="" selected>-- Không có Tax Code --</option>`);
                    $taxSelect.prop('disabled', true);
                    $taxSelect.data('required', false);
                    checkFormReady();
                }
            });

            // ==========================================
            // 3. GỌI AJAX LẤY PROJECT CODES
            // ==========================================
            $.ajax({
                url: '@Url.Action("GetProjectCodesBySubsidiary", "Oracle")',
                type: 'POST',
                contentType: 'application/json',
                data: requestPayload,
                success: function (response) {
                    if (response && response.success && response.data) {
                        let projectCodes = response.data.projectCodes || [];
                        if (projectCodes.length > 0) {
                            projectCodes.forEach(prj => {
                                if (!prj.isinactive) {
                                    $prjSelect.append(`<option value="${prj.id}">${prj.name}</option>`);
                                }
                            });
                        } else {
                            $prjSelect.append(`<option value="" disabled>Không có dữ liệu Project Code</option>`);
                        }
                    }
                    checkFormReady();
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX Project Codes:", error);
                    checkFormReady();
                }
            });

            $locSelect.trigger('change');
            $taxSelect.trigger('change');
            $prjSelect.trigger('change');

        } else {
            // Nếu bỏ chọn Subsidiary -> Khóa và reset trắng cả 3 ô còn lại
            $('#select-location, #select-taxcode, #select-projectcode').prop('disabled', true);
            checkFormReady();
        }
    });

    // 2. Theo dõi sự kiện change trên các ô Location, Tax Code, Project Code để tự động cập nhật nút Confirm
    $(document).on('change', '#select-location, #select-taxcode, #select-projectcode', function () {
        checkFormReady();
    });

    // 2. Khi bấm nút "Confirm & Create SO" trong Popup -> Tiến hành gom dữ liệu và gọi AJAX
    // Khi bấm "Confirm & Create SO" trong Popup
    $(document).on('click', '#btn-confirm-create-so', function () {
        const currentLang = localStorage.getItem('app_lang') || 'vi';

        // Đọc giá trị từ các thẻ select và ép kiểu sang int
        const selectedSubsidiary = parseInt($('#select-subsidiary').val(), 10) || 0;
        const selectedLocation = parseInt($('#select-location').val(), 10) || 0;
        const selectedTaxCode = parseInt($('#select-taxcode').val(), 10) || 0;
        const selectedProjectCode = parseInt($('#select-projectcode').val(), 10) || 0;

        $('#subsidiarySelectModal').modal('hide');

        const $btnConvert = $('#btn-convert');

        // Đồng bộ dữ liệu sửa đổi vào raw JSON ẩn
        updateHiddenRawJson();

        let rawJsonStr = $('#ocr-raw-json-hidden').val();
        let rawOcrData = {};
        try {
            if (rawJsonStr) rawOcrData = JSON.parse(rawJsonStr);
        } catch (e) {
            console.error("Lỗi parse Raw OCR JSON:", e);
        }

        let poNumber = $('#po-number-display').text().trim();
        let poDate = $('#po-date-display').text().trim();
        let customer = $('#po-customer-display').text().trim();
        let requisitioner = $('#po-requisitioner-display').text().trim();
        let currency = $('#po-currency-hidden').val() || 'USD';

        let lineItems = [];
        $('#po-line-table tbody tr').each(function () {
            const $tr = $(this);
            if ($tr.find('td').length <= 1) return;

            let itemCode = $tr.find('.cell-item-code').text().trim() || $tr.find('td:nth-child(2)').text().trim();
            let description = $tr.attr('data-description') || '';
            let qty = parseInt($tr.find('.cell-qty').attr('data-original-qty') || $tr.find('.cell-qty').text().replace(/,/g, '')) || 0;
            let unitPrice = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price') || $tr.find('.cell-ocr-price').text().replace(/[$,]/g, '')) || 0;
            let erpBasePrice = parseFloat($tr.attr('data-erp-price')) || 0;

            lineItems.push({
                Line: parseInt($tr.find('td:nth-child(1)').text()) || 1,
                ItemCode: itemCode,
                Description: description,
                Qty: qty,
                UnitPrice: unitPrice,
                Amount: qty * unitPrice,
                ErpBasePrice: erpBasePrice
            });
        });

        const jsonUrl = '@Url.Content("~/json/")' + currentLang + '.json';
        $.getJSON(jsonUrl, function (dict) {
            if (lineItems.length === 0) {
                let emptyLineMsg = dict["No line items found to create a Sales Order!"] || "Không tìm thấy danh sách dòng hàng để tạo Sales Order!";
                alert(emptyLineMsg);
                return;
            }

            let createSoPayload = {
                PONumber: poNumber,
                Date: poDate,
                Customer: customer,
                Requisitioner: requisitioner,
                Currency: currency,
                Subsidiary: selectedSubsidiary,     // Gửi lên kiểu int
                Location: selectedLocation,         // Gửi lên kiểu int
                TaxCode: selectedTaxCode,           // Gửi lên kiểu int
                ProjectCode: selectedProjectCode,   // Gửi lên kiểu int
                LineItems: lineItems,
                RawOcrResponse: JSON.stringify(rawOcrData)
            };

            let processingSoText = dict["Creating Sales Order..."] || "Đang tạo Sales Order...";
            $btnConvert.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin mr-1"></i> ${processingSoText}`);
            let btnDefaultText = dict["Convert to Sales Order"] || "Convert to Sales Order";

            $.ajax({
                url: '@Url.Action("CreateNetsuiteSO", "Oracle")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(createSoPayload),
                success: function (response) {
                    $btnConvert.prop('disabled', false).html(btnDefaultText);

                    if (response.success) {
                        $('#ns-modal-header').removeClass('bg-danger').addClass('bg-success');
                        $('#ns-modal-icon').removeClass('fa-exclamation-triangle').addClass('fa-check-circle');
                        $('#ns-modal-message').text(response.message);
                        $('#ns-modal-po-number').text(response.poNumber);
                        $('#ns-modal-po-info').removeClass('d-none');

                        if (response.poUrl) {
                            $('#ns-modal-link-btn').attr('href', response.poUrl).removeClass('d-none');
                        } else {
                            $('#ns-modal-link-btn').addClass('d-none');
                        }

                        $('#netsuiteResultModal').modal('show');
                        $('#netsuiteResultModal').off('hidden.bs.modal').on('hidden.bs.modal', function () {
                            location.reload();
                        });
                    } else {
                        $('#ns-modal-header').removeClass('bg-success').addClass('bg-danger');
                        $('#ns-modal-icon').removeClass('fa-check-circle').addClass('fa-exclamation-triangle');
                        let defaultErr = dict["An error occurred while creating the PO in NetSuite."] || "Đã xảy ra lỗi khi tạo PO lên NetSuite.";
                        $('#ns-modal-message').text(response.message || defaultErr);
                        $('#ns-modal-po-info').addClass('d-none');
                        $('#ns-modal-link-btn').addClass('d-none');
                        $('#netsuiteResultModal').modal('show');
                    }
                },
                error: function () {
                    let connErrMsg = dict["A connection error occurred while sending the Sales Order request to the server!"] || "Đã xảy ra lỗi kết nối khi gửi yêu cầu tạo Sales Order lên server!";
                    alert(connErrMsg);
                    $btnConvert.prop('disabled', false).html(btnDefaultText);
                }
            });
        });
    });

    // Hàm cập nhật thông tin chỉnh sửa từ giao diện vào object Raw JSON ẩn một cách chính xác
    function updateHiddenRawJson() {
        let rawJsonStr = $('#ocr-raw-json-hidden').val();
        if (!rawJsonStr) return;

        let rawOcrData = {};
        try {
            rawOcrData = JSON.parse(rawJsonStr);
        } catch (e) {
            console.error("Không thể parse JSON từ thẻ ẩn:", e);
            return;
        }

        // 1. Cập nhật các trường Header cơ bản nếu có thay đổi
        if (!rawOcrData.header) rawOcrData.header = {};

        let poNum = $('#po-number-display').text().trim();
        if (poNum && poNum !== 'N/A') rawOcrData.header.po_number = poNum;

        let poDate = $('#po-date-display').text().trim();
        if (poDate && poDate !== 'N/A') rawOcrData.header.po_date = poDate;

        let customer = $('#po-customer-display').text().trim();
        if (customer && customer !== 'N/A') {
            if (!rawOcrData.header.buyer) rawOcrData.header.buyer = {};
            rawOcrData.header.buyer.name = customer;
        }

        let requisitioner = $('#po-requisitioner-display').text().trim();
        if (requisitioner && requisitioner !== 'N/A') {
            if (!rawOcrData.header.buyer_contact) rawOcrData.header.buyer_contact = {};
            rawOcrData.header.buyer_contact.name = requisitioner;
        }

        let currency = $('#po-currency-hidden').val();
        if (currency) rawOcrData.header.currency = currency;

        // 2. Cập nhật danh sách Line Items từ bảng hiển thị hiện tại
        let updatedRawLineItems = [];
        $('#po-line-table tbody tr').each(function (idx) {
            const $tr = $(this);
            if ($tr.find('td').length <= 1) return;

            let lineNo = parseInt($tr.find('td:nth-child(1)').text()) || (idx + 1);

            let itemCode = $tr.find('.cell-item-code').text().trim() || $tr.find('td:nth-child(2)').text().trim();
            let description = $tr.attr('data-description') || $tr.find('td:nth-child(3)').text().trim() || '';

            let qty = parseInt($tr.find('.cell-qty').attr('data-original-qty') || $tr.find('.cell-qty').text().replace(/,/g, '')) ||
                      parseInt($tr.find('.input-qty').val()) || 0;

            let unitPrice = parseFloat($tr.find('.cell-ocr-price').attr('data-original-price')) ||
                            parseFloat($tr.find('.input-ocr-price').val()) ||
                            parseFloat($tr.find('.input-price').val()) ||
                            parseFloat($tr.find('td:nth-child(5)').text().replace(/[$,]/g, '')) || 0;

            let amount = qty * unitPrice;

            // Lấy lại dòng gốc tương ứng trong mảng line_items cũ (để bảo toàn các thông tin phụ như category, inv_org, uom, eta_date...)
            let origRawItem = (rawOcrData.line_items && rawOcrData.line_items[idx]) ? rawOcrData.line_items[idx] : {};

            // Ghi đè các giá trị mới nhất
            origRawItem.line_no = lineNo;
            origRawItem.item = itemCode;
            origRawItem.description = description;
            origRawItem.quantity = qty;
            origRawItem.price_each = unitPrice;
            origRawItem.amount = amount;

            updatedRawLineItems.push(origRawItem);
        });

        // Chỉ gán lại line_items nếu có dữ liệu hợp lệ, tránh làm rỗng mảng gốc
        if (updatedRawLineItems.length > 0) {
            rawOcrData.line_items = updatedRawLineItems;
        }

        // Lưu ngược lại chuỗi JSON hoàn chỉnh vào thẻ ẩn
        $('#ocr-raw-json-hidden').val(JSON.stringify(rawOcrData));
    }
</script>

<script>
    // Tự động bật Loader khi bất kỳ một request AJAX nào bắt đầu
    $(document).ajaxStart(function () {
        $('#global-loader').css('display', 'flex');
    });

    // Tự động tắt Loader khi tất cả các request AJAX hoàn tất (dù thành công hay lỗi)
    $(document).ajaxStop(function () {
        $('#global-loader').hide();
    });
</script>
