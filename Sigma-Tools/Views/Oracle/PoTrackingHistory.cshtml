@model List<Sigma_Tools.Models.PoOrderTrackingDisplayModel>
@{
    ViewData["Title"] = "PO Tracking History Report";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container-fluid px-4 py-3">
    <!-- Card Bộ Lọc Thời Gian -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body bg-light py-2 px-3">
            <form method="get" asp-action="PoTrackingHistory" class="form-inline justify-content-between">
                <div class="d-flex align-items-center flex-wrap">
                    <div class="form-group mr-3 mb-2">
                        <label class="small font-weight-bold mr-2 text-muted"><span>From Date:</span></label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group mr-3 mb-2">
                        <label class="small font-weight-bold mr-2 text-muted"><span>To Date:</span></label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary font-weight-bold mb-2 px-3">
                        <i class="fas fa-filter mr-1"></i> <span>Filter Data</span>
                    </button>
                </div>
                <div class="small text-muted mb-2">
                    <span>Total row:</span> <strong class="text-dark">@totalItems</strong>
                </div>
            </form>
        </div>
    </div>

    <!-- Card Bảng Dữ Liệu -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0 font-weight-bold">
                <i class="fas fa-table mr-1"></i> <span>PO & Part Number Tracking History Report</span>
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped mb-0 text-dark" style="font-size: 0.88rem;">
                    <thead class="thead-light text-uppercase" style="font-size: 0.78rem;">
                        <tr>
                            <th style="width: 13%;"><span>Creation time</span></th>
                            <th style="width: 11%;"><span>Creator</span></th>
                            <th style="width: 12%;"><span>PO Number</span></th>
                            <th style="width: 14%;"><span>Part Number</span></th>
                            <th style="width: 27%;"><span>Description</span></th>
                            <th style="width: 11%; text-align: right;"><span>Order Qty</span></th>
                            <!-- Sử dụng text có trong JSON hoặc thay thế tạm thời bằng key tương thích -->
                            <th style="width: 12%; text-align: right;"><span>Open Order Qty</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var row in Model)
                            {
                                <tr>
                                    <td>@row.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="text-secondary font-weight-bold">@row.CreatedBy</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(row.PoUrl))
                                        {
                                            <a href="@row.PoUrl" target="_blank" class="badge badge-primary font-weight-bold px-2 py-1 text-decoration-none" style="font-size: 0.80rem;" title="Mở trên NetSuite">
                                                @row.SigmaPO <i class="fas fa-external-link-alt ml-1" style="font-size: 0.7rem;"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary font-weight-bold px-2 py-1" style="font-size: 0.80rem;">
                                                @row.SigmaPO
                                            </span>
                                        }
                                    </td>
                                    <td class="font-weight-bold text-dark">@row.PartNumber</td>
                                    <td>@row.Description</td>
                                    <td class="text-right">@row.OrderQty.ToString("N0")</td>
                                    <td class="text-right text-success font-weight-bold">@row.OpenOrderQty.ToString("N0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle mr-1"></i> <span>There is no tracking data for this period.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer Phân Trang (Paging) -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-2 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Trang <strong>@currentPage</strong> / <strong>@totalPages</strong></span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = 1 })">Đầu</a>
                        </li>
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage - 1 })">&laquo;</a>
                        </li>

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = i })">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = currentPage + 1 })">&raquo;</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = totalPages })">Cuối</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>