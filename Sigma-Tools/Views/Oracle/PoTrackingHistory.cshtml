@model List<Sigma_Tools.Models.PoOrderTrackingDisplayModel>
@{
    ViewData["Title"] = "PO Tracking History Report";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container-fluid px-4 py-3">
    <!-- Card Bộ Lọc Thời Gian -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body bg-light py-2 px-3">
            <form method="get" asp-action="PoTrackingHistory" class="form-inline justify-content-between">
                <div class="d-flex align-items-center flex-wrap">
                    <div class="form-group mr-3 mb-2">
                        <label class="small font-weight-bold mr-2 text-muted"><span class="lang-text" data-i18n="From Date">From Date:</span></label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group mr-3 mb-2">
                        <label class="small font-weight-bold mr-2 text-muted"><span class="lang-text" data-i18n="To Date">To Date:</span></label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group mr-3 mb-2">
                        <label class="small font-weight-bold mr-2 text-muted"><span class="lang-text" data-i18n="Status">Status:</span></label>
                        <select name="status" class="form-control form-control-sm font-weight-bold text-dark">
                            <option value="" class="lang-text" data-i18n="All Status">-- All Status --</option>
                            <option value="PROCESSING" selected="@(ViewBag.SelectedStatus == "PROCESSING")" class="lang-text" data-i18n="Processing (Incomplete)">Processing (Chưa hoàn thành)</option>
                            <option value="PO_CREATED" selected="@(ViewBag.SelectedStatus == "PO_CREATED")" class="lang-text" data-i18n="PO Created (Pending SO)">PO Created (Chờ tạo SO)</option>
                            <option value="SO_COMPLETED" selected="@(ViewBag.SelectedStatus == "SO_COMPLETED")" class="lang-text" data-i18n="Completed (PO & SO)">Completed (Đã xong PO & SO)</option>
                            <option value="REJECTED" selected="@(ViewBag.SelectedStatus == "REJECTED")" class="lang-text" data-i18n="Rejected">Rejected</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary font-weight-bold mb-2 px-3">
                        <i class="fas fa-filter mr-1"></i> <span class="lang-text" data-i18n="Filter Data">Filter Data</span>
                    </button>

                    <!-- NÚT EXPORT EXCEL BỔ SUNG -->
                    <button type="button" id="btn-export-excel" class="btn btn-sm btn-success font-weight-bold mb-2 px-3 ml-3">
                        <i class="fas fa-file-excel mr-1"></i> <span class="lang-text" data-i18n="Export Data">Export Data</span>
                    </button>
                </div>
                <div class="small text-muted mb-2">
                    <span class="lang-text" data-i18n="Total row">Total row:</span> <strong class="text-dark">@totalItems</strong>
                </div>
            </form>
        </div>
    </div>

    <!-- Card Bảng Dữ Liệu -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0 font-weight-bold">
                <i class="fas fa-table mr-1"></i> <span class="lang-text" data-i18n="PO & Part Number Tracking History Report">PO & Part Number Tracking History Report</span>
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped mb-0 text-dark" style="font-size: 0.88rem;">
                    <thead class="thead-light text-uppercase" style="font-size: 0.78rem;">
                        <tr>
                            <th style="width: 12%;"><span class="lang-text" data-i18n="Creation Time">Creation time</span></th>
                            <th style="width: 10%;"><span class="lang-text" data-i18n="Creator">Creator</span></th>
                            <th style="width: 11%;"><span class="lang-text" data-i18n="Status">Status</span></th>
                            <th style="width: 13%;"><span class="lang-text" data-i18n="PO / SO Number">PO / SO Number</span></th>
                            <th style="width: 13%;"><span class="lang-text" data-i18n="Part Number">Part Number</span></th>
                            <th style="width: 23%;"><span class="lang-text" data-i18n="Description">Description</span></th>
                            <th style="width: 8%; text-align: right;"><span class="lang-text" data-i18n="Order Qty">Order Qty</span></th>
                            <th style="width: 10%; text-align: center;"><span class="lang-text" data-i18n="Action">Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var row in Model)
                            {
                                <tr>
                                    <td>@row.CreatedOn.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="text-secondary font-weight-bold">@row.CreatedBy</span></td>
                                    <td>
                                        @if (row.Status == "PO_CREATED")
                                        {
                                            <span class="badge badge-info font-weight-bold px-2 py-1" style="font-size: 0.78rem;" title="Đã tạo NetSuite PO, đang chờ tạo Sales Order">
                                                <i class="fas fa-clock mr-1"></i><span class="lang-text" data-i18n="Pending SO Creation">Chờ tạo SO</span>
                                            </span>
                                        }
                                        else if (row.Status == "PROCESSING")
                                        {
                                            <span class="badge badge-warning text-dark font-weight-bold px-2 py-1" style="font-size: 0.78rem;" title="Đang xử lý Bước @row.CurrentStep">
                                                <i class="fas fa-spinner fa-spin mr-1"></i><span class="lang-text" data-i18n="Processing">Đang xử lý</span> (B.@row.CurrentStep)
                                            </span>
                                        }
                                        else if (row.Status == "REJECTED")
                                        {
                                            <span class="badge badge-secondary font-weight-bold px-2 py-1" style="font-size: 0.78rem;">
                                                <i class="fas fa-ban mr-1"></i><span class="lang-text" data-i18n="Rejected">Đã từ chối</span>
                                            </span>
                                        }
                                        else if (row.Status == "FAILED")
                                        {
                                            <span class="badge badge-danger font-weight-bold px-2 py-1" style="font-size: 0.78rem;">
                                                <i class="fas fa-times-circle mr-1"></i><span class="lang-text" data-i18n="Error">Lỗi</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success font-weight-bold px-2 py-1" style="font-size: 0.78rem;">
                                                <i class="fas @(row.Status == "SO_COMPLETED" ? "fa-check-double" : "fa-check-circle") mr-1"></i>
                                                @if (row.Status == "SO_COMPLETED")
                                                {
                                                    <span class="lang-text" data-i18n="Completed (PO & SO)">Hoàn thành (PO & SO)</span>
                                                }
                                                else
                                                {
                                                    <span class="lang-text" data-i18n="Completed">Hoàn thành</span>
                                                }
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            @if (!string.IsNullOrEmpty(row.PoUrl))
                                            {
                                                <a href="@row.PoUrl" target="_blank" class="badge badge-primary font-weight-bold px-2 py-1 text-decoration-none shadow-sm" style="font-size: 0.80rem;" title="Mở NetSuite Purchase Order">
                                                    <i class="fas fa-file-invoice mr-1"></i>@row.SigmaPO <i class="fas fa-external-link-alt ml-1" style="font-size: 0.65rem;"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary font-weight-bold px-2 py-1" style="font-size: 0.80rem;">
                                                    @row.SigmaPO
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(row.SoNumber))
                                        {
                                            <div class="mt-1">
                                                @if (!string.IsNullOrEmpty(row.SoUrl))
                                                {
                                                    <a href="@row.SoUrl" target="_blank" class="badge badge-success font-weight-bold px-2 py-1 text-decoration-none shadow-sm" style="font-size: 0.80rem;" title="Mở NetSuite Sales Order">
                                                        <i class="fas fa-shopping-cart mr-1"></i>@row.SoNumber <i class="fas fa-external-link-alt ml-1" style="font-size: 0.65rem;"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success font-weight-bold px-2 py-1" style="font-size: 0.80rem;">
                                                        <i class="fas fa-shopping-cart mr-1"></i>@row.SoNumber
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(row.CustomerPONumber) && row.CustomerPONumber != row.SigmaPO)
                                        {
                                            <div class="text-muted small mt-1" style="font-size: 0.70rem;">
                                                <i class="fas fa-tag mr-1"></i>Cust PO: <strong>@row.CustomerPONumber</strong>
                                            </div>
                                        }
                                    </td>
                                    <td class="font-weight-bold text-dark">@row.PartNumber</td>
                                    <td>@row.Description</td>
                                    <td class="text-right font-weight-bold text-success">@row.OrderQty.ToString("N0")</td>
                                    <td class="text-center align-middle">
                                        @if (row.CanResume && !string.IsNullOrEmpty(row.TransactionId))
                                        {
                                            <a href="@Url.Action("POInbound", "Oracle", new { transactionId = row.TransactionId })" class="btn btn-sm btn-primary font-weight-bold px-2 py-1 shadow-sm text-nowrap" style="font-size: 0.78rem;" title="Tiếp tục tiến trình này">
                                                <i class="fas fa-play mr-1"></i><span class="lang-text" data-i18n="Resume">Tiếp tục</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle mr-1"></i> <span class="lang-text" data-i18n="There is no tracking data for this period.">There is no tracking data for this period.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer Phân Trang (Paging) -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-2 d-flex justify-content-between align-items-center">
                <span class="small text-muted"><span data-i18n="Page">Trang</span> <strong>@currentPage</strong> / <strong>@totalPages</strong></span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, status = ViewBag.SelectedStatus, page = 1 })" data-i18n="First">Đầu</a>
                        </li>
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, status = ViewBag.SelectedStatus, page = currentPage - 1 })">&laquo;</a>
                        </li>

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, status = ViewBag.SelectedStatus, page = i })">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, status = ViewBag.SelectedStatus, page = currentPage + 1 })">&raquo;</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("PoTrackingHistory", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, status = ViewBag.SelectedStatus, page = totalPages })" data-i18n="Last">Cuối</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>


<script>
        $('#btn-export-excel').on('click', function () {
            const fromDate = $('input[name="fromDate"]').val();
            const toDate = $('input[name="toDate"]').val();

            const payload = {
                fromDate: fromDate ? fromDate : null,
                toDate: toDate ? toDate : null
            };

            // Hiển thị trạng thái đang xử lý nếu muốn
            const $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> <span>' + t('Exporting...', 'Exporting...') + '</span>');

            fetch('@Url.Action("ExportPoTrackingToExcel", "Oracle")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(t('Could not export Excel file from server.'));
                }
                return response.blob();
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `PO_Tracking_History_${fromDate || 'all'}_${toDate || 'all'}.xlsx`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            })
            .catch(error => {
                console.error('Export Error:', error);
                alert(t('An error occurred while exporting the Excel file!'));
            })
            .finally(() => {
                $btn.prop('disabled', false).html('<i class="fas fa-file-excel mr-1"></i> <span>' + t('Export Data') + '</span>');
            });
        });
    </script>